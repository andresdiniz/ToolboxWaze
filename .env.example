# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env com credenciais reais.

APP_ENV=prod
APP_SECRET=troque_por_uma_string_aleatoria_longa

# Banco de dados
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/nome_banco?serverVersion=8.0&charset=utf8mb4"

# Mailer
MAILER_DSN=smtp://usuario:senha@smtp.exemplo.com:587
MAILER_FROM=noreply@seudominio.com.br

# URLs
APP_BASE_URL=https://seudominio.com.br

# Redis (para cache / deduplicação de e-mails)
REDIS_URL=redis://127.0.0.1:6379

# Web Push VAPID (gere com: composer require minishlink/web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seudominio.com.br

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
