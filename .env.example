# Copie este arquivo para .env.local e ajuste os valores

APP_ENV=prod
APP_SECRET=change_me_32_chars_minimum

###############################################################################
# Passo 1 — DATABASE_URL
# SEMPRE use host=localhost (socket Unix/named pipe) em vez do IP do servidor.
# Conexão via socket é ~30% mais rápida e não consome conexões TCP extras,
# evitando o erro max_connections_per_hour da Hostinger.
#
# Formato: mysql://user:password@localhost:3306/dbname?serverVersion=mariadb-10.6&charset=utf8mb4
#
# ⚠  Se algum script legado ainda usa o IP (ex.: 127.0.0.1), troque para localhost.
###############################################################################
DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_name?serverVersion=mariadb-10.6&charset=utf8mb4"

MAILER_DSN=null://null
