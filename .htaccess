# .htaccess na RAIZ do projeto Symfony
# Subdominio wazetoolbox.acheireviews.com.br aponta para esta pasta
# Redireciona tudo para /public sem path absoluto

RewriteEngine On
RewriteBase /

# Nao redirecionar se ja for um arquivo ou diretorio real
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Nao redirecionar o que ja comeca com public/
RewriteCond %{REQUEST_URI} !^/public/

# Redireciona para public/
RewriteRule ^(.*)$ public/$1 [L]
