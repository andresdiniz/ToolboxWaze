# .htaccess na RAIZ do projeto
# Redireciona todo o trafego para a pasta /public (front controller do Symfony)

RewriteEngine On

# Nao redirecionar se ja estiver dentro de /public
RewriteCond %{REQUEST_URI} !^/public/

# Nao redirecionar arquivos fisicos que existam na raiz
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redireciona tudo para /public
RewriteRule ^(.*)$ /public/$1 [L]
