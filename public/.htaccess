DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]
    RewriteCond %{ENV:REDIRECT_STATUS} ^\/?
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    # ------------------------------------------------------------------
    # CSP — ToolboxWaze
    # font-src usa wildcard (*) para cobrir qualquer CDN de fonte
    # (Google Fonts, jsDelivr, Fontshare, etc.) sem precisar listar
    # cada subdomínio individualmente.
    # ------------------------------------------------------------------
    Header always set Content-Security-Policy "\
 default-src 'self'; \
 script-src  'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net data:; \
 style-src   'self' 'unsafe-inline' cdn.jsdelivr.net fonts.googleapis.com api.fontshare.com; \
 font-src    *; \
 img-src     'self' data: blob: https://www.gstatic.com https://lh3.googleusercontent.com; \
 connect-src 'self' cdn.jsdelivr.net; \
 frame-ancestors 'none'; \
 base-uri    'self'; \
 form-action 'self'"

    Header always unset X-Powered-By
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
