# === Roteamento Symfony ===
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# === Headers de Segurança HTTP ===
<IfModule mod_headers.c>
    # Previne clickjacking — a página não pode ser embarcada em iframe externo
    Header always set X-Frame-Options "SAMEORIGIN"

    # Previne MIME type sniffing — browser respeita o Content-Type declarado
    Header always set X-Content-Type-Options "nosniff"

    # Controla quais informações de referrer são enviadas
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desabilita acesso a APIs sensíveis do browser
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Proteção XSS para browsers legados
    Header always set X-XSS-Protection "1; mode=block"

    # HSTS: força HTTPS por 1 ano (ativar somente se o site usar HTTPS)
    # Remova o # abaixo após confirmar que HTTPS está funcionando corretamente
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Remove header que expõe tecnologia do servidor
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# === Bloqueia acesso direto a arquivos sensíveis ===
<FilesMatch "(\.env|\.env\.local|\.env\.prod|composer\.json|composer\.lock|symfony\.lock|\.gitignore|phpunit\.dist\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
