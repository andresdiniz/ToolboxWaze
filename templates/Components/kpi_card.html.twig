<div class="card border-0 shadow-sm h-100" style="border-left:4px solid var(--bs-{{ color }}) !important">
    <div class="card-body py-3">
        <div class="text-{{ color }} small mb-1"><i class="bi {{ icon }} me-1"></i>{{ label }}</div>
        <div class="fs-4 fw-bold text-{{ color }} count-up" 
             data-key="{{ data_key|default('') }}"
             data-target="{{ value }}" 
             data-suffix="{{ suffix|default('') }}">0</div>
        {% if subtitle %}<div class="small text-muted">{{ subtitle }}</div>{% endif %}
    </div>
</div>