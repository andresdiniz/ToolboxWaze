{% extends 'base.html.twig' %}

{% block title %}Importando {{ state.uf }} — Log{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('admin_estados_index') }}" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Voltar
        </a>
        <h1 class="h4 mb-0">
            <i class="fas fa-terminal me-2 text-success"></i>
            Importação — <strong>{{ state.name }} ({{ state.uf }})</strong>
            {% if skip_waze %}
                <span class="badge bg-secondary ms-2">sem links Waze</span>
            {% endif %}
        </h1>
    </div>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-header bg-black d-flex align-items-center justify-content-between py-2 px-3">
            <div class="d-flex gap-2">
                <span style="width:12px;height:12px;border-radius:50%;background:#ff5f56;display:inline-block"></span>
                <span style="width:12px;height:12px;border-radius:50%;background:#ffbd2e;display:inline-block"></span>
                <span style="width:12px;height:12px;border-radius:50%;background:#27c93f;display:inline-block"></span>
            </div>
            <span class="text-muted small font-monospace">app:import-radares --uf={{ state.uf }}</span>
            <div class="d-flex gap-2 align-items-center">
                <span id="status-badge" class="badge bg-warning text-dark">
                    <i class="fas fa-spinner fa-spin me-1"></i> Iniciando…
                </span>
                <button id="btn-copy" class="btn btn-sm btn-outline-secondary py-0" title="Copiar log">
                    <i class="fas fa-copy"></i>
                </button>
            </div>
        </div>
        <div id="terminal"
             class="p-3 font-monospace"
             style="background:#0d1117;color:#c9d1d9;min-height:400px;max-height:70vh;
                    overflow-y:auto;font-size:0.8rem;line-height:1.6;white-space:pre-wrap;word-break:break-all">
            <span class="text-secondary">Aguardando início do processo…</span>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2" id="done-actions" style="display:none!important">
        <a href="{{ path('admin_estados_index') }}" class="btn btn-outline-primary">
            <i class="fas fa-list me-1"></i> Voltar à lista
        </a>
        <button id="btn-reimport" class="btn btn-outline-warning">
            <i class="fas fa-redo me-1"></i> Reimportar
        </button>
    </div>
</div>

<style>
.log-line  { display:block; padding:1px 0; }
.log-ok    { color:#3fb950; }
.log-warn  { color:#d29922; }
.log-err   { color:#f85149; }
.log-info  { color:#58a6ff; }
.log-muted { color:#8b949e; }
.badge-skip{ background:#6c757d;color:#fff;padding:2px 6px;border-radius:4px;font-size:.75em; }
</style>

<script>
(function () {
    const terminal = document.getElementById('terminal');
    const badge    = document.getElementById('status-badge');
    const doneBar  = document.getElementById('done-actions');
    const btnCopy  = document.getElementById('btn-copy');
    const btnRe    = document.getElementById('btn-reimport');

    {# start_url ja tem skip_waze como query param #}
    const startUrl = {{ start_url|json_encode|raw }};

    const MAX_RETRIES = 8;
    let retries  = 0;
    let finished = false;
    let es       = null;

    terminal.innerHTML = '';

    function classify(text) {
        const t = text.toLowerCase();
        if (/\[ok\]|sucesso|concluíd|✅/.test(t))  return 'log-ok';
        if (/\[warning\]|⚠️|deprecated|warning/.test(t)) return 'log-warn';
        if (/\[error\]|❌|exception|fatal|erro/.test(t))  return 'log-err';
        if (/🚀|🔧|📝|importand|iniciand|background|\[notice\]/.test(t)) return 'log-info';
        return 'log-muted';
    }

    function addLine(html) {
        const span = document.createElement('span');
        span.className = 'log-line ' + classify(html);
        span.innerHTML = html
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/&lt;strong&gt;/g,'<strong>').replace(/&lt;\/strong&gt;/g,'</strong>')
            .replace(/&lt;span class=&quot;badge-skip&quot;&gt;/g,'<span class="badge-skip">')
            .replace(/&lt;\/span&gt;/g,'</span>');
        terminal.appendChild(span);
        terminal.scrollTop = terminal.scrollHeight;
    }

    function markDone(code) {
        finished = true;
        badge.className = code === 0 ? 'badge bg-success' : 'badge bg-danger';
        badge.innerHTML = code === 0
            ? '<i class="fas fa-check me-1"></i> Concluído'
            : '<i class="fas fa-times me-1"></i> Erro (exit ' + code + ')';
        doneBar.style.removeProperty('display');
    }

    function connectPoll(pollUrl) {
        es = new EventSource(pollUrl);

        badge.className = 'badge bg-primary';
        badge.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Executando…';

        es.onmessage = function (e) {
            if (e.data && e.data.trim()) addLine(e.data);
        };

        es.addEventListener('done', function (e) {
            es.close();
            markDone(parseInt(e.data, 10));
        });

        es.onerror = function () {
            es.close();
            if (finished) return;
            if (retries < MAX_RETRIES) {
                retries++;
                const delay = Math.min(Math.pow(2, retries) * 1000, 30000);
                badge.className = 'badge bg-secondary';
                badge.innerHTML = '<i class="fas fa-sync fa-spin me-1"></i> Reconectando (' + retries + '/' + MAX_RETRIES + ')…';
                addLine('⚠️ SSE interrompido — processo continua no servidor. Reconectando em ' + (delay/1000) + 's…');
                setTimeout(() => connectPoll(pollUrl), delay);
            } else {
                addLine('❌ SSE desconectado após ' + MAX_RETRIES + ' tentativas.');
                addLine('ℹ️  O processo CONTINUA RODANDO no servidor. Recarregue a página para ver o status ou verifique var/log/');
                badge.className = 'badge bg-warning text-dark';
                badge.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Processo em background';
                doneBar.style.removeProperty('display');
            }
        };
    }

    // ETAPA 1: GET /start?skip_waze=0 — inicia background e retorna token
    async function startImport() {
        badge.className = 'badge bg-warning text-dark';
        badge.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Iniciando…';

        try {
            const res = await fetch(startUrl, {
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            });

            let data;
            const contentType = res.headers.get('content-type') || '';
            if (contentType.includes('application/json')) {
                data = await res.json();
            } else {
                const text = await res.text();
                addLine('❌ Resposta inesperada do servidor (HTTP ' + res.status + '):');
                addLine(text.substring(0, 300));
                badge.className = 'badge bg-danger';
                badge.innerHTML = '<i class="fas fa-times me-1"></i> Erro do servidor';
                doneBar.style.removeProperty('display');
                return;
            }

            if (!res.ok || data.error) {
                addLine('❌ Erro ao iniciar: ' + JSON.stringify(data));
                badge.className = 'badge bg-danger';
                badge.innerHTML = '<i class="fas fa-times me-1"></i> Erro ao iniciar';
                doneBar.style.removeProperty('display');
                return;
            }

            addLine('✅ Processo iniciado. Token: ' + data.token);
            connectPoll(data.poll_url);

        } catch (err) {
            addLine('❌ Falha na requisição: ' + err.message);
            badge.className = 'badge bg-danger';
            badge.innerHTML = '<i class="fas fa-times me-1"></i> Erro';
            doneBar.style.removeProperty('display');
        }
    }

    startImport();

    btnCopy.addEventListener('click', function () {
        const text = Array.from(terminal.querySelectorAll('.log-line'))
            .map(el => el.textContent).join('\n');
        navigator.clipboard.writeText(text).then(() => {
            btnCopy.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => btnCopy.innerHTML = '<i class="fas fa-copy"></i>', 1500);
        });
    });

    btnRe.addEventListener('click', () => location.reload());
}());
</script>
{% endblock %}
