{% extends 'base.html.twig' %}

{% block title %}Estados — Radares{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-map me-2 text-primary"></i>
            Estados — Configuração de Radares
        </h1>
    </div>

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px">UF</th>
                        <th>Estado</th>
                        <th>Região</th>
                        <th>Link Base (aba UF)</th>
                        <th>Link Referência (aba REFERENCIA.UF)</th>
                        <th class="text-center" style="width:160px">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for state in states %}
                    <tr>
                        <td>
                            <span class="badge bg-primary fs-6">{{ state.uf }}</span>
                        </td>
                        <td>{{ state.name }}</td>
                        <td><span class="badge bg-secondary">{{ state.region }}</span></td>

                        {# Link Base #}
                        <td class="small">
                            {% if state.linkBaseRadares %}
                                <a href="{{ state.linkBaseRadares }}" target="_blank" rel="noopener"
                                   class="text-success text-break" title="{{ state.linkBaseRadares }}">
                                    <i class="fas fa-check-circle me-1"></i>
                                    {{ state.linkBaseRadares|u.truncate(50, '…') }}
                                </a>
                            {% else %}
                                <span class="text-muted fst-italic">
                                    <i class="fas fa-minus-circle me-1"></i> não configurado
                                </span>
                            {% endif %}
                        </td>

                        {# Link Referência #}
                        <td class="small">
                            {% if state.linkReferenciaRadares %}
                                <a href="{{ state.linkReferenciaRadares }}" target="_blank" rel="noopener"
                                   class="text-info text-break" title="{{ state.linkReferenciaRadares }}">
                                    <i class="fas fa-check-circle me-1"></i>
                                    {{ state.linkReferenciaRadares|u.truncate(50, '…') }}
                                </a>
                            {% else %}
                                <span class="text-muted fst-italic">
                                    <i class="fas fa-minus-circle me-1"></i> não configurado
                                </span>
                            {% endif %}
                        </td>

                        {# Ações #}
                        <td class="text-center text-nowrap">
                            {# Editar #}
                            <a href="{{ path('admin_estados_edit', {id: state.id}) }}"
                               class="btn btn-sm btn-warning" title="Editar links">
                                <i class="fas fa-pen"></i>
                            </a>

                            {# Forçar importação completa #}
                            <form method="post"
                                  action="{{ path('admin_estados_importar', {id: state.id}) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Forçar importação de {{ state.uf }}? Isso pode demorar alguns segundos.')">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('importar_state_' ~ state.id) }}">
                                <button class="btn btn-sm btn-success" title="Importar radares + Waze">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </form>

                            {# Forçar importação só radares (sem Waze) #}
                            <form method="post"
                                  action="{{ path('admin_estados_importar', {id: state.id}) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Importar só radares de {{ state.uf }} (sem links Waze)?')">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('importar_state_' ~ state.id) }}">
                                <input type="hidden" name="skip_waze" value="1">
                                <button class="btn btn-sm btn-outline-secondary" title="Importar só radares (sem Waze)">
                                    <i class="fas fa-database"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 text-muted small">
        <i class="fas fa-info-circle me-1"></i>
        <strong><i class="fas fa-sync-alt"></i></strong> = Importa radares + links Waze &nbsp;|
        <strong><i class="fas fa-database"></i></strong> = Importa só radares (pula etapa Waze)
    </div>

</div>
{% endblock %}
