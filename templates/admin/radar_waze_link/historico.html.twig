{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}
    Histórico de Alterações — Link Waze #{{ link.id }}
{% endblock %}

{% block main %}
<div class="content-header">
    <div class="container-fluid">

        {# Resumo do link atual #}
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-map-marker-alt me-2"></i>
                Radar: {{ link.radarMedidor.municipio }} / {{ link.radarMedidor.siglaUf }}
                — {{ link.radarMedidor.localVerificacao }}
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <strong>Link atual:</strong>
                        <a href="{{ link.wazeLink }}" target="_blank" rel="noopener">
                            🗺 Editor Waze — Hazard #{{ link.permanentHazardId }}
                        </a>
                    </div>
                    <div class="col-md-4 text-end">
                        <small class="text-muted">
                            Inserido por <strong>{{ link.insertedBy.email }}</strong>
                            em {{ link.insertedAt|date('d/m/Y H:i') }}
                        </small>
                        {% if link.updatedAt %}
                        <br>
                        <small class="text-muted">
                            Última alteração por <strong>{{ link.updatedBy.email }}</strong>
                            em {{ link.updatedAt|date('d/m/Y H:i') }}
                        </small>
                        {% endif %}
                    </div>
                </div>
                {% if link.observacao %}
                <div class="mt-2">
                    <strong>Observação:</strong> {{ link.observacao }}
                </div>
                {% endif %}
            </div>
        </div>

        {# Histórico de alterações #}
        {% if logs is empty %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Nenhuma alteração registrada para este link.
            </div>
        {% else %}
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-history me-2"></i>
                    {{ logs|length }} alteração(ões) registrada(s)
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Data/Hora</th>
                                <th>Usuário</th>
                                <th>Campo</th>
                                <th>Valor anterior</th>
                                <th>Novo valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                            <tr>
                                <td class="text-nowrap">
                                    {{ log.changedAt|date('d/m/Y H:i:s') }}
                                </td>
                                <td>{{ log.changedBy.email }}</td>
                                <td>
                                    <span class="badge bg-secondary">{{ log.campoAlterado }}</span>
                                </td>
                                <td class="text-danger small">
                                    {% if log.campoAlterado == 'wazeLink' and log.valorAnterior %}
                                        <a href="{{ log.valorAnterior }}" target="_blank" rel="noopener"
                                           class="text-danger text-decoration-line-through">
                                            {{ log.valorAnterior|u.truncate(60, '…') }}
                                        </a>
                                    {% else %}
                                        {{ log.valorAnterior|default('—')|u.truncate(80, '…') }}
                                    {% endif %}
                                </td>
                                <td class="text-success small">
                                    {% if log.campoAlterado == 'wazeLink' and log.valorNovo %}
                                        <a href="{{ log.valorNovo }}" target="_blank" rel="noopener"
                                           class="text-success">
                                            {{ log.valorNovo|u.truncate(60, '…') }}
                                        </a>
                                    {% else %}
                                        {{ log.valorNovo|default('—')|u.truncate(80, '…') }}
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        <div class="mt-3">
            <a href="{{ ea_url().setController(constant('App\\Controller\\Admin\\RadarWazeLinkCrudController::class')).setAction('index') }}"
               class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Voltar para lista
            </a>
        </div>

    </div>
</div>
{% endblock %}
