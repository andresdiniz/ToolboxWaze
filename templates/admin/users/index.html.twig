{% extends 'base.html.twig' %}

{% block title %}Gerenciar Usuários — Admin{% endblock %}

{% block body %}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 fw-bold mb-0">
        <i class="bi bi-people me-2 text-danger"></i>Gerenciar Usuários
    </h1>
</div>

{# ── Pendentes ── #}
{% if pending is not empty %}
<div class="card border-warning mb-4">
    <div class="card-header bg-warning bg-opacity-10 fw-semibold">
        <i class="bi bi-hourglass-split me-2 text-warning"></i>
        Aguardando Aprovação
        <span class="badge bg-warning text-dark ms-1">{{ pending|length }}</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Origem</th>
                    <th>Solicitado em</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for u in pending %}
                <tr>
                    <td class="fw-semibold">{{ u.name }}</td>
                    <td>{{ u.email }}</td>
                    <td>
                        {% if u.googleId %}
                            <span class="badge bg-light text-dark border">
                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="14"> Google
                            </span>
                        {% else %}
                            <span class="badge bg-light text-dark border"><i class="bi bi-envelope me-1"></i>E-mail</span>
                        {% endif %}
                    </td>
                    <td><small class="text-muted">{{ u.createdAt|date('d/m/Y H:i') }}</small></td>
                    <td>
                        <div class="d-flex gap-2">
                            <form method="post" action="{{ path('admin_user_approve', {id: u.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ u.id) }}">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Aprovar
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_user_reject', {id: u.id}) }}"
                                  onsubmit="return confirm('Recusar este usuário?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ u.id) }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-lg me-1"></i>Recusar
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="alert alert-success mb-4">
    <i class="bi bi-check-circle me-2"></i>Nenhum usuário pendente de aprovação.
</div>
{% endif %}

{# ── Todos os usuários ── #}
<div class="card">
    <div class="card-header fw-semibold">
        <i class="bi bi-list-ul me-2"></i>Todos os Usuários
        <span class="badge bg-secondary ms-1">{{ all|length }}</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Papéis</th>
                    <th>Status</th>
                    <th>Cadastro</th>
                    <th>Último login</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for u in all %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            {% if u.avatarUrl %}
                                <img src="{{ u.avatarUrl }}" class="rounded-circle" width="32" height="32" alt="">
                            {% else %}
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white"
                                     style="width:32px;height:32px;font-size:.8rem;font-weight:700">
                                    {{ u.name|first|upper }}
                                </div>
                            {% endif %}
                            <span class="fw-semibold">{{ u.name }}</span>
                            {% if u == app.user %}
                                <span class="badge bg-primary" style="font-size:.65rem">você</span>
                            {% endif %}
                        </div>
                    </td>
                    <td><small>{{ u.email }}</small></td>
                    <td>
                        {% for role in u.roles %}
                            {% if role != 'ROLE_USER' %}
                                <span class="badge {{ role == 'ROLE_ADMIN' ? 'bg-danger' : 'bg-secondary' }}">
                                    {{ role|replace({'ROLE_': ''}) }}
                                </span>
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td>
                        {% if u.status == 'approved' %}
                            <span class="badge bg-success"><i class="bi bi-check me-1"></i>Aprovado</span>
                        {% elseif u.status == 'pending' %}
                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass me-1"></i>Pendente</span>
                        {% else %}
                            <span class="badge bg-danger"><i class="bi bi-x me-1"></i>Recusado</span>
                        {% endif %}
                    </td>
                    <td><small class="text-muted">{{ u.createdAt|date('d/m/Y') }}</small></td>
                    <td><small class="text-muted">{{ u.lastLoginAt ? u.lastLoginAt|date('d/m/Y H:i') : '—' }}</small></td>
                    <td>
                        {% if u != app.user %}
                        <div class="d-flex gap-1">
                            {% if u.status == 'pending' %}
                            <form method="post" action="{{ path('admin_user_approve', {id: u.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ u.id) }}">
                                <button class="btn btn-success btn-sm py-0 px-2" title="Aprovar"><i class="bi bi-check-lg"></i></button>
                            </form>
                            <form method="post" action="{{ path('admin_user_reject', {id: u.id}) }}" onsubmit="return confirm('Recusar?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ u.id) }}">
                                <button class="btn btn-outline-danger btn-sm py-0 px-2" title="Recusar"><i class="bi bi-x-lg"></i></button>
                            </form>
                            {% endif %}
                            <form method="post" action="{{ path('admin_user_toggle_admin', {id: u.id}) }}"
                                  onsubmit="return confirm('Alterar papel de administrador?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ u.id) }}">
                                <button class="btn btn-outline-secondary btn-sm py-0 px-2"
                                        title="{{ u.isAdmin() ? 'Remover admin' : 'Tornar admin' }}">
                                    <i class="bi bi-shield{{ u.isAdmin() ? '-fill text-warning' : '' }}"></i>
                                </button>
                            </form>
                        </div>
                        {% else %}
                            <span class="text-muted small">—</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
