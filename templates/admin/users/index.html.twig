{% extends 'base.html.twig' %}
{% block title %}Gerenciar Usuários — Admin{% endblock %}

{% block body %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Usuários — ToolboxWaze Admin</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet">
    <style>
        :root,[data-theme=light]{--bg:#f7f6f2;--surface:#fff;--surface2:#f3f0ec;--border:#d4d1ca;--divider:#e8e5e0;--text:#28251d;--muted:#7a7974;--faint:#bab9b4;--primary:#01696f;--primary-h:#0c4e54;--primary-hl:color-mix(in oklab,#01696f 12%,transparent);--success:#437a22;--success-hl:color-mix(in oklab,#437a22 12%,transparent);--error:#a12c7b;--error-hl:color-mix(in oklab,#a12c7b 12%,transparent);--warning:#964219;--warning-hl:color-mix(in oklab,#964219 12%,transparent);--amber:#7a5c00;--amber-hl:color-mix(in oklab,#7a5c00 10%,transparent);--champ:#6b21a8;--champ-hl:color-mix(in oklab,#6b21a8 12%,transparent);--gchamp:#be185d;--gchamp-hl:color-mix(in oklab,#be185d 12%,transparent);--radius:.75rem;--shadow:0 2px 12px rgba(0,0,0,.07)}
        [data-theme=dark]{--bg:#171614;--surface:#1c1b19;--surface2:#22211f;--border:#393836;--divider:#2a2927;--text:#cdccca;--muted:#797876;--faint:#5a5957;--primary:#4f98a3;--primary-h:#227f8b;--primary-hl:color-mix(in oklab,#4f98a3 15%,transparent);--success:#6daa45;--success-hl:color-mix(in oklab,#6daa45 15%,transparent);--error:#d163a7;--error-hl:color-mix(in oklab,#d163a7 15%,transparent);--warning:#bb653b;--warning-hl:color-mix(in oklab,#bb653b 15%,transparent);--amber:#c8960a;--amber-hl:color-mix(in oklab,#c8960a 15%,transparent);--champ:#a855f7;--champ-hl:color-mix(in oklab,#a855f7 15%,transparent);--gchamp:#f472b6;--gchamp-hl:color-mix(in oklab,#f472b6 15%,transparent)}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{-webkit-font-smoothing:antialiased}
        body{font-family:'Satoshi',sans-serif;font-size:1rem;color:var(--text);background:var(--bg);min-height:100dvh}
        .page{max-width:1100px;margin:0 auto;padding:2rem 1.5rem}
        .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;gap:1rem;flex-wrap:wrap}
        .page-title{font-size:1.5rem;font-weight:700}
        .page-title span{color:var(--muted);font-size:.95rem;font-weight:400;margin-left:.5rem}
        .tabs{display:flex;gap:.25rem;border-bottom:1px solid var(--divider);margin-bottom:1.75rem}
        .tab-btn{padding:.6rem 1.2rem;border:none;background:none;color:var(--muted);font-size:.9rem;font-weight:500;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:.18s;font-family:inherit;border-radius:.4rem .4rem 0 0}
        .tab-btn.active{color:var(--primary);border-bottom-color:var(--primary)}
        .tab-btn:hover:not(.active){color:var(--text);background:var(--surface2)}
        .tab-badge{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;border-radius:9px;font-size:.7rem;font-weight:700;padding:0 5px;margin-left:.4rem}
        .tab-badge.pending{background:var(--warning-hl);color:var(--warning)}
        .tab-badge.approved{background:var(--success-hl);color:var(--success)}
        .tab-badge.rejected{background:var(--error-hl);color:var(--error)}
        .tab-panel{display:none}.tab-panel.active{display:block}
        .flash{padding:.8rem 1rem;border-radius:.5rem;margin-bottom:1.25rem;font-size:.9rem;font-weight:500}
        .flash-success{background:var(--success-hl);color:var(--success)}
        .flash-warning{background:var(--warning-hl);color:var(--warning)}
        .flash-error{background:var(--error-hl);color:var(--error)}
        .user-list{display:flex;flex-direction:column;gap:1rem}
        .user-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
        .user-card-header{display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;cursor:pointer;user-select:none}
        .avatar{width:42px;height:42px;border-radius:50%;background:var(--primary-hl);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem;color:var(--primary);flex-shrink:0;overflow:hidden}
        .avatar img{width:100%;height:100%;object-fit:cover}
        .user-info{flex:1;min-width:0}
        .user-name{font-weight:600;font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .user-meta{font-size:.8rem;color:var(--muted);display:flex;gap:.75rem;flex-wrap:wrap;margin-top:.15rem}
        .badge{display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .55rem;border-radius:9999px;font-size:.75rem;font-weight:600}
        .badge-pending{background:var(--warning-hl);color:var(--warning)}
        .badge-approved{background:var(--success-hl);color:var(--success)}
        .badge-rejected{background:var(--error-hl);color:var(--error)}
        .badge-admin{background:var(--primary-hl);color:var(--primary)}
        .badge-champ{background:var(--champ-hl);color:var(--champ)}
        .badge-gchamp{background:var(--gchamp-hl);color:var(--gchamp)}
        .chevron{color:var(--faint);transition:transform .2s;flex-shrink:0}
        .user-card.open .chevron{transform:rotate(180deg)}
        .user-card-body{display:none;border-top:1px solid var(--divider);padding:1.25rem}
        .user-card.open .user-card-body{display:block}
        .section-label{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);margin-bottom:.75rem}

        /* Toggles de perfil */
        .role-toggles{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}
        .role-toggle{display:flex;align-items:center;gap:.55rem;padding:.55rem .85rem;border-radius:.5rem;cursor:pointer;transition:.15s;border:1.5px solid var(--border);background:var(--surface2);font-family:inherit}
        .role-toggle:hover{border-color:currentColor;opacity:.9}
        .role-toggle input{width:15px;height:15px;cursor:pointer;flex-shrink:0}
        .role-toggle label{font-size:.875rem;font-weight:600;cursor:pointer;white-space:nowrap}
        .role-toggle.admin-t  {border-color:var(--primary);background:var(--primary-hl);color:var(--primary)}
        .role-toggle.admin-t input{accent-color:var(--primary)}
        .role-toggle.champ-t  {border-color:var(--champ);background:var(--champ-hl);color:var(--champ)}
        .role-toggle.champ-t input{accent-color:var(--champ)}
        .role-toggle.gchamp-t {border-color:var(--gchamp);background:var(--gchamp-hl);color:var(--gchamp)}
        .role-toggle.gchamp-t input{accent-color:var(--gchamp)}
        .role-toggle.inactive{border-color:var(--border);background:var(--surface2);color:var(--muted)}

        /* Nota Global Champ */
        .gchamp-note{font-size:.8rem;color:var(--gchamp);background:var(--gchamp-hl);border:1px solid var(--gchamp);border-radius:.4rem;padding:.45rem .75rem;margin-bottom:1rem}

        /* UFs */
        .ufs-section{margin-top:1rem;margin-bottom:1.25rem}
        .ufs-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;flex-wrap:wrap;gap:.5rem}
        .ufs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:.35rem;margin-top:.6rem}
        .uf-check{display:flex;align-items:center;justify-content:center;gap:.3rem;padding:.4rem .5rem;border:1px solid var(--border);border-radius:.4rem;cursor:pointer;transition:.15s;font-size:.8rem;font-weight:600;background:var(--surface)}
        .uf-check:hover{border-color:var(--primary);background:var(--primary-hl)}
        .uf-check input{accent-color:var(--primary);width:13px;height:13px;cursor:pointer}
        .uf-check.is-checked{border-color:var(--primary);background:var(--primary-hl);color:var(--primary)}
        .all-ufs-toggle{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:var(--muted);cursor:pointer;user-select:none}
        .all-ufs-toggle input{accent-color:var(--primary);width:14px;height:14px;cursor:pointer}
        .ufs-count{font-size:.78rem;color:var(--muted);margin-top:.45rem}

        /* Tipos de Solicitação */
        .tipos-section{margin-top:1rem;margin-bottom:1.25rem}
        .tipos-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem}
        .tipos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.5rem}
        .tipo-check{display:flex;align-items:center;gap:.5rem;padding:.5rem .75rem;border:1px solid var(--border);border-radius:.5rem;cursor:pointer;transition:.15s;background:var(--surface)}
        .tipo-check:hover{border-color:var(--amber);background:var(--amber-hl)}
        .tipo-check input{accent-color:var(--amber);width:15px;height:15px;cursor:pointer}
        .tipo-check span{font-size:.85rem;font-weight:500}
        .tipo-check.is-checked{border-color:var(--amber);background:var(--amber-hl)}
        .all-tipos-toggle{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:var(--muted);cursor:pointer;user-select:none}
        .all-tipos-toggle input{accent-color:var(--amber);width:14px;height:14px;cursor:pointer}
        .tipos-count{font-size:.78rem;color:var(--muted);margin-top:.45rem}

        .actions{display:flex;gap:.6rem;flex-wrap:wrap;padding-top:1rem;border-top:1px solid var(--divider);margin-top:1rem;align-items:center}
        .btn{padding:.55rem 1.1rem;border-radius:.5rem;font-size:.875rem;font-weight:600;cursor:pointer;border:none;font-family:inherit;transition:.18s;display:inline-flex;align-items:center;gap:.4rem}
        .btn-approve{background:var(--success);color:#fff}.btn-approve:hover{filter:brightness(.9)}
        .btn-reject{background:var(--warning-hl);color:var(--warning);border:1px solid var(--warning)}.btn-reject:hover{background:var(--warning);color:#fff}
        .btn-save{background:var(--primary);color:#fff}.btn-save:hover{background:var(--primary-h)}
        .btn-delete{background:var(--error-hl);color:var(--error);border:1px solid var(--error)}.btn-delete:hover{background:var(--error);color:#fff}
        .btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border)}.btn-ghost:hover{color:var(--text);border-color:var(--text)}
        .info-row{display:flex;gap:1.5rem;flex-wrap:wrap;margin-bottom:1rem;font-size:.85rem;color:var(--muted)}
        .info-row strong{color:var(--text)}
        .perms-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.5rem;margin-bottom:1.25rem}
        .perm-check{display:flex;align-items:center;gap:.5rem;padding:.5rem .75rem;border:1px solid var(--border);border-radius:.5rem;cursor:pointer;transition:.15s}
        .perm-check:hover{border-color:var(--primary);background:var(--primary-hl)}
        .perm-check input{accent-color:var(--primary);width:15px;height:15px;cursor:pointer}
        .perm-check span{font-size:.875rem;font-weight:500}
        .empty{text-align:center;padding:3rem 1rem;color:var(--muted)}
        .empty svg{margin:0 auto 1rem;color:var(--faint)}
        .theme-btn{position:fixed;top:1rem;right:1rem;background:var(--surface);border:1px solid var(--border);border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text);z-index:100}

        /* Modal */
        .modal-overlay{position:fixed;inset:0;background:oklch(0 0 0/0.45);z-index:200;display:flex;align-items:center;justify-content:center;padding:1rem;opacity:0;pointer-events:none;transition:opacity .18s}
        .modal-overlay.open{opacity:1;pointer-events:all}
        .modal-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;max-width:380px;width:100%;box-shadow:0 8px 32px rgba(0,0,0,.15);transform:translateY(8px);transition:transform .18s}
        .modal-overlay.open .modal-box{transform:translateY(0)}
        .modal-title{font-weight:700;font-size:1rem;margin-bottom:.5rem}
        .modal-body{font-size:.9rem;color:var(--muted);margin-bottom:1.25rem;line-height:1.5}
        .modal-actions{display:flex;gap:.6rem;justify-content:flex-end}

        @media(max-width:600px){.page{padding:1rem}.actions{gap:.4rem}.btn{padding:.5rem .8rem;font-size:.8rem}}
    </style>
</head>
<body>

<div class="modal-overlay" id="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
        <div class="modal-title" id="modal-title"></div>
        <div class="modal-body" id="modal-body"></div>
        <div class="modal-actions">
            <button class="btn btn-ghost" onclick="closeModal()">Cancelar</button>
            <button class="btn" id="modal-confirm-btn"></button>
        </div>
    </div>
</div>

<button class="theme-btn" data-theme-toggle aria-label="Alternar tema">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<div class="page">
    <div class="page-header">
        <div class="page-title">Gerenciar Usuários <span>Painel Admin</span></div>
        <a href="{{ path('app_logout') }}" style="font-size:.875rem;color:var(--muted);text-decoration:none">Sair →</a>
    </div>

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash flash-{{ type }}">{{ msg }}</div>
        {% endfor %}
    {% endfor %}

    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('pending',this)">
            Pendentes <span class="tab-badge pending">{{ pending|length }}</span>
        </button>
        <button class="tab-btn" onclick="switchTab('approved',this)">
            Aprovados <span class="tab-badge approved">{{ approved|length }}</span>
        </button>
        <button class="tab-btn" onclick="switchTab('rejected',this)">
            Rejeitados <span class="tab-badge rejected">{{ rejected|length }}</span>
        </button>
    </div>

    {# MACRO: Perfil/roles #}
    {% macro rolesBlock(user, uid, initAdmin, initChamp, initGlobalChamp) %}
    <div class="section-label" style="margin-bottom:.5rem">Perfil do usuário</div>
    <div class="role-toggles">
        <div class="role-toggle admin-t{{ not initAdmin ? ' inactive' : '' }}" id="toggle_admin_{{ uid }}">
            <input type="checkbox" name="is_admin" id="is_admin_{{ uid }}" value="1"
                   {{ initAdmin ? 'checked' : '' }}
                   onchange="syncRoleToggle('admin','{{ uid }}',this.checked)">
            <label for="is_admin_{{ uid }}">🔑 Administrador</label>
        </div>
        <div class="role-toggle champ-t{{ not initChamp ? ' inactive' : '' }}"
             id="toggle_champ_{{ uid }}"
             style="{{ initGlobalChamp ? 'display:none' : '' }}">
            <input type="checkbox" name="is_champ" id="is_champ_{{ uid }}" value="1"
                   {{ initChamp ? 'checked' : '' }}
                   onchange="syncRoleToggle('champ','{{ uid }}',this.checked)">
            <label for="is_champ_{{ uid }}">⭐ Champ</label>
        </div>
        <div class="role-toggle gchamp-t{{ not initGlobalChamp ? ' inactive' : '' }}"
             id="toggle_gchamp_{{ uid }}">
            <input type="checkbox" name="is_global_champ" id="is_global_champ_{{ uid }}" value="1"
                   {{ initGlobalChamp ? 'checked' : '' }}
                   onchange="syncRoleToggle('gchamp','{{ uid }}',this.checked)">
            <label for="is_global_champ_{{ uid }}">🌟 Global Champ</label>
        </div>
    </div>
    {% if initGlobalChamp %}
    <div class="gchamp-note" id="gchamp_note_{{ uid }}">
        🌟 <strong>Global Champ</strong> — acesso irrestrito a <em>todos os estados</em>. O seletor de UFs será ignorado.
    </div>
    {% else %}
    <div class="gchamp-note" id="gchamp_note_{{ uid }}" style="display:none">
        🌟 <strong>Global Champ</strong> — acesso irrestrito a <em>todos os estados</em>. O seletor de UFs será ignorado.
    </div>
    {% endif %}
    {% endmacro %}

    {# MACRO: Estados (UFs) #}
    {% macro ufsBlock(user, allUfs, isPending, prefix) %}
    {% set uid = prefix ~ user.id %}
    {% set allChecked = isPending ? true : (user.allowedUfs is null) %}
    <div class="ufs-section" id="ufs_section_{{ uid }}">
        <div class="ufs-header">
            <div class="section-label" style="margin-bottom:0">Estados com acesso</div>
            <label class="all-ufs-toggle">
                <input type="checkbox" name="all_ufs" value="1"
                    id="all_ufs_{{ uid }}" data-uid="{{ uid }}"
                    {{ allChecked ? 'checked' : '' }}
                    onchange="toggleAllUfs('{{ uid }}', this.checked)">
                Todos os estados
            </label>
        </div>
        <div class="ufs-grid" id="ufs_grid_{{ uid }}"
             style="{{ allChecked ? 'opacity:.4;pointer-events:none' : '' }}">
            {% for uf in allUfs %}
            {% set checked = allChecked or (not isPending and uf in (user.allowedUfs ?? [])) %}
            <label class="uf-check {{ checked ? 'is-checked' : '' }}">
                <input type="checkbox" name="allowed_ufs[]" value="{{ uf }}"
                    {{ checked ? 'checked' : '' }}
                    onchange="this.closest('.uf-check').classList.toggle('is-checked', this.checked);updateUfsCount('{{ uid }}')">
                {{ uf }}
            </label>
            {% endfor %}
        </div>
        <div class="ufs-count" id="ufs_count_{{ uid }}"></div>
    </div>
    {% endmacro %}

    {# MACRO: Tipos de Solicitação #}
    {% macro tiposBlock(user, allTipos, isPending, prefix) %}
    {% set uid = prefix ~ user.id %}
    {% set allChecked = isPending ? true : (user.solicitacaoTipos is null) %}
    <div class="tipos-section">
        <div class="tipos-header">
            <div class="section-label" style="margin-bottom:0">Tipos de Solicitação que pode tratar</div>
            <label class="all-tipos-toggle">
                <input type="checkbox" name="all_tipos" value="1"
                    id="all_tipos_{{ uid }}" data-uid="{{ uid }}"
                    {{ allChecked ? 'checked' : '' }}
                    onchange="toggleAllTipos('{{ uid }}', this.checked)">
                Todos os tipos
            </label>
        </div>
        <div class="tipos-grid" id="tipos_grid_{{ uid }}"
             style="margin-top:.6rem;{{ allChecked ? 'opacity:.4;pointer-events:none' : '' }}">
            {% for valor, label in allTipos %}
            {% set checked = allChecked or (not isPending and valor in (user.solicitacaoTipos ?? [])) %}
            <label class="tipo-check {{ checked ? 'is-checked' : '' }}">
                <input type="checkbox" name="solicitacao_tipos[]" value="{{ valor }}"
                    {{ checked ? 'checked' : '' }}
                    onchange="this.closest('.tipo-check').classList.toggle('is-checked', this.checked);updateTiposCount('{{ uid }}')">
                <span>{{ label }}</span>
            </label>
            {% endfor %}
        </div>
        <div class="tipos-count" id="tipos_count_{{ uid }}"></div>
    </div>
    {% endmacro %}

    {# ===== PENDENTES ===== #}
    <div class="tab-panel active" id="tab-pending">
        {% if pending is empty %}
            <div class="empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
                <p>Nenhuma solicitação pendente.</p>
            </div>
        {% else %}
        <div class="user-list">
        {% for user in pending %}
        <div class="user-card" id="card-{{ user.id }}">
            <div class="user-card-header" onclick="toggleCard({{ user.id }})">
                <div class="avatar">
                    {% if user.avatarUrl %}<img src="{{ user.avatarUrl }}" alt="">{% else %}{{ user.name|first|upper }}{% endif %}
                </div>
                <div class="user-info">
                    <div class="user-name">{{ user.name }}</div>
                    <div class="user-meta">
                        <span>{{ user.email }}</span>
                        {% if user.wazeNickname %}<span>🗺 {{ user.wazeNickname }}</span>{% endif %}
                        <span>Solicitado {{ user.createdAt|date('d/m/Y H:i') }}</span>
                    </div>
                </div>
                <span class="badge badge-pending">Pendente</span>
                <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </div>
            <div class="user-card-body">
                <form method="POST" action="{{ path('admin_users_approve', {id: user.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ user.id) }}">

                    {{ _self.rolesBlock(user, user.id, false, false, false) }}

                    <div class="section-label">Permissões de Área</div>
                    <div class="perms-grid">
                        {% for key, label in allPerms %}
                        <label class="perm-check">
                            <input type="checkbox" name="permissions[]" value="{{ key }}">
                            <span>{{ label }}</span>
                        </label>
                        {% endfor %}
                    </div>

                    {{ _self.ufsBlock(user, allUfs, true, '') }}
                    {{ _self.tiposBlock(user, allTipos, true, '') }}

                    <div class="actions">
                        <button type="submit" class="btn btn-approve">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                            Aprovar
                        </button>
                    </div>
                </form>

                <form method="POST" action="{{ path('admin_users_reject', {id: user.id}) }}" style="margin-top:.5rem">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ user.id) }}">
                    <button type="button" class="btn btn-reject"
                            onclick="openModal('Rejeitar usuário','Confirma a rejeição de <strong>{{ user.name|e('html') }}</strong>?','Rejeitar','var(--warning)',this.closest('form'))">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        Rejeitar
                    </button>
                </form>
            </div>
        </div>
        {% endfor %}
        </div>
        {% endif %}
    </div>

    {# ===== APROVADOS ===== #}
    <div class="tab-panel" id="tab-approved">
        {% if approved is empty %}
            <div class="empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <p>Nenhum usuário aprovado ainda.</p>
            </div>
        {% else %}
        <div class="user-list">
        {% for user in approved %}
        {% set userIsGlobalChamp = 'ROLE_GLOBAL_CHAMP' in user.roles %}
        {% set userIsChamp = (not userIsGlobalChamp) and ('ROLE_CHAMP' in user.roles) %}
        <div class="user-card" id="card-{{ user.id }}">
            <div class="user-card-header" onclick="toggleCard({{ user.id }})">
                <div class="avatar">
                    {% if user.avatarUrl %}<img src="{{ user.avatarUrl }}" alt="">{% else %}{{ user.name|first|upper }}{% endif %}
                </div>
                <div class="user-info">
                    <div class="user-name">{{ user.name }}</div>
                    <div class="user-meta">
                        <span>{{ user.email }}</span>
                        {% if user.wazeNickname %}<span>🗺 {{ user.wazeNickname }}</span>{% endif %}
                        {% if user.lastLoginAt %}<span>Último acesso {{ user.lastLoginAt|date('d/m/Y') }}</span>{% endif %}
                        {% if userIsGlobalChamp %}
                            <span>🌟 Todos os estados</span>
                        {% elseif user.allowedUfs is not null %}
                            <span>🗺
                                {% for uf in user.allowedUfs|slice(0,4) %}{{ uf }}{% if not loop.last %}, {% endif %}{% endfor %}
                                {% if user.allowedUfs|length > 4 %}+{{ user.allowedUfs|length - 4 }} UFs{% endif %}
                            </span>
                        {% else %}
                            <span>🌎 Todos os estados</span>
                        {% endif %}
                    </div>
                </div>
                {% if user.isAdmin %}<span class="badge badge-admin">🔑 Admin</span>{% else %}<span class="badge badge-approved">Ativo</span>{% endif %}
                {% if userIsGlobalChamp %}<span class="badge badge-gchamp">🌟 Global Champ</span>
                {% elseif userIsChamp %}<span class="badge badge-champ">⭐ Champ</span>{% endif %}
                <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </div>
            <div class="user-card-body">
                <div class="info-row">
                    <span>Aprovado em <strong>{{ user.approvedAt ? user.approvedAt|date('d/m/Y') : '—' }}</strong></span>
                    <span>Cadastrado em <strong>{{ user.createdAt|date('d/m/Y') }}</strong></span>
                </div>

                <form method="POST" action="{{ path('admin_users_permissions', {id: user.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_perms_' ~ user.id) }}">

                    {{ _self.rolesBlock(user, user.id, user.isAdmin, userIsChamp, userIsGlobalChamp) }}

                    <div class="section-label">Permissões de Área</div>
                    <div class="perms-grid">
                        {% for key, label in allPerms %}
                        <label class="perm-check">
                            <input type="checkbox" name="permissions[]" value="{{ key }}" {{ key in user.permissions ? 'checked' : '' }}>
                            <span>{{ label }}</span>
                        </label>
                        {% endfor %}
                    </div>

                    {{ _self.ufsBlock(user, allUfs, false, '') }}
                    {{ _self.tiposBlock(user, allTipos, false, '') }}

                    <div class="actions">
                        <button type="submit" class="btn btn-save">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            Salvar Permissões
                        </button>
                    </div>
                </form>

                <form method="POST" action="{{ path('admin_users_delete', {id: user.id}) }}" style="margin-top:.5rem">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_delete_' ~ user.id) }}">
                    <button type="button" class="btn btn-delete"
                            onclick="openModal('Remover usuário','Tem certeza que deseja remover <strong>{{ user.name|e('html') }}</strong> permanentemente?','Remover','var(--error)',this.closest('form'))">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                        Remover
                    </button>
                </form>
            </div>
        </div>
        {% endfor %}
        </div>
        {% endif %}
    </div>

    {# ===== REJEITADOS ===== #}
    <div class="tab-panel" id="tab-rejected">
        {% if rejected is empty %}
            <div class="empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
                <p>Nenhum usuário rejeitado.</p>
            </div>
        {% else %}
        <div class="user-list">
        {% for user in rejected %}
        <div class="user-card" id="card-re{{ user.id }}">
            <div class="user-card-header" onclick="toggleCard('re{{ user.id }}')">
                <div class="avatar">{{ user.name|first|upper }}</div>
                <div class="user-info">
                    <div class="user-name">{{ user.name }}</div>
                    <div class="user-meta"><span>{{ user.email }}</span>{% if user.wazeNickname %}<span>🗺 {{ user.wazeNickname }}</span>{% endif %}</div>
                </div>
                <span class="badge badge-rejected">Rejeitado</span>
                <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </div>
            <div class="user-card-body">
                <form method="POST" action="{{ path('admin_users_approve', {id: user.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ user.id) }}">

                    {{ _self.rolesBlock(user, 're' ~ user.id, false, false, false) }}

                    <div class="section-label" style="margin-top:.75rem">Permissões de Área</div>
                    <div class="perms-grid">
                        {% for key, label in allPerms %}
                        <label class="perm-check">
                            <input type="checkbox" name="permissions[]" value="{{ key }}">
                            <span>{{ label }}</span>
                        </label>
                        {% endfor %}
                    </div>

                    {{ _self.ufsBlock(user, allUfs, true, 're') }}
                    {{ _self.tiposBlock(user, allTipos, true, 're') }}

                    <div class="actions">
                        <button type="submit" class="btn btn-approve">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                            Reativar e Aprovar
                        </button>
                    </div>
                </form>

                <form method="POST" action="{{ path('admin_users_delete', {id: user.id}) }}" style="margin-top:.5rem">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_delete_' ~ user.id) }}">
                    <button type="button" class="btn btn-delete"
                            onclick="openModal('Remover usuário','Tem certeza que deseja remover <strong>{{ user.name|e('html') }}</strong> permanentemente?','Remover','var(--error)',this.closest('form'))">
                        Remover permanentemente
                    </button>
                </form>
            </div>
        </div>
        {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

<script>
function switchTab(name, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
}
function toggleCard(id) {
    document.getElementById('card-' + id).classList.toggle('open');
}

/* Modal */
let _modalForm = null;
function openModal(title, body, confirmLabel, confirmColor, form) {
    document.getElementById('modal-title').textContent = title;
    document.getElementById('modal-body').innerHTML = body;
    const btn = document.getElementById('modal-confirm-btn');
    btn.textContent = confirmLabel;
    btn.style.background = confirmColor;
    btn.style.color = '#fff';
    btn.style.border = 'none';
    _modalForm = form;
    document.getElementById('confirm-modal').classList.add('open');
}
function closeModal() {
    document.getElementById('confirm-modal').classList.remove('open');
    _modalForm = null;
}
document.getElementById('modal-confirm-btn').addEventListener('click', () => { if (_modalForm) _modalForm.submit(); closeModal(); });
document.getElementById('confirm-modal').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

/* Toggles de perfil */
function syncRoleToggle(role, uid, checked) {
    const champEl    = document.getElementById('toggle_champ_'   + uid);
    const champCb    = document.getElementById('is_champ_'        + uid);
    const gchampEl   = document.getElementById('toggle_gchamp_'  + uid);
    const gchampNote = document.getElementById('gchamp_note_'    + uid);
    const ufsSection = document.getElementById('ufs_section_'    + uid);

    if (role === 'gchamp') {
        if (checked) {
            if (champEl)  champEl.style.display = 'none';
            if (champCb)  champCb.checked = false;
            if (gchampNote) gchampNote.style.display = 'block';
            if (ufsSection) { ufsSection.style.opacity = '.4'; ufsSection.style.pointerEvents = 'none'; }
        } else {
            if (champEl)  champEl.style.display = '';
            if (gchampNote) gchampNote.style.display = 'none';
            if (ufsSection) { ufsSection.style.opacity = ''; ufsSection.style.pointerEvents = ''; }
        }
        if (gchampEl) gchampEl.classList.toggle('inactive', !checked);
    } else if (role === 'champ') {
        if (champEl) champEl.classList.toggle('inactive', !checked);
    } else if (role === 'admin') {
        const adminEl = document.getElementById('toggle_admin_' + uid);
        if (adminEl) adminEl.classList.toggle('inactive', !checked);
    }
}

/* UFs */
function toggleAllUfs(uid, allChecked) {
    const grid = document.getElementById('ufs_grid_' + uid);
    if (!grid) return;
    grid.style.opacity = allChecked ? '.4' : '1';
    grid.style.pointerEvents = allChecked ? 'none' : '';
    if (allChecked) grid.querySelectorAll('input[type=checkbox]').forEach(cb => { cb.checked = true; cb.closest('.uf-check').classList.add('is-checked'); });
    updateUfsCount(uid);
}
function updateUfsCount(uid) {
    const grid  = document.getElementById('ufs_grid_'  + uid);
    const all   = document.getElementById('all_ufs_'   + uid);
    const count = document.getElementById('ufs_count_' + uid);
    if (!count) return;
    if (all && all.checked) { count.textContent = 'Acesso a todos os estados'; count.style.color = ''; return; }
    const n = grid ? grid.querySelectorAll('input:checked').length : 0;
    if (n === 0) { count.textContent = '⚠ Nenhum estado selecionado — salvar removerá todo acesso.'; count.style.color = 'var(--warning)'; }
    else { count.textContent = n + ' estado(s) selecionado(s)'; count.style.color = ''; }
}

/* Tipos */
function toggleAllTipos(uid, allChecked) {
    const grid = document.getElementById('tipos_grid_' + uid);
    if (!grid) return;
    grid.style.opacity = allChecked ? '.4' : '1';
    grid.style.pointerEvents = allChecked ? 'none' : '';
    if (allChecked) grid.querySelectorAll('input[type=checkbox]').forEach(cb => { cb.checked = true; cb.closest('.tipo-check').classList.add('is-checked'); });
    updateTiposCount(uid);
}
function updateTiposCount(uid) {
    const grid  = document.getElementById('tipos_grid_'  + uid);
    const all   = document.getElementById('all_tipos_'   + uid);
    const count = document.getElementById('tipos_count_' + uid);
    if (!count) return;
    if (all && all.checked) { count.textContent = 'Todos os tipos habilitados'; count.style.color = ''; return; }
    const n = grid ? grid.querySelectorAll('input:checked').length : 0;
    count.textContent = n + ' tipo(s) selecionado(s)';
}

/* Init */
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[id^="all_ufs_"]').forEach(el => { const uid = el.dataset.uid; if (uid) updateUfsCount(uid); });
    document.querySelectorAll('[id^="all_tipos_"]').forEach(el => {
        const uid = el.dataset.uid;
        if (!uid) return;
        updateTiposCount(uid);
        const grid = document.getElementById('tipos_grid_' + uid);
        if (grid) grid.querySelectorAll('input[type=checkbox]').forEach(cb => cb.addEventListener('change', () => updateTiposCount(uid)));
    });
    // Bloqueia UFs para Global Champs já salvos
    document.querySelectorAll('[id^="is_global_champ_"]').forEach(cb => {
        if (cb.checked) {
            const uid = cb.id.replace('is_global_champ_', '');
            const sec = document.getElementById('ufs_section_' + uid);
            if (sec) { sec.style.opacity = '.4'; sec.style.pointerEvents = 'none'; }
        }
    });
});

(function(){
    const t=document.querySelector('[data-theme-toggle]'),r=document.documentElement;
    let d=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
    r.setAttribute('data-theme',d);
    if(t)t.addEventListener('click',()=>{
        d=d==='dark'?'light':'dark';r.setAttribute('data-theme',d);
        t.innerHTML=d==='dark'?'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>':'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
    });
})();
</script>
</body>
</html>
{% endblock %}
