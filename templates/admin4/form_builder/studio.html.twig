{% extends 'base.html.twig' %}
{% block title %}Estúdio de formulários · ToolboxWaze{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/form-builder-studio.css') }}">{% endblock %}
{% block body %}
<section class="fbs" data-form-studio>
<header class="fbs-header"><div><span class="fbs-eyebrow">ToolboxWaze / FormBuilder</span><h1><i class="bi bi-ui-checks-grid" aria-hidden="true"></i> Estúdio de formulários</h1><p>Organize campos. Preserve regras. Construa novas experiências.</p></div><a class="btn btn-outline-secondary" href="{{ path('admin4_form_builder_index') }}">Voltar à lista</a></header>
{% if studio_error %}<div class="alert alert-danger" role="alert">{{ studio_error }}</div>{% endif %}
<div class="alert alert-info small">Este editor preserva as configurações atuais de publicação. Novos formulários começam desabilitados no WME. Remover ou renomear campos existentes exige migração explícita.</div>
{% if studio_id %}<div class="small text-muted mb-2"><i class="bi bi-broadcast" aria-hidden="true"></i> Script WME: <strong>{{ wme_published ? 'publicado' : 'não publicado' }}</strong> · <a href="{{ path('admin4_form_api_index') }}">gerenciar publicação e papéis</a></div>{% endif %}
<form method="post" id="fbs-form" data-turbo="false">
<input type="hidden" name="_token" value="{{ csrf_token('form_studio_' ~ (studio_id ?? 'new')) }}"><input type="hidden" name="definition" id="fbs-definition">
{% if wme_published %}<div class="alert alert-warning small" role="alert"><strong>Este formulário está publicado no script WME.</strong> Alterações valem imediatamente para quem usa o script; quem estiver preenchendo pode ver “formulário desatualizado”. <label class="form-check mt-2 mb-0"><input class="form-check-input" type="checkbox" name="confirm_published" value="1" required> Entendo e quero salvar mesmo assim</label></div>{% endif %}
<div id="fbs-message" class="alert alert-warning" role="status" hidden></div>
<div class="fbs-grid">
<aside class="card fbs-library"><div class="card-body"><h2>Biblioteca</h2><p class="text-muted small">Clique para adicionar</p><div id="fbs-types"></div><hr><p class="small text-muted">Condições, variantes e permissões avançadas são preservadas no JSON de opções. Sua execução depende do backend de cada canal.</p></div></aside>
<main><div class="card fbs-intro mb-3"><div class="card-body"><label for="fbs-name" class="form-label">Nome do formulário</label><input id="fbs-name" class="form-control form-control-lg" maxlength="120" required value="{{ definition.nome }}"><label for="fbs-desc" class="form-label mt-3">Descrição</label><textarea id="fbs-desc" class="form-control" maxlength="255">{{ definition.descricao }}</textarea><div class="row g-3 mt-1"><div class="col-sm-8"><label for="fbs-slug" class="form-label">Identificador estável</label><input id="fbs-slug" class="form-control" pattern="[a-z0-9_-]+" maxlength="80" required value="{{ definition.slug }}" {{ studio_id ? 'readonly' }}></div><div class="col-sm-4 d-flex align-items-end"><label class="form-check mb-2"><input id="fbs-active" class="form-check-input" type="checkbox" {{ definition.ativo ? 'checked' }}> Ativo</label></div></div></div></div><div class="card mb-3"><div class="card-body"><h2 class="h6 mb-3">Configurações do formulário</h2><div class="row g-3">
<div class="col-md-6"><label class="form-label" for="cfg-success">Mensagem após o envio</label><input id="cfg-success" class="form-control" name="cfg[success_message]" maxlength="255" value="{{ cfg.success_message }}" placeholder="Obrigado pelo envio!"></div>
<div class="col-md-6"><label class="form-label" for="cfg-redirect">Redirecionar após o envio (opcional)</label><input id="cfg-redirect" class="form-control" name="cfg[redirect_url]" maxlength="500" value="{{ cfg.redirect_url }}" placeholder="https://… ou /caminho"></div>
<div class="col-md-6"><label class="form-label" for="cfg-email">E-mail de notificação (opcional)</label><input id="cfg-email" type="email" class="form-control" name="cfg[email_notificacao]" maxlength="180" value="{{ cfg.email_notificacao }}"></div>
<div class="col-md-6"><label class="form-label" for="cfg-visibility">Quem pode ver</label><select id="cfg-visibility" class="form-select" name="cfg[mostrar_para]"><option value="todos" {{ cfg.mostrar_para == 'todos' ? 'selected' }}>Todos</option><option value="logado" {{ cfg.mostrar_para == 'logado' ? 'selected' }}>Somente logados</option><option value="visitante" {{ cfg.mostrar_para == 'visitante' ? 'selected' }}>Somente visitantes (não funciona no script WME)</option></select></div>
<div class="col-md-6"><label class="form-label" for="cfg-limit">Limite de envios por pessoa</label><input id="cfg-limit" type="number" min="0" max="1000000" class="form-control" name="cfg[limite_envios]" value="{{ cfg.limite_envios }}" placeholder="padrão do canal"><div class="form-text">Vazio = padrão do canal (no script WME, 1 por e-mail). 0 = ilimitado.</div></div>
<div class="col-md-6"><label class="form-label" for="cfg-expires">Expira em (opcional)</label><input id="cfg-expires" class="form-control" name="cfg[expira_em]" maxlength="40" value="{{ cfg.expira_em }}" placeholder="2026-12-31 23:59"><div class="form-text">Depois dessa data o formulário deixa de aceitar envios.</div></div>
</div></div></div>
<div id="fbs-fields"></div><div class="fbs-empty" id="fbs-empty"><i class="bi bi-plus-circle" aria-hidden="true"></i><h2>Comece pelo primeiro campo</h2><p>Escolha um tipo na biblioteca.</p></div></main>
<aside class="card fbs-properties"><div class="card-body"><h2>Propriedades</h2><div id="fbs-properties"><p class="text-muted small">Selecione um campo para editar.</p></div></div></aside>
</div><footer class="fbs-footer"><span id="fbs-count" aria-live="polite"></span><div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary" id="fbs-export">Exportar JSON</button><button type="button" class="btn btn-outline-primary" id="fbs-preview">Prévia</button><button class="btn btn-primary" type="submit"><i class="bi bi-floppy me-1"></i>Salvar</button></div></footer>
</form><dialog id="fbs-dialog"><header class="d-flex justify-content-between align-items-center mb-3"><h2>Prévia estrutural</h2><button type="button" class="btn btn-sm btn-outline-secondary" id="fbs-close">Fechar</button></header><p class="small text-muted">Exibe todos os campos; não executa permissões, variantes ou validações do servidor.</p><div id="fbs-preview-content"></div></dialog>
<script type="application/json" id="fbs-initial">{{ definition|json_encode(15)|raw }}</script>
</section>
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('js/form-builder-studio.js') }}" defer></script>{% endblock %}
