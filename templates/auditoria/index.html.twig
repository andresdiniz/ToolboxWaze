{% extends 'base.html.twig' %}

{% block title %}Auditoria — ToolboxWaze{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 fw-bold mb-0">Auditoria de Alterações</h1>
    <span class="badge bg-secondary fs-6">{{ total }} registros</span>
</div>

{# ── Filtros ── #}
<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold small">Usuário</label>
                <input type="text" name="user" class="form-control form-control-sm"
                       value="{{ filtros.filtroUser }}" placeholder="filtrar por e-mail">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small">Campo alterado</label>
                <select name="campo" class="form-select form-select-sm">
                    <option value="">— todos —</option>
                    <option value="waze_link" {{ filtros.filtroCampo == 'waze_link' ? 'selected' }}>waze_link</option>
                    <option value="motivo_revisao" {{ filtros.filtroCampo == 'motivo_revisao' ? 'selected' }}>motivo_revisao</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small">Data início</label>
                <input type="date" name="inicio" class="form-control form-control-sm" value="{{ filtros.dataInicio }}">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small">Data fim</label>
                <input type="date" name="fim" class="form-control form-control-sm" value="{{ filtros.dataFim }}">
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</form>

{# ── Tabela ── #}
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Data/Hora</th>
                    <th>Usuário</th>
                    <th>Tipo</th>
                    <th>Objeto</th>
                    <th>Campo</th>
                    <th>Anterior</th>
                    <th>Novo</th>
                </tr>
            </thead>
            <tbody>
            {% for log in logs %}
                <tr>
                    <td class="text-muted small text-nowrap">{{ log.changed_at|date('d/m/Y H:i') }}</td>
                    <td class="small">{{ log.changed_by_email }}</td>
                    <td>
                        {% if log.tipo == 'radar' %}
                            <span class="badge bg-primary bg-opacity-75">Radar</span>
                        {% else %}
                            <span class="badge bg-warning text-dark bg-opacity-75">Posto</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if log.tipo == 'radar' %}
                            <a href="{{ path('radar_show', {id: log.objeto_id}) }}" class="text-decoration-none">
                                <span class="badge badge-uf me-1">{{ log.uf }}</span>
                                <span class="small">{{ log.objeto_nome|slice(0,35) }}{% if log.objeto_nome|length > 35 %}…{% endif %}</span>
                            </a>
                        {% else %}
                            <a href="{{ path('posto_show', {id: log.objeto_id}) }}" class="text-decoration-none">
                                <span class="badge badge-uf me-1">{{ log.uf }}</span>
                                <span class="small">{{ log.objeto_nome|slice(0,35) }}{% if log.objeto_nome|length > 35 %}…{% endif %}</span>
                            </a>
                        {% endif %}
                    </td>
                    <td><span class="badge bg-secondary">{{ log.campo_alterado }}</span></td>
                    <td class="small text-danger text-break" style="max-width:180px">
                        {% if log.valor_anterior %}
                            {{ log.valor_anterior|slice(0,80) }}{% if log.valor_anterior|length > 80 %}…{% endif %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="small text-success text-break" style="max-width:180px">
                        {% if log.valor_novo %}
                            {{ log.valor_novo|slice(0,80) }}{% if log.valor_novo|length > 80 %}…{% endif %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Nenhum registro encontrado.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pages > 1 %}
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="text-muted small">Página {{ page }} de {{ pages }}</span>
        <div class="btn-group btn-group-sm">
            {% if page > 1 %}
                <a href="?{{ app.request.query.all|merge({page: page - 1})|url_encode }}" class="btn btn-outline-secondary">
                    ‹
                </a>
            {% endif %}
            {% if page < pages %}
                <a href="?{{ app.request.query.all|merge({page: page + 1})|url_encode }}" class="btn btn-outline-secondary">
                    ›
                </a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
