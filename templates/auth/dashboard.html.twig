{% extends 'base.html.twig' %}

{% block title %}Dashboard — ToolboxWaze{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-3 mb-4">
            {% if app.user.avatarUrl %}
                <img src="{{ app.user.avatarUrl }}" class="rounded-circle" width="48" height="48" alt="">
            {% else %}
                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center text-white fw-bold"
                     style="width:48px;height:48px;font-size:1.2rem">
                    {{ app.user.name|first|upper }}
                </div>
            {% endif %}
            <div>
                <h1 class="h4 mb-0 fw-bold">Olá, {{ app.user.name }}!</h1>
                <small class="text-muted">{{ app.user.email }}</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <a href="{{ path('radar_index') }}" class="card text-decoration-none h-100" style="border-left:4px solid #01696f">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-camera-video fs-1 text-success"></i>
                <div>
                    <div class="fw-bold">Radares</div>
                    <small class="text-muted">Consultar medidores RBMLQ</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="{{ path('posto_index') }}" class="card text-decoration-none h-100" style="border-left:4px solid #fd7e14">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-fuel-pump fs-1" style="color:#fd7e14"></i>
                <div>
                    <div class="fw-bold">Postos</div>
                    <small class="text-muted">Revendedores ANP autorizados</small>
                </div>
            </div>
        </a>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
    <div class="col-md-4">
        <a href="{{ path('admin_user_index') }}" class="card text-decoration-none h-100" style="border-left:4px solid #dc3545">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-people fs-1 text-danger"></i>
                <div>
                    <div class="fw-bold">Usuários</div>
                    <small class="text-muted">Aprovar / gerenciar contas</small>
                </div>
            </div>
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
