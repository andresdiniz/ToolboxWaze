<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Senha — ToolboxWaze</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --tw: #01696f; --tw-d: #0c4e54; --tw-dd: #0f3638;
            --tw-light: #e8f4f4; --tw-muted: #cedcd8;
            --text: #1e2a2b; --text-muted: #637070; --text-faint: #a0b0b0;
            --surface: #fff; --surface-2: #f5f9f9;
            --border: rgba(1,105,111,.14);
            --transition: 180ms cubic-bezier(.16,1,.3,1);
        }
        [data-theme="dark"] {
            --text: #d0dede; --text-muted: #7a9898; --text-faint: #4a6464;
            --surface: #1a2424; --surface-2: #1e2c2c;
            --border: rgba(79,152,163,.18);
            --tw: #4f98a3; --tw-d: #227f8b; --tw-light: #1e3434; --tw-muted: #2a4848;
        }
        html { -webkit-font-smoothing: antialiased; }
        body {
            min-height: 100dvh; font-family: 'Inter', sans-serif;
            color: var(--text); background: var(--surface-2);
            display: flex; align-items: center; justify-content: center; padding: 1.5rem 1rem;
        }
        .auth-container { width: 100%; max-width: 420px; }
        .back-link {
            display: inline-flex; align-items: center; gap: .375rem;
            color: var(--tw); font-size: .875rem; font-weight: 500;
            text-decoration: none; margin-bottom: 1.5rem;
        }
        .back-link:hover { text-decoration: underline; }
        .auth-card {
            background: var(--surface); border-radius: 1.125rem;
            box-shadow: 0 2px 6px rgba(1,105,111,.06), 0 16px 48px rgba(0,0,0,.10);
            overflow: hidden;
        }
        .auth-card-header {
            background: linear-gradient(135deg, var(--tw-dd) 0%, var(--tw) 100%);
            padding: 2rem; text-align: center;
        }
        .header-icon {
            width: 56px; height: 56px; border-radius: 50%;
            background: rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.625rem; color: #fff; margin: 0 auto 1rem;
        }
        .auth-card-header h1 { font-family:'Instrument Serif',serif; font-size:1.625rem; color:#fff; margin-bottom:.375rem; }
        .auth-card-header p { color:rgba(255,255,255,.75); font-size:.875rem; max-width:30ch; margin:0 auto; line-height:1.5; }
        .auth-card-body { padding: 2rem; }
        /* Success state */
        .success-state { text-align: center; padding: 1rem 0; }
        .success-icon {
            width: 72px; height: 72px; border-radius: 50%;
            background: #edf7f2; display: flex; align-items: center; justify-content: center;
            font-size: 2rem; color: #1a6640; margin: 0 auto 1.25rem;
        }
        [data-theme="dark"] .success-icon { background: #132a1e; color: #6fd6a0; }
        .success-state h3 { font-size: 1.125rem; font-weight: 700; margin-bottom: .5rem; }
        .success-state p { color: var(--text-muted); font-size: .9375rem; line-height: 1.6; }
        /* Form */
        .form-group { margin-bottom: 1.25rem; }
        .form-group label { display: block; font-size: .8125rem; font-weight: 600; color: var(--text-muted); margin-bottom: .375rem; letter-spacing: .02em; text-transform: uppercase; }
        .input-wrap { position: relative; }
        .input-wrap .icon { position: absolute; left: .875rem; top: 50%; transform: translateY(-50%); color: var(--text-faint); font-size: 1rem; pointer-events: none; }
        .input-wrap input {
            width: 100%; padding: .75rem .875rem .75rem 2.5rem;
            border: 1.5px solid var(--border); border-radius: .625rem;
            background: var(--surface-2); color: var(--text); font-size: .9375rem;
            transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
            outline: none; font-family: inherit;
        }
        .input-wrap input:focus { border-color: var(--tw); box-shadow: 0 0 0 3px rgba(1,105,111,.12); background: var(--surface); }
        .input-wrap input::placeholder { color: var(--text-faint); }
        .btn-primary {
            width: 100%; padding: .8125rem 1.25rem; border-radius: .625rem; border: none;
            background: var(--tw); color: #fff; font-size: 1rem; font-weight: 600;
            cursor: pointer; font-family: inherit;
            display: flex; align-items: center; justify-content: center; gap: .5rem;
            transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
        }
        .btn-primary:hover { background: var(--tw-d); box-shadow: 0 4px 16px rgba(1,105,111,.35); transform: translateY(-1px); }
        .hint { font-size: .8125rem; color: var(--text-faint); margin-top: .625rem; line-height: 1.5; }
        .auth-card-footer { padding: 1.125rem 2rem; background: var(--surface-2); text-align: center; font-size: .9rem; color: var(--text-muted); border-top: 1px solid var(--border); }
        .link { color: var(--tw); text-decoration: none; font-weight: 600; }
        .link:hover { text-decoration: underline; }
        .theme-toggle { position: fixed; top: 1.25rem; right: 1.25rem; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-muted); font-size: 1rem; transition: background var(--transition); }
        .theme-toggle:hover { background: var(--tw-light); color: var(--tw); }
    </style>
</head>
<body>

<button class="theme-toggle" data-theme-toggle aria-label="Alternar tema">
    <i class="bi bi-moon" id="themeIcon"></i>
</button>

<div class="auth-container">
    <a href="{{ path('app_login') }}" class="back-link">
        <i class="bi bi-arrow-left"></i> Voltar para o login
    </a>

    <div class="auth-card">
        <div class="auth-card-header">
            <div class="header-icon"><i class="bi bi-key-fill"></i></div>
            <h1>Recuperar Senha</h1>
            <p>Informe seu e-mail e enviaremos um link para redefinir sua senha</p>
        </div>

        <div class="auth-card-body">
            {% if sent %}
                <div class="success-state">
                    <div class="success-icon"><i class="bi bi-envelope-check-fill"></i></div>
                    <h3>E-mail enviado!</h3>
                    <p>Se este e-mail estiver cadastrado, você receberá as instruções em breve. Verifique também sua caixa de spam.</p>
                </div>
            {% else %}
                <form method="post" novalidate>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                    <div class="form-group">
                        <label for="email">E-mail cadastrado</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope icon"></i>
                            <input type="email" id="email" name="email"
                                   placeholder="seu@email.com"
                                   autocomplete="email" autofocus required>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">
                        <i class="bi bi-send"></i>
                        Enviar link de recuperação
                    </button>
                    <p class="hint"><i class="bi bi-info-circle me-1"></i>O link expira em 1 hora por segurança.</p>
                </form>
            {% endif %}
        </div>

        <div class="auth-card-footer">
            Lembrou a senha? <a href="{{ path('app_login') }}" class="link">Fazer login</a>
        </div>
    </div>
</div>

<script>
(function(){
    const root = document.documentElement;
    const btn  = document.querySelector('[data-theme-toggle]');
    const icon = document.getElementById('themeIcon');
    let dark = window.matchMedia('(prefers-color-scheme:dark)').matches;
    function apply(d) {
        root.setAttribute('data-theme', d ? 'dark' : 'light');
        icon.className = d ? 'bi bi-sun' : 'bi bi-moon';
    }
    apply(dark);
    btn.addEventListener('click', () => { dark = !dark; apply(dark); });
})();
</script>
</body>
</html>