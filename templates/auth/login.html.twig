<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — ToolboxWaze</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --tw:          #01696f;
            --tw-d:        #0c4e54;
            --tw-dd:       #0f3638;
            --tw-light:    #e8f4f4;
            --tw-muted:    #cedcd8;
            --text:        #1e2a2b;
            --text-muted:  #637070;
            --text-faint:  #a0b0b0;
            --surface:     #ffffff;
            --surface-2:   #f5f9f9;
            --border:      rgba(1,105,111,.14);
            --shadow-card: 0 2px 6px rgba(1,105,111,.06), 0 16px 48px rgba(0,0,0,.10);
            --radius:      .875rem;
            --transition:  180ms cubic-bezier(.16,1,.3,1);
        }

        [data-theme="dark"] {
            --text:        #d0dede;
            --text-muted:  #7a9898;
            --text-faint:  #4a6464;
            --surface:     #1a2424;
            --surface-2:   #1e2c2c;
            --border:      rgba(79,152,163,.18);
            --shadow-card: 0 2px 6px rgba(0,0,0,.3), 0 16px 48px rgba(0,0,0,.4);
            --tw:          #4f98a3;
            --tw-d:        #227f8b;
            --tw-light:    #1e3434;
            --tw-muted:    #2a4848;
        }

        html { -webkit-font-smoothing: antialiased; }

        body {
            min-height: 100dvh;
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            color: var(--text);
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── LEFT PANEL ── */
        .panel-left {
            position: relative;
            background: linear-gradient(160deg, var(--tw-dd) 0%, var(--tw) 55%, #1a8a92 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem;
            overflow: hidden;
            min-height: 100dvh;
        }
        .panel-left::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }
        .panel-left-logo {
            display: flex; align-items: center; gap: .75rem;
            color: #fff; font-weight: 700; font-size: 1.125rem;
            text-decoration: none;
        }
        .panel-left-logo svg { width: 36px; height: 36px; }
        .panel-left-body { position: relative; }
        .panel-left-body .tagline {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(2rem, 3.5vw, 2.75rem);
            color: #fff;
            line-height: 1.2;
            margin-bottom: 1.25rem;
        }
        .panel-left-body .tagline em { font-style: italic; opacity: .85; }
        .panel-left-body p {
            color: rgba(255,255,255,.7);
            font-size: .9375rem;
            line-height: 1.7;
            max-width: 38ch;
        }
        .feature-list { list-style: none; margin-top: 2rem; display: flex; flex-direction: column; gap: .75rem; }
        .feature-list li {
            display: flex; align-items: center; gap: .75rem;
            color: rgba(255,255,255,.85); font-size: .875rem;
        }
        .feature-list li .icon {
            width: 32px; height: 32px; border-radius: 8px;
            background: rgba(255,255,255,.12);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }
        .panel-left-footer { color: rgba(255,255,255,.4); font-size: .75rem; position: relative; }

        /* ── RIGHT PANEL ── */
        .panel-right {
            background: var(--surface);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1.5rem;
            min-height: 100dvh;
            position: relative;
        }
        .theme-toggle {
            position: absolute; top: 1.5rem; right: 1.5rem;
            width: 38px; height: 38px; border-radius: 50%;
            border: 1px solid var(--border);
            background: var(--surface-2);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-muted);
            transition: background var(--transition), color var(--transition);
            font-size: 1rem;
        }
        .theme-toggle:hover { background: var(--tw-light); color: var(--tw); }

        .auth-box {
            width: 100%; max-width: 420px;
        }
        .auth-box h2 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.875rem;
            color: var(--text);
            margin-bottom: .375rem;
        }
        .auth-box .subtitle {
            color: var(--text-muted); font-size: .9375rem;
            margin-bottom: 2rem;
        }

        /* Alerts */
        .alert {
            border-radius: .625rem;
            padding: .75rem 1rem;
            font-size: .875rem;
            margin-bottom: 1rem;
            display: flex; align-items: flex-start; gap: .6rem;
            border: none;
        }
        .alert-danger  { background: #fdf0f3; color: #8b1a33; }
        .alert-success { background: #edf7f2; color: #1a6640; }
        .alert-warning { background: #fff8e6; color: #7a5200; }
        .alert-info    { background: var(--tw-light); color: var(--tw-d); }
        [data-theme="dark"] .alert-danger  { background: #2f1520; color: #f08fa8; }
        [data-theme="dark"] .alert-success { background: #132a1e; color: #6fd6a0; }
        [data-theme="dark"] .alert-info    { background: var(--tw-light); color: var(--tw); }

        /* Google button */
        .btn-google {
            width: 100%; padding: .75rem 1rem;
            border-radius: .625rem;
            border: 1.5px solid var(--border);
            background: var(--surface);
            color: var(--text);
            font-size: .9375rem; font-weight: 500;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: .625rem;
            text-decoration: none;
            transition: background var(--transition), box-shadow var(--transition), border-color var(--transition);
        }
        .btn-google:hover {
            background: var(--surface-2);
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
            border-color: rgba(1,105,111,.3);
        }
        .btn-google img { width: 20px; height: 20px; }

        /* Divider */
        .divider {
            display: flex; align-items: center; gap: .75rem;
            margin: 1.25rem 0; color: var(--text-faint); font-size: .8125rem;
        }
        .divider::before, .divider::after {
            content: ''; flex: 1; height: 1px; background: var(--border);
        }

        /* Form */
        .form-group { margin-bottom: 1.125rem; }
        .form-group label {
            display: block; font-size: .8125rem; font-weight: 600;
            color: var(--text-muted); margin-bottom: .375rem;
            letter-spacing: .02em; text-transform: uppercase;
        }
        .input-wrap { position: relative; }
        .input-wrap .icon {
            position: absolute; left: .875rem; top: 50%; transform: translateY(-50%);
            color: var(--text-faint); font-size: 1rem; pointer-events: none;
        }
        .input-wrap input {
            width: 100%; padding: .75rem .875rem .75rem 2.5rem;
            border: 1.5px solid var(--border);
            border-radius: .625rem;
            background: var(--surface-2);
            color: var(--text);
            font-size: .9375rem;
            transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
            outline: none;
        }
        .input-wrap input:focus {
            border-color: var(--tw);
            box-shadow: 0 0 0 3px rgba(1,105,111,.12);
            background: var(--surface);
        }
        .input-wrap input::placeholder { color: var(--text-faint); }
        .input-wrap .toggle-pw {
            position: absolute; right: .875rem; top: 50%; transform: translateY(-50%);
            color: var(--text-faint); cursor: pointer; font-size: 1rem;
            background: none; border: none; padding: 0;
            transition: color var(--transition);
        }
        .input-wrap .toggle-pw:hover { color: var(--tw); }
        .input-wrap input.has-toggle { padding-right: 2.75rem; }

        .row-between { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: 1rem; }
        .check-group { display: flex; align-items: center; gap: .5rem; font-size: .875rem; color: var(--text-muted); cursor: pointer; }
        .check-group input[type=checkbox] { accent-color: var(--tw); width: 15px; height: 15px; }
        .link { color: var(--tw); text-decoration: none; font-size: .875rem; font-weight: 500; }
        .link:hover { text-decoration: underline; }

        /* Primary button */
        .btn-primary {
            width: 100%; padding: .8125rem 1.25rem;
            border-radius: .625rem; border: none;
            background: var(--tw); color: #fff;
            font-size: 1rem; font-weight: 600;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: .5rem;
            transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
        }
        .btn-primary:hover { background: var(--tw-d); box-shadow: 0 4px 16px rgba(1,105,111,.35); transform: translateY(-1px); }
        .btn-primary:active { transform: translateY(0); box-shadow: none; }

        /* Footer links */
        .auth-footer-links {
            margin-top: 1.75rem;
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            gap: .375rem; font-size: .9rem; color: var(--text-muted);
        }

        /* ── MOBILE ── */
        @media (max-width: 768px) {
            body { grid-template-columns: 1fr; }
            .panel-left {
                display: none;
            }
            .panel-right { padding: 2rem 1.25rem; }
            .auth-box { max-width: 100%; }
        }
    </style>
</head>
<body>

{# ── LEFT PANEL ── #}
<div class="panel-left" aria-hidden="true">
    <a href="#" class="panel-left-logo">
        <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="36" height="36" rx="9" fill="rgba(255,255,255,.15)"/>
            <path d="M18 7C13.03 7 9 11.03 9 16c0 7.5 9 14 9 14s9-6.5 9-14c0-4.97-4.03-9-9-9z" fill="#fff" opacity=".9"/>
            <circle cx="18" cy="16" r="3.5" fill="#01696f"/>
        </svg>
        ToolboxWaze
    </a>

    <div class="panel-left-body">
        <h1 class="tagline">Dados que <em>guiam</em><br>decisões inteligentes</h1>
        <p>Acesse radares, postos de combustível, dados estaduais e muito mais — tudo integrado com a plataforma Waze for Cities.</p>
        <ul class="feature-list">
            <li><span class="icon">📡</span> Monitoramento de radares em tempo real</li>
            <li><span class="icon">⛽</span> Gestão de revendedores de combustível</li>
            <li><span class="icon">🗺️</span> Dados geográficos por estado e município</li>
            <li><span class="icon">📊</span> Histórico e análise de ocorrências</li>
        </ul>
    </div>

    <p class="panel-left-footer">© {{ 'now'|date('Y') }} ToolboxWaze — Plataforma de dados Waze for Cities</p>
</div>

{# ── RIGHT PANEL ── #}
<div class="panel-right">
    <button class="theme-toggle" data-theme-toggle aria-label="Alternar tema">
        <i class="bi bi-moon" id="themeIcon"></i>
    </button>

    <div class="auth-box">
        <h2>Bem-vindo de volta</h2>
        <p class="subtitle">Entre com sua conta para acessar a plataforma</p>

        {# Flash messages #}
        {% for label, messages in app.flashes(['success','warning','danger','info']) %}
            {% for msg in messages %}
                <div class="alert alert-{{ label }}" role="alert">
                    <i class="bi bi-{% if label == 'danger' %}exclamation-triangle{% elseif label == 'success' %}check-circle{% elseif label == 'warning' %}exclamation-circle{% else %}info-circle{% endif %}-fill"></i>
                    {{ msg }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Erro de autenticação #}
        {% if error %}
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {# Botão Google #}
        <a href="{{ path('app_google_connect') }}" class="btn-google">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="" loading="lazy">
            Continuar com Google
        </a>

        <div class="divider">ou entre com e-mail</div>

        {# Formulário #}
        <form method="post" action="{{ path('app_login') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="email">E-mail</label>
                <div class="input-wrap">
                    <i class="bi bi-envelope icon"></i>
                    <input type="email" id="email" name="email"
                           value="{{ last_username }}"
                           placeholder="seu@email.com"
                           autocomplete="email" autofocus required>
                </div>
            </div>

            <div class="form-group">
                <label for="password" style="display:flex;justify-content:space-between;align-items:center">
                    <span>Senha</span>
                    <a href="{{ path('app_forgot_password') }}" class="link" style="font-size:.8125rem;text-transform:none;letter-spacing:0">Esqueceu a senha?</a>
                </label>
                <div class="input-wrap">
                    <i class="bi bi-lock icon"></i>
                    <input type="password" id="password" name="password"
                           class="has-toggle"
                           placeholder="Sua senha"
                           autocomplete="current-password" required>
                    <button type="button" class="toggle-pw" onclick="togglePw()" aria-label="Mostrar/ocultar senha">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <div class="row-between">
                <label class="check-group">
                    <input type="checkbox" name="_remember_me">
                    Lembrar-me
                </label>
            </div>

            <button type="submit" class="btn-primary">
                <i class="bi bi-box-arrow-in-right"></i>
                Entrar na plataforma
            </button>
        </form>

        <div class="auth-footer-links">
            Não tem conta?
            <a href="{{ path('app_register') }}" class="link" style="font-weight:600">Solicitar acesso</a>
        </div>
    </div>
</div>

<script>
(function(){
    const root = document.documentElement;
    const btn  = document.querySelector('[data-theme-toggle]');
    const icon = document.getElementById('themeIcon');
    let dark = window.matchMedia('(prefers-color-scheme:dark)').matches;
    function apply(d) {
        root.setAttribute('data-theme', d ? 'dark' : 'light');
        icon.className = d ? 'bi bi-sun' : 'bi bi-moon';
    }
    apply(dark);
    btn.addEventListener('click', () => { dark = !dark; apply(dark); });
})();

function togglePw() {
    const inp = document.getElementById('password');
    const ico = document.getElementById('eyeIcon');
    if (inp.type === 'password') {
        inp.type = 'text';
        ico.className = 'bi bi-eye-slash';
    } else {
        inp.type = 'password';
        ico.className = 'bi bi-eye';
    }
}
</script>
</body>
</html>
