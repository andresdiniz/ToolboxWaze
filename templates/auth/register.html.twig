<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitar Acesso — ToolboxWaze</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=instrument-serif@400&display=swap" rel="stylesheet">
    <style>
        :root,[data-theme=light]{--bg:#f7f6f2;--surface:#fff;--border:#d4d1ca;--text:#28251d;--muted:#7a7974;--faint:#bab9b4;--primary:#01696f;--primary-h:#0c4e54;--primary-hl:color-mix(in oklab,#01696f 14%,transparent);--error:#a12c7b;--warning-bg:#fef9ec;--warning-border:#f0d060;--warning-text:#7a5a00;--radius:.75rem;--shadow:0 4px 24px rgba(0,0,0,.08)}
        [data-theme=dark]{--bg:#171614;--surface:#1c1b19;--border:#393836;--text:#cdccca;--muted:#797876;--faint:#5a5957;--primary:#4f98a3;--primary-h:#227f8b;--primary-hl:color-mix(in oklab,#4f98a3 15%,transparent);--error:#d163a7;--warning-bg:#2a2510;--warning-border:#6b5500;--warning-text:#e8c84a}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{-webkit-font-smoothing:antialiased}
        body{min-height:100dvh;font-family:'Satoshi',sans-serif;font-size:1rem;color:var(--text);background:var(--bg);display:flex;align-items:center;justify-content:center;padding:2rem 1rem}
        .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);width:100%;max-width:560px;padding:2.5rem}
        .logo{display:flex;align-items:center;gap:.6rem;margin-bottom:2rem;justify-content:center}
        .logo svg{width:36px;height:36px;color:var(--primary)}
        .logo-text{font-family:'Instrument Serif',serif;font-size:1.4rem;color:var(--text)}
        h1{font-size:1.35rem;font-weight:700;margin-bottom:.4rem;text-align:center}
        .subtitle{color:var(--muted);font-size:.875rem;text-align:center;margin-bottom:1.5rem}
        .notice{background:var(--warning-bg);border:1px solid var(--warning-border);color:var(--warning-text);border-radius:.5rem;padding:.85rem 1rem;font-size:.875rem;margin-bottom:1.5rem;display:flex;gap:.6rem;align-items:flex-start;line-height:1.5}
        .notice svg{flex-shrink:0;margin-top:1px}
        .row-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
        .field{display:flex;flex-direction:column;gap:.35rem;margin-bottom:.9rem}
        label{font-size:.85rem;font-weight:500;color:var(--text)}
        .label-hint{font-size:.78rem;color:var(--muted);font-weight:400;margin-left:.3rem}
        .input-wrap{position:relative}
        .input-wrap svg{position:absolute;left:.75rem;top:50%;transform:translateY(-50%);color:var(--faint);pointer-events:none}
        input{padding:.65rem .9rem;border:1px solid var(--border);border-radius:.5rem;background:var(--bg);color:var(--text);font-size:.95rem;transition:.18s;width:100%;font-family:inherit}
        input.has-icon{padding-left:2.5rem}
        input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-hl)}
        input::placeholder{color:var(--faint)}
        .hint{font-size:.78rem;color:var(--muted);margin-top:.15rem}
        .strength{height:3px;border-radius:2px;background:var(--border);margin-top:.4rem;overflow:hidden}
        .strength-bar{height:100%;width:0;transition:width .3s,background .3s;border-radius:2px}
        .strength-label{font-size:.75rem;color:var(--muted);margin-top:.2rem;height:1em}
        .errors{background:#fdf0f6;border:1px solid #e8b4d5;border-radius:.5rem;padding:.85rem 1rem;margin-bottom:1.25rem;list-style:none}
        .errors li{font-size:.875rem;color:var(--error);padding:.15rem 0}
        .divider{border:none;border-top:1px solid var(--border);margin:1.25rem 0}
        .section-title{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--faint);margin-bottom:.75rem}
        .waze-field{background:color-mix(in oklab,var(--primary) 6%,var(--surface));border:1px solid color-mix(in oklab,var(--primary) 22%,var(--border));border-radius:.6rem;padding:1rem;margin-bottom:.9rem}
        .waze-field label{color:var(--primary);font-weight:600}

        /* UF selector */
        .uf-box{background:color-mix(in oklab,#006494 5%,var(--surface));border:1px solid color-mix(in oklab,#006494 20%,var(--border));border-radius:.6rem;padding:1rem;margin-bottom:.9rem}
        .uf-box .section-title{color:#006494}
        .uf-hint{font-size:.8rem;color:var(--muted);margin-bottom:.75rem;line-height:1.5}
        .uf-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(58px,1fr));gap:.35rem}
        .uf-chip input{display:none}
        .uf-chip label{
            display:block;text-align:center;padding:.35rem .2rem;
            border:1px solid var(--border);border-radius:.4rem;
            font-size:.8rem;font-weight:600;cursor:pointer;
            transition:.15s;background:var(--surface);color:var(--muted)
        }
        .uf-chip input:checked + label{
            background:var(--primary);color:#fff;border-color:var(--primary)
        }
        .uf-chip label:hover{border-color:var(--primary);color:var(--primary)}
        .uf-actions{display:flex;gap:.5rem;margin-bottom:.6rem}
        .uf-btn{font-size:.75rem;padding:.25rem .6rem;border:1px solid var(--border);border-radius:.35rem;background:var(--surface);color:var(--muted);cursor:pointer;transition:.15s}
        .uf-btn:hover{border-color:var(--primary);color:var(--primary)}
        .uf-counter{font-size:.75rem;color:var(--muted);margin-top:.5rem}
        .uf-counter span{font-weight:700;color:var(--primary)}

        .btn{width:100%;padding:.75rem;border-radius:.5rem;font-size:.95rem;font-weight:600;cursor:pointer;border:none;transition:.18s;font-family:inherit;margin-top:.5rem}
        .btn-primary{background:var(--primary);color:#fff}
        .btn-primary:hover{background:var(--primary-h)}
        .footer-link{text-align:center;margin-top:1.25rem;font-size:.875rem;color:var(--muted)}
        .footer-link a{color:var(--primary);text-decoration:none;font-weight:500}
        .success-box{text-align:center;padding:.5rem 0}
        .success-icon{width:68px;height:68px;background:var(--primary-hl);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem}
        .success-title{font-size:1.3rem;font-weight:700;margin-bottom:.5rem}
        .success-text{color:var(--muted);font-size:.9rem;line-height:1.6;max-width:38ch;margin:0 auto 1.75rem}
        .toggle{position:fixed;top:1rem;right:1rem;background:var(--surface);border:1px solid var(--border);border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text);transition:.18s}
        .toggle:hover{border-color:var(--primary);color:var(--primary)}
        @media(max-width:520px){.row-2{grid-template-columns:1fr}.card{padding:1.75rem 1.25rem}}
    </style>
</head>
<body>
<button class="toggle" data-theme-toggle aria-label="Alternar tema">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<div class="card">
    <div class="logo">
        <svg viewBox="0 0 40 40" fill="none" aria-label="ToolboxWaze">
            <rect width="40" height="40" rx="10" fill="currentColor" opacity=".12"/>
            <path d="M10 28 L20 12 L30 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 22 h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="20" cy="20" r="2" fill="currentColor"/>
        </svg>
        <span class="logo-text">ToolboxWaze</span>
    </div>

    {% if sent %}
    <div class="success-box">
        <div class="success-icon">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <div class="success-title">Solicitação enviada!</div>
        <p class="success-text">Sua solicitação foi recebida. Os administradores foram notificados e analisarão seu pedido em breve.</p>
        <a href="{{ path('app_login') }}" style="display:inline-flex;align-items:center;gap:.4rem;color:var(--primary);font-weight:600;text-decoration:none">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Voltar ao login
        </a>
    </div>

    {% else %}
    <h1>Solicitar Acesso</h1>
    <p class="subtitle">Preencha os dados abaixo. Sua conta será ativada após aprovação de um administrador.</p>

    <div class="notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span>Sua conta ficará <strong>pendente</strong> até aprovação. Indique os estados onde você atua para que o admin configure seu acesso corretamente.</span>
    </div>

    {% if errors is defined and errors|length > 0 %}
    <ul class="errors">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
    {% endif %}

    <form method="POST" novalidate>
        <div class="section-title">Dados pessoais</div>
        <div class="row-2">
            <div class="field">
                <label for="name">Nome completo</label>
                <div class="input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input class="has-icon" type="text" id="name" name="name" required autocomplete="name" value="{{ values.name ?? '' }}" placeholder="João Silva">
                </div>
            </div>
            <div class="field">
                <label for="email">E-mail</label>
                <div class="input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <input class="has-icon" type="email" id="email" name="email" required autocomplete="email" value="{{ values.email ?? '' }}" placeholder="seu@email.com">
                </div>
            </div>
        </div>

        <hr class="divider">
        <div class="section-title">Identificação no Waze</div>
        <div class="waze-field">
            <div class="field" style="margin-bottom:0">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <label for="waze_nickname">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline;vertical-align:-2px;margin-right:.3rem">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 8v4l3 3"></path>
                    </svg>
                    Nickname no Waze <span class="label-hint">(obrigatório)</span>
                </label>
        
                <div class="input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 0 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
        
                    <input
                        class="has-icon"
                        type="text"
                        id="waze_nickname"
                        name="waze_nickname"
                        required
                        autocomplete="off"
                        maxlength="50"
                        inputmode="text"
                        pattern="[A-Za-z0-9_.-]{3,50}"
                        value="{{ values.waze_nickname ?? '' }}"
                        placeholder="Ex: JoaoWaze_MG"
                        aria-describedby="waze_nickname_hint waze_nickname_status"
                    >
                </div>
        
                <span class="hint" id="waze_nickname_hint">
                    Seu nome de usuário exatamente como aparece no Waze.
                </span>
        
                <div class="hint" id="waze_nickname_status" role="status" aria-live="polite"></div>
            </div>
        </div>
        
        <hr class="divider">

        {# ---- Seleção de estados ---- #}
        <div class="uf-box">
            <div class="section-title" style="color:#006494">Estados de atuação</div>
            <p class="uf-hint">
                Selecione os estados brasileiros onde você atua no Waze. O administrador irá revisar e configurar seu acesso com base nessa informação.
            </p>
            <div class="uf-actions">
                <button type="button" class="uf-btn" id="selAll">Selecionar todos</button>
                <button type="button" class="uf-btn" id="selNone">Limpar</button>
            </div>
            <div class="uf-grid" id="ufGrid">
                {% set ufs = ['AC','AL','AM','AP','BA','CE','DF','ES','GO','MA','MG','MS','MT','PA','PB','PE','PI','PR','RJ','RN','RO','RR','RS','SC','SE','SP','TO'] %}
                {% for uf in ufs %}
                <div class="uf-chip">
                    <input type="checkbox" name="requested_ufs[]" id="uf_{{ uf }}" value="{{ uf }}"
                           {% if values.requested_ufs is defined and uf in values.requested_ufs %}checked{% endif %}>
                    <label for="uf_{{ uf }}">{{ uf }}</label>
                </div>
                {% endfor %}
            </div>
            <div class="uf-counter">Estados selecionados: <span id="ufCount">0</span> / 27</div>
        </div>

        <hr class="divider">
        <div class="section-title">Senha de acesso</div>
        <div class="row-2">
            <div class="field">
                <label for="password">Senha <span class="label-hint">(mín. 8 caracteres)</span></label>
                <div class="input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <input class="has-icon" type="password" id="password" name="password" required autocomplete="new-password" placeholder="Min. 8 caracteres">
                </div>
                <div class="strength"><div class="strength-bar" id="sbar"></div></div>
                <div class="strength-label" id="slbl"></div>
            </div>
            <div class="field">
                <label for="password2">Confirmar senha</label>
                <div class="input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <input class="has-icon" type="password" id="password2" name="password2" required autocomplete="new-password" placeholder="Repita a senha">
                </div>
                <div class="hint" id="mhint" style="min-height:1em"></div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Solicitar acesso</button>
    </form>
    <div class="footer-link">Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a></div>
    {% endif %}
</div>

<script>
(function(){
    const t=document.querySelector('[data-theme-toggle]'),r=document.documentElement;
    let d=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
    r.setAttribute('data-theme',d);
    if(t)t.addEventListener('click',()=>{d=d==='dark'?'light':'dark';r.setAttribute('data-theme',d);});

    // Password strength
    const pw=document.getElementById('password'),bar=document.getElementById('sbar'),lbl=document.getElementById('slbl');
    if(pw)pw.addEventListener('input',()=>{
        const v=pw.value;let s=0;
        if(v.length>=8)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
        const c=['#e74c3c','#e67e22','#f1c40f','#2ecc71'],l=['Muito fraca','Razoável','Boa','Forte'];
        bar.style.width=(s*25)+'%';bar.style.background=v.length?c[s-1]||c[0]:'';
        lbl.textContent=v.length?l[s-1]||'Muito fraca':'';
    });
    const pw2=document.getElementById('password2'),mh=document.getElementById('mhint');
    function cm(){if(!pw2.value)return mh.textContent='';mh.textContent=pw.value===pw2.value?'\u2713 Senhas coincidem':'\u2717 Senhas diferentes';mh.style.color=pw.value===pw2.value?'#437a22':'#a12c7b';}
    if(pw&&pw2){pw.addEventListener('input',cm);pw2.addEventListener('input',cm);}

    // UF counter & select/clear
    const grid=document.getElementById('ufGrid'),counter=document.getElementById('ufCount');
    function upd(){if(counter)counter.textContent=grid.querySelectorAll('input:checked').length;}
    if(grid){grid.addEventListener('change',upd);upd();}
    document.getElementById('selAll')?.addEventListener('click',()=>{grid.querySelectorAll('input').forEach(i=>i.checked=true);upd();});
    document.getElementById('selNone')?.addEventListener('click',()=>{grid.querySelectorAll('input').forEach(i=>i.checked=false);upd();});
})();
</script>
<!-- Validação de Nickname com santização e envio para api do discuss-->
<script>
    (() => {
        const input = document.getElementById('waze_nickname');
        const status = document.getElementById('waze_nickname_status');
        const form = document.querySelector('form');
        const submitBtn = form?.querySelector('button[type="submit"]');
    
        if (!input || !status || !form || !submitBtn) return;
    
        let debounceTimer = null;
        let controller = null;
        let lastValidatedValue = '';
        let nicknameValid = false;
        let validating = false;
    
        function sanitizeNickname(value) {
            return value
                .normalize('NFKC')
                .replace(/[^A-Za-z0-9_.-]/g, '')
                .slice(0, 50);
        }
    
        function updateButtonState() {
            const value = sanitizeNickname(input.value);
            const ready = nicknameValid && value.length >= 3 && !validating && value === lastValidatedValue;
            submitBtn.disabled = !ready;
        }
    
        function setStatus(message, type = 'neutral') {
            status.textContent = message;
            status.style.color =
                type === 'success' ? '#437a22' :
                type === 'error' ? '#680911' :
                type === 'loading' ? '#7a7974' :
                '';
        }
    
        function setValidState(valid) {
            nicknameValid = valid;
            input.dataset.validNickname = valid ? '1' : '0';
            input.setAttribute('aria-invalid', valid ? 'false' : 'true');
            updateButtonState();
        }
    
        async function validateNickname(rawValue) {
            const clean = sanitizeNickname(rawValue);
    
            if (input.value !== clean) {
                input.value = clean;
            }
    
            if (!clean || clean.length < 3) {
                validating = false;
                setValidState(false);
                setStatus('');
                updateButtonState();
                return;
            }
    
            if (clean === lastValidatedValue && nicknameValid) {
                validating = false;
                updateButtonState();
                return;
            }
    
            if (controller) controller.abort();
            controller = new AbortController();
    
            validating = true;
            setValidState(false);
            setStatus('Validando nickname...', 'loading');
            updateButtonState();
    
            try {
                const response = await fetch('/auth/waze-check', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ nickname: clean }),
                    signal: controller.signal
                });
    
                const data = await response.json().catch(() => ({}));
    
                if (!response.ok || data.valid !== true) {
                    lastValidatedValue = '';
                    validating = false;
                    setValidState(false);
                    setStatus(data.message || 'Nickname inválido.', 'error');
                    updateButtonState();
                    return;
                }
    
                lastValidatedValue = clean;
                validating = false;
                setValidState(true);
                setStatus('Nickname validado com sucesso.', 'success');
                updateButtonState();
            } catch (error) {
                if (error.name === 'AbortError') return;
    
                lastValidatedValue = '';
                validating = false;
                setValidState(false);
                setStatus('Não foi possível validar agora.', 'error');
                updateButtonState();
            }
        }
    
        input.addEventListener('input', (e) => {
            const clean = sanitizeNickname(e.target.value);
            if (e.target.value !== clean) e.target.value = clean;
    
            lastValidatedValue = '';
            validating = false;
            setValidState(false);
            setStatus('');
    
            clearTimeout(debounceTimer);
    
            if (!clean || clean.length < 3) {
                updateButtonState();
                return;
            }
    
            updateButtonState();
            debounceTimer = setTimeout(() => validateNickname(clean), 700);
        });
    
        input.addEventListener('blur', () => {
            clearTimeout(debounceTimer);
            const clean = sanitizeNickname(input.value);
            if (clean.length >= 3) validateNickname(clean);
        });
    
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData('text');
            const clean = sanitizeNickname(pasted);
            input.value = clean;
            input.dispatchEvent(new Event('input', { bubbles: true }));
        });
    
        form.addEventListener('submit', (e) => {
            const clean = sanitizeNickname(input.value);
            input.value = clean;
    
            if (!nicknameValid || clean !== lastValidatedValue) {
                e.preventDefault();
                setStatus('Valide um nickname Waze antes de solicitar acesso.', 'error');
                input.focus();
            }
        });
    
        updateButtonState();
    })();
</script>

</body>
</html>
