<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitar Acesso — ToolboxWaze</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --tw: #01696f; --tw-d: #0c4e54; --tw-dd: #0f3638;
            --tw-light: #e8f4f4; --tw-muted: #cedcd8;
            --text: #1e2a2b; --text-muted: #637070; --text-faint: #a0b0b0;
            --surface: #fff; --surface-2: #f5f9f9;
            --border: rgba(1,105,111,.14);
            --shadow-card: 0 2px 6px rgba(1,105,111,.06), 0 16px 48px rgba(0,0,0,.10);
            --radius: .875rem; --transition: 180ms cubic-bezier(.16,1,.3,1);
        }
        [data-theme="dark"] {
            --text: #d0dede; --text-muted: #7a9898; --text-faint: #4a6464;
            --surface: #1a2424; --surface-2: #1e2c2c;
            --border: rgba(79,152,163,.18);
            --tw: #4f98a3; --tw-d: #227f8b; --tw-light: #1e3434; --tw-muted: #2a4848;
        }
        html { -webkit-font-smoothing: antialiased; }
        body {
            min-height: 100dvh;
            font-family: 'Inter', sans-serif; font-size: 1rem;
            color: var(--text);
            background: var(--surface-2);
            display: flex; align-items: center; justify-content: center;
            padding: 1.5rem 1rem;
        }
        .auth-container {
            width: 100%; max-width: 480px;
        }
        /* Back link */
        .back-link {
            display: inline-flex; align-items: center; gap: .375rem;
            color: var(--tw); font-size: .875rem; font-weight: 500;
            text-decoration: none; margin-bottom: 1.5rem;
            transition: color var(--transition);
        }
        .back-link:hover { color: var(--tw-d); }
        /* Card */
        .auth-card {
            background: var(--surface);
            border-radius: 1.125rem;
            box-shadow: var(--shadow-card);
            overflow: hidden;
        }
        .auth-card-header {
            background: linear-gradient(135deg, var(--tw-dd) 0%, var(--tw) 100%);
            padding: 2rem;
            display: flex; align-items: flex-start; gap: 1rem;
        }
        .auth-card-header .header-icon {
            width: 48px; height: 48px; border-radius: .75rem;
            background: rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.375rem; color: #fff; flex-shrink: 0;
        }
        .auth-card-header h1 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.5rem; color: #fff; line-height: 1.2;
            margin-bottom: .25rem;
        }
        .auth-card-header p { color: rgba(255,255,255,.75); font-size: .875rem; line-height: 1.5; }
        /* Body */
        .auth-card-body { padding: 2rem; }
        /* Pending notice */
        .notice-pending {
            background: var(--tw-light);
            border: 1px solid var(--tw-muted);
            border-radius: .625rem;
            padding: .875rem 1rem;
            display: flex; align-items: flex-start; gap: .625rem;
            font-size: .875rem; color: var(--tw-d);
            margin-bottom: 1.5rem; line-height: 1.5;
        }
        [data-theme="dark"] .notice-pending { color: var(--tw); border-color: var(--tw-muted); }
        .notice-pending i { font-size: 1.1rem; flex-shrink: 0; margin-top: .1rem; }
        /* Alerts */
        .alert {
            border-radius: .625rem; padding: .75rem 1rem;
            font-size: .875rem; margin-bottom: 1rem;
            display: flex; align-items: flex-start; gap: .6rem; border: none;
        }
        .alert-danger { background: #fdf0f3; color: #8b1a33; }
        .alert-danger ul { margin: .25rem 0 0 1rem; padding: 0; }
        [data-theme="dark"] .alert-danger { background: #2f1520; color: #f08fa8; }
        /* Form */
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .form-group { margin-bottom: 1.125rem; }
        .form-group label {
            display: block; font-size: .8125rem; font-weight: 600;
            color: var(--text-muted); margin-bottom: .375rem;
            letter-spacing: .02em; text-transform: uppercase;
        }
        .input-wrap { position: relative; }
        .input-wrap .icon {
            position: absolute; left: .875rem; top: 50%; transform: translateY(-50%);
            color: var(--text-faint); font-size: 1rem; pointer-events: none;
        }
        .input-wrap input {
            width: 100%; padding: .75rem .875rem .75rem 2.5rem;
            border: 1.5px solid var(--border); border-radius: .625rem;
            background: var(--surface-2); color: var(--text); font-size: .9375rem;
            transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
            outline: none; font-family: inherit;
        }
        .input-wrap input:focus {
            border-color: var(--tw); box-shadow: 0 0 0 3px rgba(1,105,111,.12);
            background: var(--surface);
        }
        .input-wrap input::placeholder { color: var(--text-faint); }
        /* Strength */
        .strength-track {
            height: 4px; border-radius: 2px;
            background: var(--border); margin-top: .5rem; overflow: hidden;
        }
        .strength-bar {
            height: 100%; border-radius: 2px;
            width: 0; transition: width .35s ease, background .35s ease;
        }
        .strength-label { font-size: .75rem; color: var(--text-faint); margin-top: .3rem; }
        /* Button */
        .btn-primary {
            width: 100%; padding: .8125rem 1.25rem;
            border-radius: .625rem; border: none;
            background: var(--tw); color: #fff;
            font-size: 1rem; font-weight: 600;
            cursor: pointer; font-family: inherit;
            display: flex; align-items: center; justify-content: center; gap: .5rem;
            margin-top: .5rem;
            transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
        }
        .btn-primary:hover { background: var(--tw-d); box-shadow: 0 4px 16px rgba(1,105,111,.35); transform: translateY(-1px); }
        .btn-primary:active { transform: translateY(0); }
        /* Footer */
        .auth-card-footer {
            padding: 1.125rem 2rem;
            background: var(--surface-2);
            text-align: center;
            font-size: .9rem; color: var(--text-muted);
            border-top: 1px solid var(--border);
        }
        .link { color: var(--tw); text-decoration: none; font-weight: 600; }
        .link:hover { text-decoration: underline; }
        /* Theme toggle */
        .theme-toggle {
            position: fixed; top: 1.25rem; right: 1.25rem;
            width: 38px; height: 38px; border-radius: 50%;
            border: 1px solid var(--border); background: var(--surface);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-muted); font-size: 1rem;
            transition: background var(--transition);
        }
        .theme-toggle:hover { background: var(--tw-light); color: var(--tw); }
        @media (max-width: 480px) {
            .form-row { grid-template-columns: 1fr; }
            .auth-card-body { padding: 1.5rem; }
            .auth-card-header { padding: 1.5rem; }
        }
    </style>
</head>
<body>

<button class="theme-toggle" data-theme-toggle aria-label="Alternar tema">
    <i class="bi bi-moon" id="themeIcon"></i>
</button>

<div class="auth-container">
    <a href="{{ path('app_login') }}" class="back-link">
        <i class="bi bi-arrow-left"></i> Voltar para o login
    </a>

    <div class="auth-card">
        <div class="auth-card-header">
            <div class="header-icon"><i class="bi bi-person-plus-fill"></i></div>
            <div>
                <h1>Solicitar Acesso</h1>
                <p>Preencha os dados abaixo. Seu acesso será liberado após aprovação de um administrador.</p>
            </div>
        </div>

        <div class="auth-card-body">

            <div class="notice-pending">
                <i class="bi bi-shield-check-fill"></i>
                <span>Seu cadastro ficará <strong>pendente</strong> até que um administrador aprove sua solicitação. Você receberá uma notificação quando sua conta for ativada.</span>
            </div>

            {% if errors is not empty %}
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" style="flex-shrink:0;margin-top:.1rem"></i>
                    <div><strong>Por favor corrija os erros:</strong>
                        <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
                    </div>
                </div>
            {% endif %}

            <form method="post" novalidate>

                <div class="form-group">
                    <label for="name">Nome completo</label>
                    <div class="input-wrap">
                        <i class="bi bi-person icon"></i>
                        <input type="text" id="name" name="name"
                               value="{{ values.name ?? '' }}"
                               placeholder="Seu nome completo"
                               required autofocus>
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">E-mail</label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope icon"></i>
                        <input type="email" id="email" name="email"
                               value="{{ values.email ?? '' }}"
                               placeholder="seu@email.com"
                               required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="password">Senha</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock icon"></i>
                            <input type="password" id="password" name="password"
                                   placeholder="Mínimo 8 caracteres"
                                   required oninput="checkStrength(this.value)">
                        </div>
                        <div class="strength-track"><div class="strength-bar" id="strengthBar"></div></div>
                        <div class="strength-label" id="strengthLabel"></div>
                    </div>

                    <div class="form-group">
                        <label for="confirm">Confirmar senha</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock-fill icon"></i>
                            <input type="password" id="confirm" name="confirm"
                                   placeholder="Repita a senha" required>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-primary">
                    <i class="bi bi-send"></i>
                    Enviar solicitação de acesso
                </button>
            </form>
        </div>

        <div class="auth-card-footer">
            Já tem conta? <a href="{{ path('app_login') }}" class="link">Fazer login</a>
        </div>
    </div>
</div>

<script>
(function(){
    const root = document.documentElement;
    const btn  = document.querySelector('[data-theme-toggle]');
    const icon = document.getElementById('themeIcon');
    let dark = window.matchMedia('(prefers-color-scheme:dark)').matches;
    function apply(d) {
        root.setAttribute('data-theme', d ? 'dark' : 'light');
        icon.className = d ? 'bi bi-sun' : 'bi bi-moon';
    }
    apply(dark);
    btn.addEventListener('click', () => { dark = !dark; apply(dark); });
})();

function checkStrength(v) {
    const bar = document.getElementById('strengthBar');
    const lbl = document.getElementById('strengthLabel');
    if (!v) { bar.style.width = '0'; lbl.textContent = ''; return; }
    let score = 0;
    if (v.length >= 8)  score++;
    if (v.length >= 12) score++;
    if (/[A-Z]/.test(v)) score++;
    if (/[0-9]/.test(v)) score++;
    if (/[^A-Za-z0-9]/.test(v)) score++;
    const configs = ['#dc3545','Muito fraca','#dc3545','Fraca','#fd7e14','Média','#f0ad4e','Boa','#198754','Forte'];
    const i = Math.max(0, (score - 1)) * 2;
    const color = configs[i] ?? '#01696f';
    const label = configs[i + 1] ?? 'Forte';
    bar.style.width = (score * 20) + '%';
    bar.style.background = color;
    lbl.textContent = label;
    lbl.style.color = color;
}
</script>
</body>
</html>
