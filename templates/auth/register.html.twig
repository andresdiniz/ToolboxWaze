<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitar Acesso — ToolboxWaze</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --tw: #01696f; --tw-d: #0c4e54; }
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0c4e54 0%, #01696f 50%, #1a8a92 100%);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Segoe UI', sans-serif; padding: 1rem;
        }
        .auth-card { width: 100%; max-width: 460px; background: #fff; border-radius: 1rem; box-shadow: 0 20px 60px rgba(0,0,0,.25); overflow: hidden; }
        .auth-header { background: var(--tw); color: #fff; padding: 1.75rem 2rem; text-align: center; }
        .auth-body { padding: 2rem; }
        .btn-primary { background: var(--tw); border-color: var(--tw); }
        .btn-primary:hover { background: var(--tw-d); border-color: var(--tw-d); }
        .form-control:focus { border-color: var(--tw); box-shadow: 0 0 0 .2rem rgba(1,105,111,.2); }
        .auth-footer { background: #f8f9fa; padding: 1rem 2rem; text-align: center; font-size:.875rem; }
        .auth-footer a { color: var(--tw); text-decoration: none; font-weight: 600; }
        .input-group-text { background: #f8f9fa; }
        .pending-info { background: #e8f4f8; border-left: 3px solid var(--tw); padding: .75rem 1rem; border-radius: .375rem; font-size: .875rem; }
        .strength-bar { height: 4px; border-radius: 2px; transition: width .3s, background .3s; }
    </style>
</head>
<body>

<div class="auth-card">
    <div class="auth-header">
        <i class="bi bi-person-plus-fill fs-2 d-block mb-2"></i>
        <h1 class="h5 mb-0 fw-bold">Solicitar Acesso</h1>
        <p class="mb-0 opacity-75 small">Após o cadastro, um administrador deverá aprovar sua conta</p>
    </div>

    <div class="auth-body">

        <div class="pending-info mb-4">
            <i class="bi bi-info-circle-fill me-2" style="color:var(--tw)"></i>
            Seu acesso será liberado somente após aprovação de um administrador do sistema.
        </div>

        {% if errors is not empty %}
            <div class="alert alert-danger py-2 mb-3">
                <ul class="mb-0 ps-3">
                    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="post" novalidate>

            <div class="mb-3">
                <label class="form-label fw-semibold small" for="name">Nome completo</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" id="name" name="name" class="form-control"
                           value="{{ values.name ?? '' }}" placeholder="Seu nome" required autofocus>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small" for="email">E-mail</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" id="email" name="email" class="form-control"
                           value="{{ values.email ?? '' }}" placeholder="seu@email.com" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small" for="password">Senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" id="password" name="password" class="form-control"
                           placeholder="Mínimo 8 caracteres" required oninput="checkStrength(this.value)">
                </div>
                <div class="mt-1" style="background:#e9ecef;border-radius:2px;height:4px">
                    <div class="strength-bar" id="strengthBar" style="width:0;background:#dc3545"></div>
                </div>
                <small id="strengthLabel" class="text-muted"></small>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small" for="confirm">Confirmar senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input type="password" id="confirm" name="confirm" class="form-control"
                           placeholder="Repita a senha" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="bi bi-send me-2"></i>Enviar solicitação
            </button>
        </form>
    </div>

    <div class="auth-footer">
        Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function checkStrength(v) {
    const bar = document.getElementById('strengthBar');
    const lbl = document.getElementById('strengthLabel');
    let score = 0;
    if (v.length >= 8)  score++;
    if (v.length >= 12) score++;
    if (/[A-Z]/.test(v)) score++;
    if (/[0-9]/.test(v)) score++;
    if (/[^A-Za-z0-9]/.test(v)) score++;
    const map = [
        [0, '#dc3545', ''],
        [1, '#dc3545', 'Muito fraca'],
        [2, '#fd7e14', 'Fraca'],
        [3, '#ffc107', 'Média'],
        [4, '#198754', 'Boa'],
        [5, '#01696f', 'Forte'],
    ];
    const [, color, label] = map[score] ?? map[5];
    bar.style.width = (score * 20) + '%';
    bar.style.background = color;
    lbl.textContent = label;
    lbl.style.color = color;
}
</script>
</body>
</html>
