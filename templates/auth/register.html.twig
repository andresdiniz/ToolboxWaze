<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitar Acesso — ToolboxWaze</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=instrument-serif@400&display=swap" rel="stylesheet">
    <style>
        :root,[data-theme=light]{--bg:#f7f6f2;--surface:#fff;--border:#d4d1ca;--text:#28251d;--muted:#7a7974;--primary:#01696f;--primary-h:#0c4e54;--error:#a12c7b;--warning-bg:#fef9ec;--warning-border:#f0d060;--warning-text:#7a5a00;--radius:0.75rem;--shadow:0 4px 24px rgba(0,0,0,.08)}
        [data-theme=dark]{--bg:#171614;--surface:#1c1b19;--border:#393836;--text:#cdccca;--muted:#797876;--primary:#4f98a3;--primary-h:#227f8b;--error:#d163a7;--warning-bg:#2a2510;--warning-border:#6b5500;--warning-text:#e8c84a}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
        body{min-height:100dvh;font-family:'Satoshi',sans-serif;font-size:1rem;color:var(--text);background:var(--bg);display:flex;align-items:center;justify-content:center;padding:2rem 1rem}
        .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);width:100%;max-width:480px;padding:2.5rem}
        .logo{display:flex;align-items:center;gap:.6rem;margin-bottom:2rem;justify-content:center}
        .logo svg{width:36px;height:36px;color:var(--primary)}
        .logo-text{font-family:'Instrument Serif',serif;font-size:1.4rem;color:var(--text)}
        h1{font-size:1.4rem;font-weight:700;margin-bottom:.4rem;text-align:center}
        .subtitle{color:var(--muted);font-size:.9rem;text-align:center;margin-bottom:1.75rem}
        .notice{background:var(--warning-bg);border:1px solid var(--warning-border);color:var(--warning-text);border-radius:.5rem;padding:.85rem 1rem;font-size:.875rem;margin-bottom:1.5rem;display:flex;gap:.6rem;align-items:flex-start}
        .notice svg{flex-shrink:0;margin-top:2px}
        .row-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
        .field{display:flex;flex-direction:column;gap:.35rem;margin-bottom:1rem}
        label{font-size:.85rem;font-weight:500;color:var(--text)}
        input{padding:.65rem .9rem;border:1px solid var(--border);border-radius:.5rem;background:var(--bg);color:var(--text);font-size:.95rem;transition:.18s;width:100%}
        input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px color-mix(in oklab,var(--primary) 18%,transparent)}
        .hint{font-size:.78rem;color:var(--muted)}
        .strength{height:3px;border-radius:2px;background:var(--border);margin-top:.35rem;overflow:hidden}
        .strength-bar{height:100%;width:0;transition:width .3s,background .3s;border-radius:2px}
        .btn{width:100%;padding:.75rem;border-radius:.5rem;font-size:.95rem;font-weight:600;cursor:pointer;border:none;transition:.18s}
        .btn-primary{background:var(--primary);color:#fff}
        .btn-primary:hover{background:var(--primary-h)}
        .errors{background:#fdf0f6;border:1px solid #e8b4d5;border-radius:.5rem;padding:.85rem 1rem;margin-bottom:1.25rem}
        .errors li{font-size:.875rem;color:var(--error);margin-left:1.1rem}
        .footer-link{text-align:center;margin-top:1.25rem;font-size:.875rem;color:var(--muted)}
        .footer-link a{color:var(--primary);text-decoration:none;font-weight:500}
        .success-box{text-align:center;padding:1rem 0}
        .success-icon{width:64px;height:64px;background:color-mix(in oklab,var(--primary) 12%,transparent);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem}
        .toggle{position:fixed;top:1rem;right:1rem;background:var(--surface);border:1px solid var(--border);border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text)}
        @media(max-width:480px){.row-2{grid-template-columns:1fr}.card{padding:1.75rem 1.25rem}}
    </style>
</head>
<body>
<button class="toggle" data-theme-toggle aria-label="Alternar tema">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<div class="card">
    <div class="logo">
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="ToolboxWaze logo">
            <rect width="40" height="40" rx="10" fill="currentColor" opacity=".12"/>
            <path d="M10 28 L20 12 L30 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 22 h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="20" cy="20" r="2" fill="currentColor"/>
        </svg>
        <span class="logo-text">ToolboxWaze</span>
    </div>

    {% if sent %}
    <div class="success-box">
        <div class="success-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#01696f" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <h1>Solicitação enviada!</h1>
        <p class="subtitle" style="margin-top:.5rem">Sua solicitação foi recebida. Os administradores foram notificados e analisarão seu pedido em breve.</p>
        <a href="{{ path('app_login') }}" style="display:inline-block;margin-top:1.5rem;color:var(--primary);font-weight:500;text-decoration:none">← Voltar ao login</a>
    </div>
    {% else %}
    <h1>Solicitar Acesso</h1>
    <p class="subtitle">Preencha os dados abaixo. Sua conta será ativada após aprovação.</p>

    <div class="notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span>Sua conta ficará <strong>pendente</strong> até que um administrador aprove e configure suas permissões.</span>
    </div>

    {% if errors is defined and errors|length > 0 %}
    <ul class="errors">
        {% for e in errors %}<li>{{ e }}</li>{% endfor %}
    </ul>
    {% endif %}

    <form method="POST">
        <div class="row-2">
            <div class="field">
                <label for="name">Nome completo</label>
                <input type="text" id="name" name="name" required autocomplete="name"
                       value="{{ values.name ?? '' }}" placeholder="João Silva">
            </div>
            <div class="field">
                <label for="waze_nickname">Nickname no Waze</label>
                <input type="text" id="waze_nickname" name="waze_nickname" required
                       value="{{ values.waze_nickname ?? '' }}" placeholder="Ex: JoaoWaze_BR">
            </div>
        </div>
        <div class="field">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" required autocomplete="email"
                   value="{{ values.email ?? '' }}" placeholder="seu@email.com">
        </div>
        <div class="row-2">
            <div class="field">
                <label for="password">Senha</label>
                <input type="password" id="password" name="password" required autocomplete="new-password" placeholder="Mín. 8 caracteres">
                <div class="strength"><div class="strength-bar" id="strength-bar"></div></div>
                <span class="hint" id="strength-label"> </span>
            </div>
            <div class="field">
                <label for="password2">Confirmar senha</label>
                <input type="password" id="password2" name="password2" required autocomplete="new-password" placeholder="Repita a senha">
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Solicitar acesso</button>
    </form>

    <div class="footer-link">
        Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a>
    </div>
    {% endif %}
</div>

<script>
(function(){
    // theme toggle
    const t=document.querySelector('[data-theme-toggle]'),r=document.documentElement;
    let d=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
    r.setAttribute('data-theme',d);
    if(t)t.addEventListener('click',()=>{d=d==='dark'?'light':'dark';r.setAttribute('data-theme',d)});

    // password strength
    const pw=document.getElementById('password');
    const bar=document.getElementById('strength-bar');
    const lbl=document.getElementById('strength-label');
    if(pw&&bar){
        pw.addEventListener('input',()=>{
            const v=pw.value;
            let s=0;
            if(v.length>=8)s++;
            if(/[A-Z]/.test(v))s++;
            if(/[0-9]/.test(v))s++;
            if(/[^A-Za-z0-9]/.test(v))s++;
            const cols=['#e74c3c','#e67e22','#f1c40f','#2ecc71'];
            const labs=['Fraca','Razoável','Boa','Forte'];
            bar.style.width=(s*25)+'%';
            bar.style.background=cols[s-1]||'#e74c3c';
            lbl.textContent=v.length?labs[s-1]||'Muito fraca':' ';
        });
    }
})();
</script>
</body>
</html>
