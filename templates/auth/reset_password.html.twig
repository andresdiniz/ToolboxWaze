<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redefinir Senha — ToolboxWaze</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --tw: #01696f; --tw-d: #0c4e54; }
        body { min-height:100vh; background:linear-gradient(135deg,#0c4e54,#01696f,#1a8a92); display:flex; align-items:center; justify-content:center; font-family:'Segoe UI',sans-serif; }
        .auth-card { width:100%; max-width:420px; background:#fff; border-radius:1rem; box-shadow:0 20px 60px rgba(0,0,0,.25); overflow:hidden; }
        .auth-header { background:var(--tw); color:#fff; padding:1.75rem 2rem; text-align:center; }
        .auth-body { padding:2rem; }
        .btn-primary { background:var(--tw); border-color:var(--tw); }
        .btn-primary:hover { background:var(--tw-d); border-color:var(--tw-d); }
        .form-control:focus { border-color:var(--tw); box-shadow:0 0 0 .2rem rgba(1,105,111,.2); }
        .input-group-text { background:#f8f9fa; }
        .auth-footer { background:#f8f9fa; padding:1rem 2rem; text-align:center; font-size:.875rem; }
        .auth-footer a { color:var(--tw); text-decoration:none; font-weight:600; }
    </style>
</head>
<body>
<div class="auth-card">
    <div class="auth-header">
        <i class="bi bi-shield-lock-fill fs-2 d-block mb-2"></i>
        <h1 class="h5 mb-0 fw-bold">Redefinir Senha</h1>
    </div>
    <div class="auth-body">
        {% if errors is not empty %}
            <div class="alert alert-danger py-2 mb-3">
                <ul class="mb-0 ps-3">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
            </div>
        {% endif %}
        <form method="post" novalidate>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Nova senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Mínimo 8 caracteres" required autofocus>
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold small">Confirmar nova senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input type="password" name="confirm" class="form-control" placeholder="Repita a senha" required>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="bi bi-check2 me-2"></i>Salvar nova senha
            </button>
        </form>
    </div>
    <div class="auth-footer">
        <a href="{{ path('app_login') }}"><i class="bi bi-arrow-left me-1"></i>Voltar ao login</a>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
