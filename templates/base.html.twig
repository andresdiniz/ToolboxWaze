<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#01696f">
    <title>{% block title %}ToolboxWaze{% endblock %}</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&display=swap" rel="stylesheet">

    {{ importmap('app') }}
    {% block stylesheets %}{% endblock %}

    <style>
    @keyframes twSlideIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes twFadeOut {
        from { opacity: 1; }
        to   { opacity: 0; transform: translateY(-4px); }
    }
    .alert-animated {
        animation: twSlideIn 220ms cubic-bezier(0.16,1,0.3,1) both;
    }
    .alert-animated.tw-hiding {
        animation: twFadeOut 300ms ease forwards;
    }

    /* ── Busca global ─────────────────────────────────────────────── */
    .navbar-search-wrap {
        position: relative;
    }
    .navbar-search-input {
        background: transparent;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 20px;
        color: inherit;
        font-size: .82rem;
        padding: .3rem .85rem .3rem 2rem;
        width: 200px;
        transition: width .25s ease, border-color .2s;
        outline: none;
    }
    .navbar-search-input:focus {
        width: 280px;
        border-color: rgba(255,255,255,.5);
        background: rgba(255,255,255,.08);
    }
    .navbar-search-input::placeholder { color: rgba(255,255,255,.5); }
    .navbar-search-icon {
        position: absolute;
        left: .55rem;
        top: 50%;
        transform: translateY(-50%);
        opacity: .5;
        pointer-events: none;
    }
    .search-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        min-width: 320px;
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: .5rem;
        box-shadow: 0 8px 24px rgba(0,0,0,.14);
        z-index: 1055;
        display: none;
        max-height: 360px;
        overflow-y: auto;
    }
    .search-dropdown.show { display: block; }
    .search-item {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .5rem .85rem;
        font-size: .82rem;
        color: var(--bs-body-color);
        text-decoration: none;
        transition: background .15s;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }
    .search-item:last-child { border-bottom: none; }
    .search-item:hover { background: var(--bs-tertiary-bg, #f5f5f5); }
    .search-item-label { flex: 1; line-height: 1.3; }
    .search-item-type {
        font-size: .7rem;
        padding: .12em .45em;
        border-radius: 8px;
        font-weight: 600;
        white-space: nowrap;
    }
    .search-item-type.radar { background: rgba(13,110,253,.15); color: #0d6efd; }
    .search-item-type.posto { background: rgba(253,126,20,.15); color: #fd7e14; }
    .search-empty {
        padding: .75rem 1rem;
        font-size: .82rem;
        color: var(--bs-secondary-color, #6c757d);
        text-align: center;
    }
    </style>

    <script>
    (function(){
        var t = localStorage.getItem('twTheme');
        if (!t) t = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
    }());
    </script>
</head>
<body>

<nav class="navbar navbar-expand-lg mb-4">
    <div class="container-xl">
        <a class="navbar-brand" href="{{ path('app_dashboard') }}">
            <span class="navbar-brand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
