<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#01696f">
    <title>{% block title %}ToolboxWaze{% endblock %}</title>

    {# Skip link — acessibilidade: primeiro elemento focalizável #}
    <a href="#main-content" class="tw-skip-link">Ir ao conteúdo principal</a>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&display=optional" rel="stylesheet">

    {{ importmap('app') }}
    {% block stylesheets %}{% endblock %}

    <style>
    /* ── Tokens próprios ────────────────────────────────────── */
    :root {
        --tw-surface:        #ffffff;
        --tw-surface-hover:  #f5f5f5;
        --tw-border:         rgba(0,0,0,.12);
        --tw-text:           #212529;
        --tw-text-muted:     #6c757d;
        --tw-shadow-dropdown: 0 8px 24px rgba(0,0,0,.14);
    }
    [data-theme="dark"] {
        --tw-surface:        #1e1e1e;
        --tw-surface-hover:  #2a2a2a;
        --tw-border:         rgba(255,255,255,.12);
        --tw-text:           #e3e3e3;
        --tw-text-muted:     #9e9e9e;
        --tw-shadow-dropdown: 0 8px 24px rgba(0,0,0,.45);
    }

    /* ── Skip link ─────────────────────────────────────────── */
    .tw-skip-link {
        position: absolute;
        left: -9999px;
        top: .5rem;
        z-index: 9999;
        padding: .4rem .9rem;
        background: var(--tw-surface);
        color: var(--tw-text);
        border: 1px solid var(--tw-border);
        border-radius: .4rem;
        font-size: .875rem;
        text-decoration: none;
    }
    .tw-skip-link:focus { left: 1rem; }

    /* ── Animações de alerta ───────────────────────────────── */
    @keyframes twSlideIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes twFadeOut {
        from { opacity: 1; }
        to   { opacity: 0; transform: translateY(-4px); }
    }
    .alert-animated {
        animation: twSlideIn 220ms cubic-bezier(0.16,1,0.3,1) both;
    }
    .alert-animated.tw-hiding {
        animation: twFadeOut 300ms ease forwards;
    }
    @media (prefers-reduced-motion: reduce) {
        .alert-animated,
        .alert-animated.tw-hiding,
        .reveal { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
    }

    /* ── Busca global ──────────────────────────────────────── */
    .navbar-search-wrap { position: relative; }
    .navbar-search-input {
        background: transparent;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 20px;
        color: inherit;
        font-size: .82rem;
        padding: .3rem .85rem .3rem 2rem;
        width: min(200px, 20vw);
        transition: width .25s ease, border-color .2s;
        outline: none;
    }
    .navbar-search-input:focus {
        width: min(280px, 28vw);
        border-color: rgba(255,255,255,.5);
        background: rgba(255,255,255,.08);
    }
    .navbar-search-input::placeholder { color: rgba(255,255,255,.5); }
    .navbar-search-icon {
        position: absolute;
        left: .55rem;
        top: 50%;
        transform: translateY(-50%);
        opacity: .5;
        pointer-events: none;
    }
    .search-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        min-width: 320px;
        background: var(--tw-surface);
        border: 1px solid var(--tw-border);
        border-radius: .5rem;
        box-shadow: var(--tw-shadow-dropdown);
        z-index: 1055;
        display: none;
        max-height: 360px;
        overflow-y: auto;
    }
    .search-dropdown.show { display: block; }
    .search-item {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .5rem .85rem;
        font-size: .82rem;
        color: var(--tw-text);
        text-decoration: none;
        transition: background .15s;
        border-bottom: 1px solid var(--tw-border);
    }
    .search-item:last-child { border-bottom: none; }
    .search-item:hover, .search-item:focus { background: var(--tw-surface-hover); outline: none; }
    .search-item-label { flex: 1; line-height: 1.3; }
    .search-item-type {
        font-size: .7rem;
        padding: .12em .45em;
        border-radius: 8px;
        font-weight: 600;
        white-space: nowrap;
    }
    .search-item-type.radar  { background: rgba(13,110,253,.15);  color: #0d6efd; }
    .search-item-type.posto  { background: rgba(253,126,20,.15);   color: #fd7e14; }
    .search-item-type.escola { background: rgba(25,135,84,.15);    color: #198754; }
    .search-empty {
        padding: .75rem 1rem;
        font-size: .82rem;
        color: var(--tw-text-muted);
        text-align: center;
    }
    .search-footer {
        display: block;
        padding: .45rem 1rem;
        font-size: .75rem;
        color: var(--tw-text-muted);
        text-align: center;
        border-top: 1px solid var(--tw-border);
        text-decoration: none;
    }
    .search-footer:hover { background: var(--tw-surface-hover); color: var(--tw-text); }

    /* ── Botão lupa mobile ──────────────────────────────────── */
    .tw-search-mobile-btn {
        background: none;
        border: none;
        color: inherit;
        padding: .25rem .4rem;
        opacity: .8;
        cursor: pointer;
    }
    .tw-search-mobile-btn:hover { opacity: 1; }
    </style>

    {# ── Google Tag Manager — inicialização do dataLayer ──────────────────── #}
    {% set gtmId = app_gtm_id|default('') %}
    {% if gtmId %}
    <script>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
        'event':          'page_context',
        'user_role':      '{{ app.user ? (is_granted('ROLE_ADMIN') ? 'admin' : 'user') : 'guest' }}',
        'user_logged_in': {{ app.user ? 'true' : 'false' }},
        'page_section':   '{{ app.request.pathInfo|split('/')|filter(v => v != '')|first|default('home') }}'
    });
    </script>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','{{ gtmId|e('js') }}');</script>
    <!-- End Google Tag Manager -->
    {% endif %}

    {# Tema inicial sem flash — com try/catch para Safari privado #}
    <script>
    (function(){
        var t;
        try { t = localStorage.getItem('twTheme'); } catch(e){}
        if (!t) t = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
    }());
    </script>
</head>
<body>

{% if gtmId is defined and gtmId %}
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ gtmId|e('html_attr') }}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
{% endif %}

<header role="banner">
