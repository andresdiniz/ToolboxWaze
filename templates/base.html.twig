<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ToolboxWaze{% endblock %}</title>
    {{ importmap('app') }}
    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg mb-4 shadow-sm">
    <div class="container-xl">
        <a class="navbar-brand fw-bold" href="{{ path('app_dashboard') }}">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 aria-label="ToolboxWaze" style="vertical-align:-.25em;margin-right:.35em">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7z"/>
                <circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none"/>
            </svg>
            ToolboxWaze
        </a>
        <button class="navbar-toggler bg-white" type="button"
                data-bs-toggle="collapse" data-bs-target="#nav"
                aria-controls="nav" aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/radares' %}active{% endif %}"
                       href="{{ path('radar_index') }}">
                        <i class="bi bi-camera-video me-1"></i>Radares
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/postos' %}active{% endif %}"
                       href="{{ path('posto_index') }}">
                        <i class="bi bi-fuel-pump me-1"></i>Postos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/solicitacoes' %}active{% endif %}"
                       href="{{ path('solicitacao_hub') }}">
                        <i class="bi bi-send me-1"></i>Solicitações
                    </a>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/admin' %}active{% endif %}"
                       href="{{ path('admin_users_index') }}">
                        <i class="bi bi-people me-1"></i>Usuários
                    </a>
                </li>
                {% endif %}
            </ul>

            {% if app.user %}
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown user-menu">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        {% if app.user.avatarUrl %}
                            <img src="{{ app.user.avatarUrl }}" class="avatar-sm" alt="" loading="lazy">
                        {% else %}
                            <div class="avatar-sm bg-white text-success d-flex align-items-center justify-content-center fw-bold"
                                 style="font-size:.8rem">
                                {{ app.user.name|first|upper }}
                            </div>
                        {% endif %}
                        <span class="d-none d-md-inline">{{ app.user.name|split(' ')|first }}</span>
                        <i class="bi bi-chevron-down" style="font-size:.7rem"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <div class="dropdown-item-text">
                                <div class="fw-semibold">{{ app.user.name }}</div>
                                <small class="text-muted">{{ app.user.email }}</small>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right me-2"></i>Sair
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container-xl pb-5">
    {% for label, messages in app.flashes(['success','warning','danger','info','error']) %}
        {% for msg in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible py-2 mb-3" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
