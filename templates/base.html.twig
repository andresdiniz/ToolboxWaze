<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#01696f">
    <title>{% block title %}ToolboxWaze{% endblock %}</title>

    {# Skip link #}
    <a href="#main-content" class="tw-skip-link">Ir ao conteúdo principal</a>

    {# Bootstrap CSS + Icons (CDN) #}
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          crossorigin="anonymous">

    {# Bootstrap JS (bundle) #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous" defer></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&display=optional" rel="stylesheet">

    {{ importmap('app') }}

    {# CSS principal (app.css) #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}

    {# Google Tag Manager #}
    {% set gtmId = app_gtm_id|default('') %}
    {% if gtmId %}
    <script>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
        'event':          'page_context',
        'user_role':      '{{ app.user ? (is_granted('ROLE_ADMIN') ? 'admin' : 'user') : 'guest' }}',
        'user_logged_in': {{ app.user ? 'true' : 'false' }},
        'page_section':   '{{ app.request.pathInfo|split('/')|filter(v => v != '')|first|default('home') }}'
    });
    </script>
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','{{ gtmId|e('js') }}');</script>
    {% endif %}

    {# Tema inicial (apenas JS mínimo para evitar flash) #}
    <script>
    (function(){
        var t;
        try { t = localStorage.getItem('twTheme'); } catch(e){}
        if (!t) t = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
    }());
    </script>
</head>
<body>

{% if gtmId is defined and gtmId %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ gtmId|e('html_attr') }}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
{% endif %}

{# ===== NAVBAR ===== #}
<header role="banner">
<nav class="navbar navbar-expand-lg bg-dark navbar-dark mb-4">
    <div class="container-xl">
        <a class="navbar-brand" href="{{ path('app_dashboard') }}">
            <span class="navbar-brand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     aria-label="ToolboxWaze">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7z"/>
                    <circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none"/>
                </svg>
            </span>
            ToolboxWaze
        </a>
        <div class="d-flex align-items-center gap-2">
            <button class="theme-toggle btn btn-outline-light btn-sm" data-theme-toggle aria-label="Alternar tema" title="Alternar modo escuro">
                <i id="icon-sun" class="bi bi-sun" style="display:none"></i>
                <i id="icon-moon" class="bi bi-moon"></i>
            </button>

            {% if app.user %}
            <button class="tw-search-mobile-btn d-lg-none text-light" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#searchOffcanvas"
                    aria-label="Buscar" title="Buscar">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11"/>
                </svg>
            </button>
            {% endif %}

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#nav"
                    aria-controls="nav" aria-expanded="false" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item"><a class="nav-link {% if app.request.pathInfo starts with '/radares' %}active{% endif %}" href="{{ path('radar_index') }}"><i class="bi bi-broadcast me-1"></i> Radares</a></li>
                <li class="nav-item"><a class="nav-link {% if app.request.pathInfo starts with '/postos' %}active{% endif %}" href="{{ path('posto_index') }}"><i class="bi bi-fuel-pump me-1"></i> Postos</a></li>
                <li class="nav-item"><a class="nav-link {% if app.request.pathInfo starts with '/escolas' %}active{% endif %}" href="{{ path('escola_inep_index') }}"><i class="bi bi-building me-1"></i> Escolas</a></li>
                <li class="nav-item"><a class="nav-link {% if app.request.pathInfo starts with '/solicitacoes' %}active{% endif %}" href="{{ path('solicitacao_hub') }}"><i class="bi bi-inbox me-1"></i> Solicitações</a></li>
                <li class="nav-item"><a class="nav-link {% if app.request.pathInfo starts with '/cobertura' %}active{% endif %}" href="{{ path('cobertura_radar') }}" title="Cobertura Waze"><i class="bi bi-globe me-1"></i> Cobertura</a></li>

                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" data-turbo="false" aria-expanded="false">
                        <i class="bi bi-shield-lock me-1"></i> Admin
                    </a>
                    <ul class="dropdown-menu shadow">
                        <li><h6 class="dropdown-header text-uppercase" style="font-size:.68rem;letter-spacing:.06em">Gerenciamento</h6></li>
                        <li><a class="dropdown-item" href="{{ path('admin_users_index') }}"><i class="bi bi-people me-2"></i>Usuários</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_estados_index') }}"><i class="bi bi-geo-alt me-2"></i>Estados / Radares</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_waze_link_index') }}"><i class="bi bi-link-45deg me-2"></i>Links Waze</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_waze_link_new') }}"><i class="bi bi-plus-circle me-2"></i>Novo Formulário</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header text-uppercase" style="font-size:.68rem;letter-spacing:.06em">Monitoramento</h6></li>
                        <li><a class="dropdown-item" href="{{ path('auditoria_index') }}"><i class="bi bi-clipboard-data me-2"></i>Auditoria</a></li>
                        <li><a class="dropdown-item" href="{{ path('monitoring_dashboard') }}"><i class="bi bi-graph-up me-2"></i>Frontend Monitor</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_suspicious_requests_index') }}"><i class="bi bi-exclamation-triangle me-2"></i>Requisições Suspeitas</a></li>
                    </ul>
                </li>
                {% endif %}
            </ul>

            {# Busca desktop #}
            {% if app.user %}
            <div class="navbar-search-wrap d-none d-lg-block me-2">
                <i class="bi bi-search navbar-search-icon"></i>
                <input type="text" id="globalSearch" class="navbar-search-input"
                       placeholder="Buscar radares, postos…"
                       autocomplete="off" aria-label="Busca global">
                <div class="search-dropdown" id="searchDropdown" role="listbox" aria-label="Resultados da busca"></div>
            </div>
            {% endif %}

            {# Usuário #}
            {% if app.user %}
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown user-menu">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                       data-bs-toggle="dropdown" data-turbo="false" aria-expanded="false">
                        {% if app.user.avatarUrl %}
                            <img src="{{ app.user.avatarUrl }}" class="avatar-sm" alt="" loading="lazy">
                        {% else %}
                            <span class="avatar-sm bg-light text-dark d-flex align-items-center justify-content-center fw-bold">
                                {{ app.user.name|first|upper }}
                            </span>
                        {% endif %}
                        <span class="d-none d-md-inline">{{ app.user.name|split(' ')|first }}</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><div class="dropdown-item-text"><div class="fw-semibold">{{ app.user.name }}</div><small class="text-muted">{{ app.user.email }}</small></div></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('perfil_index') }}"><i class="bi bi-person me-2"></i>Meu Perfil</a></li>
                        <li><a class="dropdown-item" href="{{ path('perfil_api_token') }}"><i class="bi bi-key me-2"></i>Token de API</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('export_radares_csv') }}" data-gtm-event="export_csv" data-gtm-tipo="radares"><i class="bi bi-download me-2"></i>Exportar Radares CSV</a></li>
                        <li><a class="dropdown-item" href="{{ path('export_postos_csv') }}" data-gtm-event="export_csv" data-gtm-tipo="postos"><i class="bi bi-download me-2"></i>Exportar Postos CSV</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                    </ul>
                </li>
            </ul>
            {% endif %}
        </div>
    </div>
</nav>
</header>

{# Offcanvas busca mobile #}
{% if app.user %}
<div class="offcanvas offcanvas-top" tabindex="-1" id="searchOffcanvas" aria-labelledby="searchOffcanvasLabel">
    <div class="offcanvas-header pb-0">
        <h5 class="offcanvas-title" id="searchOffcanvasLabel" style="font-size:.9rem">Buscar</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body pt-2">
        <div class="input-group mb-2">
            <span class="input-group-text"><svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11"/></svg></span>
            <input type="text" id="globalSearchMobile" class="form-control"
                   placeholder="Buscar radares, postos…" autocomplete="off" aria-label="Busca global mobile">
        </div>
        <div id="searchDropdownMobile" role="listbox" aria-label="Resultados"></div>
    </div>
</div>
{% endif %}

{# ===== CONTEÚDO ===== #}
<main id="main-content" class="container-xl pb-5">
    {% for label, messages in app.flashes(['success','warning','danger','info','error']) %}
        {% for msg in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible alert-animated py-2 mb-3" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

{# ===== JAVASCRIPT ===== #}
{% block javascripts %}
    <script src="{{ asset('js/app.js') }}" defer></script>
    <script src="{{ asset('js/tw-monitor.js') }}" defer></script>
{% endblock %}

</body>
</html>