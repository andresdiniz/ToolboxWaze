<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ToolboxWaze{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --tw: #01696f; --tw-d: #0c4e54; --tw-border: #d4d1ca; --tw-surface: #f7f6f2; }
        body { background: var(--tw-surface); font-size:.9375rem; }
        .navbar { background: var(--tw) !important; }
        .navbar-brand, .nav-link { color:#fff !important; }
        .nav-link:hover, .nav-link.active { opacity:.8; }
        .card { border-color: var(--tw-border); }
        .badge-aprovado  { background:#198754; }
        .badge-reprovado { background:#dc3545; }
        .badge-uf { background:var(--tw); font-size:.7rem; }
        .stat-card { border-left:3px solid var(--tw); }
        .stat-card .stat-value { font-size:1.75rem; font-weight:700; color:var(--tw); }
        .filters-form .form-select, .filters-form .form-control { font-size:.875rem; }
        .page-link { color:var(--tw); }
        .page-item.active .page-link { background:var(--tw); border-color:var(--tw); }
        .btn-primary { background:var(--tw); border-color:var(--tw); }
        .btn-primary:hover { background:var(--tw-d); border-color:var(--tw-d); }
        .btn-outline-primary { color:var(--tw); border-color:var(--tw); }
        .btn-outline-primary:hover { background:var(--tw); border-color:var(--tw); }
        .detail-label { font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; color:#6c757d; }
        .detail-value { font-size:.9375rem; font-weight:500; }
        .row-link:hover td { background:#f0f5f5; cursor:pointer; }
        .avatar-sm { width:32px; height:32px; border-radius:50%; object-fit:cover; }
        .user-menu .dropdown-toggle::after { display:none; }
        .navbar-pending-badge { position:absolute; top:-4px; right:-4px; background:#dc3545; color:#fff; border-radius:50%; width:16px; height:16px; font-size:.6rem; display:flex; align-items:center; justify-content:center; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg mb-4 shadow-sm">
    <div class="container-xl">
        <a class="navbar-brand fw-bold" href="{{ path('app_dashboard') }}">
            <i class="bi bi-map me-1"></i> ToolboxWaze
        </a>
        <button class="navbar-toggler bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/radares' %}active fw-semibold{% endif %}"
                       href="{{ path('radar_index') }}">
                        <i class="bi bi-camera-video me-1"></i>Radares
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/postos' %}active fw-semibold{% endif %}"
                       href="{{ path('posto_index') }}">
                        <i class="bi bi-fuel-pump me-1"></i>Postos
                    </a>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link {% if app.request.pathInfo starts with '/admin' %}active fw-semibold{% endif %}"
                       href="{{ path('admin_user_index') }}">
                        <i class="bi bi-people me-1"></i>Usuários
                    </a>
                </li>
                {% endif %}
            </ul>

            {% if app.user %}
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown user-menu">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        {% if app.user.avatarUrl %}
                            <img src="{{ app.user.avatarUrl }}" class="avatar-sm" alt="">
                        {% else %}
                            <div class="avatar-sm bg-white text-success d-flex align-items-center justify-content-center fw-bold" style="font-size:.8rem">
                                {{ app.user.name|first|upper }}
                            </div>
                        {% endif %}
                        <span class="d-none d-md-inline">{{ app.user.name|split(' ')|first }}</span>
                        <i class="bi bi-chevron-down" style="font-size:.7rem"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <div class="dropdown-item-text">
                                <div class="fw-semibold">{{ app.user.name }}</div>
                                <small class="text-muted">{{ app.user.email }}</small>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right me-2"></i>Sair
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container-xl pb-5">
    {% for label, messages in app.flashes(['success','warning','danger','info']) %}
        {% for msg in messages %}
            <div class="alert alert-{{ label }} alert-dismissible py-2 mb-3" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
