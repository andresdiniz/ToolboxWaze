<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow">
  <title>{% block error_code %}Erro{% endblock %} — ToolboxWaze</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&display=swap" rel="stylesheet">

  <style>
    :root {
      --tw-teal:       #01696f;
      --tw-teal-dark:  #0c4e54;
      --tw-bg:         #f7f6f2;
      --tw-surface:    #fff;
      --tw-border:     #e2e0db;
      --tw-text:       #28251d;
      --tw-muted:      #7a7974;
      --tw-danger:     #a12c7b;
      --tw-font:       'Inter', system-ui, sans-serif;
    }
    [data-theme="dark"] {
      --tw-bg:      #171614;
      --tw-surface: #1c1b19;
      --tw-border:  #393836;
      --tw-text:    #cdccca;
      --tw-muted:   #797876;
      --tw-teal:    #4f98a3;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }
    body {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      font-family: var(--tw-font);
      background: var(--tw-bg);
      color: var(--tw-text);
      transition: background .2s, color .2s;
    }

    /* ── Header minimalista ──────────────────────────────── */
    .err-header {
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--tw-border);
      background: var(--tw-surface);
    }
    .err-brand {
      display: flex;
      align-items: center;
      gap: .5rem;
      font-size: .95rem;
      font-weight: 600;
      color: var(--tw-teal);
      text-decoration: none;
    }
    .err-brand svg { color: var(--tw-teal); }

    /* ── Conteúdo central ───────────────────────────────── */
    .err-main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(2rem, 6vw, 5rem) 1.5rem;
    }
    .err-card {
      max-width: 520px;
      width: 100%;
      text-align: center;
    }

    /* ── Ícone SVG ──────────────────────────────────────── */
    .err-svg-wrap {
      width: 88px;
      height: 88px;
      margin: 0 auto 1.75rem;
      color: var(--tw-teal);
      opacity: .85;
      animation: errPop .5s cubic-bezier(0.16,1,0.3,1) both;
    }
    .err-svg { width: 100%; height: 100%; }
    @keyframes errPop {
      from { transform: scale(.7); opacity: 0; }
      to   { transform: scale(1);  opacity: 1; }
    }

    /* ── Código de erro grande ──────────────────────────── */
    .err-code {
      font-size: clamp(4.5rem, 14vw, 8rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -.04em;
      color: var(--tw-teal);
      opacity: .18;
      margin-bottom: .25rem;
      font-variant-numeric: tabular-nums;
      animation: errFade .45s ease both .05s;
    }
    @keyframes errFade {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: .18; }
    }

    /* ── Títulos e texto ────────────────────────────────── */
    .err-title {
      font-size: clamp(1.4rem, 4vw, 2rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: .75rem;
      animation: errSlide .4s cubic-bezier(0.16,1,0.3,1) both .1s;
    }
    .err-message {
      font-size: .95rem;
      color: var(--tw-muted);
      line-height: 1.7;
      max-width: 42ch;
      margin: 0 auto 2rem;
      animation: errSlide .4s cubic-bezier(0.16,1,0.3,1) both .15s;
    }
    @keyframes errSlide {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: none; }
    }

    /* ── Botões ─────────────────────────────────────────── */
    .err-actions {
      display: flex;
      gap: .75rem;
      justify-content: center;
      flex-wrap: wrap;
      animation: errSlide .4s cubic-bezier(0.16,1,0.3,1) both .2s;
    }
    .err-search-form {
      display: flex;
      gap: .5rem;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
      margin-bottom: .75rem;
      animation: errSlide .4s cubic-bezier(0.16,1,0.3,1) both .2s;
    }
    .err-search-input {
      flex: 1;
      min-width: 200px;
      max-width: 300px;
      padding: .55rem 1rem;
      border: 1px solid var(--tw-border);
      border-radius: 8px;
      background: var(--tw-surface);
      color: var(--tw-text);
      font: inherit;
      font-size: .88rem;
      outline: none;
      transition: border-color .18s;
    }
    .err-search-input:focus { border-color: var(--tw-teal); }
    .err-search-input::placeholder { color: var(--tw-muted); }
    .btn-err {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .55rem 1.25rem;
      border-radius: 8px;
      font: inherit;
      font-size: .88rem;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      border: 1px solid transparent;
      transition: background .18s, border-color .18s, color .18s, transform .15s;
      white-space: nowrap;
    }
    .btn-err:active { transform: scale(.97); }
    .btn-err-primary {
      background: var(--tw-teal);
      color: #fff;
      border-color: var(--tw-teal);
    }
    .btn-err-primary:hover { background: var(--tw-teal-dark); border-color: var(--tw-teal-dark); color: #fff; }
    .btn-err-ghost {
      background: transparent;
      color: var(--tw-text);
      border-color: var(--tw-border);
    }
    .btn-err-ghost:hover { background: var(--tw-border); color: var(--tw-text); }

    /* ── Footer ─────────────────────────────────────────── */
    .err-footer {
      padding: 1.25rem 2rem;
      text-align: center;
      font-size: .75rem;
      color: var(--tw-muted);
      border-top: 1px solid var(--tw-border);
    }
    .err-footer a { color: var(--tw-teal); text-decoration: none; }
    .err-footer a:hover { text-decoration: underline; }

    /* ── Divisor decorativo ─────────────────────────────── */
    .err-divider {
      width: 40px;
      height: 3px;
      background: var(--tw-teal);
      border-radius: 99px;
      margin: 0 auto 1.5rem;
      opacity: .4;
    }

    /* ── Toggle tema ────────────────────────────────────── */
    .theme-toggle {
      background: none;
      border: none;
      cursor: pointer;
      padding: .35rem;
      border-radius: 6px;
      color: var(--tw-muted);
      transition: color .18s, background .18s;
    }
    .theme-toggle:hover { background: var(--tw-border); color: var(--tw-text); }

    @media (max-width: 480px) {
      .err-header { padding: .85rem 1rem; }
      .err-main   { padding: 2rem 1rem; }
    }
  </style>

  <script>
  (function(){
    var t = null;
    try { t = localStorage.getItem('twTheme'); } catch(e){}
    if (!t) t = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', t);
  }());
  </script>
</head>
<body>

<header class="err-header">
  <a href="{{ path('app_dashboard') }}" class="err-brand">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" aria-label="ToolboxWaze logo">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7z"/>
      <circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none"/>
    </svg>
    ToolboxWaze
  </a>

  <button class="theme-toggle" id="themeToggle" aria-label="Alternar tema">
    <svg id="err-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
      <circle cx="12" cy="12" r="5"/>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
    <svg id="err-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
</header>

<main class="err-main">
  <div class="err-card">
    <div class="err-svg-wrap">
      {% block error_icon %}
      <svg viewBox="0 0 64 64" fill="none" class="err-svg" aria-hidden="true">
        <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2" opacity=".15"/>
        <path d="M32 20v14" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <circle cx="32" cy="42" r="3" fill="currentColor"/>
      </svg>
      {% endblock %}
    </div>

    <div class="err-code" aria-hidden="true">{% block error_code %}{% endblock %}</div>
    <div class="err-divider"></div>
    <h1 class="err-title">{% block error_title %}Erro{% endblock %}</h1>
    <p class="err-message">{% block error_message %}{% endblock %}</p>

    <div class="err-actions">
      {% block error_actions %}
        <a href="{{ path('app_dashboard') }}" class="btn-err btn-err-primary">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"/>
          </svg>
          Ir para o Dashboard
        </a>
      {% endblock %}
    </div>
  </div>
</main>

<footer class="err-footer">
  &copy; {{ 'now'|date('Y') }} ToolboxWaze &mdash;
  <a href="{{ path('app_dashboard') }}">Dashboard</a> &middot;
  <a href="{{ path('radar_index') }}">Radares</a> &middot;
  <a href="{{ path('posto_index') }}">Postos</a>
</footer>

<script>
(function(){
  var html = document.documentElement;
  var btn  = document.getElementById('themeToggle');
  var sun  = document.getElementById('err-sun');
  var moon = document.getElementById('err-moon');
  function apply(t){
    html.setAttribute('data-theme', t);
    try { localStorage.setItem('twTheme', t); } catch(e){}
    if (sun && moon) {
      sun.style.display  = t === 'dark' ? 'block' : 'none';
      moon.style.display = t === 'dark' ? 'none'  : 'block';
    }
  }
  var saved = null;
  try { saved = localStorage.getItem('twTheme'); } catch(e){}
  apply(saved || (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light'));
  if (btn) btn.addEventListener('click', function(){
    apply(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });
}());
</script>

</body>
</html>
