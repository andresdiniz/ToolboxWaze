{% extends 'bundles/TwigBundle/Exception/_error_layout.html.twig' %}

{% block error_code %}403{% endblock %}
{% block error_title %}Acesso negado{% endblock %}
{% block error_icon %}
<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="err-svg">
  <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2" opacity=".15"/>
  <rect x="18" y="28" width="28" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
  <path d="M23 28v-6a9 9 0 0 1 18 0v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <circle cx="32" cy="38" r="2.5" fill="currentColor"/>
  <path d="M32 40.5v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{% endblock %}
{% block error_message %}
  Você não tem permissão para acessar esta página.
  Se acredita que isso é um engano, entre em contato com o administrador.
{% endblock %}
{% block error_actions %}
  {% if app.user is null %}
    <a href="{{ path('app_login') }}" class="btn-err btn-err-primary">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664z"/>
      </svg>
      Fazer login
    </a>
  {% endif %}
  <a href="{{ path('app_dashboard') }}" class="btn-err btn-err-ghost">
    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"/>
    </svg>
    Ir para o Dashboard
  </a>
{% endblock %}
