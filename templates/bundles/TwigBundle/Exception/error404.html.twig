{% extends 'bundles/TwigBundle/Exception/_error_layout.html.twig' %}

{% block error_code %}404{% endblock %}
{% block error_title %}Página não encontrada{% endblock %}
{% block error_icon %}
<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="err-svg">
  <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2" opacity=".15"/>
  <circle cx="28" cy="28" r="11" stroke="currentColor" stroke-width="2"/>
  <path d="M37 37 L46 46" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M24 28h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".5"/>
  <path d="M28 24v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".5"/>
  <path d="M24 28h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".5" transform="rotate(45 28 28)"/>
  <path d="M28 24v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".5" transform="rotate(45 28 28)"/>
</svg>
{% endblock %}
{% block error_message %}
  A página que você procura não existe ou foi movida.
  Verifique o endereço ou use a busca para encontrar o que precisa.
{% endblock %}
{% block error_actions %}
  {% if app.user %}
  <form action="/busca" method="get" class="err-search-form" role="search">
    <input type="text" name="q" placeholder="Buscar radares, postos…"
           class="err-search-input" autocomplete="off" aria-label="Busca">
    <button type="submit" class="btn-err btn-err-primary" aria-label="Buscar">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zM6.5 12a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
      </svg>
      Buscar
    </button>
  </form>
  {% endif %}
  <a href="{{ path('app_dashboard') }}" class="btn-err btn-err-ghost">
    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"/>
    </svg>
    Ir para o Dashboard
  </a>
{% endblock %}
