<style>
    .coverage-page {
        --cov-bg: #ffffff;
        --cov-alt: #f4f7f9;
        --cov-line: #dce5e9;
        --cov-text: #20333e;
        --cov-muted: #586e7b;
        --cov-accent: #01696f;
        --cov-soft: #e5f4f4;
        --cov-good: #17643d;
        --cov-good-bg: #e1f4e9;
        --cov-warn: #805600;
        --cov-warn-bg: #fff1cb;
        --cov-bad: #aa2941;
        --cov-bad-bg: #ffe5eb;
    
        color: var(--cov-text);
        padding-top: 12px;
    }
    
    [data-theme="dark"] .coverage-page {
        --cov-bg: #17272e;
        --cov-alt: #112128;
        --cov-line: #334d58;
        --cov-text: #edf5f8;
        --cov-muted: #b0c3cc;
        --cov-accent: #83dce1;
        --cov-soft: #193c40;
        --cov-good: #9de6bb;
        --cov-good-bg: #1c3c2c;
        --cov-warn: #ffdb89;
        --cov-warn-bg: #43371e;
        --cov-bad: #ffb0bf;
        --cov-bad-bg: #472731;
    }
    
    .coverage-page .cov-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 20px;
    }
    
    .coverage-page .cov-eyebrow {
        margin: 0 0 7px;
        color: var(--cov-accent);
        font-size: .76rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .08em;
    }
    
    .coverage-page h1 {
        margin: 0 0 9px;
        color: var(--cov-text);
        font-size: clamp(1.55rem, 3vw, 2rem);
        font-weight: 750;
        line-height: 1.25;
    }
    
    .coverage-page .cov-description {
        max-width: 720px;
        margin: 0;
        color: var(--cov-muted);
        font-size: .94rem;
        line-height: 1.7;
    }
    
    .coverage-page .cov-nav,
    .coverage-page .cov-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    
    .coverage-page .cov-nav {
        padding: 6px;
        margin-bottom: 24px;
        border: 1px solid var(--cov-line);
        border-radius: 12px;
        background: var(--cov-alt);
        width: fit-content;
        max-width: 100%;
    }
    
    .coverage-page .cov-nav a,
    .coverage-page .cov-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 9px 15px;
        border: 1px solid var(--cov-line);
        border-radius: 8px;
        background: var(--cov-bg);
        color: var(--cov-text);
        font-size: .85rem;
        font-weight: 650;
        line-height: 1.4;
        text-decoration: none;
    }
    
    .coverage-page .cov-nav a {
        border-color: transparent;
        background: transparent;
    }
    
    .coverage-page .cov-nav a[aria-current="page"],
    .coverage-page .cov-button:hover,
    .coverage-page .cov-nav a:hover {
        border-color: var(--cov-line);
        background: var(--cov-bg);
        color: var(--cov-accent);
    }
    
    .coverage-page a:focus-visible {
        outline: 3px solid var(--cov-accent);
        outline-offset: 3px;
    }
    
    .coverage-page .cov-notice {
        margin-bottom: 20px;
        padding: 14px 16px;
        border: 1px solid var(--cov-line);
        border-left: 4px solid var(--cov-accent);
        border-radius: 10px;
        background: var(--cov-soft);
        color: var(--cov-text);
        font-size: .86rem;
        line-height: 1.7;
    }
    
    .coverage-page .cov-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }
    
    .coverage-page .cov-kpi {
        min-width: 0;
        padding: 21px;
        border: 1px solid var(--cov-line);
        border-radius: 14px;
        background: var(--cov-bg);
    }
    
    .coverage-page .cov-kpi-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: var(--cov-muted);
        font-size: .82rem;
        font-weight: 600;
    }
    
    .coverage-page .cov-kpi-value {
        color: var(--cov-text);
        font-size: clamp(1.6rem, 2.8vw, 2.1rem);
        font-weight: 750;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }
    
    .coverage-page .cov-kpi-note {
        margin: 10px 0 0;
        color: var(--cov-muted);
        font-size: .75rem;
        line-height: 1.5;
    }
    
    .coverage-page .cov-section {
        margin-bottom: 24px;
        border: 1px solid var(--cov-line);
        border-radius: 14px;
        background: var(--cov-bg);
    }
    
    .coverage-page .cov-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 20px;
        border-bottom: 1px solid var(--cov-line);
    }
    
    .coverage-page .cov-section-header h2 {
        margin: 0 0 5px;
        color: var(--cov-text);
        font-size: 1.04rem;
        font-weight: 700;
    }
    
    .coverage-page .cov-section-header p {
        margin: 0;
        color: var(--cov-muted);
        font-size: .82rem;
        line-height: 1.6;
    }
    
    .coverage-page .cov-count {
        padding: 5px 9px;
        border-radius: 7px;
        background: var(--cov-alt);
        color: var(--cov-muted);
        font-size: .77rem;
        white-space: nowrap;
    }
    
    .coverage-page .cov-table-wrap {
        overflow-x: auto;
        border-radius: 0 0 14px 14px;
    }
    
    .coverage-page .cov-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        color: var(--cov-text);
        font-size: .87rem;
    }
    
    .coverage-page .cov-table th,
    .coverage-page .cov-table td {
        padding: 15px 20px;
        border-bottom: 1px solid var(--cov-line);
        text-align: left;
        vertical-align: middle;
    }
    
    .coverage-page .cov-table th {
        background: var(--cov-alt);
        color: var(--cov-muted);
        font-size: .74rem;
        font-weight: 700;
        white-space: nowrap;
    }
    
    .coverage-page .cov-table tbody tr:last-child td {
        border-bottom: 0;
    }
    
    .coverage-page .cov-table tbody tr:hover {
        background: var(--cov-alt);
    }
    
    .coverage-page .cov-table .cov-number {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    
    .coverage-page .cov-table a:not(.cov-button) {
        color: var(--cov-accent);
        text-underline-offset: 3px;
    }
    
    .coverage-page .cov-uf {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        padding: 5px 8px;
        border-radius: 7px;
        background: var(--cov-soft);
        color: var(--cov-accent);
        font-size: .78rem;
        font-weight: 750;
    }
    
    .coverage-page .cov-progress {
        width: 100%;
        height: 8px;
        overflow: hidden;
        border-radius: 999px;
        background: var(--cov-line);
    }
    
    .coverage-page .cov-progress > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: var(--cov-accent);
    }
    
    .coverage-page .cov-progress-cell {
        min-width: 190px;
    }
    
    .coverage-page .cov-progress-meta {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 7px;
        font-size: .75rem;
    }
    
    .coverage-page .cov-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: .73rem;
        font-weight: 650;
    }
    
    .coverage-page .cov-good {
        color: var(--cov-good);
    }
    
    .coverage-page .cov-bad {
        color: var(--cov-bad);
    }
    
    .coverage-page .cov-status.good {
        background: var(--cov-good-bg);
        color: var(--cov-good);
    }
    
    .coverage-page .cov-status.partial {
        background: var(--cov-warn-bg);
        color: var(--cov-warn);
    }
    
    .coverage-page .cov-status.critical {
        background: var(--cov-bad-bg);
        color: var(--cov-bad);
    }
    
    .coverage-page .cov-progress.good > span {
        background: #29965e;
    }
    
    .coverage-page .cov-progress.partial > span {
        background: #c38c16;
    }
    
    .coverage-page .cov-progress.critical > span {
        background: #d4546a;
    }
    
    .coverage-page .cov-empty {
        padding: 38px 20px;
        color: var(--cov-muted);
        text-align: center;
        line-height: 1.7;
    }
    
    .coverage-page .cov-empty i {
        display: block;
        margin-bottom: 12px;
        color: var(--cov-accent);
        font-size: 2rem;
    }
    
    .coverage-page .cov-empty p {
        margin: 0;
    }
    
    .coverage-page .cov-secondary {
        display: block;
        margin-top: 4px;
        color: var(--cov-muted);
        font-size: .77rem;
        line-height: 1.5;
    }
    
    .coverage-page .cov-address {
        min-width: 200px;
        max-width: 420px;
        overflow-wrap: anywhere;
    }
    
    .coverage-page .cov-footer {
        padding: 14px 20px;
        border-top: 1px solid var(--cov-line);
        color: var(--cov-muted);
        font-size: .77rem;
        line-height: 1.7;
    }
    
    @media (max-width: 900px) {
        .coverage-page .cov-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    
    @media (max-width: 576px) {
        .coverage-page {
            padding-top: 4px;
        }
    
        .coverage-page .cov-header,
        .coverage-page .cov-nav {
            width: 100%;
        }
    
        .coverage-page .cov-nav a {
            flex: 1;
        }
    
        .coverage-page .cov-kpis {
            gap: 10px;
        }
    
        .coverage-page .cov-kpi {
            padding: 15px;
        }
    
        .coverage-page .cov-kpi-label {
            align-items: flex-start;
            font-size: .76rem;
        }
    
        .coverage-page .cov-section-header {
            padding: 16px;
        }
    
        .coverage-page .cov-table th,
        .coverage-page .cov-table td {
            padding: 13px 15px;
        }
    }
    </style>