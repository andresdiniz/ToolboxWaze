{% extends 'cobertura/rankings.html.twig' %}
{% block title %}Cobertura, produção e atividade da API{% endblock %}
{% block stylesheets %}{{ parent() }}<style>.cv-journal{margin-bottom:2rem}.cv-journal h1{font-size:1.65rem}.cv-journal .cv-fields{display:flex;flex-wrap:wrap;gap:.75rem;align-items:end}.cv-journal label{display:block;font-size:.8rem}.cv-journal .cv-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin:1rem 0}.cv-journal .cv-card{border:1px solid var(--color-border,#ccc);border-radius:12px;padding:1rem;background:var(--color-surface,#fff)}.cv-journal .cv-number{font-size:1.7rem;font-weight:700}.cv-journal .cv-table{width:100%;border-collapse:collapse}.cv-journal th,.cv-journal td{padding:.7rem;border-bottom:1px solid var(--color-border,#ccc);vertical-align:top}.cv-journal .cv-scroll{overflow:auto}.cv-journal details{max-width:300px;overflow-wrap:anywhere}.cv-journal .cv-note{font-size:.85rem;color:var(--color-text-muted,#657580)}@media(max-width:700px){.cv-journal .cv-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cv-journal input,.cv-journal select{max-width:100%}}</style>{% endblock %}
{% block body %}
<section class="cv-journal" aria-labelledby="cv-title"><h1 id="cv-title">🏆 Cobertura e produção dos editores</h1><p>Separe a situação atual da base das contribuições com data e autoria registradas.</p><nav class="d-flex gap-3 flex-wrap mb-3" aria-label="Seções do painel"><a href="#cv-production">Produção por período</a><a href="#cv-events">Atividade da API e interface</a><a href="#cv-snapshot">Cobertura e ranking acumulado</a></nav>
<div class="alert alert-info small">O diário registra novas operações instrumentadas após a migração. Não reconstrói autores ou datas desconhecidos. Os dados antigos continuam no ranking acumulado abaixo. Datas deste diário em UTC; página gerada em {{ agora }} UTC.</div>
{% if not atividade.disponivel %}<div class="alert alert-warning" role="alert">Diário ainda não instalado. Execute apenas a migração Version20261103112100 conforme a documentação; a cobertura acumulada continua disponível.</div>{% else %}
<form method="get" action="{{ path('cobertura_rankings') }}" class="cv-fields"><div><label for="cv-tipo">Tipo</label><select id="cv-tipo" name="tipo" class="form-select form-select-sm"><option value="">Todos autorizados</option>{% for key,label in tipos %}<option value="{{ key }}" {{ filters.tipo==key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><div><label for="cv-uf">Estado</label><select id="cv-uf" name="uf" class="form-select form-select-sm"><option value="">Todas as UFs autorizadas</option>{% for uf in ufs %}<option value="{{ uf }}" {{ filters.uf==uf ? 'selected' : '' }}>{{ uf }}</option>{% endfor %}</select></div>
{% for key,label in {desde:'Início UTC',ate:'Fim UTC',editor:'Editor ou username declarado'} %}<div><label for="cv-{{ key }}">{{ label }}</label><input id="cv-{{ key }}" class="form-control form-control-sm" name="{{ key }}" type="{{ key=='editor' ? 'search' : 'date' }}" value="{{ eventFilters[key] }}" {% if key!='editor' %}required{% endif %}></div>{% endfor %}
{% set actions={cadastro_vinculo:'Cadastro de vínculo',manutencao_vinculo:'Manutenção de vínculo',remocao_vinculo:'Remoção de vínculo',confirmacao:'Confirmação informada',nao_localizado:'Não localizado',pulado:'Pulado',cadastro_manual:'Cadastro manual'} %}
<div><label for="cv-action">Ação</label><select id="cv-action" name="acao" class="form-select form-select-sm"><option value="">Todas</option>{% for key,label in actions %}<option value="{{ key }}" {{ eventFilters.acao==key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><div><label for="cv-origin">Origem</label><select id="cv-origin" name="origem" class="form-select form-select-sm"><option value="">Todas</option>{% for key,label in {api:'API autenticada',web:'Interface',historico:'Registro fora de requisição web'} %}<option value="{{ key }}" {{ eventFilters.origem==key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><input type="hidden" name="ordem" value="{{ filters.ordem }}"><button class="btn btn-primary btn-sm">Aplicar ao diário</button></form>
<div class="cv-grid">{% for label,value in {'Eventos registrados':atividade.resumo.eventos,'Locais distintos':atividade.resumo.locais,'Contas identificadas':atividade.resumo.editores,'Eventos via API':atividade.resumo.api} %}<article class="cv-card"><div>{{ label }}</div><div class="cv-number">{{ value|number_format(0,',','.') }}</div></article>{% endfor %}</div>
<h2 id="cv-production" class="h5">Produção por período · contas autenticadas</h2><p class="cv-note">Até 100 contas ordenadas por locais distintos. Eventos não são pontos: várias ações no mesmo local não multiplicam o total de locais. As colunas podem se sobrepor. Inclui remoções e revisões quando selecionadas; não mede qualidade automaticamente.</p>
<div class="cv-scroll"><table class="cv-table"><caption class="visually-hidden">Contas e contribuições no período</caption><thead><tr>{% for label in ['Posição','Conta / nickname','Locais','Cadastros de vínculo','Manutenções','Confirmações','Eventos','Via API'] %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in atividade.editores %}<tr><td>{{ loop.index }}</td><td>{{ row.editor }}<div class="cv-note">Conta #{{ row.actor_id }}</div></td><td>{{ row.locais }}</td><td>{{ row.cadastros }}</td><td>{{ row.manutencoes }}</td><td>{{ row.confirmacoes }}</td><td>{{ row.eventos }}</td><td>{{ row.api }}</td></tr>{% else %}<tr><td colspan="8">Sem eventos identificados neste período. Isso não significa ausência de trabalho histórico.</td></tr>{% endfor %}</tbody></table></div>
<h2 id="cv-events" class="h5 mt-4">Atividade da API e da interface</h2><p class="cv-note">A conta autenticada é distinta do username declarado pelo cliente. Verificação externa no Waze não é presumida.</p>
{% set routes={radares:'radar_show',postos:'posto_show',escolas:'escola_inep_show',saude:'saude_show'} %}
<div class="cv-scroll"><table class="cv-table"><caption class="visually-hidden">Diário de contribuições</caption><thead><tr>{% for label in ['Quando UTC','Local / UF','Ação','Conta autenticada','Username declarado','Origem','Detalhes'] %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in atividade.eventos %}<tr><td>{{ row.ocorrido_em }}</td><td>{% if routes[row.tipo] is defined %}<a href="{{ path(routes[row.tipo],{id:row.local_id}) }}">{{ tipos[row.tipo] }} #{{ row.local_id }}</a>{% else %}{{ tipos[row.tipo] ?? row.tipo }} #{{ row.local_id }}{% endif %}<div>{{ row.uf }}</div></td><td>{{ actions[row.acao] ?? row.acao }}</td><td>{{ row.editor }}</td><td>{{ row.username_declarado ?: 'Não informado' }}</td><td>{{ row.origem }}</td><td><details><summary>Ver alteração</summary><div>Campo: {{ row.campo }}</div><div>Antes: {{ row.valor_anterior ?: 'Vazio' }}</div><div>Depois: {{ row.valor_novo ?: 'Vazio' }}</div><div>Referência: {{ row.referencia }}</div><div>Request ID: {{ row.request_id ?: 'Não disponível' }}</div></details></td></tr>{% else %}<tr><td colspan="7">Nenhum evento para os filtros selecionados.</td></tr>{% endfor %}</tbody></table></div>
{% if atividade.paginas>1 %}<nav class="mt-3" aria-label="Paginação do diário">{% if atividade.pagina>1 %}<a class="btn btn-outline-secondary btn-sm" href="{{ path('cobertura_rankings',filters|merge(eventFilters)|merge({epage:atividade.pagina-1})) }}#cv-events">Anterior</a>{% endif %} Página {{ atividade.pagina }} de {{ atividade.paginas }} {% if atividade.pagina<atividade.paginas %}<a class="btn btn-outline-secondary btn-sm" href="{{ path('cobertura_rankings',filters|merge(eventFilters)|merge({epage:atividade.pagina+1})) }}#cv-events">Próxima</a>{% endif %}</nav>{% endif %}
{% endif %}</section>
<section id="cv-snapshot"><h2 class="h4">Situação atual da base · visão acumulada</h2><p class="small text-muted">Os filtros de data e origem acima se aplicam somente ao diário. O ranking abaixo preserva a leitura histórica disponível e suas regras anteriores.</p>{{ parent() }}</section>
{% endblock %}
