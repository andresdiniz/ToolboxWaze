{% extends 'base.html.twig' %}

{% block title %}Cobertura Waze — Postos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'cobertura/_estilos.html.twig' %}
{% endblock %}

{% block body %}
    {% set total = 0 %}
    {% set comWaze = 0 %}
    {% set semWaze = 0 %}

    {% for r in porUf %}
        {% set total = total + (r.total|default(0)) %}
        {% set comWaze = comWaze + (r.com_waze|default(0)) %}
        {% set semWaze = semWaze + (r.sem_waze|default(0)) %}
    {% endfor %}

    {% set percentual = total > 0 ? comWaze / total * 100 : 0 %}

    <div class="coverage-page">
        <header class="cov-header">
            <div>
                <p class="cov-eyebrow">Qualidade da base</p>

                <h1>
                    <i class="bi bi-fuel-pump" aria-hidden="true"></i>
                    Cobertura de postos
                </h1>

                <p class="cov-description">
                    Acompanhe os postos com vínculo Waze cadastrado
                    e identifique os estados com mais registros pendentes.
                </p>
            </div>

            <div class="cov-actions">
                <a href="{{ path('posto_index') }}" class="cov-button">
                    <i class="bi bi-list-ul" aria-hidden="true"></i>
                    Lista de postos
                </a>
            </div>
        </header>

        <nav class="cov-nav" aria-label="Tipo de cobertura">
            <a href="{{ path('cobertura_radar') }}">
                <i class="bi bi-broadcast" aria-hidden="true"></i>
                Radares
            </a>

            <a
                href="{{ path('cobertura_posto') }}"
                aria-current="page"
            >
                <i class="bi bi-fuel-pump" aria-hidden="true"></i>
                Postos
            </a>
        </nav>

        {% if allowedUfs is defined and allowedUfs is not null %}
            <div class="cov-notice">
                {% if allowedUfs is empty %}
                    Nenhuma UF disponível no seu escopo de acesso.
                {% else %}
                    Dados limitados às suas UFs:
                    <strong>{{ allowedUfs|join(', ') }}</strong>.
                {% endif %}
            </div>
        {% endif %}

        <section class="cov-kpis" aria-label="Indicadores de postos">
            <article class="cov-kpi">
                <div class="cov-kpi-label">
                    <i class="bi bi-fuel-pump" aria-hidden="true"></i>
                    Total de postos
                </div>

                <div class="cov-kpi-value">
                    {{ total|number_format(0, ',', '.') }}
                </div>

                <p class="cov-kpi-note">No escopo exibido</p>
            </article>

            <article class="cov-kpi">
                <div class="cov-kpi-label">
                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    Com vínculo Waze
                </div>

                <div class="cov-kpi-value">
                    {{ comWaze|number_format(0, ',', '.') }}
                </div>

                <p class="cov-kpi-note">Vínculo informado na base</p>
            </article>

            <article class="cov-kpi">
                <div class="cov-kpi-label">
                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    Sem vínculo Waze
                </div>

                <div class="cov-kpi-value">
                    {{ semWaze|number_format(0, ',', '.') }}
                </div>

                <p class="cov-kpi-note">Registros a revisar</p>
            </article>

            <article class="cov-kpi">
                <div class="cov-kpi-label">
                    <i class="bi bi-pie-chart" aria-hidden="true"></i>
                    Cobertura cadastrada
                </div>

                <div class="cov-kpi-value">
                    {{ percentual|number_format(1, ',', '.') }}%
                </div>

                <p class="cov-kpi-note">
                    Com vínculo / total
                </p>
            </article>
        </section>

        {% include 'cobertura/_tabela_ufs.html.twig' with {
            porUf: porUf,
            rotaLista: 'posto_index'
        } only %}
    </div>
{% endblock %}