{% extends 'base.html.twig' %}
{% block title %}Cobertura Waze — Radares{% endblock %}
{% block stylesheets %}{{ parent() }}{% include 'cobertura/_estilos.html.twig' %}{% endblock %}
{% block body %}
{% set total = 0 %}{% set comWaze = 0 %}{% set semVinculo = 0 %}
{% for r in porUf %}{% set total = total + r.total|default(0) %}{% set comWaze = comWaze + r.com_waze|default(0) %}{% set semVinculo = semVinculo + r.sem_waze|default(0) %}{% endfor %}
{% set percentual = total > 0 ? comWaze / total * 100 : 0 %}
<div class="coverage-page"><header class="cov-header"><div><p class="cov-eyebrow">Qualidade da base</p><h1><i class="bi bi-broadcast" aria-hidden="true"></i> Cobertura de radares</h1><p class="cov-description">Cobertura de vínculos por estado e fila prioritária de revisão.</p></div><div class="cov-actions"><a href="{{ path('cobertura_rankings') }}" class="cov-button">🏆 Rankings de todos os locais</a><a href="{{ path('radar_index') }}" class="cov-button">Lista de radares</a></div></header>
<nav class="cov-nav" aria-label="Tipo de cobertura"><a href="{{ path('cobertura_rankings') }}">Rankings por estado e editor</a><a href="{{ path('cobertura_radar') }}" aria-current="page">Radares</a>{% if app.user.hasPermission('PERM_POSTOS') %}<a href="{{ path('cobertura_posto') }}">Postos</a>{% endif %}</nav>
{% if allowedUfs is defined and allowedUfs is not null %}<div class="cov-notice">{% if allowedUfs is empty %}Nenhuma UF disponível no seu escopo de acesso.{% else %}Dados limitados às suas UFs: <strong>{{ allowedUfs|join(', ') }}</strong>.{% endif %}</div>{% endif %}
<section class="cov-kpis" aria-label="Indicadores de radares">{% for label,value in {'Total de radares':total,'Com vínculo Waze':comWaze,'Sem vínculo Waze':semVinculo} %}<article class="cov-kpi"><div class="cov-kpi-label">{{ label }}</div><div class="cov-kpi-value">{{ value|number_format(0,',','.') }}</div><p class="cov-kpi-note">No escopo exibido</p></article>{% endfor %}<article class="cov-kpi"><div class="cov-kpi-label">Cobertura cadastrada</div><div class="cov-kpi-value">{{ percentual|number_format(1,',','.') }}%</div><p class="cov-kpi-note">Com vínculo / total; não substitui verificação</p></article></section>
{% include 'cobertura/_tabela_ufs.html.twig' with {porUf:porUf,rotaLista:'radar_index'} only %}
<section class="cov-section"><header class="cov-section-header"><div><h2>Fila prioritária de revisão</h2><p>Radares retornados pelo filtro de aprovação e ainda sem vínculo Waze.</p></div><span class="cov-count">{{ semWaze|length }} registro(s) nesta lista</span></header><div class="cov-table-wrap"><table class="cov-table"><caption class="visually-hidden">Radares prioritários sem vínculo Waze</caption><thead><tr><th scope="col">Radar / UF</th><th scope="col">Localização</th><th scope="col">Validade informada</th><th scope="col">Ação</th></tr></thead><tbody>{% for r in semWaze %}<tr><td><span class="cov-uf">{{ r.sigla_uf|default('—') }}</span> <span class="cov-secondary">#{{ r.id }}</span></td><td class="cov-address">{{ r.municipio|default('Não informado',true) }}<span class="cov-secondary">{{ r.logradouro|default('Logradouro não informado',true) }}</span></td><td>{{ r.data_validade|default('—',true) }}</td><td><a href="{{ path('radar_show',{id:r.id}) }}" class="cov-button" aria-label="Revisar radar {{ r.id }}">Revisar</a></td></tr>{% else %}<tr><td colspan="4"><div class="cov-empty"><p>Nenhum radar retornado pela fila prioritária no seu escopo.</p><span class="cov-secondary">Isso não substitui a revisão da listagem completa.</span></div></td></tr>{% endfor %}</tbody></table></div><footer class="cov-footer">A quantidade exibida pode estar limitada pelo controller. Esta fila não representa necessariamente todos os registros sem vínculo.</footer></section></div>
{% endblock %}
