<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Consulta pública | Waze Toolbox{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Consulte dados públicos de radares, escolas e postos por estado e município.{% endblock %}">
    <meta name="robots" content="index,follow">
    <meta name="theme-color" content="#101828">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/consulta_publica.css') }}">
    {% block head_extra %}{% endblock %}
</head>
<body>
    <div class="public-site">
        {% block public_content %}{% endblock %}
    </div>
    <footer class="public-footer">
        <div class="public-footer__inner"><div><span class="public-footer__brand">Waze Toolbox</span><p>Consulta pública de informações oficiais.</p></div><a href="#public-top">Voltar ao topo ↑</a></div>
        <div class="public-footer__bottom">Use os dados como referência e consulte sempre a fonte oficial.</div>
    </footer>
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</body>
</html>
