<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Consulta pública | Dados oficiais{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Consulte informações públicas por estado e município.{% endblock %}">
    <meta name="robots" content="index,follow">
    <meta name="theme-color" content="#172554">
    <link rel="canonical" href="{{ app.request.uri }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/consulta-publica.css') }}">
    {% block head_extra %}{% endblock %}
</head>
<body>
    <main id="main-content" class="public-shell">
        {% block public_content %}{% endblock %}
    </main>

    <footer class="public-footer">
        <div class="public-footer__inner">
            <div>
                <strong>Consulta pública</strong>
                <p>Informação para pesquisa e transparência.</p>
            </div>
            <nav aria-label="Links institucionais">
                <a href="#main-content">Voltar ao topo</a>
            </nav>
        </div>
        <div class="public-footer__bottom">Fonte dos dados: órgãos e bases oficiais indicados na consulta.</div>
    </footer>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</body>
</html>
