{% extends 'consulta_publica/base.html.twig' %}

{% block public_content %}
<div id="public-top" class="public-page" data-controller="consulta-publica" data-search-base-url="{{ path('consulta_publica_search', {tipo: 'radar'})|replace({'/radar':''}) }}" data-municipios-url="{{ path('consulta_publica_municipios') }}">
    <header class="public-hero"><div class="public-hero__grid"><div class="public-hero__copy"><span class="public-kicker">WAZE TOOLBOX · DADOS ABERTOS</span><h1>Consulte. Confira. <em>Decida melhor.</em></h1><p>Pesquise informações públicas de radares, escolas e postos em uma interface simples, rápida e transparente.</p><div class="public-hero__meta"><span>Busca por município</span><span>Dados oficiais</span><span>Acesso livre</span></div></div><div class="public-hero__visual" aria-hidden="true"><div class="public-orbit public-orbit--one"></div><div class="public-orbit public-orbit--two"></div><div class="public-hero__chip">CONSULTA<br><strong>PÚBLICA</strong></div></div></div></header>
    <section class="public-search-card" aria-labelledby="search-title"><div class="public-section-heading"><div><span class="public-kicker public-kicker--dark">PESQUISA</span><h2 id="search-title">Encontre um registro</h2></div><p data-consulta-publica-helper>Selecione uma categoria e um estado para carregar os municípios.</p></div><div class="public-type-tabs" role="tablist" aria-label="Tipo de registro">{% for type in types|default([]) %}<button type="button" role="tab" class="public-type-tab{% if loop.first %} is-active{% endif %}" data-consulta-publica-target="type" data-action="click->consulta-publica#selectType" data-type="{{ type.key|default('radar')|e('html_attr') }}" aria-selected="{{ loop.first ? 'true':'false' }}">{{ type.label|default(type.key|default('Categoria')) }}</button>{% endfor %}</div><form class="public-search-form" data-action="submit->consulta-publica#search"><label>Estado<select data-consulta-publica-target="state" data-action="change->consulta-publica#stateChanged" required><option value="">Selecione o estado</option>{% for state in states|default([]) %}<option value="{{ state.uf|default('')|e('html_attr') }}">{{ state.name|default(state.uf|default('')) }}</option>{% endfor %}</select></label><label class="public-search-form__city">Município<select data-consulta-publica-target="city" data-action="change->consulta-publica#cityChanged" disabled required><option>Escolha primeiro o estado</option></select></label><label>Busca opcional<input type="search" data-consulta-publica-target="query" placeholder="Endereço, nome ou código"></label><button class="public-button" type="submit">Consultar <span>→</span></button></form></section>
    <section class="public-results" data-consulta-publica-target="results" hidden aria-live="polite"><div class="public-results__bar"><div><span class="public-kicker public-kicker--dark">RESULTADOS</span><h2 data-consulta-publica-target="resultTitle">Resultados</h2></div><button class="public-button public-button--soft" type="button" data-share-results>Compartilhar</button></div><div class="public-list" data-consulta-publica-target="list"></div><nav class="public-pagination" data-consulta-publica-target="pagination" aria-label="Paginação"></nav><p class="public-source" data-consulta-publica-target="source"></p></section>
</div>
{% endblock %}
