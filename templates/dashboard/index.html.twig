{% extends 'base.html.twig' %}

{% block title %}Dashboard — ToolboxWaze{% endblock %}

{% block body %}
<div class="page-header reveal">
    <h1>
        <span class="page-header-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-6"/>
            </svg>
        </span>
        Dashboard
    </h1>
    <a href="{{ path('export_postos_csv') }}" class="btn btn-outline-success btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:.3rem;vertical-align:-.15em">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7,10 12,15 17,10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Exportar CSV
    </a>
</div>

{# ── KPIs ── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card reveal reveal-delay-1">
            <div class="kpi-label">
                <span class="kpi-icon" style="background:rgba(1,105,111,.12)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--tw)" stroke-width="2.5"><path d="M3 3h18v18H3z"/></svg>
                </span>
                Total de Postos
            </div>
            <div class="kpi-value"><span class="count-up">{{ kpis.total }}</span></div>
            <div class="kpi-subtext">cadastros ativos</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card reveal reveal-delay-2">
            <div class="kpi-label">
                <span class="kpi-icon" style="background:rgba(16,185,129,.12)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                </span>
                Com Link Waze
            </div>
            <div class="kpi-value" style="color: var(--status-resolvida-text)"><span class="count-up">{{ kpis.comWaze }}</span></div>
            <div class="progress mt-2" style="height:5px">
                <div class="progress-bar" style="background:var(--status-resolvida-dot);width:{{ kpis.pct }}%"></div>
            </div>
            <div class="kpi-subtext">{{ kpis.pct }}% cobertos</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card reveal reveal-delay-3">
            <div class="kpi-label">
                <span class="kpi-icon" style="background:rgba(245,158,11,.12)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </span>
                Sem Link Waze
            </div>
            <div class="kpi-value" style="color: var(--status-pendente-text)"><span class="count-up">{{ kpis.semWaze }}</span></div>
            <a href="{{ path('posto_index', {sem_waze: 1}) }}" class="btn btn-sm btn-outline-warning mt-2" style="font-size:.75rem;padding:.25rem .65rem">
                Ver postos →
            </a>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card reveal reveal-delay-4">
            <div class="kpi-label">
                <span class="kpi-icon" style="background:rgba(1,105,111,.12)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--tw)" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                Cadastrados este mês
            </div>
            <div class="kpi-value"><span class="count-up">{{ kpis.mesAtual }}</span></div>
            <span class="kpi-trend up">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18,15 12,9 6,15"/></svg>
                mês atual
            </span>
        </div>
    </div>
</div>

{# ── Tabela por UF + Gráfico ── #}
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 reveal">
            <div class="card-header d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 6l4 1 4-5 4 4 3-2"/><path d="M3 18h18"/>
                </svg>
                Cobertura por UF
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>UF</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Com Waze</th>
                            <th class="text-end">Sem Waze</th>
                            <th style="min-width:130px">Cobertura</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for row in kpis.porUf %}
                        <tr>
                            <td><span class="badge badge-uf">{{ row.uf }}</span></td>
                            <td class="text-end" style="font-variant-numeric:tabular-nums">{{ row.total|number_format(0,',','.') }}</td>
                            <td class="text-end" style="color:var(--status-resolvida-text);font-variant-numeric:tabular-nums">{{ row.com_waze|number_format(0,',','.') }}</td>
                            <td class="text-end" style="color:var(--status-pendente-text);font-variant-numeric:tabular-nums">{{ row.sem_waze|number_format(0,',','.') }}</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:7px">
                                        <div class="progress-bar
                                            {% if row.pct >= 80 %}bg-success
                                            {% elseif row.pct >= 40 %}bg-warning
                                            {% else %}bg-danger{% endif %}"
                                             style="width:{{ row.pct }}%"></div>
                                    </div>
                                    <span style="font-size:.75rem;min-width:38px;color:var(--color-text-muted)">{{ row.pct }}%</span>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center py-4" style="color:var(--color-text-faint)">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto .5rem;display:block;opacity:.4"><circle cx="12" cy="12" r="10"/><path d="M8 15s1.5-2 4-2 4 2 4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                            Sem dados.
                        </td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 h-100 reveal reveal-delay-1">
            <div class="card-header d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/>
                </svg>
                Atividade — últimos 30 dias
            </div>
            <div class="card-body d-flex align-items-center p-3">
                <canvas id="chartAtividade" style="width:100%;max-height:260px"></canvas>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function(){
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    var gridColor = isDark ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.06)';
    var labelColor = isDark ? '#7a9a9d' : '#6c757d';
    var barColor = isDark ? 'rgba(79,152,163,0.80)' : 'rgba(1,105,111,0.75)';

    const labels = {{ atividade|map(r => r.dia)|json_encode|raw }};
    const data   = {{ atividade|map(r => r.cadastros)|json_encode|raw }};
    new Chart(document.getElementById('chartAtividade'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Links cadastrados',
                data,
                backgroundColor: barColor,
                borderRadius: 5,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            animation: { duration: 900, easing: 'easeOutQuart' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: isDark ? '#182224' : '#fff',
                    titleColor: isDark ? '#d4e0e1' : '#1e2a2b',
                    bodyColor: isDark ? '#7a9a9d' : '#6c757d',
                    borderColor: isDark ? 'rgba(255,255,255,.10)' : 'rgba(0,0,0,.10)',
                    borderWidth: 1,
                    padding: 10,
                    cornerRadius: 8,
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: labelColor, font: { size: 11 }, maxTicksLimit: 8 }
                },
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1, color: labelColor, font: { size: 11 } },
                    grid: { color: gridColor }
                }
            }
        }
    });
}());
</script>
{% endblock %}
