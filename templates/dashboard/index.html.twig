{% extends 'base.html.twig' %}

{% block title %}Dashboard — ToolboxWaze{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h1>
    <a href="{{ path('export_postos_csv') }}" class="btn btn-outline-success btn-sm">
        <i class="bi bi-download me-1"></i>Exportar CSV
    </a>
</div>

{# ── KPIs ── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-fuel-pump me-1"></i>Total de Postos</div>
                <div class="fs-3 fw-bold">{{ kpis.total|number_format(0, ',', '.') }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-waze me-1 text-success"></i>Com Link Waze</div>
                <div class="fs-3 fw-bold text-success">{{ kpis.comWaze|number_format(0, ',', '.') }}</div>
                <div class="progress mt-2" style="height:6px">
                    <div class="progress-bar bg-success" style="width:{{ kpis.pct }}%"></div>
                </div>
                <div class="text-muted" style="font-size:.75rem">{{ kpis.pct }}% cobertos</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-exclamation-circle me-1 text-warning"></i>Sem Link Waze</div>
                <div class="fs-3 fw-bold text-warning">{{ kpis.semWaze|number_format(0, ',', '.') }}</div>
                <a href="{{ path('posto_index', {sem_waze: 1}) }}" class="btn btn-sm btn-outline-warning mt-2">
                    <i class="bi bi-search me-1"></i>Ver postos
                </a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="bi bi-calendar-check me-1 text-primary"></i>Cadastrados este mês</div>
                <div class="fs-3 fw-bold text-primary">{{ kpis.mesAtual }}</div>
            </div>
        </div>
    </div>
</div>

{# ── Tabela por UF + Gráfico ── #}
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-semibold"><i class="bi bi-map me-2"></i>Cobertura por UF</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>UF</th>
                            <th class="text-end">Total</th>
                            <th class="text-end text-success">Com Waze</th>
                            <th class="text-end text-warning">Sem Waze</th>
                            <th style="min-width:130px">Cobertura</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for row in kpis.porUf %}
                        <tr>
                            <td><span class="badge badge-uf">{{ row.uf }}</span></td>
                            <td class="text-end">{{ row.total|number_format(0,',','.') }}</td>
                            <td class="text-end text-success">{{ row.com_waze|number_format(0,',','.') }}</td>
                            <td class="text-end text-warning">{{ row.sem_waze|number_format(0,',','.') }}</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px">
                                        <div class="progress-bar
                                            {% if row.pct >= 80 %}bg-success
                                            {% elseif row.pct >= 40 %}bg-warning
                                            {% else %}bg-danger{% endif %}"
                                             style="width:{{ row.pct }}%"></div>
                                    </div>
                                    <span class="text-muted" style="font-size:.75rem;min-width:38px">{{ row.pct }}%</span>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-3">Sem dados.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-graph-up me-2"></i>Atividade — últimos 30 dias</div>
            <div class="card-body d-flex align-items-center">
                <canvas id="chartAtividade" style="width:100%;max-height:260px"></canvas>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function(){
    const labels = {{ atividade|map(r => r.dia)|json_encode|raw }};
    const data   = {{ atividade|map(r => r.cadastros)|json_encode|raw }};
    new Chart(document.getElementById('chartAtividade'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Links cadastrados',
                data,
                backgroundColor: 'rgba(1,105,111,0.75)',
                borderRadius: 4,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
})();
</script>
{% endblock %}
