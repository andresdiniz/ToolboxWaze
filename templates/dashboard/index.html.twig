{% extends 'base.html.twig' %}
{% block title %}Dashboard — ToolboxWaze{% endblock %}

{% block body %}
<div class="container-fluid py-4">

  {# ═══════════════════════════════════════════════════════════════
     KPIs RADARES
  ═══════════════════════════════════════════════════════════════ #}
  <h5 class="text-uppercase text-muted fw-semibold mb-3 small ls-1">
    <i class="bi bi-broadcast me-1"></i> Radares Medidores
  </h5>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card kpi-card h-100">
        <div class="card-body">
          <div class="kpi-label">Total</div>
          <div class="kpi-value count-up" data-target="{{ radarKpis.total ?? 0 }}">0</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card kpi-card h-100 border-success">
        <div class="card-body">
          <div class="kpi-label text-success">Aprovados</div>
          <div class="kpi-value text-success count-up" data-target="{{ radarKpis.aprovados ?? 0 }}">0</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card kpi-card h-100 border-danger">
        <div class="card-body">
          <div class="kpi-label text-danger">Reprovados</div>
          <div class="kpi-value text-danger count-up" data-target="{{ radarKpis.reprovados ?? 0 }}">0</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card kpi-card h-100 border-warning">
        <div class="card-body">
          <div class="kpi-label text-warning">Vencidos</div>
          <div class="kpi-value text-warning count-up" data-target="{{ radarKpis.vencidos ?? 0 }}">0</div>
          <div class="kpi-sub">validade expirada</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card kpi-card h-100 border-warning">
        <div class="card-body">
          <div class="kpi-label text-warning">Vencendo</div>
          <div class="kpi-value text-warning count-up" data-target="{{ radarKpis.vencendo ?? 0 }}">0</div>
          <div class="kpi-sub">próx. 30 dias</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card kpi-card h-100">
        <div class="card-body">
          <div class="kpi-label">Cobertura Waze</div>
          <div class="kpi-value text-info count-up" data-target="{{ radarKpis.pctWaze ?? 0 }}" data-suffix="%">0%</div>
          <div class="kpi-sub">{{ radarKpis.comWaze ?? 0 }} / {{ radarKpis.total ?? 0 }}</div>
        </div>
      </div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════
     GRÁFICOS RADARES — linha 1
  ═══════════════════════════════════════════════════════════════ #}
  <div class="row g-3 mb-4">
    <div class="col-12 col-xl-8">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Radares por Estado</span>
          <a href="{{ path('radar_index') }}" class="btn btn-sm btn-outline-secondary">Ver todos</a>
        </div>
        <div class="card-body" style="min-height:280px">
          <canvas id="chartRadarUf"></canvas>
        </div>
      </div>
    </div>
    <div class="col-12 col-xl-4">
      <div class="card h-100">
        <div class="card-header"><span class="fw-semibold">Resultado Geral</span></div>
        <div class="card-body d-flex align-items-center justify-content-center" style="min-height:280px">
          <canvas id="chartRadarResultado" style="max-height:240px"></canvas>
        </div>
      </div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════
     GRÁFICOS RADARES — linha 2
  ═══════════════════════════════════════════════════════════════ #}
  <div class="row g-3 mb-4">
    <div class="col-12 col-xl-6">
      <div class="card h-100">
        <div class="card-header"><span class="fw-semibold">Verificações Mensais (12 meses)</span></div>
        <div class="card-body" style="min-height:240px">
          <canvas id="chartVerifMensais"></canvas>
        </div>
      </div>
    </div>
    <div class="col-12 col-xl-6">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Cobertura Waze por Estado</span>
          <a href="{{ path('cobertura_radar') }}" class="btn btn-sm btn-outline-secondary">Relatório</a>
        </div>
        <div class="card-body" style="min-height:240px">
          <canvas id="chartCoberturaUf"></canvas>
        </div>
      </div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════
     KPIs POSTOS
  ═══════════════════════════════════════════════════════════════ #}
  <h5 class="text-uppercase text-muted fw-semibold mb-3 small ls-1">
    <i class="bi bi-fuel-pump me-1"></i> Postos de Combustível
  </h5>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card kpi-card h-100">
        <div class="card-body">
          <div class="kpi-label">Total Postos</div>
          <div class="kpi-value count-up" data-target="{{ kpis.total ?? 0 }}">0</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card kpi-card h-100 border-success">
        <div class="card-body">
          <div class="kpi-label text-success">Com Link Waze</div>
          <div class="kpi-value text-success count-up" data-target="{{ kpis.comWaze ?? 0 }}">0</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card kpi-card h-100 border-danger">
        <div class="card-body">
          <div class="kpi-label text-danger">Sem Link Waze</div>
          <div class="kpi-value text-danger count-up" data-target="{{ kpis.semWaze ?? 0 }}">0</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card kpi-card h-100 border-info">
        <div class="card-body">
          <div class="kpi-label text-info">Cobertura</div>
          <div class="kpi-value text-info">{{ kpis.pct ?? 0 }}%</div>
          <div class="kpi-sub">{{ kpis.mesAtual ?? 0 }} cadastros este mês</div>
        </div>
      </div>
    </div>
  </div>

  {# Gráfico atividade postos #}
  <div class="row g-3 mb-4">
    <div class="col-12 col-xl-8">
      <div class="card">
        <div class="card-header"><span class="fw-semibold">Atividade de Cadastros — Postos (30 dias)</span></div>
        <div class="card-body" style="min-height:220px">
          <canvas id="chartPostoAtividade"></canvas>
        </div>
      </div>
    </div>
    <div class="col-12 col-xl-4">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Radares APROVADOS sem Waze</span>
          <a href="{{ path('cobertura_radar') }}" class="btn btn-sm btn-outline-warning">Ver todos</a>
        </div>
        <div class="card-body p-0" style="max-height:260px;overflow-y:auto">
          <table class="table table-sm table-hover mb-0">
            <thead class="sticky-top"><tr><th>UF</th><th>Município</th><th>Local</th></tr></thead>
            <tbody>
            {% for r in radarSemWaze %}
              <tr>
                <td><span class="badge bg-secondary">{{ r.sigla_uf }}</span></td>
                <td class="small">{{ r.municipio }}</td>
                <td class="small text-truncate" style="max-width:140px" title="{{ r.local_verificacao }}">{{ r.local_verificacao }}</td>
              </tr>
            {% else %}
              <tr><td colspan="3" class="text-center text-muted py-3">Todos vinculados! 🎉</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>{# /container #}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function(){
  'use strict';

  // ─── Dados do PHP → JS ───────────────────────────────────────
  const radarUf = {{ radarPorUf | json_encode | raw }};
  const resultado = {{ radarResultado | json_encode | raw }};
  const mensais = {{ radarMensais | json_encode | raw }};
  const coberturaUf = {{ radarCobertura | json_encode | raw }};
  const postoAtiv = {{ atividade | json_encode | raw }};

  // ─── Helpers ─────────────────────────────────────────────────
  const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark'
                    || document.documentElement.classList.contains('dark-mode')
                    || window.matchMedia('(prefers-color-scheme: dark)').matches;

  const gridColor  = () => isDark() ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)';
  const labelColor = () => isDark() ? '#adb5bd' : '#495057';

  Chart.defaults.font.family = 'system-ui, -apple-system, sans-serif';
  Chart.defaults.font.size   = 12;

  function buildScales(x = true, y = true) {
    const base = { grid: { color: gridColor() }, ticks: { color: labelColor() } };
    return {
      ...(x ? { x: base } : {}),
      ...(y ? { y: base } : {}),
    };
  }

  // ─── 1. Radares por UF (barras empilhadas) ───────────────────
  new Chart(document.getElementById('chartRadarUf'), {
    type: 'bar',
    data: {
      labels: radarUf.map(r => r.uf),
      datasets: [
        { label: 'Aprovados',  data: radarUf.map(r => +r.aprovados),  backgroundColor: '#20c997', stack: 's' },
        { label: 'Reprovados', data: radarUf.map(r => +r.reprovados), backgroundColor: '#dc3545', stack: 's' },
        { label: 'Outros',     data: radarUf.map(r => +r.total - (+r.aprovados||0) - (+r.reprovados||0)), backgroundColor: '#6c757d', stack: 's' },
      ],
    },
    options: {
      responsive: true, maintainAspectRatio: true,
      plugins: { legend: { position: 'bottom', labels: { color: labelColor() } } },
      scales: { ...buildScales(), x: { stacked: true, grid: { color: gridColor() }, ticks: { color: labelColor() } }, y: { stacked: true, grid: { color: gridColor() }, ticks: { color: labelColor() } } },
    },
  });

  // ─── 2. Resultado geral (rosca) ───────────────────────────────
  const resColors = { 'APROVADO': '#20c997', 'REPROVADO': '#dc3545', 'SEM INFO': '#6c757d' };
  new Chart(document.getElementById('chartRadarResultado'), {
    type: 'doughnut',
    data: {
      labels: resultado.map(r => r.resultado),
      datasets: [{ data: resultado.map(r => +r.total), backgroundColor: resultado.map(r => resColors[r.resultado] ?? '#adb5bd'), borderWidth: 2 }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { color: labelColor() } } },
      cutout: '65%',
    },
  });

  // ─── 3. Verificações mensais (linha) ─────────────────────────
  new Chart(document.getElementById('chartVerifMensais'), {
    type: 'line',
    data: {
      labels: mensais.map(r => r.mes),
      datasets: [{
        label: 'Verificações',
        data: mensais.map(r => +r.total),
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13,110,253,0.1)',
        fill: true, tension: 0.4, pointRadius: 4,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: true,
      plugins: { legend: { display: false } },
      scales: buildScales(),
    },
  });

  // ─── 4. Cobertura Waze por UF (barras horizontais) ───────────
  new Chart(document.getElementById('chartCoberturaUf'), {
    type: 'bar',
    data: {
      labels: coberturaUf.map(r => r.uf),
      datasets: [
        { label: 'Com Waze',  data: coberturaUf.map(r => +r.com_waze), backgroundColor: '#20c997' },
        { label: 'Sem Waze',  data: coberturaUf.map(r => +r.sem_waze), backgroundColor: '#dc3545' },
      ],
    },
    options: {
      indexAxis: 'y', responsive: true, maintainAspectRatio: true,
      plugins: { legend: { position: 'bottom', labels: { color: labelColor() } } },
      scales: buildScales(),
    },
  });

  // ─── 5. Atividade postos (linha) ─────────────────────────────
  new Chart(document.getElementById('chartPostoAtividade'), {
    type: 'line',
    data: {
      labels: postoAtiv.map(r => r.dia),
      datasets: [{
        label: 'Cadastros',
        data: postoAtiv.map(r => +r.cadastros),
        borderColor: '#fd7e14',
        backgroundColor: 'rgba(253,126,20,0.1)',
        fill: true, tension: 0.4, pointRadius: 3,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: true,
      plugins: { legend: { display: false } },
      scales: buildScales(),
    },
  });

  // ─── Count-up animado ─────────────────────────────────────────
  document.querySelectorAll('.count-up').forEach(el => {
    const target = parseFloat(el.dataset.target ?? '0');
    const suffix = el.dataset.suffix ?? '';
    const dur = 1200;
    const start = performance.now();
    const fmt = v => Number.isInteger(target) ? Math.round(v).toLocaleString('pt-BR') : v.toFixed(1);
    const step = t => {
      const p = Math.min((t - start) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(ease * target) + suffix;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });

})();
</script>
{% endblock %}
