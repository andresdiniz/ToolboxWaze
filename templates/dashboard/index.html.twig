{% extends 'base.html.twig' %}
{% block title %}Dashboard — ToolboxWaze{% endblock %}

{% block body %}
<div class="container-fluid py-4">

{# ── Cabeçalho ──────────────────────────────────────────────────── #}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h4 class="mb-0 fw-bold"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h4>
    <p class="text-muted small mb-0">Visão geral do WazeToolbox
      {% if allowedUfs is not null %}
        — <span class="text-info">filtrado por {{ allowedUfs|join(', ') }}</span>
      {% endif %}
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="{{ path('radar_index') }}"        class="btn btn-sm btn-outline-secondary"><i class="bi bi-broadcast me-1"></i>Radares</a>
    <a href="{{ path('posto_index') }}"         class="btn btn-sm btn-outline-secondary"><i class="bi bi-fuel-pump me-1"></i>Postos</a>
    <a href="{{ path('escola_inep_index') }}"   class="btn btn-sm btn-outline-secondary"><i class="bi bi-building me-1"></i>Escolas</a>
    <a href="{{ path('solicitacao_index') }}"   class="btn btn-sm btn-outline-secondary"><i class="bi bi-inbox me-1"></i>Solicitações</a>
    {% if isAdmin %}
    <a href="{{ path('admin_user_index') }}"    class="btn btn-sm btn-outline-secondary"><i class="bi bi-people me-1"></i>Usuários</a>
    {% endif %}
    <a href="{{ path('cobertura_radar') }}"     class="btn btn-sm btn-outline-danger"><i class="bi bi-broadcast me-1"></i>Cobertura</a>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════
   LINHA 1 — Métricas globais (escolas + estados + usuários)
══════════════════════════════════════════════════════════════════ #}
<p class="text-uppercase text-muted small fw-semibold mb-2 ls-1"><i class="bi bi-globe me-1"></i>Visão Geral</p>
<div class="row g-3 mb-4">

  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
      <div class="card-body py-3">
        <div class="text-muted small mb-1"><i class="bi bi-map me-1"></i>Estados ativos</div>
        <div class="fs-3 fw-bold count-up" data-target="{{ estadosAtivos }}">0</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
      <div class="card-body py-3">
        <div class="text-muted small mb-1"><i class="bi bi-building me-1"></i>Escolas INEP</div>
        <div class="fs-3 fw-bold count-up" data-target="{{ escolaKpis.total ?? 0 }}">0</div>
        <div class="small text-muted">{{ escolaKpis.com_waze ?? 0 }} com Waze</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
      <div class="card-body py-3">
        <div class="text-muted small mb-1"><i class="bi bi-broadcast me-1"></i>Radares</div>
        <div class="fs-3 fw-bold count-up" data-target="{{ radarKpis.total ?? 0 }}">0</div>
        <div class="small text-muted">{{ radarKpis.aprovados ?? 0 }} aprovados</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-orange">
      <div class="card-body py-3">
        <div class="text-muted small mb-1"><i class="bi bi-fuel-pump me-1"></i>Postos</div>
        <div class="fs-3 fw-bold count-up" data-target="{{ postoKpis.total ?? 0 }}">0</div>
        <div class="small text-muted">{{ postoKpis.comWaze ?? 0 }} com Waze</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
      <div class="card-body py-3">
        <div class="text-muted small mb-1"><i class="bi bi-inbox me-1"></i>Solicitações</div>
        <div class="fs-3 fw-bold count-up" data-target="{{ solicKpis.geral.total ?? 0 }}">0</div>
        <div class="small text-muted">{{ solicKpis.geral.hoje ?? 0 }} hoje</div>
      </div>
    </div>
  </div>

  {% if isAdmin and usuarioKpis.total is defined %}
  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-secondary">
      <div class="card-body py-3">
        <div class="text-muted small mb-1"><i class="bi bi-people me-1"></i>Usuários</div>
        <div class="fs-3 fw-bold count-up" data-target="{{ usuarioKpis.total }}">0</div>
        <div class="small text-muted">{{ usuarioKpis.pendentes ?? 0 }} pendentes</div>
      </div>
    </div>
  </div>
  {% endif %}

</div>

{# ══════════════════════════════════════════════════════════════════
   LINHA 2 — KPIs de Radares detalhados
══════════════════════════════════════════════════════════════════ #}
<p class="text-uppercase text-muted small fw-semibold mb-2 ls-1"><i class="bi bi-broadcast me-1"></i>Radares</p>
<div class="row g-3 mb-4">
  {% set radarCards = [
    {label:'Total',         val: radarKpis.total      ?? 0, color:'primary',  sub: null},
    {label:'Aprovados',     val: radarKpis.aprovados   ?? 0, color:'success',  sub: null},
    {label:'Reprovados',    val: radarKpis.reprovados  ?? 0, color:'danger',   sub: null},
    {label:'Vencidos',      val: radarKpis.vencidos    ?? 0, color:'warning',  sub:'validade expirada'},
    {label:'Vencendo',      val: radarKpis.vencendo    ?? 0, color:'warning',  sub:'próx. 30 dias'},
    {label:'Cobertura Waze',val: radarKpis.pctWaze     ?? 0, color:'info',     sub:(radarKpis.comWaze ?? 0)~' vinculados', suffix:'%'},
  ] %}
  {% for c in radarCards %}
  <div class="col-6 col-sm-4 col-xl-2">
    <div class="card border-0 shadow-sm h-100 border-start border-4 border-{{ c.color }}">
      <div class="card-body py-3">
        <div class="text-{{ c.color }} small mb-1">{{ c.label }}</div>
        <div class="fs-4 fw-bold text-{{ c.color }} count-up"
             data-target="{{ c.val }}"
             {% if c.suffix is defined %}data-suffix="{{ c.suffix }}"{% endif %}>0</div>
        {% if c.sub %}<div class="small text-muted">{{ c.sub }}</div>{% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>

{# ══════════════════════════════════════════════════════════════════
   LINHA 3 — Gráficos de Radares
══════════════════════════════════════════════════════════════════ #}
<div class="row g-3 mb-4">
  <div class="col-12 col-xl-8">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-bar-chart-fill me-1 text-primary"></i>Radares por Estado</span>
        <a href="{{ path('radar_index') }}" class="btn btn-sm btn-outline-secondary">Ver todos</a>
      </div>
      <div class="card-body" style="min-height:260px">
        <canvas id="chartRadarUf"></canvas>
      </div>
    </div>
  </div>
  <div class="col-12 col-xl-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-pie-chart-fill me-1 text-success"></i>Resultado Geral</span>
      </div>
      <div class="card-body d-flex align-items-center justify-content-center" style="min-height:260px">
        <canvas id="chartRadarResultado" style="max-height:240px"></canvas>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-12 col-xl-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-graph-up me-1 text-primary"></i>Verificações Mensais (12 meses)</span>
      </div>
      <div class="card-body" style="min-height:220px">
        <canvas id="chartVerifMensais"></canvas>
      </div>
    </div>
  </div>
  <div class="col-12 col-xl-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-broadcast me-1 text-danger"></i>Cobertura Waze por Estado</span>
        <a href="{{ path('cobertura_radar') }}" class="btn btn-sm btn-outline-danger">Relatório</a>
      </div>
      <div class="card-body" style="min-height:220px">
        <canvas id="chartCoberturaUf"></canvas>
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════
   LINHA 4 — KPIs Postos + Escolas
══════════════════════════════════════════════════════════════════ #}
<div class="row g-3 mb-4">

  {# Postos #}
  <div class="col-12 col-xl-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-fuel-pump me-1 text-warning"></i>Postos de Combustível
          <a href="{{ path('posto_index') }}" class="btn btn-sm btn-outline-secondary ms-2">Ver lista</a>
          <a href="{{ path('cobertura_posto') }}" class="btn btn-sm btn-outline-warning ms-1">Cobertura</a>
        </span>
      </div>
      <div class="card-body">
        <div class="row g-2 mb-3">
          <div class="col-6">
            <div class="p-2 rounded bg-body-secondary text-center">
              <div class="small text-muted">Total</div>
              <div class="fw-bold fs-5 count-up" data-target="{{ postoKpis.total ?? 0 }}">0</div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-success bg-opacity-10 text-center">
              <div class="small text-success">Com Waze</div>
              <div class="fw-bold fs-5 text-success count-up" data-target="{{ postoKpis.comWaze ?? 0 }}">0</div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-danger bg-opacity-10 text-center">
              <div class="small text-danger">Sem Waze</div>
              <div class="fw-bold fs-5 text-danger count-up" data-target="{{ postoKpis.semWaze ?? 0 }}">0</div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-info bg-opacity-10 text-center">
              <div class="small text-info">Cobertura</div>
              <div class="fw-bold fs-5 text-info">{{ postoKpis.pct ?? 0 }}%</div>
              <div class="progress mt-1" style="height:3px">
                <div class="progress-bar bg-info" style="width:{{ postoKpis.pct ?? 0 }}%"></div>
              </div>
            </div>
          </div>
        </div>
        <canvas id="chartPostoAtividade" style="max-height:140px"></canvas>
      </div>
    </div>
  </div>

  {# Escolas #}
  <div class="col-12 col-xl-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-building me-1 text-warning"></i>Escolas INEP
          <a href="{{ path('escola_inep_index') }}" class="btn btn-sm btn-outline-secondary ms-2">Ver lista</a>
        </span>
      </div>
      <div class="card-body">
        <div class="row g-2 mb-3">
          <div class="col-6">
            <div class="p-2 rounded bg-body-secondary text-center">
              <div class="small text-muted">Total</div>
              <div class="fw-bold fs-5 count-up" data-target="{{ escolaKpis.total ?? 0 }}">0</div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-success bg-opacity-10 text-center">
              <div class="small text-success">Ativas</div>
              <div class="fw-bold fs-5 text-success count-up" data-target="{{ escolaKpis.ativas ?? 0 }}">0</div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-success bg-opacity-10 text-center">
              <div class="small text-success">Com Waze</div>
              <div class="fw-bold fs-5 text-success count-up" data-target="{{ escolaKpis.com_waze ?? 0 }}">0</div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 rounded bg-danger bg-opacity-10 text-center">
              <div class="small text-danger">Sem Waze</div>
              <div class="fw-bold fs-5 text-danger count-up" data-target="{{ escolaKpis.sem_waze ?? 0 }}">0</div>
            </div>
          </div>
        </div>
        {% if escolaKpis.total is defined and escolaKpis.total > 0 %}
        <div class="progress" style="height:10px" title="Cobertura Waze Escolas">
          {% set pctEscola = ((escolaKpis.com_waze ?? 0) / max(escolaKpis.total, 1) * 100)|round(1) %}
          <div class="progress-bar bg-success" style="width:{{ pctEscola }}%"></div>
          <div class="progress-bar bg-danger" style="width:{{ 100 - pctEscola }}%"></div>
        </div>
        <div class="d-flex justify-content-between small text-muted mt-1">
          <span>{{ pctEscola }}% com Waze</span>
          <span>{{ (100 - pctEscola)|round(1) }}% sem Waze</span>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════
   LINHA 5 — Solicitações por tipo + gráfico
══════════════════════════════════════════════════════════════════ #}
<div class="row g-3 mb-4">

  {# Tabela por tipo #}
  <div class="col-12 col-xl-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-inbox me-1 text-info"></i>Solicitações por Tipo</span>
        <a href="{{ path('solicitacao_index') }}" class="btn btn-sm btn-outline-secondary">Ver todas</a>
      </div>
      <div class="card-body p-0">
        {% if solicKpis.geral.total is defined %}
        <div class="px-3 py-2 border-bottom d-flex gap-3">
          <span class="small">Total <strong class="count-up" data-target="{{ solicKpis.geral.total }}">0</strong></span>
          <span class="small text-success">Atendidas <strong class="count-up text-success" data-target="{{ solicKpis.geral.atendidas ?? 0 }}">0</strong></span>
          <span class="small text-warning">Pendentes <strong class="count-up text-warning" data-target="{{ solicKpis.geral.pendentes ?? 0 }}">0</strong></span>
          <span class="small text-danger">Recusadas <strong class="count-up text-danger" data-target="{{ solicKpis.geral.recusadas ?? 0 }}">0</strong></span>
        </div>
        {% endif %}
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="sticky-top table-light">
            <tr><th>Tipo</th><th class="text-end">Total</th><th class="text-end text-success">Atend.</th><th class="text-end">Taxa</th></tr>
          </thead>
          <tbody>
          {% for t in solicKpis.totais ?? [] %}
            {% set taxa = t.total > 0 ? (t.atendidas / t.total * 100)|round(0) : 0 %}
            <tr>
              <td><span class="badge bg-secondary">{{ t.tipo }}</span></td>
              <td class="text-end fw-semibold">{{ t.total }}</td>
              <td class="text-end text-success">{{ t.atendidas ?? 0 }}</td>
              <td>
                <div class="progress" style="height:6px" title="{{ taxa }}%">
                  <div class="progress-bar bg-{{ taxa >= 75 ? 'success' : (taxa >= 40 ? 'warning' : 'danger') }}" style="width:{{ taxa }}%"></div>
                </div>
                <small class="text-muted">{{ taxa }}%</small>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="4" class="text-center text-muted py-3">Nenhuma solicitação.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {# Gráfico linha solicitações diárias #}
  <div class="col-12 col-xl-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-graph-up-arrow me-1 text-info"></i>Solicitações Diárias (30 dias)</span>
      </div>
      <div class="card-body" style="min-height:240px">
        <canvas id="chartSolicDiarias"></canvas>
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════
   LINHA 6 — Radares sem Waze prioritários + Usuários
══════════════════════════════════════════════════════════════════ #}
<div class="row g-3 mb-2">

  <div class="col-12 col-xl-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i>Radares APROVADOS sem Link Waze</span>
        <a href="{{ path('cobertura_radar') }}" class="btn btn-sm btn-outline-warning">Ver todos</a>
      </div>
      <div class="card-body p-0" style="max-height:280px;overflow-y:auto">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="sticky-top table-light"><tr><th>UF</th><th>Município</th><th>Logradouro</th><th class="text-end">Ação</th></tr></thead>
          <tbody>
          {% for r in radarSemWaze %}
            <tr>
              <td><span class="badge bg-secondary">{{ r.sigla_uf }}</span></td>
              <td class="small">{{ r.municipio }}</td>
              <td class="small text-muted text-truncate" style="max-width:180px">{{ r.logradouro ?? '—' }}</td>
              <td class="text-end">
                <a href="{{ path('radar_show', {id: r.id}) }}" class="btn btn-sm btn-outline-primary py-0 px-2">
                  <i class="bi bi-link-45deg"></i>
                </a>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="4" class="text-center py-4 text-success">
              <i class="bi bi-check-circle-fill fs-3 d-block mb-1"></i>Todos vinculados!
            </td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {% if isAdmin and usuarioKpis.total is defined %}
  <div class="col-12 col-xl-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-transparent border-bottom-0 pt-3">
        <span class="fw-semibold"><i class="bi bi-people me-1 text-secondary"></i>Usuários
          <a href="{{ path('admin_user_index') }}" class="btn btn-sm btn-outline-secondary ms-2">Gerenciar</a>
        </span>
      </div>
      <div class="card-body">
        <div class="row g-2">
          {% set uCards = [
            {label:'Total',        val: usuarioKpis.total ?? 0,       color:'secondary'},
            {label:'Ativos',       val: usuarioKpis.ativos ?? 0,      color:'success'},
            {label:'Verificados',  val: usuarioKpis.verificados ?? 0, color:'primary'},
            {label:'Pendentes',    val: usuarioKpis.pendentes ?? 0,   color:'warning'},
          ] %}
          {% for u in uCards %}
          <div class="col-6">
            <div class="p-2 rounded bg-{{ u.color }} bg-opacity-10 text-center">
              <div class="small text-{{ u.color }}">{{ u.label }}</div>
              <div class="fw-bold fs-5 text-{{ u.color }} count-up" data-target="{{ u.val }}">0</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

</div>

</div>{# /container #}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
  .border-orange { border-color: #fd7e14 !important; }
  .ls-1 { letter-spacing: .05em; }
</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function(){
  'use strict';

  const radarUf      = {{ radarPorUf     | json_encode | raw }};
  const resultado    = {{ radarResultado | json_encode | raw }};
  const mensais      = {{ radarMensais   | json_encode | raw }};
  const coberturaUf  = {{ radarCobertura | json_encode | raw }};
  const postoAtiv    = {{ postoAtividade | json_encode | raw }};
  const solicDiarias = {{ solicDiarias   | json_encode | raw }};

  const isDark = () =>
    document.documentElement.getAttribute('data-bs-theme') === 'dark' ||
    document.documentElement.classList.contains('dark-mode') ||
    window.matchMedia('(prefers-color-scheme: dark)').matches;

  const gc = () => isDark() ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
  const tc = () => isDark() ? '#adb5bd' : '#6c757d';

  Chart.defaults.font.family = 'system-ui,-apple-system,sans-serif';
  Chart.defaults.font.size   = 11;

  const scales = (stacked = false) => ({
    x: { stacked, grid: { color: gc() }, ticks: { color: tc() } },
    y: { stacked, beginAtZero: true, grid: { color: gc() }, ticks: { color: tc(), precision: 0 } },
  });

  // 1. Radares por UF (barras empilhadas)
  new Chart(document.getElementById('chartRadarUf'), {
    type: 'bar',
    data: {
      labels: radarUf.map(r => r.uf),
      datasets: [
        { label: 'Aprovados',  data: radarUf.map(r => +r.aprovados),  backgroundColor: '#20c997', borderRadius: 3, stack: 's' },
        { label: 'Reprovados', data: radarUf.map(r => +r.reprovados), backgroundColor: '#dc3545', borderRadius: 3, stack: 's' },
        { label: 'Outros',     data: radarUf.map(r => +r.total - (+r.aprovados||0) - (+r.reprovados||0)), backgroundColor: '#6c757d', borderRadius: 3, stack: 's' },
      ],
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { color: tc() } } }, scales: scales(true) },
  });

  // 2. Resultado geral (rosca)
  const resColors = { 'APROVADO': '#20c997', 'REPROVADO': '#dc3545', 'SEM INFO': '#6c757d' };
  new Chart(document.getElementById('chartRadarResultado'), {
    type: 'doughnut',
    data: {
      labels: resultado.map(r => r.resultado),
      datasets: [{ data: resultado.map(r => +r.total), backgroundColor: resultado.map(r => resColors[r.resultado] ?? '#adb5bd'), borderWidth: 2 }],
    },
    options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'bottom', labels: { color: tc() } } } },
  });

  // 3. Verificações mensais (linha)
  new Chart(document.getElementById('chartVerifMensais'), {
    type: 'line',
    data: {
      labels: mensais.map(r => r.mes),
      datasets: [{ label: 'Verificações', data: mensais.map(r => +r.total), borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,0.1)', fill: true, tension: 0.4, pointRadius: 4 }],
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: scales() },
  });

  // 4. Cobertura Waze por UF (barras horizontais)
  new Chart(document.getElementById('chartCoberturaUf'), {
    type: 'bar',
    data: {
      labels: coberturaUf.map(r => r.uf),
      datasets: [
        { label: 'Com Waze', data: coberturaUf.map(r => +r.com_waze), backgroundColor: 'rgba(32,201,151,0.8)', borderRadius: 3 },
        { label: 'Sem Waze', data: coberturaUf.map(r => +r.sem_waze), backgroundColor: 'rgba(220,53,69,0.7)',  borderRadius: 3 },
      ],
    },
    options: { indexAxis: 'y', responsive: true, plugins: { legend: { position: 'bottom', labels: { color: tc() } } }, scales: scales() },
  });

  // 5. Atividade postos (linha)
  new Chart(document.getElementById('chartPostoAtividade'), {
    type: 'line',
    data: {
      labels: postoAtiv.map(r => r.dia),
      datasets: [{ label: 'Cadastros', data: postoAtiv.map(r => +r.cadastros), borderColor: '#fd7e14', backgroundColor: 'rgba(253,126,20,0.1)', fill: true, tension: 0.4, pointRadius: 3 }],
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: scales() },
  });

  // 6. Solicitações diárias (linha)
  new Chart(document.getElementById('chartSolicDiarias'), {
    type: 'line',
    data: {
      labels: solicDiarias.map(r => r.dia),
      datasets: [{ label: 'Solicitações', data: solicDiarias.map(r => +r.total), borderColor: '#0dcaf0', backgroundColor: 'rgba(13,202,240,0.12)', fill: true, tension: 0.4, pointRadius: 3 }],
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: scales() },
  });

  // Count-up animado
  document.querySelectorAll('.count-up').forEach(el => {
    const target = parseFloat(el.dataset.target ?? '0');
    const suffix = el.dataset.suffix ?? '';
    if (!target) { el.textContent = '0' + suffix; return; }
    const dur = 1000;
    const start = performance.now();
    const isInt = Number.isInteger(target);
    const step = t => {
      const p    = Math.min((t - start) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.textContent = (isInt ? Math.round(ease * target).toLocaleString('pt-BR') : (ease * target).toFixed(1)) + suffix;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });

})();
</script>
{% endblock %}
