{% extends 'email/_layout.html.twig' %}{% set subject = subject|default('Novo usuário cadastrado — Toolbox Waze') %}{% block content %}<h1 style="margin-top:0;">Novo usuário cadastrado</h1><p>Uma nova conta foi criada no Toolbox Waze.</p><dl><dt><strong>Nome</strong></dt><dd>{{ userName|default('Não informado') }}</dd><dt><strong>E-mail</strong></dt><dd>{{ userEmail }}</dd>{% if states is defined %}<dt><strong>Estados autorizados</strong></dt><dd>{{ states|join(', ')|default('Nenhum') }}</dd>{% endif %}</dl>{% if adminUrl is defined and adminUrl %}<p><a href="{{ adminUrl }}" style="display:inline-block;background:#1769aa;color:#fff;text-decoration:none;padding:12px 18px;border-radius:5px;">Abrir usuário</a></p>{% endif %}{% endblock %}
