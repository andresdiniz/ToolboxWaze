{% apply inline_css %}
<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ event.title }}</title></head>
<body style="margin:0;background:#f3f7f7;color:#143038;font-family:Arial,Helvetica,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:24px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:620px;background:#ffffff;border-radius:14px;border:1px solid #dbe6e7">
<tr><td style="padding:26px 26px 0"><p style="margin:0;font-size:12px;letter-spacing:.1em;font-weight:bold;color:#12685c">TOOLBOXWAZE</p><h1 style="margin:10px 0 14px;font-size:22px;line-height:1.3">{{ event.title }}</h1></td></tr>
<tr><td style="padding:0 26px"><p style="margin:0 0 18px;line-height:1.6">{{ event.body|nl2br }}</p>{% if link %}<p style="margin:0 0 24px"><a href="{{ link }}" style="display:inline-block;padding:11px 18px;background:#12685c;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:bold">Abrir no ToolboxWaze</a></p>{% endif %}</td></tr>
<tr><td style="padding:18px 26px;border-top:1px solid #dbe6e7;color:#506970;font-size:12px">Você recebe este e-mail porque ativou notificações por e-mail no ToolboxWaze. Atualize as preferências na sua conta.</td></tr>
</table></td></tr></table></body></html>
{% endapply %}
