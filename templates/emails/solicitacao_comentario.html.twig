<!DOCTYPE html>
<html lang="pt-BR">
<body style="font-family:sans-serif;color:#222;max-width:600px;margin:0 auto;padding:24px">
  <h2 style="color:#01696f">ToolboxWaze</h2>
  <p>Olá, {{ responsavel.name }},</p>
  <p>Há um novo comentário na solicitação <strong>#{{ solicitacao.id }} — {{ solicitacao.tipoLabel }}</strong>:</p>
  <blockquote style="border-left:4px solid #01696f;margin:16px 0;padding:8px 16px;background:#f7f6f2">
    {{ solicitacao.comentarios|last.mensagem|nl2br }}
  </blockquote>
  <p>
    <a href="{{ url }}" style="background:#01696f;color:#fff;padding:10px 20px;text-decoration:none;border-radius:6px;display:inline-block">Ver solicitação</a>
  </p>
  <hr style="margin:24px 0;border:none;border-top:1px solid #ddd">
  <small style="color:#888">ToolboxWaze — notificação automática</small>
</body>
</html>
