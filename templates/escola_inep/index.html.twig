{% extends 'base.html.twig' %}

{% block title %}Escolas INEP{% endblock %}

{% block body %}
<div class="container-fluid py-3">

  {# ── Cabeçalho ── #}
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h4 class="mb-0">🏫 Escolas INEP</h4>
      {% if stats is not null %}
        <small class="text-muted">
          {{ stats.total|number_format(0, ',', '.') }} escolas ·
          {{ stats.estados }} estados ·
          {{ stats.municipios|number_format(0, ',', '.') }} municípios
        </small>
      {% else %}
        <small class="text-muted">{{ total|number_format(0, ',', '.') }} resultado(s)</small>
      {% endif %}
    </div>
  </div>

  {# ── Filtros ── #}
  <form method="GET" action="{{ path('escola_inep_index') }}" class="row g-2 mb-3" id="form-filtros">
    <div class="col-12 col-md-3">
      <input type="text" name="busca" value="{{ filters.busca }}"
             class="form-control form-control-sm"
             placeholder="Buscar escola, INEP ou município…">
    </div>
    <div class="col-6 col-md-1">
      <select name="uf" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="">Estado</option>
        {% for uf in ufs %}
          <option value="{{ uf }}" {% if filters.uf == uf %}selected{% endif %}>{{ uf }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="col-6 col-md-2">
      <input type="text" name="municipio" value="{{ filters.municipio }}"
             class="form-control form-control-sm"
             placeholder="Cidade…">
    </div>
    <div class="col-6 col-md-2">
      <select name="dependencia" class="form-select form-select-sm">
        <option value="">Dependência</option>
        {% for dep in dependencias %}
          <option value="{{ dep }}" {% if filters.dependencia == dep %}selected{% endif %}>{{ dep }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="col-6 col-md-1">
      <select name="localizacao" class="form-select form-select-sm">
        <option value="">Localização</option>
        {% for loc in localizacoes %}
          <option value="{{ loc }}" {% if filters.localizacao == loc %}selected{% endif %}>{{ loc }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="col-6 col-md-1">
      <select name="situacao" class="form-select form-select-sm">
        <option value="">Situação</option>
        <option value="ativa"      {% if filters.situacao == 'ativa' %}selected{% endif %}>✅ Ativas</option>
        <option value="paralisada" {% if filters.situacao == 'paralisada' %}selected{% endif %}>🔴 Paralisadas</option>
        <option value="sem_link"   {% if filters.situacao == 'sem_link' %}selected{% endif %}>🔗 Sem link</option>
        <option value="com_link"   {% if filters.situacao == 'com_link' %}selected{% endif %}>✔ Com link</option>
      </select>
    </div>
    <div class="col-6 col-md-2 d-flex gap-1">
      <button type="submit" class="btn btn-primary btn-sm flex-grow-1">🔍 Filtrar</button>
      {% if filters.busca or filters.uf or filters.municipio or filters.dependencia or filters.localizacao or filters.situacao %}
        <a href="{{ path('escola_inep_index') }}" class="btn btn-outline-secondary btn-sm" title="Limpar filtros">✕</a>
      {% endif %}
    </div>
  </form>

  {# Tags de filtros ativos #}
  {% set activeFilters = [] %}
  {% if filters.busca %}{% set activeFilters = activeFilters|merge([{label: 'Busca', value: filters.busca, key: 'busca'}]) %}{% endif %}
  {% if filters.uf %}{% set activeFilters = activeFilters|merge([{label: 'Estado', value: filters.uf, key: 'uf'}]) %}{% endif %}
  {% if filters.municipio %}{% set activeFilters = activeFilters|merge([{label: 'Cidade', value: filters.municipio, key: 'municipio'}]) %}{% endif %}
  {% if filters.dependencia %}{% set activeFilters = activeFilters|merge([{label: 'Dependência', value: filters.dependencia, key: 'dependencia'}]) %}{% endif %}
  {% if filters.localizacao %}{% set activeFilters = activeFilters|merge([{label: 'Localização', value: filters.localizacao, key: 'localizacao'}]) %}{% endif %}
  {% if filters.situacao %}{% set activeFilters = activeFilters|merge([{label: 'Situação', value: filters.situacao, key: 'situacao'}]) %}{% endif %}
  {% if activeFilters|length > 0 %}
  <div class="d-flex flex-wrap gap-1 mb-2">
    {% for f in activeFilters %}
      <span class="badge border" style="background:var(--color-surface-2,#f8f9fa);color:var(--color-text,#212529);border-color:#dee2e6 !important">
        {{ f.label }}: <strong>{{ f.value }}</strong>
        <a href="{{ path('escola_inep_index', filters|merge({(f.key): '', page: 1})) }}" class="text-danger ms-1">×</a>
      </span>
    {% endfor %}
  </div>
  {% endif %}

  {# ── Tabela ── #}
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>Escola</th>
          <th>Cód. INEP</th>
          <th>UF</th>
          <th>Município</th>
          <th>Dependência</th>
          <th>Loc.</th>
          <th>Situação</th>
          <th>Waze</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <td class="fw-semibold">{{ row.escola }}</td>
            <td><code>{{ row.codigo_inep }}</code></td>
            <td>{{ row.uf }}</td>
            <td>{{ row.municipio }}</td>
            <td>
              {% set dep = row.dependencia_administrativa %}
              {% if dep == 'Estadual' %}<span class="badge bg-primary">Estadual</span>
              {% elseif dep == 'Municipal' %}<span class="badge bg-success">Municipal</span>
              {% elseif dep == 'Federal' %}<span class="badge bg-dark">Federal</span>
              {% elseif dep == 'Privada' %}<span class="badge bg-warning text-dark">Privada</span>
              {% else %}<span class="badge bg-secondary">{{ dep }}</span>
              {% endif %}
            </td>
            <td><small>{{ row.localizacao }}</small></td>
            <td>
              {% set restricao = row.restricao_atendimento|default('')|upper %}
              {% if 'SEM RESTRIÇÃO' in restricao or 'SEM RESTRICAO' in restricao %}
                <span class="badge bg-success">Ativa</span>
              {% elseif 'PARALISADA' in restricao %}
                <span class="badge bg-danger">Paralisada</span>
              {% elseif 'EXCLUSIVAMENTE' in restricao %}
                <span class="badge bg-info text-dark">Esp.</span>
              {% else %}
                <span class="badge bg-secondary" title="{{ row.restricao_atendimento }}">{{ row.restricao_atendimento|default('—')|slice(0,15) }}</span>
              {% endif %}
            </td>
            <td class="text-center">
              {% if row.link_waze %}
                <a href="{{ row.link_waze }}" target="_blank" title="Abrir no Editor Waze"
                   class="badge bg-primary text-decoration-none">🗺 Editor</a>
              {% else %}
                <span class="text-muted small">—</span>
              {% endif %}
            </td>
            <td>
              <a href="{{ path('escola_inep_show', {id: row.id}) }}"
                 class="btn btn-outline-primary btn-sm">👁</a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="9" class="text-center text-muted py-4">Nenhuma escola encontrada.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Paginação ── #}
  {% if pages > 1 %}
    <nav class="mt-3">
      <ul class="pagination pagination-sm justify-content-center flex-wrap mb-0">
        {% if page > 1 %}
          <li class="page-item">
            <a class="page-link" href="{{ path('escola_inep_index', filters|merge({page: page - 1})) }}">&#8249;</a>
          </li>
        {% endif %}
        {% set start = (page - 2) > 1 ? (page - 2) : 1 %}
        {% set end   = (page + 2) < pages ? (page + 2) : pages %}
        {% if start > 1 %}
          <li class="page-item"><a class="page-link" href="{{ path('escola_inep_index', filters|merge({page: 1})) }}">1</a></li>
          {% if start > 2 %}<li class="page-item disabled"><span class="page-link">&hellip;</span></li>{% endif %}
        {% endif %}
        {% for p in start..end %}
          <li class="page-item {% if p == page %}active{% endif %}">
            <a class="page-link" href="{{ path('escola_inep_index', filters|merge({page: p})) }}">{{ p }}</a>
          </li>
        {% endfor %}
        {% if end < pages %}
          {% if end < pages - 1 %}<li class="page-item disabled"><span class="page-link">&hellip;</span></li>{% endif %}
          <li class="page-item"><a class="page-link" href="{{ path('escola_inep_index', filters|merge({page: pages})) }}">{{ pages }}</a></li>
        {% endif %}
        {% if page < pages %}
          <li class="page-item">
            <a class="page-link" href="{{ path('escola_inep_index', filters|merge({page: page + 1})) }}">&#8250;</a>
          </li>
        {% endif %}
      </ul>
    </nav>
    <p class="text-center text-muted small mt-1">
      Página {{ page }} de {{ pages }} — {{ total|number_format(0, ',', '.') }} escolas
    </p>
  {% endif %}

</div>
{% endblock %}
