{% extends 'base.html.twig' %}

{% block title %}{{ escola.escola }} — Escolas INEP{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<style>
#escola-map {
    height: 280px;
    border-radius: 0 0 .375rem .375rem;
    z-index: 0;
}
</style>
{% endblock %}

{% block body %}
{# ── data-* seguros para JS ── #}
{% set hasCoords = escola.latitude is not null and escola.latitude != '' and escola.latitude != '0.00000000'
                  and escola.longitude is not null and escola.longitude != '' and escola.longitude != '0.00000000' %}

<div class="container py-3"
     id="escola-data"
     data-lat="{% if hasCoords %}{{ escola.latitude }}{% endif %}"
     data-lon="{% if hasCoords %}{{ escola.longitude }}{% endif %}"
     data-place="{{ escola.linkAreaEscolar|default('')|e('html_attr') }}"
     data-waze="{{ escola.linkWaze|default('')|e('html_attr') }}"
     data-nome="{{ escola.escola|default('')|e('html_attr') }}"
     data-municipio="{{ escola.municipio|default('')|e('html_attr') }}"
     data-uf="{{ escola.uf|default('')|e('html_attr') }}">

  <div class="mb-3">
    <a href="{{ path('escola_inep_index', voltarParams) }}" class="btn btn-sm btn-outline-secondary">← Voltar</a>
  </div>

  {# ── Cabeçalho ── #}
  <div class="d-flex align-items-start gap-3 mb-4">
    <div class="flex-grow-1">
      <h4 class="mb-1">{{ escola.escola }}</h4>
      <small class="text-muted">Cód. INEP: <code>{{ escola.codigoInep }}</code></small>
      {% set restricao = escola.restricaoAtendimento|default('')|upper %}
      {% if 'PARALISADA' in restricao %}
        <span class="badge bg-danger ms-2">Paralisada</span>
      {% elseif 'SEM RESTRIÇÃO' in restricao or 'SEM RESTRICAO' in restricao %}
        <span class="badge bg-success ms-2">Ativa</span>
      {% endif %}
    </div>
  </div>

  <div class="row g-3">

    {# ── Dados INEP ── #}
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header fw-semibold">📋 Dados INEP</div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <tr><th class="ps-3" style="width:40%">UF</th><td>{{ escola.uf }}</td></tr>
              <tr><th class="ps-3">Município</th><td>{{ escola.municipio }}</td></tr>
              <tr><th class="ps-3">Endereço</th><td>{{ escola.endereco }}</td></tr>
              <tr><th class="ps-3">Dependência</th><td>{{ escola.dependenciaAdministrativa }}</td></tr>
              <tr><th class="ps-3">Localização</th><td>{{ escola.localizacao }}</td></tr>
              <tr><th class="ps-3">Porte</th><td>{{ escola.porte }}</td></tr>
              <tr><th class="ps-3">Etapas de Ensino</th><td><small>{{ escola.etapasEnsino }}</small></td></tr>
              <tr><th class="ps-3">Situação</th><td>{{ escola.restricaoAtendimento }}</td></tr>
              <tr><th class="ps-3">Telefone</th><td>{{ escola.telefone }}</td></tr>
              {% if hasCoords %}
              <tr>
                <th class="ps-3">Coordenadas</th>
                <td>
                  <a id="coords-link"
                     href="https://www.google.com/maps?q={{ escola.latitude }},{{ escola.longitude }}"
                     data-lat-val="{{ escola.latitude }}"
                     data-lon-val="{{ escola.longitude }}"
                     target="_blank" class="text-decoration-none">
                    {{ escola.latitude }}, {{ escola.longitude }} 🗺
                  </a>
                </td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    {# ── Links Waze ── #}
    <div class="col-12 col-lg-6">
      <div class="card">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
          🗺 Links Waze
          {% if app.user %}
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalLinks">
              ✏️ Editar
            </button>
          {% endif %}
        </div>
        <div class="card-body">

          <div class="mb-3">
            <div class="fw-semibold mb-1">🚸 Area Escolar (Permanent Hazard)</div>
            {% if escola.linkWaze %}
              <a href="{{ escola.linkWaze }}" target="_blank" class="btn btn-sm btn-primary">
                Abrir no Editor Waze
              </a>
              {% if escola.permanentHazardId %}
                <small class="text-muted ms-2">ID: {{ escola.permanentHazardId }}</small>
              {% endif %}
            {% else %}
              <span class="text-muted fst-italic">Não cadastrado</span>
            {% endif %}
          </div>

          <div>
            <div class="fw-semibold mb-1">🏫 Place escolar</div>
            {% if escola.linkAreaEscolar %}
              <a href="{{ escola.linkAreaEscolar }}" target="_blank" class="btn btn-sm btn-success">
                Abrir Área Escolar
              </a>
            {% else %}
              <span class="text-muted fst-italic">Não cadastrada</span>
            {% endif %}
          </div>

        </div>
      </div>

      {# ── Mapa OSM ── #}
      <div class="card mt-3" id="card-mapa" style="display:none">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
          🗺 Localização no Mapa
          <small class="text-muted fw-normal" id="mapa-fonte"></small>
        </div>
        <div id="escola-map"></div>
      </div>

      {# ── Histórico de links ── #}
      {% if linkLogs is not empty %}
      <div class="card mt-3">
        <div class="card-header fw-semibold">📜 Histórico de Links</div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0 align-middle">
            <thead>
              <tr>
                <th class="ps-3">Campo</th>
                <th>Antes</th>
                <th>Depois</th>
                <th>Editor</th>
                <th>Data</th>
              </tr>
            </thead>
            <tbody>
              {% for log in linkLogs %}
              <tr>
                <td class="ps-3"><small>{{ log.campo }}</small></td>

                {# Coluna «Antes» — clicável no GMaps se tiver lat/lon #}
                <td>
                  {% if log.valorAnterior %}
                    <small
                      class="waze-link-cell text-muted"
                      data-url="{{ log.valorAnterior|e('html_attr') }}"
                      title="{{ log.valorAnterior }}"
                    >{{ log.valorAnterior|slice(0,35) }}{% if log.valorAnterior|length > 35 %}…{% endif %}</small>
                  {% else %}
                    <small class="text-muted">—</small>
                  {% endif %}
                </td>

                {# Coluna «Depois» — clicável no GMaps se tiver lat/lon #}
                <td>
                  {% if log.valorNovo %}
                    <small
                      class="waze-link-cell"
                      data-url="{{ log.valorNovo|e('html_attr') }}"
                      title="{{ log.valorNovo }}"
                    >{{ log.valorNovo|slice(0,35) }}{% if log.valorNovo|length > 35 %}…{% endif %}</small>
                  {% else %}
                    <small class="text-muted">—</small>
                  {% endif %}
                </td>

                <td><small>{{ log.alteradoPor.name }}</small></td>
                <td><small data-utc="{{ log.alteradoEm|date('Y-m-d H:i:s') }}">{{ log.alteradoEm|date('d/m/Y') }}</small></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      {% endif %}
    </div>

    {# ── Comentários ── #}
    <div class="col-12">
      <div class="card">
        <div class="card-header fw-semibold">💬 Comentários dos Editores</div>
        <div class="card-body">

          {% if app.user %}
          <form method="POST" action="{{ path('escola_inep_comentario_add', {id: escola.id}) }}" class="mb-4">
            <div class="mb-2">
              <textarea name="texto" class="form-control" rows="3"
                        placeholder="Adicionar observação sobre esta escola (situação no Waze, pendências, etc.)…"
                        required></textarea>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Comentar</button>
          </form>
          {% endif %}

          {% if escola.comentarios is empty %}
            <p class="text-muted fst-italic mb-0">Nenhum comentário ainda.</p>
          {% else %}
            {% for c in escola.comentarios %}
            <div class="d-flex gap-2 mb-3">
              <div class="avatar-sm bg-primary text-white d-flex align-items-center justify-content-center fw-bold rounded-circle flex-shrink-0"
                   style="width:36px;height:36px;font-size:.8rem">
                {{ c.autor.name|first|upper }}
              </div>
              <div class="flex-grow-1">
                <div class="d-flex gap-2 align-items-baseline">
                  <strong class="small">{{ c.autor.name }}</strong>
                  <small class="text-muted" data-utc="{{ c.criadoEm|date('Y-m-d H:i:s') }}">{{ c.criadoEm|date('d/m/Y H:i') }}</small>
                </div>
                <div class="mt-1">{{ c.texto|nl2br }}</div>
              </div>
            </div>
            {% endfor %}
          {% endif %}

        </div>
      </div>
    </div>

  </div>{# /row #}
</div>

{# ── Modal edição de links ── #}
{% if app.user %}
<div class="modal fade" id="modalLinks" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="{{ path('escola_inep_link_save', {id: escola.id}) }}">
        <div class="modal-header">
          <h5 class="modal-title">✏️ Editar Links Waze</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">

          <div class="mb-3">
            <label class="form-label fw-semibold">🚸 Zona Escolar — Permanent Hazard</label>
            <input type="url" name="link_waze" class="form-control"
                   value="{{ escola.linkWaze }}"
                   placeholder="https://waze.com/pt-BR/editor?env=row&permanentHazards=XXXXXXX">
            <div class="form-text">O link deve conter <code>permanentHazards=</code> com o ID numérico.</div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">🏫 Área Escolar (Place)</label>
            <input type="url" name="link_area_escolar" class="form-control"
                   value="{{ escola.linkAreaEscolar }}"
                   placeholder="https://waze.com/pt-BR/editor?env=row&venues=XXXXXXX">
          </div>

          <div class="mb-3">
            <label class="form-label">Observação (opcional)</label>
            <textarea name="observacao" class="form-control" rows="2"
                      placeholder="Ex: zona escolar criada, aguardando aprovação…"></textarea>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
(function () {

  // ── Converte células do histórico de links em âncoras para o Google Maps ──
  // Tenta extrair lat/lon do parâmetro ?lat=&lon= presente nos links do Waze Editor.
  // Se encontrar, transforma o elemento <small> em <a> clicável para o GMaps.
  function extractLatLon(url) {
    if (!url) return null;
    try {
      var u = new URL(url);
      var wLat = parseFloat(u.searchParams.get('lat'));
      var wLon = parseFloat(u.searchParams.get('lon'));
      if (!isNaN(wLat) && !isNaN(wLon)) return { lat: wLat, lon: wLon };
    } catch (e) {}
    var mLat = url.match(/[?&]lat=(-?[\d.]+)/);
    var mLon = url.match(/[?&]lon=(-?[\d.]+)/);
    if (mLat && mLon) return { lat: parseFloat(mLat[1]), lon: parseFloat(mLon[1]) };
    return null;
  }

  document.querySelectorAll('.waze-link-cell').forEach(function (el) {
    var url    = el.dataset.url;
    var coords = extractLatLon(url);
    if (!coords) return;

    var gmapsUrl = 'https://www.google.com/maps?q=' + coords.lat + ',' + coords.lon;
    var anchor   = document.createElement('a');
    anchor.href        = gmapsUrl;
    anchor.target      = '_blank';
    anchor.rel         = 'noopener noreferrer';
    anchor.className   = el.className;
    anchor.title       = el.title;
    anchor.innerHTML   = '📍 ' + el.innerHTML;
    el.replaceWith(anchor);
  });

  // ── Link coordenadas: WME no desktop, geo: no mobile ──
  var coordLink = document.getElementById('coords-link');
  if (coordLink) {
    var lat = coordLink.dataset.latVal;
    var lon = coordLink.dataset.lonVal;
    var isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (isMobile) {
      coordLink.href = 'geo:' + lat + ',' + lon + '?q=' + lat + ',' + lon;
      coordLink.removeAttribute('target');
    } else {
      coordLink.href = 'https://www.waze.com/pt-BR/editor?env=row&lat=' + lat + '&lon=' + lon + '&zoom=17';
    }
  }

  // ── Mapa Leaflet ──
  var el   = document.getElementById('escola-data');
  var nome = el.dataset.nome;
  var mun  = el.dataset.municipio;
  var uf   = el.dataset.uf;

  var lat2 = null, lon2 = null, fonte = '';

  function extractLatLon2(url) {
    if (!url) return null;
    try {
      var u = new URL(url);
      var wLat = parseFloat(u.searchParams.get('lat'));
      var wLon = parseFloat(u.searchParams.get('lon'));
      if (!isNaN(wLat) && !isNaN(wLon)) return { lat: wLat, lon: wLon };
    } catch (e) {}
    var mLat = url.match(/[?&]lat=(-?[\d.]+)/);
    var mLon = url.match(/[?&]lon=(-?[\d.]+)/);
    if (mLat && mLon) return { lat: parseFloat(mLat[1]), lon: parseFloat(mLon[1]) };
    return null;
  }

  var dLat = parseFloat(el.dataset.lat);
  var dLon = parseFloat(el.dataset.lon);
  if (el.dataset.lat !== '' && el.dataset.lon !== '' && !isNaN(dLat) && !isNaN(dLon)) {
    lat2 = dLat; lon2 = dLon;
    fonte = 'Coordenadas INEP';
  }

  if (lat2 === null) {
    var coords = extractLatLon2(el.dataset.place);
    if (coords) { lat2 = coords.lat; lon2 = coords.lon; fonte = 'Extraído do link Place'; }
  }

  if (lat2 === null) {
    var coords2 = extractLatLon2(el.dataset.waze);
    if (coords2) { lat2 = coords2.lat; lon2 = coords2.lon; fonte = 'Extraído do link Waze'; }
  }

  if (lat2 === null || lon2 === null) return;

  var cardMapa = document.getElementById('card-mapa');
  cardMapa.style.display = '';
  document.getElementById('mapa-fonte').textContent = fonte;

  setTimeout(function () {
    var map = L.map('escola-map', { scrollWheelZoom: false }).setView([lat2, lon2], 17);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19
    }).addTo(map);

    map.invalidateSize();

    var icon = L.divIcon({
      className: '',
      html: '<div style="font-size:28px;line-height:1;filter:drop-shadow(0 1px 3px rgba(0,0,0,.5))">🏫</div>',
      iconAnchor: [14, 28],
      popupAnchor: [0, -28]
    });

    L.marker([lat2, lon2], { icon: icon })
      .addTo(map)
      .bindPopup('<strong>' + nome + '</strong><br>' + mun + ' — ' + uf)
      .openPopup();
  }, 50);

}());
</script>
{% endblock %}
