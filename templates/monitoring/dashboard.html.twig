{% extends 'base.html.twig' %}
{% block title %}Monitoramento Frontend{% endblock %}

{% block stylesheets %}
<style>
.metric-card { background: var(--bs-body-bg, #fff); border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .6rem; padding: 1.2rem 1.4rem; }
.metric-value { font-size: 2rem; font-weight: 700; line-height: 1; }
.metric-label { font-size: .75rem; color: var(--bs-secondary-color, #6c757d); text-transform: uppercase; letter-spacing: .05em; margin-top: .25rem; }
.vital-good   { color: #198754; }
.vital-warn   { color: #fd7e14; }
.vital-bad    { color: #dc3545; }
.event-badge  { font-size: .68rem; padding: .18em .5em; border-radius: 20px; font-weight: 600; white-space: nowrap; }
.badge-error  { background: rgba(220,53,69,.15);  color: #dc3545; }
.badge-warn   { background: rgba(253,126,20,.15); color: #fd7e14; }
.badge-info   { background: rgba(13,110,253,.15); color: #0d6efd; }
.badge-perf   { background: rgba(25,135,84,.15);  color: #198754; }
.tw-log-row td { font-size: .8rem; vertical-align: middle; }
.tw-log-row:hover td { background: var(--bs-tertiary-bg, #f5f5f5); }
.vitals-grid  { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: .75rem; }
.chart-wrap   { position: relative; height: 260px; }
</style>
{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0">📡 Monitoramento Frontend</h1>
    <small class="text-muted">Erros, performance e comportamento do usuário</small>
  </div>
  <form method="get" class="d-flex gap-2 align-items-center">
    <select name="days" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
      {% for d in [1, 3, 7, 14, 30] %}
        <option value="{{ d }}" {% if d == period %}selected{% endif %}Últimos {{ d }} dias</option>
      {% endfor %}
    </select>
    <select name="type" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
      <option value="">Todos os tipos</option>
      {% for t, c in byType %}
        <option value="{{ t }}" {% if t == filterType %}selected{% endif %}>{{ t }} ({{ c }})</option>
      {% endfor %}
    </select>
  </form>
</div>

{# ── Web Vitals ─────────────────────────────────────────────── #}
<h5 class="mb-3">⚡ Web Vitals (média — últimos {{ period }}d)</h5>
<div class="vitals-grid mb-4">
  {% set vitalsConfig = {
    'lcp':  { label: 'LCP',  unit: 'ms', good: 2500, poor: 4000 },
    'fcp':  { label: 'FCP',  unit: 'ms', good: 1800, poor: 3000 },
    'ttfb': { label: 'TTFB', unit: 'ms', good: 800,  poor: 1800 },
    'inp':  { label: 'INP',  unit: 'ms', good: 200,  poor: 500  },
    'cls':  { label: 'CLS',  unit: '',   good: 0.1,  poor: 0.25 },
  } %}
  {% for key, cfg in vitalsConfig %}
    {% set val = vitalsAvg[key] ?? null %}
    {% if val is not null %}
      {% if val <= cfg.good %} {% set ratingClass = 'vital-good' %}
      {% elseif val <= cfg.poor %} {% set ratingClass = 'vital-warn' %}
      {% else %} {% set ratingClass = 'vital-bad' %}
      {% endif %}
    {% else %}
      {% set ratingClass = 'text-muted' %}
    {% endif %}
    <div class="metric-card">
      <div class="metric-value {{ ratingClass }}">
        {% if val is not null %}{{ val }}{% else %}—{% endif %}{{ cfg.unit }}
      </div>
      <div class="metric-label">{{ cfg.label }}</div>
    </div>
  {% endfor %}
  <div class="metric-card">
    <div class="metric-value">{{ events|length }}</div>
    <div class="metric-label">Eventos total</div>
  </div>
  <div class="metric-card">
    <div class="metric-value text-danger">{{ errors|length }}</div>
    <div class="metric-label">Erros JS / AJAX</div>
  </div>
</div>

{# ── Distribuição por tipo ────────────────────────────────────── #}
{% if byType %}
<div class="row g-3 mb-4">
  <div class="col-lg-5">
    <div class="metric-card h-100">
      <h6 class="mb-3">Eventos por tipo</h6>
      <div class="chart-wrap"><canvas id="chartByType"></canvas></div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="metric-card h-100">
      <h6 class="mb-3">Top páginas com eventos</h6>
      {% if topPages %}
        <table class="table table-sm mb-0">
          <thead><tr><th>Página</th><th class="text-end">Eventos</th></tr></thead>
          <tbody>
            {% for pg, cnt in topPages %}
            <tr>
              <td class="text-truncate" style="max-width:320px" title="{{ pg }}">{{ pg ?: '(raiz)' }}</td>
              <td class="text-end fw-semibold">{{ cnt }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="text-muted small">Sem dados.</p>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

{# ── Últimos erros ─────────────────────────────────────────────── #}
{% if errors %}
<h5 class="mb-3">🔴 Últimos erros (JS + AJAX)</h5>
<div class="metric-card mb-4">
  <table class="table table-sm table-hover mb-0">
    <thead><tr><th>Tipo</th><th>Página</th><th>Mensagem</th><th>Usuário</th><th>Data</th></tr></thead>
    <tbody>
      {% for e in errors|slice(0, 50) %}
        {# dataDecoded é fornecido pelo controller como array já decodificado #}
        {% set d = e.dataDecoded ?? {} %}
        <tr class="tw-log-row">
          <td><span class="event-badge badge-error">{{ e.type }}</span></td>
          <td class="text-truncate" style="max-width:200px" title="{{ e.page }}">{{ e.page }}</td>
          <td class="text-truncate" style="max-width:300px" title="{{ d.message ?? '' }}">{{ d.message ?? d.error ?? '—' }}</td>
          <td>{{ e.user_id ? '#'~e.user_id : 'guest' }}</td>
          <td><span data-utc="{{ e.created_at }}">{{ e.created_at }}</span></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# ── Log completo ────────────────────────────────────────────────── #}
<h5 class="mb-3">📋 Log de eventos</h5>
<div class="metric-card">
  <table class="table table-sm table-hover mb-0" id="eventsTable">
    <thead><tr><th>Tipo</th><th>Página</th><th>Sessão</th><th>Usuário</th><th>Data</th></tr></thead>
    <tbody>
      {% for e in events %}
        {% set badgeClass = 'badge-info' %}
        {% if e.type in ['js_error','unhandled_rejection','ajax_error','web_vital_critical'] %}
          {% set badgeClass = 'badge-error' %}
        {% elseif e.type in ['ajax_slow','rage_click','form_validation_error'] %}
          {% set badgeClass = 'badge-warn' %}
        {% elseif e.type in ['page_performance','web_vitals'] %}
          {% set badgeClass = 'badge-perf' %}
        {% endif %}
        <tr class="tw-log-row" data-bs-toggle="collapse" data-bs-target="#detail-{{ loop.index }}" style="cursor:pointer">
          <td><span class="event-badge {{ badgeClass }}">{{ e.type }}</span></td>
          <td class="text-truncate" style="max-width:220px" title="{{ e.page }}">{{ e.page }}</td>
          <td class="font-monospace" style="font-size:.7rem">{{ e.session_id|slice(0,10) }}…</td>
          <td>{{ e.user_id ? '#'~e.user_id : '—' }}</td>
          <td><span data-utc="{{ e.created_at }}">{{ e.created_at }}</span></td>
        </tr>
        <tr class="collapse" id="detail-{{ loop.index }}">
          <td colspan="5">
            {#
              JSON_PRETTY_PRINT = 128, JSON_UNESCAPED_UNICODE = 256
              128 | 256 = 384 — flag combinada sem precisar de bitor (inexistente no Twig)
            #}
            <pre class="mb-0 p-2" style="font-size:.72rem;white-space:pre-wrap;background:var(--bs-tertiary-bg,#f5f5f5);border-radius:.4rem">{{ e.data|json_encode(384) }}</pre>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="text-center text-muted py-4">Nenhum evento no período.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
(function(){
  var byType = {{ byType|json_encode|raw }};
  var labels = Object.keys(byType);
  var values = Object.values(byType);
  if (!labels.length) return;

  var colorMap = {
    js_error: '#dc3545', unhandled_rejection: '#c0392b', ajax_error: '#e74c3c',
    ajax_slow: '#fd7e14', rage_click: '#f39c12', form_validation_error: '#e67e22',
    page_performance: '#198754', web_vitals: '#20c997', web_vital_critical: '#ff6b6b',
    resource_error: '#6f42c1', outbound_click: '#0d6efd', session_end: '#6c757d',
  };
  var colors = labels.map(function(l){ return colorMap[l] || '#adb5bd'; });

  new Chart(document.getElementById('chartByType'), {
    type: 'doughnut',
    data: { labels: labels, datasets: [{ data: values, backgroundColor: colors, borderWidth: 1 }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'right', labels: { font: { size: 11 }, boxWidth: 12 } } }
    }
  });
}());
</script>
{% endblock %}
