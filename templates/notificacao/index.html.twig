{% extends 'base.html.twig' %}
{% block title %}Notificações — ToolboxWaze{% endblock %}

{% block body %}
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h2 class="h5 mb-4"><i class="bi bi-bell me-2"></i>Notificações</h2>

    {% if notificacoes is empty %}
      <div class="text-center py-5 text-muted">
        <i class="bi bi-bell-slash" style="font-size:2.5rem"></i>
        <p class="mt-3">Nenhuma notificação ainda.</p>
      </div>
    {% else %}
      <div class="list-group shadow-sm">
        {% for n in notificacoes %}
          <a href="{% if n.solicitacao %}{{ path('solicitacao_show', {id: n.solicitacao.id}) }}{% else %}#{% endif %}"
             class="list-group-item list-group-item-action d-flex gap-3 align-items-start py-3 {{ not n.lida ? 'list-group-item-warning' }}">
            <div class="pt-1">
              {% if n.tipo == 'nova_solicitacao' %}
                <i class="bi bi-plus-circle text-primary"></i>
              {% elseif n.tipo == 'status_alterado' %}
                <i class="bi bi-arrow-repeat text-success"></i>
              {% else %}
                <i class="bi bi-chat-dots text-info"></i>
              {% endif %}
            </div>
            <div class="flex-grow-1">
              <p class="mb-0">{{ n.mensagem }}</p>
              <small class="text-muted">{{ n.criadaEm|date('d/m/Y H:i') }}</small>
            </div>
            {% if not n.lida %}<span class="badge bg-warning text-dark ms-auto align-self-center">Nova</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
