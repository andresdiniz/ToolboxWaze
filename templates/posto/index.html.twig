{% extends 'base.html.twig' %}

{% block title %}Postos de Combustível — ToolboxWaze{% endblock %}

{% block body %}

{# ── Cabeçalho ── #}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-0 fw-bold">
            <i class="bi bi-fuel-pump text-success me-2"></i>Postos de Combustível
        </h1>
        <small class="text-muted">Dados ANP — revendedores varejistas autorizados</small>
    </div>
    <span class="badge bg-secondary">{{ total|number_format(0, ',', '.') }} registros</span>
</div>

{# ── Stats ── #}
{% if stats %}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Total</div>
            <div class="kpi-value">{{ stats.total|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Estados</div>
            <div class="kpi-value">{{ stats.estados }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Municípios</div>
            <div class="kpi-value">{{ stats.municipios|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Bandeiras</div>
            <div class="kpi-value">{{ stats.bandeiras }}</div>
        </div>
    </div>
</div>
{% endif %}

{# ── Filtros ── #}
{% set activeCount = (filters.busca ? 1 : 0) + (filters.uf ? 1 : 0) + (filters.municipio ? 1 : 0) + (filters.bandeira ? 1 : 0) %}
<div class="card mb-4">
    <div class="card-header fw-semibold py-2">
        <i class="bi bi-funnel me-1"></i>Filtros
        {% if activeCount > 0 %}
            <span class="badge bg-primary ms-1">{{ activeCount }} ativo{{ activeCount > 1 ? 's' }}</span>
        {% endif %}
    </div>
    <div class="card-body pb-2">
        <form method="get" class="filters-form">
            <div class="row g-2 align-items-end">

                <div class="col-12 col-md-3">
                    <label class="form-label mb-1 detail-label">Buscar (nome, CNPJ)</label>
                    <input type="text" name="busca" class="form-control form-control-sm"
                           placeholder="Razão social ou CNPJ" value="{{ filters.busca }}">
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 detail-label">Estado</label>
                    <select name="uf" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        {% for u in ufs %}
                            <option value="{{ u }}" {{ filters.uf == u ? 'selected' }}>{{ u }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label mb-1 detail-label">Município</label>
                    <input type="text" name="municipio" class="form-control form-control-sm"
                           placeholder="Ex: Conselheiro Lafaiete" value="{{ filters.municipio }}">
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Bandeira</label>
                    <select name="bandeira" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todas</option>
                        {% for b in bandeiras %}
                            <option value="{{ b }}" {{ filters.bandeira == b ? 'selected' }}>{{ b }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-6 col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                </div>

                {% if activeCount > 0 %}
                <div class="col-auto">
                    <a href="{{ path('posto_index') }}" class="btn btn-outline-secondary btn-sm" title="Limpar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
                {% endif %}

            </div>

            {# Tags dos filtros ativos #}
            {% if activeCount > 0 %}
            <div class="mt-2 d-flex flex-wrap gap-1">
                {% if filters.busca %}
                    <span class="badge border" style="background:var(--color-surface-2);color:var(--color-text);border-color:var(--color-border) !important">
                        Busca: <strong>{{ filters.busca }}</strong>
                        <a href="{{ path('posto_index', filters|merge({busca: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.uf %}
                    <span class="badge border" style="background:var(--color-surface-2);color:var(--color-text);border-color:var(--color-border) !important">
                        Estado: <strong>{{ filters.uf }}</strong>
                        <a href="{{ path('posto_index', filters|merge({uf: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.municipio %}
                    <span class="badge border" style="background:var(--color-surface-2);color:var(--color-text);border-color:var(--color-border) !important">
                        Município: <strong>{{ filters.municipio }}</strong>
                        <a href="{{ path('posto_index', filters|merge({municipio: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.bandeira %}
                    <span class="badge border" style="background:var(--color-surface-2);color:var(--color-text);border-color:var(--color-border) !important">
                        Bandeira: <strong>{{ filters.bandeira }}</strong>
                        <a href="{{ path('posto_index', filters|merge({bandeira: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
            </div>
            {% endif %}

        </form>
    </div>
</div>

{# ── Tabela ── #}
{% if rows is empty %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-fuel-pump fs-2 d-block mb-2"></i>
        Nenhum posto encontrado com os filtros selecionados.
        {% if activeCount > 0 %}
        <div class="mt-3">
            <a href="{{ path('posto_index') }}" class="btn btn-sm btn-outline-secondary">Limpar filtros</a>
        </div>
        {% endif %}
    </div>
{% else %}

{# Cálculo sem filtro |min (não existe no Twig nativo) #}
{% set itemFim = page * per_page %}
{% set itemFim = itemFim < total ? itemFim : total %}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold small">
            <i class="bi bi-table me-1"></i>
            Mostrando {{ ((page - 1) * per_page + 1)|number_format(0,',','.') }}–{{ itemFim|number_format(0,',','.') }}
            de {{ total|number_format(0,',','.') }}
        </span>
        {% if total > per_page %}
        <small class="text-muted">Página {{ page }} de {{ pages }}</small>
        {% endif %}
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Razão Social / Fantasia</th>
                    <th>CNPJ</th>
                    <th>Bandeira</th>
                    <th>Endereço</th>
                    <th>Município</th>
                    <th>UF</th>
                    <th>Autorização</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                <tr class="row-link" onclick="window.location='{{ path('posto_show', {id: row.id}) }}'">
                    <td>
                        <div class="fw-semibold" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ row.razao_social }}</div>
                        {% if row.nome_fantasia and row.nome_fantasia != row.razao_social %}
                            <small class="text-muted">{{ row.nome_fantasia }}</small>
                        {% endif %}
                    </td>
                    <td><code class="small">{{ row.cnpj }}</code></td>
                    <td>
                        {% if row.bandeira %}
                            <span class="badge border" style="background:var(--color-surface-2);color:var(--color-text);border-color:var(--color-border) !important">{{ row.bandeira }}</span>
                        {% else %}—{% endif %}
                    </td>
                    <td class="text-truncate" style="max-width:180px" title="{{ row.endereco }}{% if row.complemento %}, {{ row.complemento }}{% endif %}">
                        <small>{{ row.endereco }}{% if row.complemento %}, {{ row.complemento }}{% endif %}</small>
                    </td>
                    <td><small>{{ row.municipio }}</small></td>
                    <td><span class="badge badge-uf">{{ row.uf }}</span></td>
                    <td><small class="text-muted">{{ row.autorizacao ?? '—' }}</small></td>
                    <td>
                        <a href="{{ path('posto_show', {id: row.id}) }}" class="btn btn-outline-primary btn-sm py-0"
                           onclick="event.stopPropagation()">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── Paginação ── #}
    {% if pages > 1 %}
    <div class="card-footer py-2">
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0 justify-content-center flex-wrap">
                <li class="page-item {{ page == 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('posto_index', filters|merge({page: page - 1})) }}">‹ Anterior</a>
                </li>

                {% set from = max(1, page - 2) %}
                {% set to   = min(pages, page + 2) %}

                {% if from > 1 %}
                    <li class="page-item"><a class="page-link" href="{{ path('posto_index', filters|merge({page: 1})) }}">1</a></li>
                    {% if from > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                {% endif %}

                {% for p in from..to %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link" href="{{ path('posto_index', filters|merge({page: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}

                {% if to < pages %}
                    {% if to < pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                    <li class="page-item"><a class="page-link" href="{{ path('posto_index', filters|merge({page: pages})) }}">{{ pages }}</a></li>
                {% endif %}

                <li class="page-item {{ page == pages ? 'disabled' }}">
                    <a class="page-link" href="{{ path('posto_index', filters|merge({page: page + 1})) }}">Próxima ›</a>
                </li>
            </ul>
            <p class="text-center text-muted small mt-1 mb-0">
                Página {{ page }} de {{ pages }} — {{ total|number_format(0,',','.') }} registros
            </p>
        </nav>
    </div>
    {% endif %}

</div>
{% endif %}
{% endblock %}
