<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title><meta name="description" content="{{ description }}">
<meta name="robots" content="{{ detail ? 'index,follow' : (app.request.query.count > 0 ? 'noindex,follow' : 'index,follow') }}">
<meta name="theme-color" content="#143e42"><link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website"><meta property="og:locale" content="pt_BR"><meta property="og:site_name" content="ToolboxWaze">
<meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description }}"><meta property="og:url" content="{{ canonical }}">
<meta name="twitter:card" content="summary"><meta name="twitter:title" content="{{ title }}"><meta name="twitter:description" content="{{ description }}">
<script type="application/ld+json">{{ jsonld|raw }}</script>
<style>
:root{color-scheme:light;--ink:#143038;--muted:#506970;--line:#dbe6e7;--accent:#12685c}*{box-sizing:border-box}body{margin:0;background:#f3f7f7;color:var(--ink);font:16px/1.65 system-ui,sans-serif}a{color:#075f70;text-underline-offset:4px}button,input,select{font:inherit}button,.button{cursor:pointer}.wrap{width:min(1140px,calc(100% - 32px));margin:auto}.skip{position:absolute;top:-100px}.skip:focus{top:0;background:white;padding:12px;z-index:1000}header{background:#fff;border-bottom:1px solid var(--line)}header .wrap{display:flex;justify-content:space-between;align-items:center;gap:18px;padding-block:17px}.brand{font-size:1.25rem;font-weight:850;text-decoration:none;color:var(--ink)}nav,.actions,.pagination{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.hero{background:linear-gradient(120deg,#103c44,#166a5d);padding:48px 0;color:white}.hero h1{font-size:clamp(1.8rem,4vw,3rem);line-height:1.15;max-width:900px;margin:10px 0 16px;overflow-wrap:anywhere}.hero p{max-width:790px;color:#e0f5ef}.eyebrow{font-size:.77rem;letter-spacing:.12em;font-weight:800}.hero a{color:#e5fff5}main{padding-block:28px 60px}.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px;margin-bottom:24px;box-shadow:0 8px 28px #14303808}.panel h2{font-size:1.3rem;margin-top:0}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.wide{grid-column:span 2}label{display:grid;gap:6px;font-size:.87rem;font-weight:650}input,select{width:100%;min-height:46px;border:1px solid #a9bec1;border-radius:9px;padding:9px 11px;background:white;color:var(--ink)}.button,button{display:inline-flex;justify-content:center;align-items:center;min-height:44px;border:1px solid var(--accent);border-radius:9px;padding:8px 17px;background:var(--accent);color:white;text-decoration:none;font-weight:650}.secondary{background:white;color:var(--accent)}.actions{margin-top:20px}small,.muted{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.cards .panel{margin:0}.cards h2{margin:12px 0;font-size:1.15rem}.badge{display:inline-block;padding:4px 10px;border-radius:30px;background:#e8f4f0;color:#225a4b;font-size:.8rem;font-weight:700}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:0}.facts div{padding:12px;background:#f5f9f9;border-radius:9px;overflow-wrap:anywhere}dt{font-size:.8rem;color:var(--muted)}dd{margin:3px 0 0;font-weight:650}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;text-align:left;font-size:.9rem}caption{text-align:left;color:var(--muted);padding-bottom:10px}th,td{padding:12px;border-bottom:1px solid var(--line);white-space:nowrap}th{background:#f0f6f5}.history{padding:16px 0;border-bottom:1px solid var(--line)}.history h3{margin:0;font-size:1rem}.history p{margin:5px 0}.pagination{margin-top:24px}.pagination a,.pagination strong{padding:8px 14px;background:white;border:1px solid var(--line);border-radius:8px}.ad{min-height:110px;display:grid;place-items:center;border:1px dashed #a9bec1;border-radius:12px;color:var(--muted);font-size:.75rem;margin:24px 0}.map{height:380px;border-radius:12px;background:#e9f1ef;margin-top:16px}.map-note{font-size:.85rem}.breadcrumb{font-size:.85rem;margin-bottom:18px}.history time{white-space:nowrap}footer{padding:32px 0;background:#153a40;color:#d8eeea}footer a{color:white}:focus-visible{outline:3px solid #cc8700;outline-offset:4px}[hidden]{display:none!important}@media(max-width:800px){.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.facts{grid-template-columns:repeat(2,minmax(0,1fr))}header .wrap{align-items:flex-start;flex-direction:column}}@media(max-width:540px){.form-grid,.cards,.facts{grid-template-columns:1fr}.wide{grid-column:auto}.panel{padding:18px}.hero{padding:30px 0}.map{height:300px}.wrap{width:calc(100% - 24px)}nav{gap:14px}}@media(prefers-reduced-motion:no-preference){.panel{animation:appear .22s ease-out}@keyframes appear{from{opacity:.5;transform:translateY(5px)}to{opacity:1;transform:none}}}
</style>
<script defer src="{{ asset('js/public-radar.js') }}"></script>
</head>
<body><a class="skip" href="#content">Pular para o conteúdo</a>
<header><div class="wrap"><a class="brand" href="{{ path('public_radar_index') }}">ToolboxWaze</a><nav aria-label="Áreas públicas"><a href="{{ path('public_radar_index') }}" aria-current="page">Radares</a><a href="{{ path('consulta_publica', {tipo:'escola'}) }}">Escolas</a><a href="{{ path('consulta_publica', {tipo:'posto'}) }}">Postos</a><a href="{{ path('consulta_publica') }}">Consulta geral</a></nav></div></header>
<section class="hero"><div class="wrap"><span class="eyebrow">CONSULTA PÚBLICA · GRATUITA · SEM LOGIN</span><h1>{{ detail ? radar.logradouro|default('Radar #' ~ radar.id, true) : 'Encontre informações sobre radares no Brasil' }}</h1><p>{{ detail ? (radar.municipio|default('Município não informado', true) ~ ' — ' ~ radar.uf) : 'Pesquise endereço, rodovia, km, número INMETRO, série e certificado. Confira faixas, validade e histórico de verificações.' }}</p>{% if detail %}<span class="badge">{{ radar.situacao|default('Situação não informada', true) }}</span>{% endif %}</div></section>
<main id="content" class="wrap">
{% if not detail %}
<section class="panel" aria-labelledby="search-title"><h2 id="search-title">Buscar radares</h2><p class="muted">Os filtros são opcionais. Rodovia e km pesquisam o texto do logradouro; não representam uma busca por distância.</p>
<form method="get" action="{{ path('public_radar_index') }}" data-radar-form>
<div class="form-grid">
<label class="wide">Busca livre<input type="search" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Endereço, INMETRO, série, certificado ou ID"></label>
<label>Estado<select name="uf"><option value="">Todos os estados</option>{% for uf in states %}<option value="{{ uf }}"{{ filters.uf == uf ? ' selected' : '' }}>{{ uf }}</option>{% endfor %}</select></label>
<label>Município<input name="municipio" value="{{ filters.municipio }}" maxlength="100" list="radar-cities" placeholder="Nome completo do município"><datalist id="radar-cities"></datalist></label>
<label>Rodovia<input name="rodovia" value="{{ filters.rodovia }}" maxlength="40" placeholder="BR 364"></label><label>KM<input name="km" value="{{ filters.km }}" maxlength="20" placeholder="123,830" inputmode="decimal"></label>
<label>Situação<select name="situacao"><option value="">Todas</option>{% for v in options.situacao %}<option value="{{ v }}"{{ filters.situacao == v ? ' selected' : '' }}>{{ v }}</option>{% endfor %}</select></label>
<label>Tipo de medidor<select name="tipo_medidor"><option value="">Todos</option>{% for v in options.tipoMedidor %}<option value="{{ v }}"{{ filters.tipo_medidor == v ? ' selected' : '' }}>{{ v }}</option>{% endfor %}</select></label>
<label>Sentido<input name="sentido" value="{{ filters.sentido }}" maxlength="50" placeholder="CRESCENTE" list="radar-directions"><datalist id="radar-directions"><option value="CRESCENTE"><option value="DECRESCENTE"></datalist></label>
<label>Velocidade nominal<input name="velocidade" value="{{ filters.velocidade }}" maxlength="20" placeholder="40" inputmode="numeric"><small>Valor cadastrado na faixa</small></label>
<label class="wide">Empresa / proprietário<input name="empresa" value="{{ filters.empresa }}" maxlength="120" placeholder="Nome da empresa"></label>
<label>Certificado<input name="certificado" value="{{ filters.certificado }}" maxlength="50"></label><label>Ano da verificação<input name="ano" value="{{ filters.ano }}" pattern="[0-9]{4}" maxlength="4" inputmode="numeric" placeholder="2026"></label>
<label>Validade a partir de<input type="date" name="validade_de" value="{{ filters.validade_de }}"></label><label>Validade até<input type="date" name="validade_ate" value="{{ filters.validade_ate }}"></label>
<label>Ordenar por<select name="ordenar">{% for key,label in {municipio:'Município',logradouro:'Logradouro (texto)',validade:'Validade',atualizacao:'Atualização do cadastro'} %}<option value="{{ key }}"{{ filters.ordenar == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
</div><div class="actions"><button type="submit">Consultar radares</button><a class="button secondary" href="{{ path('public_radar_index') }}">Limpar filtros</a><button class="secondary" type="button" data-share>Compartilhar busca</button></div><p data-feedback role="status" aria-live="polite"></p>
</form></section>
<aside class="ad" aria-label="Espaço reservado para publicidade">Espaço reservado para publicidade</aside>
<section aria-labelledby="results-title"><h2 id="results-title">{{ total|number_format(0, ',', '.') }} {{ total == 1 ? 'radar encontrado' : 'radares encontrados' }}</h2><p class="muted">Página {{ page }} de {{ pages }}. Cada equipamento aparece uma única vez, independentemente do número de faixas.</p>
<div class="cards">{% for item in items %}<article class="panel"><span class="badge">{{ item.situacao|default('Não informada', true) }}</span><h2><a href="{{ path('public_radar_show', {id:item.id}) }}">{{ item.logradouro|default('Radar #' ~ item.id, true) }}</a></h2><p>{{ item.municipio|default('Município não informado', true) }} — {{ item.uf }}</p><p><strong>{{ item.tipoMedidor|default('Tipo não informado', true) }}</strong> · ID #{{ item.id }}<br>Validade informada: {{ item.dataValidade|default('—', true) }}</p><a class="button secondary" href="{{ path('public_radar_show', {id:item.id}) }}">Ver faixas e verificações</a></article>{% else %}<div class="panel"><h2>Nenhum resultado encontrado</h2><p>Amplie a busca ou retire algum filtro. Para rodovias, tente a grafia usada no cadastro, como BR 364.</p></div>{% endfor %}</div>
{% set query = filters|filter(v => v != '') %}<nav class="pagination" aria-label="Paginação">{% if page > 1 %}<a href="{{ path('public_radar_index', query|merge({page:1})) }}">Primeira</a><a rel="prev" href="{{ path('public_radar_index', query|merge({page:page-1})) }}">Anterior</a>{% endif %}<strong aria-current="page">{{ page }} / {{ pages }}</strong>{% if page < pages %}<a rel="next" href="{{ path('public_radar_index', query|merge({page:page+1})) }}">Próxima</a>{% endif %}</nav></section>
{% else %}
<nav class="breadcrumb" aria-label="Caminho de navegação"><a href="{{ path('public_radar_index') }}">Radares</a> / <a href="{{ path('public_radar_index', {uf:radar.uf,municipio:radar.municipio}) }}">{{ radar.municipio }} — {{ radar.uf }}</a> / #{{ radar.id }}</nav>
<div class="actions"><a class="button secondary" href="{{ path('public_radar_index') }}">Nova busca</a><button type="button" data-share>Compartilhar ficha</button><button class="secondary" type="button" data-copy-link>Copiar link</button><a href="https://wa.me/?text={{ (title ~ ' ' ~ canonical)|url_encode }}" target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="https://t.me/share/url?url={{ canonical|url_encode }}&text={{ title|url_encode }}" target="_blank" rel="noopener noreferrer">Telegram</a></div><p data-feedback role="status" aria-live="polite"></p>
<section class="panel"><h2>Dados gerais</h2><dl class="facts">{% for label,value in {'ID':'#' ~ radar.id,'Tipo de medidor':radar.tipo,'Situação':radar.situacao,'Última verificação':radar.ultimaVerificacao,'Validade':radar.validade,'Estado (UF)':radar.uf,'Município':radar.municipio,'Logradouro':radar.logradouro,'CEP':radar.cep} %}<div><dt>{{ label }}</dt><dd>{{ value|default('—', true) }}</dd></div>{% endfor %}</dl></section>
<section class="panel"><h2>Empresa / proprietário</h2><dl class="facts"><div><dt>Nome</dt><dd>{{ radar.empresa|default('—', true) }}</dd></div><div><dt>CNPJ</dt><dd>{{ radar.cnpj|default('—', true) }}</dd></div></dl></section>
<section class="panel"><h2>Faixas ({{ lanes|length }})</h2><div class="table-wrap" tabindex="0" role="region" aria-label="Tabela de faixas"><table><caption>Dados cadastrados por faixa do medidor</caption><thead><tr>{% for label in ['Faixa','Nº INMETRO','Nº série','Sentido','Vel. nominal'] %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for lane in lanes %}<tr><td>{{ lane.numeroFaixa|default('—', true) }}</td><td>{{ lane.numeroInmetro|default('—', true) }}</td><td>{{ lane.numeroSerie|default('—', true) }}</td><td>{{ lane.sentido|default('—', true) }}</td><td>{{ lane.velocidadeNominal|default('—', true) }}</td></tr>{% else %}<tr><td colspan="5">Nenhuma faixa cadastrada.</td></tr>{% endfor %}</tbody></table></div></section>
<aside class="ad" aria-label="Espaço reservado para publicidade">Espaço reservado para publicidade</aside>
<section class="panel"><h2>Histórico de verificações ({{ history|length }})</h2>{% for entry in history %}<article class="history"><h3>{{ entry.tipoServico|default('Verificação', true) }} — {{ entry.ano|default('—', true) }}</h3><p>Certificado: {{ entry.numeroCertificado|default('—', true) }} | Ensaio: {{ entry.numeroEnsaio|default('—', true) }}</p><p>Laudo: {{ entry.dataLaudo|default('—', true) }} | Validade: {{ entry.dataValidade|default('—', true) }}</p></article>{% else %}<p>Nenhuma verificação histórica cadastrada.</p>{% endfor %}</section>
<section class="panel" aria-labelledby="map-title"><h2 id="map-title">Localização de referência</h2>{% if coords %}<p class="map-note"><strong>Fonte das coordenadas: Editores Waze Brasil.</strong><br>Posição extraída do centro do permalink cadastrado no Waze; pode não coincidir com a posição exata do equipamento.</p><button type="button" class="secondary" data-load-map>Carregar mapa</button><p class="muted map-note">Ao carregar, seu navegador acessará Leaflet via unpkg e os mapas do OpenStreetMap.</p><div class="map" data-radar-map data-lat="{{ coords.lat }}" data-lon="{{ coords.lon }}" hidden role="region" aria-label="Mapa da localização de referência"></div><noscript><p>Ative JavaScript para visualizar o mapa.</p></noscript>{% else %}<p>Coordenadas válidas não disponíveis no vínculo atual. Não estimamos a localização pelo endereço.</p>{% endif %}</section>
{% endif %}
<section class="panel"><h2>Como interpretar os dados</h2><p>Fonte dos dados cadastrais: PSIE/INMETRO. Situação, datas e velocidades refletem o cadastro disponível no ToolboxWaze; campos sem informação aparecem como “—”.</p><p>“Aprovado” é a situação cadastrada, não uma confirmação em tempo real de funcionamento. Datas de validade não substituem documentos oficiais, sinalização da via ou análise do órgão responsável.</p><p>Os nomes individuais de editores, contas e históricos internos de edição não são exibidos nesta área pública. O ToolboxWaze é um projeto independente, sem apresentação como site oficial do Waze ou do INMETRO.</p></section>
</main><footer><div class="wrap"><strong>ToolboxWaze · Informação pública acessível</strong><p>Consulta gratuita e sem login. Confirme informações relevantes na fonte oficial.</p><a href="{{ path('public_radar_index') }}">Consultar outro radar</a> · <a href="{{ path('consulta_publica') }}">Outras consultas</a></div></footer></body></html>
