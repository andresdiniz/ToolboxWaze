{% extends 'base.html.twig' %}

{% block title %}Radares Medidores — ToolboxWaze{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/radar.css') }}">
{% endblock %}

{% block body %}

{# ── Cabeçalho ── #}
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 mb-0 fw-bold">
            <i class="bi bi-camera-video text-success me-2"></i>Radares Medidores
        </h1>
        <small class="text-muted">Dados RBMLQ — atualizados por estado</small>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge bg-secondary fs-6">{{ total|number_format(0, ',', '.') }} registros</span>
        <a href="{{ path('radar_manual_lista') }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-list-ul me-1"></i>Lista Manual
        </a>
        <a href="{{ path('radar_manual_novo') }}" class="btn btn-sm btn-success">
            <i class="bi bi-plus-lg me-1"></i>Adicionar Radar
        </a>
    </div>
</div>

{# ── Stats com ícones e cores ── #}
{% if stats %}
<div class="row g-3 mb-4">
    <div class="col-6 col-sm-4 col-md-2">
        <div class="stat-card text-center p-3">
            <i class="bi bi-camera-video fs-2 text-primary d-block mb-2"></i>
            <div class="stat-label text-uppercase small text-muted">Total</div>
            <div class="stat-value fw-bold fs-3">{{ stats.total|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="stat-card text-center p-3 border-success border-opacity-50">
            <i class="bi bi-check-circle-fill fs-2 text-success d-block mb-2"></i>
            <div class="stat-label text-uppercase small text-success">Aprovados</div>
            <div class="stat-value fw-bold fs-3 text-success">{{ stats.aprovados|default(0)|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="stat-card text-center p-3 border-danger border-opacity-50">
            <i class="bi bi-x-circle-fill fs-2 text-danger d-block mb-2"></i>
            <div class="stat-label text-uppercase small text-danger">Reprovados</div>
            <div class="stat-value fw-bold fs-3 text-danger">{{ stats.reprovados|default(0)|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="stat-card text-center p-3 border-danger border-opacity-25">
            <i class="bi bi-clock-history fs-2 text-danger d-block mb-2"></i>
            <div class="stat-label text-uppercase small text-danger">Vencidos</div>
            <div class="stat-value fw-bold fs-3 text-danger">{{ stats.vencidos|default(0)|number_format(0,',','.') }}</div>
            <div class="text-muted" style="font-size:.7rem">validade expirada</div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="stat-card text-center p-3 border-warning border-opacity-50">
            <i class="bi bi-hourglass-split fs-2 text-warning d-block mb-2"></i>
            <div class="stat-label text-uppercase small text-warning">Vencendo</div>
            <div class="stat-value fw-bold fs-3 text-warning">{{ stats.vencendo|default(0)|number_format(0,',','.') }}</div>
            <div class="text-muted" style="font-size:.7rem">próx. 30 dias</div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="stat-card text-center p-3 border-info border-opacity-50">
            <i class="bi bi-geo-alt fs-2 text-info d-block mb-2"></i>
            <div class="stat-label text-uppercase small text-info">Estados</div>
            <div class="stat-value fw-bold fs-3 text-info">{{ stats.estados }}</div>
        </div>
    </div>
</div>
{% endif %}

{# ── Filtros ── #}
<div class="card mb-4">
    <div class="card-header fw-semibold py-2">
        <i class="bi bi-funnel me-1"></i>Filtros
        {% set activeCount = (filters.uf ? 1 : 0) + (filters.municipio ? 1 : 0) + (filters.resultado ? 1 : 0) + (filters.tipo ? 1 : 0) + (filters.validade ? 1 : 0) + (filters.serie ? 1 : 0) %}
        {% if activeCount > 0 %}
            <span class="badge bg-primary ms-1">{{ activeCount }} ativo{{ activeCount > 1 ? 's' }}</span>
        {% endif %}
    </div>
    <div class="card-body pb-2">
        <form method="get" class="filters-form" id="filterForm">
            <div class="row g-2 align-items-end">

                <div class="col-6 col-md-1">
                    <label class="form-label mb-1 detail-label">Estado</label>
                    <select name="uf" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        {% for u in ufs %}
                            <option value="{{ u }}" {{ filters.uf == u ? 'selected' }}>{{ u }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Município</label>
                    <input type="text" name="municipio" class="form-control form-control-sm"
                           placeholder="Ex: São Paulo" value="{{ filters.municipio }}">
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 detail-label">Resultado</label>
                    <select name="resultado" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        {% for r in resultados %}
                            <option value="{{ r }}" {{ filters.resultado == r ? 'selected' }}>{{ r }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Tipo Medidor</label>
                    <select name="tipo" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        {% for t in tipos %}
                            <option value="{{ t }}" {{ filters.tipo == t ? 'selected' }}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 detail-label">Validade / Verificação</label>
                    <select name="validade" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todas</option>
                        <option value="valido"      {{ filters.validade == 'valido'      ? 'selected' }}>✓ Dentro do prazo</option>
                        <option value="30dias"      {{ filters.validade == '30dias'      ? 'selected' }}>⚠ Vence em 30 dias</option>
                        <option value="vencido"     {{ filters.validade == 'vencido'     ? 'selected' }}>✗ Vencido</option>
                        <option value="recentes30"  {{ filters.validade == 'recentes30'  ? 'selected' }}>🕐 Verificados (últ. 30 dias)</option>
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Nº Série / Inmetro</label>
                    <input type="text" name="serie" class="form-control form-control-sm"
                           placeholder="Ex: 12345" value="{{ filters.serie }}">
                </div>

                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1" title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>
                    {% if activeCount > 0 %}
                    <a href="{{ path('radar_index') }}" class="btn btn-outline-secondary btn-sm" title="Limpar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                    {% endif %}
                </div>

            </div>

            {# Tags dos filtros ativos #}
            {% if activeCount > 0 %}
            <div class="mt-2 d-flex flex-wrap gap-1">
                {% if filters.uf %}
                    <span class="filter-tag">
                        Estado: <strong>{{ filters.uf }}</strong>
                        <a href="{{ path('radar_index', filters|merge({uf: '', page: 1})) }}" class="remove">×</a>
                    </span>
                {% endif %}
                {% if filters.municipio %}
                    <span class="filter-tag">
                        Município: <strong>{{ filters.municipio }}</strong>
                        <a href="{{ path('radar_index', filters|merge({municipio: '', page: 1})) }}" class="remove">×</a>
                    </span>
                {% endif %}
                {% if filters.resultado %}
                    <span class="filter-tag">
                        Resultado: <strong>{{ filters.resultado }}</strong>
                        <a href="{{ path('radar_index', filters|merge({resultado: '', page: 1})) }}" class="remove">×</a>
                    </span>
                {% endif %}
                {% if filters.tipo %}
                    <span class="filter-tag">
                        Tipo: <strong>{{ filters.tipo }}</strong>
                        <a href="{{ path('radar_index', filters|merge({tipo: '', page: 1})) }}" class="remove">×</a>
                    </span>
                {% endif %}
                {% if filters.validade %}
                    {% set labelValidade = {valido: 'Dentro do prazo', vencido: 'Vencido', '30dias': 'Vence em 30 dias', recentes30: 'Verificados (últ. 30 dias)'} %}
                    <span class="filter-tag">
                        Validade: <strong>{{ labelValidade[filters.validade] ?? filters.validade }}</strong>
                        <a href="{{ path('radar_index', filters|merge({validade: '', page: 1})) }}" class="remove">×</a>
                    </span>
                {% endif %}
                {% if filters.serie %}
                    <span class="filter-tag">
                        Nº Série: <strong>{{ filters.serie }}</strong>
                        <a href="{{ path('radar_index', filters|merge({serie: '', page: 1})) }}" class="remove">×</a>
                    </span>
                {% endif %}
            </div>
            {% endif %}

        </form>
    </div>
</div>

{# ── Aviso UFs restritas ── #}
{% if allowedUfs is not null and allowedUfs|length > 0 %}
<div class="alert alert-info py-2 px-3 mb-3 small">
    <i class="bi bi-shield-lock me-1"></i>
    Exibindo apenas dados dos estados autorizados para sua conta:
    {% for uf in allowedUfs %}
        <span class="badge bg-primary ms-1">{{ uf }}</span>
    {% endfor %}
</div>
{% endif %}

{# ── Barra flutuante de mesclagem ── #}
<div id="mergeBar"
     data-merge-url="{{ path('radar_merge_index') }}"
     style="display:none"
     aria-live="polite">
    <div class="card shadow-lg border-warning border-2">
        <div class="card-body py-2 px-3 d-flex align-items-center gap-3 flex-wrap">
            <i class="bi bi-intersect fs-5 text-warning"></i>
            <span class="fw-semibold small">
                <span id="mergeCount">0</span> radares selecionados
            </span>
            <div id="mergeChips" class="d-flex gap-1 flex-wrap"></div>
            <div class="ms-auto d-flex gap-2">
                <button type="button" id="btnClearMerge" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Limpar
                </button>
                <button type="button" id="btnGoMerge" class="btn btn-sm btn-warning fw-semibold">
                    <i class="bi bi-intersect me-1"></i>Mesclar
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Tabela ── #}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold small">
            <i class="bi bi-table me-1"></i>
            {% if total > 0 %}
                Mostrando {{ ((page-1)*per_page + 1)|number_format(0,',','.') }}–{{ min(page*per_page, total)|number_format(0,',','.') }}
                de {{ total|number_format(0,',','.') }}
            {% else %}
                Nenhum registro encontrado
            {% endif %}
        </span>
        {% if total > per_page %}
        <small class="text-muted">Página {{ page }} de {{ pages }}</small>
        {% endif %}
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle radar-table" id="radarTable">
            <thead>
                <tr>
                    <th class="ps-2" style="width:36px">
                        <input type="checkbox" id="checkAll" class="form-check-input"
                               title="Selecionar todos da página" aria-label="Selecionar todos">
                    </th>
                    <th class="ps-2">UF</th>
                    <th>Município</th>
                    <th>Local / Logradouro</th>
                    <th>Tipo</th>
                    <th>Situação</th>
                    <th data-sortable="6" style="cursor:pointer;user-select:none;white-space:nowrap">
                        Ú. Verificação <span class="sort-icon ms-1 text-muted">↕</span>
                    </th>
                    <th data-sortable="7" style="cursor:pointer;user-select:none;white-space:nowrap">
                        Validade <span class="sort-icon ms-1 text-muted">↕</span>
                    </th>
                    <th>Empresa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                {% set dvIso = row.data_validade_iso ?? '' %}

                {% set dataVerifExibir = row.data_ultima_verificacao is not empty
                    ? row.data_ultima_verificacao
                    : (row.data_verificacao_efetiva is not empty ? row.data_verificacao_efetiva : null) %}

                {% set dveRaw = row.data_verificacao_efetiva ?? '' %}
                {% set dveIso = '' %}
                {% if dveRaw matches '#^[0-9]{2}/[0-9]{2}/[0-9]{4}$#' %}
                    {% set dveParts = dveRaw|split('/') %}
                    {% set dveIso = dveParts[2] ~ '-' ~ dveParts[1] ~ '-' ~ dveParts[0] %}
                {% endif %}
                {% set isRecente = dveIso != '' and dveIso >= ha30dias and dveIso <= hoje %}

                {# ISO para Ú. Verificação: prefere data_ultima_verificacao convertida, depois dveIso #}
                {% set uvRaw = row.data_ultima_verificacao ?? '' %}
                {% set uvIso = '' %}
                {% if uvRaw matches '#^[0-9]{2}/[0-9]{2}/[0-9]{4}$#' %}
                    {% set uvParts = uvRaw|split('/') %}
                    {% set uvIso = uvParts[2] ~ '-' ~ uvParts[1] ~ '-' ~ uvParts[0] %}
                {% elseif dveIso != '' %}
                    {% set uvIso = dveIso %}
                {% endif %}

                <tr class="radar-row" data-id="{{ row.id }}" data-label="#{{ row.id }} {{ row.sigla_uf }} – {{ row.municipio }}">
                    <td class="ps-2">
                        <input type="checkbox"
                               class="form-check-input radar-check"
                               value="{{ row.id }}"
                               aria-label="Selecionar radar #{{ row.id }}">
                    </td>
                    <td class="ps-2">
                        <span class="badge-uf">{{ row.sigla_uf }}</span>
                    </td>
                    <td class="text-nowrap">{{ row.municipio }}</td>
                    <td style="max-width:220px">
                        <span class="d-block text-truncate" title="{{ row.logradouro }}">{{ row.logradouro ?? '—' }}</span>
                    </td>
                    <td class="text-muted small text-nowrap">{{ row.tipo_medidor ?? '—' }}</td>
                    <td>
                        {% if row.situacao == 'APROVADO' %}
                            <span class="badge badge-aprovado"><i class="bi bi-check-circle me-1"></i>Aprovado</span>
                        {% elseif row.situacao == 'REPROVADO' %}
                            <span class="badge badge-reprovado"><i class="bi bi-x-circle me-1"></i>Reprovado</span>
                        {% else %}
                            <span class="text-muted small">{{ row.situacao ?? '—' }}</span>
                        {% endif %}
                    </td>
                    <td class="text-nowrap" data-sort="{{ uvIso }}">
                        <span class="text-muted small">{{ dataVerifExibir ?? '—' }}</span>
                        {% if row.data_ultima_verificacao is empty and row.data_verificacao_efetiva is not empty %}
                            <span class="badge bg-secondary ms-1" style="font-size:.65rem" title="Calculado: validade − 1 ano">calc.</span>
                        {% endif %}
                        {% if isRecente %}
                            <span class="badge bg-info text-dark ms-1" style="font-size:.65rem">Recente</span>
                        {% endif %}
                    </td>
                    <td class="text-nowrap" data-sort="{{ dvIso }}">
                        {% if row.data_validade and dvIso %}
                            {% if dvIso < hoje %}
                                <span class="text-danger small"><i class="bi bi-exclamation-triangle-fill me-1"></i>{{ row.data_validade }}</span>
                            {% elseif dvIso <= em30 %}
                                <span class="text-warning small"><i class="bi bi-clock me-1"></i>{{ row.data_validade }}</span>
                            {% else %}
                                <span class="text-success small"><i class="bi bi-check me-1"></i>{{ row.data_validade }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted small">—</span>
                        {% endif %}
                    </td>
                    <td class="text-muted small" style="max-width:160px">
                        <span class="d-block text-truncate" title="{{ row.nome_empresa }}">{{ row.nome_empresa ?? '—' }}</span>
                    </td>
                    <td class="text-end pe-3">
                        <a href="{{ path('radar_show', {id: row.id}) }}"
                           class="btn btn-sm btn-outline-primary py-0 px-2">
                            <i class="bi bi-eye me-1"></i>Ver
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="10" class="text-center text-muted py-5">
                        <i class="bi bi-camera-video-off d-block mb-2" style="font-size:2rem"></i>
                        Nenhum radar encontrado com os filtros aplicados.
                        {% if activeCount > 0 %}
                            <div class="mt-2">
                                <a href="{{ path('radar_index') }}" class="btn btn-sm btn-outline-secondary">Limpar filtros</a>
                            </div>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Paginação #}
    {% if pages > 1 %}
    <div class="card-footer py-2">
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0 justify-content-center flex-wrap">
                <li class="page-item {{ page <= 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('radar_index', filters|merge({page: page-1})) }}">‹ Anterior</a>
                </li>

                {% set startPage = max(1, page - 2) %}
                {% set endPage   = min(pages, page + 2) %}

                {% if startPage > 1 %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('radar_index', filters|merge({page: 1})) }}">1</a>
                    </li>
                    {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                {% endif %}

                {% for p in startPage..endPage %}
                <li class="page-item {{ p == page ? 'active' }}">
                    <a class="page-link" href="{{ path('radar_index', filters|merge({page: p})) }}">{{ p }}</a>
                </li>
                {% endfor %}

                {% if endPage < pages %}
                    {% if endPage < pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('radar_index', filters|merge({page: pages})) }}">{{ pages }}</a>
                    </li>
                {% endif %}

                <li class="page-item {{ page >= pages ? 'disabled' }}">
                    <a class="page-link" href="{{ path('radar_index', filters|merge({page: page+1})) }}">Próxima ›</a>
                </li>
            </ul>
        </nav>
    </div>
    {% endif %}
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/radar.js') }}" defer></script>
{% endblock %}