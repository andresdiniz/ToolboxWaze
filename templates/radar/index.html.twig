{% extends 'base.html.twig' %}

{% block title %}Radares Medidores — ToolboxWaze{% endblock %}

{% block body %}

{# ── Cabeçalho ── #}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-0 fw-bold">
            <i class="bi bi-camera-video text-success me-2"></i>Radares Medidores
        </h1>
        <small class="text-muted">Dados RBMLQ — atualizados por estado</small>
    </div>
    <span class="badge bg-secondary fs-6">{{ total|number_format(0, ',', '.') }} registros</span>
</div>

{# ── Stats ── #}
{% if stats %}
<div class="row g-3 mb-4">
    <div class="col-6 col-md col-sm-4">
        <div class="card stat-card p-3 h-100">
            <div class="detail-label">Total</div>
            <div class="stat-value">{{ stats.total|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-md col-sm-4">
        <div class="card p-3 h-100" style="border-left:3px solid #198754">
            <div class="detail-label">Aprovados</div>
            <div class="stat-value" style="color:#198754">{{ stats.aprovados|default(0)|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-md col-sm-4">
        <div class="card p-3 h-100" style="border-left:3px solid #dc3545">
            <div class="detail-label">Reprovados</div>
            <div class="stat-value" style="color:#dc3545">{{ stats.reprovados|default(0)|number_format(0,',','.') }}</div>
        </div>
    </div>
    <div class="col-6 col-md col-sm-4">
        <div class="card p-3 h-100" style="border-left:3px solid #dc3545">
            <div class="detail-label">Vencidos</div>
            <div class="stat-value" style="color:#dc3545">{{ stats.vencidos|default(0)|number_format(0,',','.') }}</div>
            <div style="font-size:.7rem" class="text-muted">validade expirada</div>
        </div>
    </div>
    <div class="col-6 col-md col-sm-4">
        <div class="card p-3 h-100" style="border-left:3px solid #fd7e14">
            <div class="detail-label">Vencendo</div>
            <div class="stat-value" style="color:#fd7e14">{{ stats.vencendo|default(0)|number_format(0,',','.') }}</div>
            <div style="font-size:.7rem" class="text-muted">próx. 30 dias</div>
        </div>
    </div>
    <div class="col-6 col-md col-sm-4">
        <div class="card p-3 h-100" style="border-left:3px solid #6c757d">
            <div class="detail-label">Estados</div>
            <div class="stat-value" style="color:#6c757d">{{ stats.estados }}</div>
        </div>
    </div>
</div>
{% endif %}

{# ── Filtros ── #}
<div class="card mb-4">
    <div class="card-header fw-semibold py-2">
        <i class="bi bi-funnel me-1"></i>Filtros
        {% set activeCount = (filters.uf ? 1 : 0) + (filters.municipio ? 1 : 0) + (filters.resultado ? 1 : 0) + (filters.tipo ? 1 : 0) + (filters.validade ? 1 : 0) + (filters.serie ? 1 : 0) %}
        {% if activeCount > 0 %}
            <span class="badge bg-primary ms-1">{{ activeCount }} ativo{{ activeCount > 1 ? 's' }}</span>
        {% endif %}
    </div>
    <div class="card-body">
        <form method="get" class="filters-form" id="filterForm">
            <div class="row g-2 align-items-end">

                <div class="col-6 col-md-1">
                    <label class="form-label mb-1 detail-label">Estado</label>
                    <select name="uf" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        {% for u in ufs %}
                            <option value="{{ u }}" {{ filters.uf == u ? 'selected' }}>{{ u }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Município</label>
                    <input type="text" name="municipio" class="form-control form-control-sm"
                           placeholder="Ex: São Paulo" value="{{ filters.municipio }}">
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 detail-label">Resultado</label>
                    <select name="resultado" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        {% for r in resultados %}
                            <option value="{{ r }}" {{ filters.resultado == r ? 'selected' }}>{{ r }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Tipo Medidor</label>
                    <select name="tipo" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        {% for t in tipos %}
                            <option value="{{ t }}" {{ filters.tipo == t ? 'selected' }}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 detail-label">Validade</label>
                    <select name="validade" class="form-select form-select-sm">
                        <option value="">Todas</option>
                        <option value="valido"  {{ filters.validade == 'valido'  ? 'selected' }}>✓ Dentro do prazo</option>
                        <option value="30dias"  {{ filters.validade == '30dias'  ? 'selected' }}>⚠ Vence em 30 dias</option>
                        <option value="vencido" {{ filters.validade == 'vencido' ? 'selected' }}>✗ Vencido</option>
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label mb-1 detail-label">Nº Série / Inmetro</label>
                    <input type="text" name="serie" class="form-control form-control-sm"
                           placeholder="Ex: 12345" value="{{ filters.serie }}">
                </div>

                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                        <i class="bi bi-search"></i>
                    </button>
                    {% if activeCount > 0 %}
                    <a href="{{ path('radar_index') }}" class="btn btn-outline-secondary btn-sm" title="Limpar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                    {% endif %}
                </div>

            </div>

            {# Tags dos filtros ativos #}
            {% if activeCount > 0 %}
            <div class="mt-2 d-flex flex-wrap gap-1">
                {% if filters.uf %}
                    <span class="badge bg-light text-dark border">
                        Estado: <strong>{{ filters.uf }}</strong>
                        <a href="{{ path('radar_index', filters|merge({uf: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.municipio %}
                    <span class="badge bg-light text-dark border">
                        Município: <strong>{{ filters.municipio }}</strong>
                        <a href="{{ path('radar_index', filters|merge({municipio: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.resultado %}
                    <span class="badge bg-light text-dark border">
                        Resultado: <strong>{{ filters.resultado }}</strong>
                        <a href="{{ path('radar_index', filters|merge({resultado: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.tipo %}
                    <span class="badge bg-light text-dark border">
                        Tipo: <strong>{{ filters.tipo }}</strong>
                        <a href="{{ path('radar_index', filters|merge({tipo: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.validade %}
                    {% set labelValidade = {valido: 'Dentro do prazo', vencido: 'Vencido', '30dias': 'Vence em 30 dias'} %}
                    <span class="badge bg-light text-dark border">
                        Validade: <strong>{{ labelValidade[filters.validade] ?? filters.validade }}</strong>
                        <a href="{{ path('radar_index', filters|merge({validade: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
                {% if filters.serie %}
                    <span class="badge bg-light text-dark border">
                        Nº Série: <strong>{{ filters.serie }}</strong>
                        <a href="{{ path('radar_index', filters|merge({serie: '', page: 1})) }}" class="text-danger ms-1">×</a>
                    </span>
                {% endif %}
            </div>
            {% endif %}

        </form>
    </div>
</div>

{# ── Tabela ── #}
{% if rows is empty %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-camera-video-off fs-1 d-block mb-2"></i>
        <p class="mb-0">Nenhum radar encontrado com os filtros selecionados.</p>
        {% if activeCount > 0 %}
            <a href="{{ path('radar_index') }}" class="btn btn-outline-primary btn-sm mt-3">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Limpar filtros
            </a>
        {% endif %}
    </div>
{% else %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:50px">UF</th>
                    <th>Município</th>
                    <th>Local de Verificação</th>
                    <th>Tipo</th>
                    <th>Resultado</th>
                    <th>Última Verif.</th>
                    <th>Validade</th>
                    <th>Proprietário</th>
                    <th style="width:40px"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                {% set vencido   = row.data_validade and row.data_validade < hoje %}
                {% set vencendo  = row.data_validade and row.data_validade >= hoje and row.data_validade <= em30 %}
                <tr class="row-link {{ vencido ? 'table-danger' : (vencendo ? 'table-warning' : '') }}"
                    onclick="window.location='{{ path('radar_show', {id: row.id}) }}'">
                    <td><span class="badge badge-uf">{{ row.sigla_uf }}</span></td>
                    <td>{{ row.municipio }}</td>
                    <td class="text-truncate" style="max-width:200px" title="{{ row.local_verificacao }}">
                        {{ row.local_verificacao }}
                    </td>
                    <td><small class="text-muted">{{ row.tipo_medidor ?? '—' }}</small></td>
                    <td>
                        {% if row.ultimo_resultado == 'APROVADO' %}
                            <span class="badge badge-aprovado"><i class="bi bi-check-circle me-1"></i>APROVADO</span>
                        {% elseif row.ultimo_resultado == 'REPROVADO' %}
                            <span class="badge badge-reprovado"><i class="bi bi-x-circle me-1"></i>REPROVADO</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ row.ultimo_resultado ?? '—' }}</span>
                        {% endif %}
                    </td>
                    <td><small>{{ row.data_ultima_verificacao ?? '—' }}</small></td>
                    <td>
                        {% if row.data_validade %}
                            {% if vencido %}
                                <span class="fw-semibold text-danger">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>{{ row.data_validade }}
                                </span>
                            {% elseif vencendo %}
                                <span class="fw-semibold text-warning">
                                    <i class="bi bi-clock-fill me-1"></i>{{ row.data_validade }}
                                </span>
                            {% else %}
                                <span class="text-success">
                                    <i class="bi bi-check me-1"></i>{{ row.data_validade }}
                                </span>
                            {% endif %}
                        {% else %}—{% endif %}
                    </td>
                    <td class="text-truncate" style="max-width:150px" title="{{ row.proprietario_nome }}">
                        <small>{{ row.proprietario_nome ?? '—' }}</small>
                    </td>
                    <td>
                        <a href="{{ path('radar_show', {id: row.id}) }}"
                           class="btn btn-outline-primary btn-sm py-0 px-2"
                           onclick="event.stopPropagation()" title="Ver detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card-footer text-muted small d-flex justify-content-between align-items-center">
        <span>
            Mostrando {{ rows|length }} de {{ total|number_format(0,',','.') }} registros
        </span>
        <div class="d-flex gap-3">
            <span><span class="badge" style="background:#dc354520;color:#dc3545;border:1px solid #dc354550">■</span> Vencido</span>
            <span><span class="badge" style="background:#ffc10720;color:#856404;border:1px solid #ffc10750">■</span> Vence em 30 dias</span>
        </div>
    </div>
</div>

{# ── Paginação ── #}
{% if pages > 1 %}
<nav class="mt-3" aria-label="Paginação">
    <ul class="pagination pagination-sm justify-content-center flex-wrap">

        <li class="page-item {{ page == 1 ? 'disabled' }}">
            <a class="page-link" href="{{ path('radar_index', filters|merge({page: page - 1})) }}" aria-label="Anterior">‹</a>
        </li>

        {% set from = max(1, page - 2) %}
        {% set to   = min(pages, page + 2) %}

        {% if from > 1 %}
            <li class="page-item"><a class="page-link" href="{{ path('radar_index', filters|merge({page: 1})) }}">1</a></li>
            {% if from > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
        {% endif %}

        {% for p in from..to %}
            <li class="page-item {{ p == page ? 'active' }}">
                <a class="page-link" href="{{ path('radar_index', filters|merge({page: p})) }}">{{ p }}</a>
            </li>
        {% endfor %}

        {% if to < pages %}
            {% if to < pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            <li class="page-item"><a class="page-link" href="{{ path('radar_index', filters|merge({page: pages})) }}">{{ pages }}</a></li>
        {% endif %}

        <li class="page-item {{ page == pages ? 'disabled' }}">
            <a class="page-link" href="{{ path('radar_index', filters|merge({page: page + 1})) }}" aria-label="Próxima">›</a>
        </li>

    </ul>
    <p class="text-center text-muted small mt-1">
        Página {{ page }} de {{ pages }} — {{ total|number_format(0,',','.') }} registros
    </p>
</nav>
{% endif %}

{% endif %}
{% endblock %}
