{% extends 'base.html.twig' %}

{% block title %}Radares Manuais{% endblock %}

{% block body %}
<div class="container-xl py-4">

  {# ── Cabeçalho ── #}
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <h1 class="h4 mb-0 fw-semibold">Radares Manuais</h1>
      <p class="text-muted small mb-0">
        {{ total }} cadastrado{{ total != 1 ? 's' : '' }} ·
        <span class="text-warning fw-semibold">{{ pendentes }} pendente{{ pendentes != 1 ? 's' : '' }}</span>
      </p>
    </div>
    <a href="{{ path('radar_manual_novo') }}" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Novo Radar Manual
    </a>
  </div>

  {# ── Flash ── #}
  {% for type, msgs in app.flashes %}
    {% for msg in msgs %}
      <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
        {{ msg|raw }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}
  {% endfor %}

  {# ── Tabela ── #}
  {% if radares is empty %}
    <div class="text-center py-5 text-muted">
      <i class="bi bi-radar fs-1 d-block mb-3 opacity-25"></i>
      <p class="mb-3">Nenhum radar manual cadastrado ainda.</p>
      <a href="{{ path('radar_manual_novo') }}" class="btn btn-outline-primary btn-sm">Cadastrar o primeiro</a>
    </div>
  {% else %}
    <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>UF</th>
              <th>Município</th>
              <th>Local</th>
              <th>Tipo</th>
              <th>Vel.</th>
              <th>Status</th>
              <th>Cadastrado em</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for r in radares %}
            <tr>
              <td class="text-muted small">{{ r.id }}</td>
              <td><span class="badge bg-secondary">{{ r.siglaUf }}</span></td>
              <td>{{ r.municipio }}</td>
              <td class="text-truncate" style="max-width:260px" title="{{ r.localVerificacao }}">{{ r.localVerificacao }}</td>
              <td class="small text-muted">{{ r.tipoMedidor ?? '—' }}</td>
              <td class="small">{{ r.velocidade ? r.velocidade ~ ' km/h' : '—' }}</td>
              <td>
                {% if r.status == 'mesclado' %}
                  <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Mesclado</span>
                {% else %}
                  <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pendente</span>
                {% endif %}
              </td>
              <td class="small text-muted">{{ r.criadoEm|date('d/m/Y') }}</td>
              <td>
                <a href="{{ path('radar_manual_show', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary">
                  <i class="bi bi-eye"></i>
                </a>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# ── Paginação ── #}
    {% set totalPages = (total / perPage)|round(0, 'ceil') %}
    {% if totalPages > 1 %}
    <nav class="mt-3">
      <ul class="pagination pagination-sm justify-content-center">
        {% for p in 1..totalPages %}
          <li class="page-item {{ p == page ? 'active' : '' }}">
            <a class="page-link" href="{{ path('radar_manual_lista', {page: p}) }}">{{ p }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
    {% endif %}
  {% endif %}

</div>
{% endblock %}
