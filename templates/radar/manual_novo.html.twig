{% extends 'base.html.twig' %}

{% block title %}Novo Radar Manual{% endblock %}

{% block body %}
<div class="container py-4" style="max-width:720px">

  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="{{ path('radar_manual_lista') }}">Radares Manuais</a></li>
      <li class="breadcrumb-item active">Novo</li>
    </ol>
  </nav>

  <h1 class="h4 fw-semibold mb-1">Novo Radar Manual</h1>
  <p class="text-muted small mb-4">
    Cadastre um radar que ainda não aparece na fonte oficial (INMETRO/Google Sheets).
    Assim que ele aparecer na próxima importação, o sistema fará o <strong>merge automático</strong>
    e atualizará o status para <span class="badge bg-success">Mesclado</span>.
  </p>

  {# ── Flash ── #}
  {% for type, msgs in app.flashes %}
    {% for msg in msgs %}
      <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
        {{ msg|raw }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}
  {% endfor %}

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'needs-validation'}}) }}

        <div class="row g-3">

          <div class="col-12 col-sm-3">
            {{ form_label(form.siglaUf) }}
            {{ form_widget(form.siglaUf) }}
            {{ form_errors(form.siglaUf) }}
          </div>

          <div class="col-12 col-sm-9">
            {{ form_label(form.municipio) }}
            {{ form_widget(form.municipio) }}
            {{ form_errors(form.municipio) }}
          </div>

          <div class="col-12">
            {{ form_label(form.localVerificacao) }}
            <div class="input-group">
              {{ form_widget(form.localVerificacao) }}
              <span class="input-group-text" data-bs-toggle="tooltip"
                title="Use a descrição exata como aparece no INMETRO para garantir o merge automático.">
                <i class="bi bi-info-circle"></i>
              </span>
            </div>
            {{ form_errors(form.localVerificacao) }}
            <div class="form-text">Campo-chave para o merge. Use a descrição exata como aparece no INMETRO.</div>
          </div>

          <div class="col-12 col-sm-6">
            {{ form_label(form.tipoMedidor) }}
            {{ form_widget(form.tipoMedidor) }}
            {{ form_errors(form.tipoMedidor) }}
          </div>

          <div class="col-12 col-sm-6">
            {{ form_label(form.velocidade) }}
            {{ form_widget(form.velocidade) }}
            {{ form_errors(form.velocidade) }}
          </div>

          <div class="col-12">
            {{ form_label(form.sentido) }}
            {{ form_widget(form.sentido) }}
            {{ form_errors(form.sentido) }}
          </div>

          <div class="col-12">
            {{ form_label(form.observacoes) }}
            {{ form_widget(form.observacoes) }}
            {{ form_errors(form.observacoes) }}
          </div>

        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-1"></i> Salvar Radar
          </button>
          <a href="{{ path('radar_manual_lista') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

      {{ form_end(form) }}
    </div>
  </div>

</div>

<script>
// Bootstrap tooltip
document.querySelectorAll('[data-bs-toggle="tooltip"]')
  .forEach(el => new bootstrap.Tooltip(el));
</script>
{% endblock %}
