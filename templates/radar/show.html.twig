{% extends 'base.html.twig' %}

{% block title %}{{ radar.local_verificacao }} — Radar #{{ radar.id }}{% endblock %}

{% block body %}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('radar_index') }}">Radares</a></li>
        <li class="breadcrumb-item active">{{ radar.local_verificacao|default('Radar #' ~ radar.id) }}</li>
    </ol>
</nav>

{# ── Cabeçalho ── #}
<div class="d-flex align-items-start justify-content-between mb-4">
    <div>
        <h1 class="h4 mb-1 fw-bold">
            <span class="badge badge-uf me-2">{{ radar.sigla_uf }}</span>
            {{ radar.local_verificacao }}
        </h1>
        <div class="text-muted small">{{ radar.municipio }} — {{ radar.estado }}</div>
    </div>
    {% if radar.ultimo_resultado == 'APROVADO' %}
        <span class="badge badge-aprovado fs-6 px-3 py-2"><i class="bi bi-check-circle me-1"></i>APROVADO</span>
    {% elseif radar.ultimo_resultado == 'REPROVADO' %}
        <span class="badge badge-reprovado fs-6 px-3 py-2"><i class="bi bi-x-circle me-1"></i>REPROVADO</span>
    {% elseif radar.ultimo_resultado %}
        <span class="badge bg-secondary fs-6 px-3 py-2">{{ radar.ultimo_resultado }}</span>
    {% endif %}
</div>

{% for type, messages in app.flashes %}
    {% for msg in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
            {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="row g-4">

    {# ── Coluna esquerda ── #}
    <div class="col-lg-7">

        {# Dados gerais #}
        <div class="card mb-4">
            <div class="card-header fw-semibold">
                <i class="bi bi-info-circle me-2"></i>Dados Gerais
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="detail-label">Tipo de Medidor</div>
                        <div class="detail-value">{{ radar.tipo_medidor ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Resultado</div>
                        <div class="detail-value">{{ radar.ultimo_resultado ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Última Verificação</div>
                        <div class="detail-value">{{ radar.data_ultima_verificacao ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Validade</div>
                        <div class="detail-value">
                            {% set hoje = 'now'|date('Y-m-d') %}
                            {% if radar.data_validade %}
                                {% if radar.data_validade < hoje %}
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>{{ radar.data_validade }} (vencido)</span>
                                {% elseif radar.data_validade <= hoje|date_modify('+30 days')|date('Y-m-d') %}
                                    <span class="text-warning"><i class="bi bi-clock me-1"></i>{{ radar.data_validade }} (vence em breve)</span>
                                {% else %}
                                    <span class="text-success"><i class="bi bi-check me-1"></i>{{ radar.data_validade }}</span>
                                {% endif %}
                            {% else %}—{% endif %}
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Estado</div>
                        <div class="detail-value">{{ radar.estado ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Município</div>
                        <div class="detail-value">{{ radar.municipio ?? '—' }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# Proprietário #}
        <div class="card mb-4">
            <div class="card-header fw-semibold">
                <i class="bi bi-building me-2"></i>Proprietário
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="detail-label">Nome</div>
                        <div class="detail-value">{{ radar.proprietario_nome ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Município</div>
                        <div class="detail-value">{{ radar.proprietario_municipio ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-label">Estado</div>
                        <div class="detail-value">{{ radar.proprietario_estado ?? '—' }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# Faixas #}
        {% if faixas is not empty %}
        <div class="card mb-4">
            <div class="card-header fw-semibold">
                <i class="bi bi-layout-three-columns me-2"></i>Faixas ({{ faixas|length }})
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Faixa</th>
                            <th>Nº Inmetro</th>
                            <th>Nº Série</th>
                            <th>Sentido</th>
                            <th>Vel. Nominal</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for f in faixas %}
                        <tr>
                            <td>{{ f.numero_faixa ?? '—' }}</td>
                            <td><code>{{ f.numero_inmetro ?? '—' }}</code></td>
                            <td><code>{{ f.numero_serie ?? '—' }}</code></td>
                            <td>{{ f.sentido ?? '—' }}</td>
                            <td>{{ f.velocidade_nominal ?? '—' }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}

    </div>{# /col-lg-7 #}

    {# ── Coluna direita ── #}
    <div class="col-lg-5">

        {# ===================================================
           CARD: EDITOR WAZE
        =================================================== #}
        {% if app.user %}
        <div class="card mb-4 border-primary" id="card-waze">
            <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-signpost-2 me-2"></i>Editor Waze</span>
                {% if wazeLink %}
                    <a href="{{ wazeLink.waze_link }}" target="_blank" rel="noopener"
                       class="btn btn-sm btn-light">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir Editor
                    </a>
                {% endif %}
            </div>
            <div class="card-body">

                {# ── Estado atual (somente leitura) quando já existe link ── #}
                {% if wazeLink %}
                <div class="mb-3 p-2 rounded bg-light border">
                    <div class="detail-label">Hazard ID atual</div>
                    <div class="fw-bold text-primary fs-5">#{{ wazeLink.permanent_hazard_id }}</div>

                    <div class="detail-label mt-2">Cadastrado por</div>
                    <div class="small">{{ wazeLink.inserted_by_email }}
                        <span class="text-muted">— {{ wazeLink.inserted_at|date('d/m/Y H:i') }}</span>
                    </div>

                    {% if wazeLink.updated_at %}
                    <div class="detail-label mt-2">Última edição</div>
                    <div class="small text-warning fw-semibold">{{ wazeLink.updated_by_email }}
                        <span class="fw-normal">— {{ wazeLink.updated_at|date('d/m/Y H:i') }}</span>
                    </div>
                    {% endif %}

                    {% if wazeLink.observacao %}
                    <div class="detail-label mt-2">Motivo última revisão</div>
                    <div class="small fst-italic">{{ wazeLink.observacao }}</div>
                    {% endif %}
                </div>
                {% endif %}

                {# ── Botão para recolher/expandir o formulário (só quando já tem link) ── #}
                {% if wazeLink %}
                <button class="btn btn-outline-primary btn-sm w-100 mb-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#waze-form-wrap"
                        aria-expanded="{% if wazeErrors is not empty %}true{% else %}false{% endif %}"
                        aria-controls="waze-form-wrap">
                    <i class="bi bi-pencil me-1"></i>Alterar link / motivo
                </button>
                <div class="collapse{% if wazeErrors is not empty %} show{% endif %}" id="waze-form-wrap">
                {% else %}
                <div id="waze-form-wrap">
                {% endif %}

                    <form method="post"
                          action="{{ path('radar_waze_save', {id: radar.id}) }}"
                          novalidate>
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('waze_save_' ~ radar.id) }}">

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Link do Editor Waze <span class="text-danger">*</span>
                            </label>
                            <input type="url"
                                   name="waze_link"
                                   id="waze-link-input"
                                   value="{{ wazeLink ? wazeLink.waze_link : wazeFormData.waze_link|default('') }}"
                                   class="form-control form-control-sm font-monospace {{ wazeErrors.waze_link is defined ? 'is-invalid' : '' }}"
                                   placeholder="https://waze.com/pt-BR/editor?…&permanentHazards=272464"
                                   required>
                            {% if wazeErrors.waze_link is defined %}
                                <div class="invalid-feedback">{{ wazeErrors.waze_link }}</div>
                            {% else %}
                                <div class="form-text">Cole a URL do Editor Waze com <code>permanentHazards=NÚMERO</code>.</div>
                            {% endif %}
                        </div>

                        <div id="waze-hazard-preview" class="alert alert-info py-1 px-2 mb-3 d-none small">
                            Hazard ID: <strong id="waze-hazard-id"></strong>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Motivo da revisão
                                {% if wazeLink %}<span class="text-danger">*</span>{% else %}<span class="text-muted fw-normal">(opcional)</span>{% endif %}
                            </label>
                            <textarea name="motivo_revisao"
                                      class="form-control form-control-sm {{ wazeErrors.motivo_revisao is defined ? 'is-invalid' : '' }}"
                                      rows="2"
                                      placeholder="Ex: atualização de posição, novo hazard, correção…">{{ wazeFormData.motivo_revisao|default('') }}</textarea>
                            {% if wazeErrors.motivo_revisao is defined %}
                                <div class="invalid-feedback">{{ wazeErrors.motivo_revisao }}</div>
                            {% endif %}
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label fw-semibold small">Usuário (auto)</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="{{ app.user.email }}" disabled
                                       style="background:#f8f9fa;font-style:italic">
                            </div>
                            <div class="col-5">
                                <label class="form-label fw-semibold small">Data/Hora (auto)</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="Agora" disabled
                                       style="background:#f8f9fa;font-style:italic">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-save me-1"></i>
                            {{ wazeLink ? 'Salvar alterações' : 'Cadastrar link Waze' }}
                        </button>
                    </form>

                </div>{# /waze-form-wrap #}

                {# ===================================================
                   TIMELINE DE HISTÓRICO DO LINK WAZE
                   Exibe TODOS os registros de radar_waze_link_log,
                   não apenas o último.
                =================================================== #}
                {% if wazeLog is not empty %}
                <hr class="my-3">
                <button class="btn btn-outline-secondary btn-sm w-100 mb-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#waze-historico-wrap"
                        aria-expanded="false"
                        aria-controls="waze-historico-wrap">
                    <i class="bi bi-clock-history me-1"></i>
                    Histórico de alterações ({{ wazeLog|length }})
                </button>
                <div class="collapse" id="waze-historico-wrap">
                    <div class="waze-timeline mt-2">
                        {% for log in wazeLog %}
                        <div class="waze-timeline-item">
                            {# Bolinha + linha vertical #}
                            <div class="waze-timeline-dot
                                {{ log.campo_alterado == 'waze_link' ? 'dot-link' : 'dot-obs' }}"></div>

                            <div class="waze-timeline-content">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="badge
                                        {{ log.campo_alterado == 'waze_link' ? 'bg-primary' : 'bg-secondary' }}
                                        badge-sm">
                                        {% if log.campo_alterado == 'waze_link' %}
                                            <i class="bi bi-link-45deg me-1"></i>Link alterado
                                        {% elseif log.campo_alterado == 'motivo_revisao' %}
                                            <i class="bi bi-chat-text me-1"></i>Motivo
                                        {% else %}
                                            <i class="bi bi-pencil me-1"></i>{{ log.campo_alterado }}
                                        {% endif %}
                                    </span>
                                    <small class="text-muted ms-2" style="white-space:nowrap">
                                        {{ log.changed_at|date('d/m/Y H:i') }}
                                    </small>
                                </div>

                                <div class="small mb-1">
                                    <i class="bi bi-person me-1 text-muted"></i>
                                    <span class="fw-semibold">{{ log.changed_by_email }}</span>
                                </div>

                                {% if log.campo_alterado == 'waze_link' %}
                                    {% if log.valor_anterior %}
                                    <div class="small text-muted">
                                        <span class="text-danger"><i class="bi bi-dash-circle me-1"></i>Anterior:</span>
                                        <a href="{{ log.valor_anterior }}" target="_blank" rel="noopener"
                                           class="font-monospace text-decoration-none text-muted"
                                           style="word-break:break-all;font-size:.7rem">
                                            {{ log.valor_anterior|slice(0, 60) }}{% if log.valor_anterior|length > 60 %}…{% endif %}
                                        </a>
                                    </div>
                                    {% else %}
                                    <div class="small text-success">
                                        <i class="bi bi-plus-circle me-1"></i>Primeiro cadastro
                                    </div>
                                    {% endif %}
                                    <div class="small">
                                        <span class="text-success"><i class="bi bi-check-circle me-1"></i>Novo:</span>
                                        <a href="{{ log.valor_novo }}" target="_blank" rel="noopener"
                                           class="font-monospace text-decoration-none"
                                           style="word-break:break-all;font-size:.7rem">
                                            {{ log.valor_novo|slice(0, 60) }}{% if log.valor_novo|length > 60 %}…{% endif %}
                                        </a>
                                    </div>
                                {% else %}
                                    {% if log.valor_anterior %}
                                    <div class="small text-muted">
                                        <i class="bi bi-dash me-1 text-danger"></i><em>{{ log.valor_anterior }}</em>
                                    </div>
                                    {% endif %}
                                    {% if log.valor_novo %}
                                    <div class="small">
                                        <i class="bi bi-arrow-right me-1 text-success"></i>{{ log.valor_novo }}
                                    </div>
                                    {% endif %}
                                {% endif %}

                                {% if log.observacao %}
                                <div class="small text-muted fst-italic mt-1">
                                    <i class="bi bi-sticky me-1"></i>{{ log.observacao }}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>{# /waze-historico-wrap #}
                {% endif %}{# wazeLog #}

            </div>{# /card-body #}
        </div>{# /card editor waze #}
        {% endif %}{# app.user #}

        {# Histórico de verificações #}
        {% if historico is not empty %}
        <div class="card mb-4">
            <div class="card-header fw-semibold">
                <i class="bi bi-clock-history me-2"></i>Histórico de Verificações
            </div>
            <div class="list-group list-group-flush">
                {% for h in historico %}
                <div class="list-group-item px-3 py-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold small">{{ h.tipo_servico ?? '—' }} — {{ h.ano ?? '' }}</div>
                            <div class="text-muted" style="font-size:.8rem">
                                Cert: <code>{{ h.numero_certificado ?? '—' }}</code> |
                                Ensaio: <code>{{ h.numero_ensaio ?? '—' }}</code>
                            </div>
                            <div class="text-muted" style="font-size:.8rem">
                                Laudo: {{ h.data_laudo ?? '—' }} | Validade: {{ h.data_validade ?? '—' }}
                            </div>
                        </div>
                        <span class="badge {{ h.resultado == 'APROVADO' ? 'badge-aprovado' : (h.resultado == 'REPROVADO' ? 'badge-reprovado' : 'bg-secondary') }} ms-2">
                            {{ h.resultado ?? '—' }}
                        </span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Metadados de importação #}
        <div class="card">
            <div class="card-header fw-semibold">
                <i class="bi bi-database me-2"></i>Metadados
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12">
                        <div class="detail-label">Importado em</div>
                        <div class="detail-value small">{{ radar.imported_at ?? '—' }}</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Atualizado em</div>
                        <div class="detail-value small">{{ radar.updated_at ?? '—' }}</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Row Hash</div>
                        <div class="detail-value"><code style="font-size:.7rem">{{ radar.row_hash }}</code></div>
                    </div>
                </div>
            </div>
        </div>

    </div>{# /col-lg-5 #}
</div>

{# ===================================================
   CSS INLINE — Timeline Waze
=================================================== #}
<style>
.waze-timeline {
    position: relative;
    padding-left: 1.5rem;
}
.waze-timeline::before {
    content: '';
    position: absolute;
    left: .45rem;
    top: .5rem;
    bottom: .5rem;
    width: 2px;
    background: #dee2e6;
    border-radius: 2px;
}
.waze-timeline-item {
    position: relative;
    margin-bottom: 1rem;
}
.waze-timeline-item:last-child {
    margin-bottom: 0;
}
.waze-timeline-dot {
    position: absolute;
    left: -1.5rem;
    top: .3rem;
    width: .7rem;
    height: .7rem;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px currentColor;
}
.waze-timeline-dot.dot-link  { color: var(--bs-primary, #0d6efd); }
.waze-timeline-dot.dot-obs   { color: var(--bs-secondary, #6c757d); }
.waze-timeline-content {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: .4rem;
    padding: .5rem .75rem;
}
.badge-sm { font-size: .7rem; padding: .2em .5em; }
</style>

<script>
(function () {
    const input    = document.getElementById('waze-link-input');
    const preview  = document.getElementById('waze-hazard-preview');
    const hazardEl = document.getElementById('waze-hazard-id');
    if (!input) return;
    function update() {
        const m = input.value.match(/[?&]permanentHazards=(\d+)/);
        if (m) { hazardEl.textContent = m[1]; preview.classList.remove('d-none'); }
        else   { preview.classList.add('d-none'); }
    }
    input.addEventListener('input', update);
    update();
}());
</script>

{% endblock %}
