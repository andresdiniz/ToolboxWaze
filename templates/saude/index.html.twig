{% extends 'saude/layout.html.twig' %}
{% block title %}Estabelecimentos de Saúde{% endblock %}
{% block body %}
<div class="saude-page">
<header class="s-header"><div><h1>🏥 Estabelecimentos de Saúde</h1><p class="text-muted mb-0">{{ total|number_format(0, ',', '.') }} resultados{% if stats %} · {{ stats.ativos|number_format(0, ',', '.') }} ativos · {{ stats.estados }} estados · {{ stats.municipios|number_format(0, ',', '.') }} municípios{% endif %}</p></div></header>
{% if allowedUfs is not null %}<div class="alert alert-info small">Estados autorizados: {{ allowedUfs is empty ? 'Nenhum' : allowedUfs|join(', ') }}.</div>{% endif %}
{% set choices = {situacao:{ativo:'Ativos',inativo:'Inativos'},link:{com_link:'Com link',sem_link:'Sem link'},coordenadas:{com_coord:'Com coordenadas',sem_coord:'Sem coordenadas'},fluxo:{pendente:'Pendente',reservado:'Reservado',confirmado:'Confirmado',nao_localizado:'Não localizado',pulado:'Pulado'}} %}
{% set labels = {busca:'Busca',uf:'Estado',municipio:'Município',situacao:'Situação CNES',link:'Link Waze',coordenadas:'Coordenadas',fluxo:'Andamento'} %}
<form method="get" action="{{ path('saude_index') }}" class="s-card row g-2 mx-0">
<div class="col-12 col-md-4"><label for="s-busca">Nome, CNES, rua ou município</label><input id="s-busca" name="busca" value="{{ filters.busca }}" class="form-control form-control-sm"></div>
<div class="col-6 col-md-2"><label for="s-uf">Estado</label><select id="s-uf" name="uf" class="form-select form-select-sm"><option value="">Todos</option>{% for uf in ufs %}<option value="{{ uf }}" {{ filters.uf == uf ? 'selected' : '' }}>{{ uf }}</option>{% endfor %}</select></div>
<div class="col-6 col-md-3"><label for="s-municipio">Município</label><input id="s-municipio" name="municipio" value="{{ filters.municipio }}" class="form-control form-control-sm"></div>
{% for key, options in choices %}<div class="col-6 col-md-3"><label for="s-{{ key }}">{{ labels[key] }}</label><select id="s-{{ key }}" name="{{ key }}" class="form-select form-select-sm"><option value="">Todos</option>{% for value, label in options %}<option value="{{ value }}" {{ filters[key] == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>{% endfor %}
<div class="col-12 s-actions align-items-end"><button class="btn btn-primary btn-sm">Filtrar</button><a class="btn btn-outline-secondary btn-sm" href="{{ path('saude_index') }}">Limpar filtros</a></div>
</form>
<div class="s-filter-tags">{% for key, value in filters %}{% if value != '' %}<a href="{{ path('saude_index', filters|merge({(key):'',page:1})) }}" aria-label="Remover filtro {{ labels[key] }}">{{ labels[key] }}: {{ choices[key][value] ?? value }} ×</a>{% endif %}{% endfor %}</div>
<p class="text-muted small">{% if total %}Mostrando {{ (page-1)*perPage+1 }}–{{ min(page*perPage,total) }} de {{ total|number_format(0, ',', '.') }}{% else %}Nenhum resultado{% endif %}</p>
<div class="table-responsive"><table class="table table-hover s-table"><caption class="visually-hidden">Estabelecimentos de saúde e andamento da edição</caption><thead><tr>{% for label in ['Estabelecimento','Município / UF','Endereço','Telefone','Situação CNES','Andamento','Localização','Ações'] %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead><tbody>
{% for row in rows %}<tr>
<td data-label="Estabelecimento" class="s-name"><div><a class="fw-semibold" href="{{ path('saude_show',{id:row.id}) }}">{{ row.nome_fantasia ?: 'Sem nome informado' }}</a><div class="small text-muted">CNES <code>{{ row.cnes }}</code></div></div></td>
<td data-label="Município / UF">{{ row.municipio ?: '—' }} / {{ row.uf ?: '—' }}</td>
<td data-label="Endereço" class="s-address">{{ row.logradouro ?: '—' }}</td>
<td data-label="Telefone">{% if row.telefone %}<a href="tel:{{ row.telefone|replace({'(':'',')':'',' ':'','-':''}) }}">{{ row.telefone }}</a>{% else %}—{% endif %}</td>
<td data-label="Situação CNES"><div><span class="badge {{ row.ativo ? 'bg-success' : 'bg-danger' }}">{{ row.ativo ? 'Ativo' : 'Inativo' }}</span></div></td>
<td data-label="Andamento"><div>{% include 'saude/_status.html.twig' with {status:row.status} only %}{% if row.reservado_para %}<div class="small text-muted">{{ row.status == 'reservado' ? 'Reservado para' : 'Editor' }}: {{ row.reservado_para }}</div>{% endif %}{% if row.status == 'reservado' and row.reservado_em %}<div class="small text-muted">Renovação: {{ row.reservado_em|date('d/m/Y H:i') }}</div>{% endif %}</div></td>
<td data-label="Localização">{{ row.has_coords ? 'Com coordenadas' : 'Sem coordenadas' }}</td>
<td data-label="Ações"><div class="s-actions"><a class="btn btn-outline-primary btn-sm" href="{{ path('saude_show',{id:row.id}) }}" aria-label="Ver {{ row.nome_fantasia ?: row.cnes }}">Detalhes</a>{% if row.link_waze %}<a class="btn btn-outline-secondary btn-sm" href="{{ row.link_waze }}" target="_blank" rel="noopener noreferrer">Waze</a>{% endif %}</div></td>
</tr>{% else %}<tr><td colspan="8">Nenhum estabelecimento encontrado. <a href="{{ path('saude_index') }}">Limpar filtros</a></td></tr>{% endfor %}
</tbody></table></div>
{% if pages > 1 %}<nav aria-label="Paginação dos estabelecimentos"><ul class="pagination pagination-sm flex-wrap justify-content-center">
{% if page > 1 %}<li class="page-item"><a class="page-link" href="{{ path('saude_index',filters|merge({page:page-1})) }}">Anterior</a></li>{% endif %}
{% set start = max(1,page-2) %}{% set end = min(pages,page+2) %}
{% if start > 1 %}<li class="page-item"><a class="page-link" href="{{ path('saude_index',filters|merge({page:1})) }}">1</a></li>{% if start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{% endif %}
{% for p in start..end %}<li class="page-item {{ p == page ? 'active' : '' }}"><a class="page-link" {% if p == page %}aria-current="page"{% endif %} href="{{ path('saude_index',filters|merge({page:p})) }}">{{ p }}</a></li>{% endfor %}
{% if end < pages %}{% if end < pages-1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}<li class="page-item"><a class="page-link" href="{{ path('saude_index',filters|merge({page:pages})) }}">{{ pages }}</a></li>{% endif %}
{% if page < pages %}<li class="page-item"><a class="page-link" href="{{ path('saude_index',filters|merge({page:page+1})) }}">Próxima</a></li>{% endif %}
</ul></nav>{% endif %}<p class="text-muted small text-center">Página {{ page }} de {{ pages }}</p>
</div>
{% endblock %}
