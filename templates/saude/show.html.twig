{% extends 'saude/layout.html.twig' %}
{% block title %}{{ item.nomeFantasia ?: item.cnes }} — Saúde{% endblock %}
{% block stylesheets %}{{ parent() }}{% if coords %}<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" crossorigin="">{% endif %}{% endblock %}
{% block saude_map_scripts %}{% if coords %}<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" crossorigin="" defer></script>{% endif %}{% endblock %}
{% block body %}
<div class="saude-page" id="saude-data" data-lat="{{ coords ? coords[0] : '' }}" data-lon="{{ coords ? coords[1] : '' }}" data-nome="{{ item.nomeFantasia ?: item.cnes }}" data-local="{{ item.municipio }} — {{ item.uf }}">
<a class="btn btn-sm btn-outline-secondary mb-3" href="{{ path('saude_index',voltarParams) }}">← Voltar à listagem</a>
<header class="s-header"><div><h1>🏥 {{ item.nomeFantasia ?: 'Sem nome informado' }}</h1><p class="text-muted">CNES <code>{{ item.cnes }}</code> · {{ item.municipio ?: 'Município não informado' }} / {{ item.uf ?: '—' }}</p><span class="badge {{ item.ativo ? 'bg-success' : 'bg-danger' }}">CNES {{ item.ativo ? 'Ativo' : 'Inativo' }}</span> {% include 'saude/_status.html.twig' with {status:item.status} only %}</div>{% if is_granted('ROLE_ADMIN') %}<a class="btn btn-outline-primary btn-sm" href="{{ path('saude_edit',{id:item.id}) }}">Editar dados</a>{% endif %}</header>
<div class="s-actions mb-3"><button type="button" class="btn btn-outline-secondary" data-copy="{{ item.cnes }}">Copiar CNES</button><button type="button" class="btn btn-outline-secondary" data-copy="{{ item.nomeFantasia ?: item.cnes }}">Copiar nome</button>{% if item.logradouro %}<button type="button" class="btn btn-outline-secondary" data-copy="{{ item.logradouro }}, {{ item.municipio }} / {{ item.uf }}">Copiar endereço</button>{% endif %}</div><p id="saude-feedback" class="small text-muted" role="status" aria-live="polite"></p>
<div class="s-grid"><section class="s-card"><h2>Dados CNES</h2><dl><dt>CNES</dt><dd><code>{{ item.cnes }}</code></dd><dt>Município / UF</dt><dd>{{ item.municipio ?: '—' }} / {{ item.uf ?: '—' }}</dd><dt>Endereço</dt><dd>{{ item.logradouro ?: 'Não informado' }}</dd><dt>Telefone</dt><dd>{% if item.telefone %}<a href="tel:{{ item.telefone|replace({'(':'',')':'',' ':'','-':''}) }}">{{ item.telefone }}</a>{% else %}Não informado{% endif %}</dd><dt>Coordenadas CNES</dt><dd>{% if coords %}{{ item.latitude }}, {{ item.longitude }}{% else %}Não disponíveis{% endif %}</dd></dl>
{% if coords %}<div class="s-actions"><button type="button" class="btn btn-outline-secondary" data-copy="{{ coords[0] }}, {{ coords[1] }}">Copiar coordenadas</button><a class="btn btn-outline-primary" href="https://www.waze.com/pt-BR/editor?env=row&amp;lat={{ coords[0] }}&amp;lon={{ coords[1] }}&amp;zoom=17" target="_blank" rel="noopener noreferrer">Localização no WME</a><a class="btn btn-outline-secondary" href="geo:{{ coords[0] }},{{ coords[1] }}?q={{ coords[0] }},{{ coords[1] }}">Navegar no celular</a><a class="btn btn-outline-secondary" href="https://www.google.com/maps?q={{ coords[0] }},{{ coords[1] }}" target="_blank" rel="noopener noreferrer">Google Maps</a></div>{% endif %}</section>
<div><section class="s-card"><h2>Place no Waze</h2>{% if item.linkWaze %}<a class="btn btn-primary btn-sm mb-3" href="{{ item.linkWaze }}" target="_blank" rel="noopener noreferrer">Abrir link cadastrado</a>{% else %}<p class="text-muted">Nenhum link cadastrado.</p>{% endif %}<p class="small text-muted">Abrir coordenadas no WME não significa que um Place já foi cadastrado.</p>
{% if errors %}<div class="alert alert-danger" role="alert"><ul class="mb-0">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<form method="post" action="{{ path('saude_link_save',{id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('saude_link_' ~ item.id) }}"><label for="s-link">Cadastrar ou editar link Waze</label><input id="s-link" class="form-control form-control-sm mb-2" type="url" name="link_waze" maxlength="1000" value="{{ linkValue }}" aria-describedby="s-link-help"><p id="s-link-help" class="small text-muted">URL do Waze. Deixe vazio para remover o link; isso não altera o andamento.</p><button class="btn btn-primary btn-sm">Salvar link</button></form></section>
<section class="s-card"><h2>Andamento da edição</h2>{% include 'saude/_status.html.twig' with {status:item.status} only %}<dl class="mt-3"><dt>{{ item.status == 'reservado' ? 'Reservado para' : 'Editor registrado' }}</dt><dd>{{ item.reservadoPara ?: 'Não informado' }}</dd>{% if item.status == 'reservado' %}<dt>Última renovação da reserva</dt><dd>{{ item.reservadoEm ? item.reservadoEm|date('d/m/Y H:i') : 'Não informada' }}</dd><dt>Prazo da reserva</dt><dd>{{ reservationExpires ? reservationExpires|date('d/m/Y H:i') : 'Não informado' }} · {{ reservationExpired ? 'Expirada, sujeita a retomada' : 'Vigente no carregamento da página' }}</dd>{% endif %}</dl><p class="small text-muted mb-0">Reservas, renovações e mudanças de andamento continuam pelo fluxo da API.</p></section></div></div>
<section class="s-card"><h2>Localização no mapa · OpenStreetMap</h2>{% if coords %}<div id="saude-map" aria-label="Mapa da localização do estabelecimento"></div>{% else %}<p class="text-muted mb-0">Coordenadas não disponíveis ou inválidas. O mapa será exibido quando houver uma localização válida.</p>{% endif %}</section>
<details class="s-card s-metadata"><summary>Metadados do registro</summary><dl class="mt-3"><dt>ID interno</dt><dd>{{ item.id }}</dd><dt>Importado em</dt><dd>{{ item.importedAt|date('d/m/Y H:i') }}</dd><dt>Atualização do registro</dt><dd>{{ item.updatedAt ? item.updatedAt|date('d/m/Y H:i') : 'Não informada' }}</dd></dl><p class="text-muted">A atualização pode vir de importação, edição ou reserva; não comprova edição no Waze.</p>{% if is_granted('ROLE_ADMIN') %}<div>Row hash: <code>{{ item.rowHash }}</code></div>{% endif %}</details>
</div>
{% endblock %}
