{#
  Fragmento AJAX puro — SEM extends, SEM block.
  Substitui completamente #campos-dinamicos.

  Variáveis:
    form                     — FormView de SolicitacaoType
    tipoAtual                — tipo da solicitação (ex: "nivel", "gerente_estado_pais")
    isChamp                  — bool
    tipoNivelAtual           — "upgrade" | "downgrade" | null  (só tipo nivel)
    souChampAuto             — bool: true quando Champ+downgrade (campo oculto/implícito)
    acaoGerenteAtual         — "incluir" | "excluir" | null  (gerente_area)
    acaoGerenteEpAtual       — "incluir" | "excluir" | null  (gerente_estado_pais)

  Estrutura para tipo="nivel":
    <div id="card-tipo-nivel-ajax">               ← sempre presente, nunca destruído
    <div id="campos-extras-nivel-server">         ← campos extras; vazio quando null

  Estrutura para tipo="gerente_area":
    <div id="card-acao-gerente-area-ajax">        ← sempre presente, nunca destruído
    <div id="campos-extras-gerente-area-server"> ← campos extras; vazio quando null

  Estrutura para tipo="gerente_estado_pais":
    <div id="card-acao-gerente-ep-ajax">          ← sempre presente, nunca destruído
    <div id="campos-extras-gerente-ep-server">   ← campos extras; vazio quando null

  Para outros tipos: campos direto, sem wrapping especial.
#}
{% set souChampAuto        = souChampAuto ?? false %}
{% set acaoGerenteAtual    = acaoGerenteAtual ?? null %}
{% set acaoGerenteEpAtual  = acaoGerenteEpAtual ?? null %}
{% form_theme form 'form/sol_theme.html.twig' %}

{# ─────────────────────────────────────────────────────────────────────────────
   Estilos das action-pills (Incluir / Excluir / Upgrade / Downgrade)
   Mesmo visual para os três tipos que têm radio de seleção.
───────────────────────────────────────────────────────────────────────────── #}
<style>
.acao-pill-group {
  display: flex;
  gap: .6rem;
  flex-wrap: wrap;
  margin-top: .5rem;
}
.acao-pill {
  display: flex;
  align-items: center;
  gap: .45rem;
  padding: .55rem 1.1rem;
  border: 1.5px solid var(--sol-border, #dee2e6);
  border-radius: 2rem;
  cursor: pointer;
  font-size: .9rem;
  font-weight: 500;
  background: var(--sol-surface, #fff);
  color: var(--sol-text, #212529);
  transition: border-color .15s, background .15s, color .15s, box-shadow .15s;
  user-select: none;
  position: relative;
}
.acao-pill input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.acao-pill:hover {
  border-color: var(--sol-primary, #198754);
  background: var(--sol-primary-soft, #f0faf4);
}
.acao-pill.active,
.acao-pill:has(input:checked) {
  border-color: var(--sol-primary, #198754);
  background: var(--sol-primary-soft, #f0faf4);
  color: var(--sol-primary, #198754);
  box-shadow: 0 0 0 3px rgba(25,135,84,.12);
}
.acao-pill .pill-check {
  display: none;
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}
.acao-pill.active .pill-check,
.acao-pill:has(input:checked) .pill-check {
  display: inline-block;
}
/* Pill excluir: vermelho quando ativo */
.acao-pill--excluir.active,
.acao-pill--excluir:has(input:checked) {
  border-color: var(--bs-danger, #dc3545);
  background: #fff5f5;
  color: var(--bs-danger, #dc3545);
  box-shadow: 0 0 0 3px rgba(220,53,69,.12);
}
.acao-pill--excluir:hover {
  border-color: var(--bs-danger, #dc3545);
  background: #fff5f5;
}
</style>

{# ── Bloco nivel: radio Upgrade/Downgrade ───────────────────────────────────── #}
{% if tipoAtual == 'nivel' %}
  {% if form.dados_tipoNivel is defined %}
    <div class="sol-card campo-animado" id="card-tipo-nivel-ajax">
      <div class="sol-card-body">
        {{ form_label(form.dados_tipoNivel) }}

        <div class="acao-pill-group" role="radiogroup">
          {% for child in form.dados_tipoNivel %}
            {% set isActive = tipoNivelAtual == child.vars.value %}
            <label class="acao-pill{% if child.vars.value == 'downgrade' %} acao-pill--excluir{% endif %}{% if isActive %} active{% endif %}"
                   for="{{ child.vars.id }}">
              <input
                type="radio"
                id="{{ child.vars.id }}"
                name="{{ child.vars.full_name }}"
                value="{{ child.vars.value }}"
                data-tipo-nivel-ajax
                {{ isActive ? 'checked' : '' }}
              >
              <span>{% if child.vars.value == 'upgrade' %}⬆️{% else %}⬇️{% endif %} {{ child.vars.label }}</span>
              <svg class="pill-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
              </svg>
            </label>
          {% endfor %}
        </div>

        {{ form_errors(form.dados_tipoNivel) }}

        {% if tipoNivelAtual is null %}
          <p style="margin:.75rem 0 0;font-size:.85rem;color:var(--bs-secondary-color,#6c757d)">
            {% if isChamp %}
              Você é Champ. Selecione <strong>Upgrade</strong> ou <strong>Downgrade</strong> para continuar.
            {% else %}
              Selecione <strong>Upgrade</strong> para continuar preenchendo o formulário.
            {% endif %}
          </p>
        {% endif %}
      </div>
    </div>

    <div id="campos-extras-nivel-server">
      {% if tipoNivelAtual is not null %}
        {% for field in form %}
          {% if field.vars.name starts with 'dados_' and field.vars.name != 'dados_tipoNivel' %}
            {{ _self.renderField(field, souChampAuto) }}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}

{# ── Bloco gerente_area: radio Incluir/Excluir ─────────────────────────────── #}
{% elseif tipoAtual == 'gerente_area' %}
  {% if form.dados_acaoGerenteArea is defined %}
    <div class="sol-card campo-animado" id="card-acao-gerente-area-ajax">
      <div class="sol-card-body">
        {{ form_label(form.dados_acaoGerenteArea) }}

        <div class="acao-pill-group" role="radiogroup">
          {% for child in form.dados_acaoGerenteArea %}
            {% set isActive = acaoGerenteAtual == child.vars.value %}
            <label class="acao-pill{% if child.vars.value == 'excluir' %} acao-pill--excluir{% endif %}{% if isActive %} active{% endif %}"
                   for="{{ child.vars.id }}">
              <input
                type="radio"
                id="{{ child.vars.id }}"
                name="{{ child.vars.full_name }}"
                value="{{ child.vars.value }}"
                data-acao-gerente-area-ajax
                {{ isActive ? 'checked' : '' }}
              >
              <span>{% if child.vars.value == 'incluir' %}📌{% else %}🗑️{% endif %} {{ child.vars.label }}</span>
              <svg class="pill-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
              </svg>
            </label>
          {% endfor %}
        </div>

        {{ form_errors(form.dados_acaoGerenteArea) }}

        {% if acaoGerenteAtual is null %}
          <p style="margin:.75rem 0 0;font-size:.85rem;color:var(--bs-secondary-color,#6c757d)">
            Selecione a <strong>Ação</strong> desejada para continuar preenchendo o formulário.
          </p>
        {% endif %}
      </div>
    </div>

    <div id="campos-extras-gerente-area-server">
      {% if acaoGerenteAtual is not null %}
        {% for field in form %}
          {% if field.vars.name starts with 'dados_' and field.vars.name != 'dados_acaoGerenteArea' %}
            {{ _self.renderField(field, false) }}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% else %}
    {% for field in form %}
      {% if field.vars.name starts with 'dados_' %}
        {{ _self.renderField(field, false) }}
      {% endif %}
    {% endfor %}
  {% endif %}

{# ── Bloco gerente_estado_pais: radio Incluir/Excluir ───────────────────────── #}
{% elseif tipoAtual == 'gerente_estado_pais' %}
  {% if form.dados_acaoGerenteEstadoPais is defined %}
    <div class="sol-card campo-animado" id="card-acao-gerente-ep-ajax">
      <div class="sol-card-body">
        {{ form_label(form.dados_acaoGerenteEstadoPais) }}

        <div class="acao-pill-group" role="radiogroup">
          {% for child in form.dados_acaoGerenteEstadoPais %}
            {% set isActive = acaoGerenteEpAtual == child.vars.value %}
            <label class="acao-pill{% if child.vars.value == 'excluir' %} acao-pill--excluir{% endif %}{% if isActive %} active{% endif %}"
                   for="{{ child.vars.id }}">
              <input
                type="radio"
                id="{{ child.vars.id }}"
                name="{{ child.vars.full_name }}"
                value="{{ child.vars.value }}"
                data-acao-gerente-ep-ajax
                {{ isActive ? 'checked' : '' }}
              >
              <span>{% if child.vars.value == 'incluir' %}📌{% else %}🗑️{% endif %} {{ child.vars.label }}</span>
              <svg class="pill-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
              </svg>
            </label>
          {% endfor %}
        </div>

        {{ form_errors(form.dados_acaoGerenteEstadoPais) }}

        {% if acaoGerenteEpAtual is null %}
          <p style="margin:.75rem 0 0;font-size:.85rem;color:var(--bs-secondary-color,#6c757d)">
            Selecione a <strong>Ação</strong> desejada para continuar preenchendo o formulário.
          </p>
        {% endif %}
      </div>
    </div>

    <div id="campos-extras-gerente-ep-server">
      {% if acaoGerenteEpAtual is not null %}
        {% for field in form %}
          {% if field.vars.name starts with 'dados_' and field.vars.name != 'dados_acaoGerenteEstadoPais' %}
            {{ _self.renderField(field, false) }}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% else %}
    {% for field in form %}
      {% if field.vars.name starts with 'dados_' %}
        {{ _self.renderField(field, false) }}
      {% endif %}
    {% endfor %}
  {% endif %}

{# ── Demais tipos ────────────────────────────────────────────────── #}
{% else %}
  {% for field in form %}
    {% if field.vars.name starts with 'dados_' and field.vars.name != 'dados_tipoNivel' %}
      {{ _self.renderField(field, souChampAuto) }}
    {% endif %}
  {% endfor %}
{% endif %}

{# Bloco de provas Oops #}
<div id="bloco-oops" class="sol-card campo-animado{{ tipoAtual == 'oops' ? '' : ' d-none' }}">
  <div class="sol-card-header">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M4.502 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3"/><path d="M14.002 13a2 2 0 0 1-2 2h-10a2 2 0 0 1-2-2V5A2 2 0 0 1 2 3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-1.998 2zM14 2H4a1 1 0 0 0-1 1h9.002a2 2 0 0 1 2 2v7A1 1 0 0 0 15 11V3a1 1 0 0 0-1-1zM2.002 4a1 1 0 0 0-1 1v8l2.646-2.354a.5.5 0 0 1 .63-.062l2.66 1.773 3.71-3.71a.5.5 0 0 1 .577-.094l1.777 1.947V5a1 1 0 0 0-1-1z"/></svg>
    Provas (imagens)
  </div>
  <div class="sol-card-body">
    <label class="sol-help">Compartilhe as provas <span class="text-muted fw-normal" style="font-size:.8rem">(até 5 imagens, 1 MB cada)</span></label>
    <input type="file" id="input-oops-files" name="arquivos_oops[]" class="sol-input" accept="image/*" multiple>
    <div id="oops-file-preview" style="display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem"></div>
    <div id="oops-file-error" class="sol-error d-none mt-2"><i class="bi bi-exclamation-circle"></i> <span></span></div>
  </div>
</div>

{# ── JS: pills + gate Discuss ───────────────────────────────────────────────── #}
<script>
(function () {
  /* Pills */
  function bindPillActive(groupSelector) {
    document.querySelectorAll(groupSelector).forEach(function (group) {
      var pills = group.querySelectorAll('.acao-pill');
      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          pills.forEach(function (p) { p.classList.remove('active'); });
          pill.classList.add('active');
        });
      });
    });
  }
  bindPillActive('.acao-pill-group');

  /* Gate Discuss: libera o checkbox somente após clicar no link */
  var linkDiscuss = document.getElementById('link-discuss-intencao');
  if (linkDiscuss) {
    var checkbox = document.querySelector('[data-discuss-gate="1"]');
    linkDiscuss.addEventListener('click', function () {
      if (checkbox) {
        checkbox.removeAttribute('disabled');
        var helpEl = checkbox.closest('.sol-card-body');
        if (helpEl) {
          var hint = helpEl.querySelector('.sol-help, .form-text');
          if (hint) {
            hint.innerHTML = '✅ Link aberto. Agora marque a caixa após publicar sua intenção no Discuss.';
          }
        }
      }
    });
  }
})();
</script>

{# ── Macro interna: renderiza um campo genérico ou especializado ────────── #}
{% macro renderField(field, souChampAuto) %}
  {% if field.vars.name == 'dados_souChamp' %}
    {% if souChampAuto %}
      <input type="hidden" name="{{ field.vars.full_name }}" value="1">
    {% else %}
      <div class="sol-card campo-animado">
        <div class="sol-card-body">
          <div data-sou-champ-wrapper="1">
            {{ form_label(field) }}
            {{ form_widget(field, {attr: {'data-sou-champ': '1'}}) }}
            {{ form_errors(field) }}
            {% if field.vars.help is defined and field.vars.help %}<p class="sol-help">{{ field.vars.help }}</p>{% endif %}
          </div>
        </div>
      </div>
    {% endif %}

  {% elseif field.vars.name == 'dados_permalink' %}
    <div class="sol-card campo-animado">
      <div class="sol-card-body">
        <label class="sol-label{% if field.vars.required %} sol-label--required{% endif %}" for="{{ field.vars.id }}">
          {{ field.vars.label }}{% if field.vars.required %} <span class="sol-required" aria-hidden="true">*</span>{% endif %}
        </label>
        <div class="permalink-wrapper">
          {{ form_widget(field, {attr: {'data-permalink': '1', 'autocomplete': 'off', 'spellcheck': 'false', 'placeholder': 'https://waze.com/pt-BR/editor?env=row&lat=-20.255&lon=-43.224&zoomLevel=15'}}) }}
          <button type="button" class="permalink-copy-btn" title="Copiar URL" aria-label="Copiar permalink">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/></svg>
          </button>
        </div>
        {% if field.vars.help is defined and field.vars.help %}<p class="sol-help">{{ field.vars.help }}</p>{% endif %}
        {{ form_errors(field) }}
      </div>
    </div>

  {% else %}
    <div class="sol-card campo-animado">
      <div class="sol-card-body">
        {{ form_row(field) }}
      </div>
    </div>
  {% endif %}
{% endmacro %}
