{% set comentariosVisiveis = [] %}
{% for c in solicitacao.comentarios %}
  {% if not c.interno or is_granted('ROLE_ADMIN') %}
    {% set comentariosVisiveis = comentariosVisiveis|merge([c]) %}
  {% endif %}
{% endfor %}

<div id="chat" class="mt-5">
  <h5 class="mb-3"><i class="bi bi-chat-dots me-2"></i>Histórico de mensagens</h5>

  <div class="d-flex flex-column gap-3 mb-4" style="max-height:480px;overflow-y:auto" id="chat-messages">
    {% if comentariosVisiveis is empty %}
      <p class="text-muted text-center py-4">Nenhuma mensagem ainda.</p>
    {% endif %}
    {% for c in comentariosVisiveis %}
      {% set isMe = app.user and app.user.id == c.autor.id %}
      <div class="d-flex {{ isMe ? 'justify-content-end' }} gap-2">
        {% if not isMe %}
          <div class="avatar-sm bg-secondary text-white d-flex align-items-center justify-content-center rounded-circle fw-bold flex-shrink-0" style="width:36px;height:36px;font-size:.8rem">
            {{ c.autorNome|first|upper }}
          </div>
        {% endif %}
        <div class="rounded-3 px-3 py-2 shadow-sm {{ isMe ? 'bg-primary text-white' : (c.interno ? 'bg-warning-subtle border border-warning' : 'bg-light') }}"
             style="max-width:75%">
          <div class="d-flex align-items-center gap-2 mb-1">
            <strong style="font-size:.82rem">{{ c.autorNome }}</strong>
            {% if c.interno %}<span class="badge bg-warning text-dark" style="font-size:.7rem">Interno</span>{% endif %}
            {% if c.responsavel %}<span class="badge bg-secondary" style="font-size:.7rem">Equipe</span>{% endif %}
          </div>
          <p class="mb-0" style="font-size:.92rem;white-space:pre-wrap">{{ c.mensagem|nl2br }}</p>
          <div class="mt-1 opacity-75" style="font-size:.75rem">{{ c.criadoEm|date('d/m H:i') }}</div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if app.user %}
  <form method="post" action="{{ path('solicitacao_comentario_add', {id: solicitacao.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('comment_' ~ solicitacao.id) }}">
    <div class="input-group">
      <textarea name="mensagem" class="form-control" rows="2" placeholder="Escreva uma mensagem…" required maxlength="2000"></textarea>
      <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i></button>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <div class="form-check mt-2">
      <input class="form-check-input" type="checkbox" name="interno" id="checkInterno" value="1">
      <label class="form-check-label text-muted" for="checkInterno" style="font-size:.85rem">
        <i class="bi bi-lock me-1"></i>Comentário interno (visível apenas para a equipe)
      </label>
    </div>
    {% endif %}
  </form>
  {% endif %}
</div>
