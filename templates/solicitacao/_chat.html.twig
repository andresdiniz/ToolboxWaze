{#
  Partial: _chat.html.twig
  Recebe:
    - solicitacao  : Solicitacao
    - comentarios  : SolicitacaoComentario[]
  Usa o SolicitacaoVoter para controlar quem pode comentar.
#}
{% set podeVer      = is_granted('SOLICITACAO_VER',          solicitacao) %}
{% set podeComentar = is_granted('SOLICITACAO_COMENTAR',     solicitacao) %}
{% set podeInterno  = is_granted('SOLICITACAO_VER_INTERNO',  solicitacao) %}

<div class="card" id="chat">
    <div class="card-header fw-semibold d-flex align-items-center gap-2">
        <i class="bi bi-chat-dots"></i>
        Chat da solicitação
        <span class="badge bg-secondary ms-auto">{{ comentarios|length }}</span>
    </div>

    {# ── Lista de mensagens ── #}
    <div class="card-body chat-body" style="max-height:420px;overflow-y:auto">
        {% if comentarios is empty %}
            <p class="text-muted text-center my-4">
                <i class="bi bi-chat-square d-block mb-2" style="font-size:2rem"></i>
                Nenhuma mensagem ainda.
            </p>
        {% else %}
            {% for c in comentarios %}
                {# Comentários internos só são exibidos para quem tem permissão #}
                {% if not c.interno or podeInterno %}
                    {% set eMinhaMensagem = app.user and app.user.id == c.autor.id %}
                    <div class="d-flex mb-3 {{ eMinhaMensagem ? 'flex-row-reverse' : '' }}">

                        {# Avatar inicial #}
                        <div class="chat-avatar {{ eMinhaMensagem ? 'ms-2' : 'me-2' }}"
                             title="{{ c.autor.email }}">
                            {{ c.autor.email|slice(0,1)|upper }}
                        </div>

                        <div class="chat-bubble-wrap {{ eMinhaMensagem ? 'text-end' : '' }}"
                             style="max-width:78%">

                            {# Cabeçalho: nome + badge interno #}
                            <div class="small text-muted mb-1">
                                <span class="fw-semibold">{{ c.autor.email }}</span>
                                <span class="ms-2">{{ c.criadoEm|date('d/m/Y H:i') }}</span>
                                {% if c.interno %}
                                    <span class="badge bg-warning text-dark ms-1" title="Visível apenas para a equipe">
                                        <i class="bi bi-lock-fill me-1"></i>Interno
                                    </span>
                                {% endif %}
                            </div>

                            {# Bolha de mensagem #}
                            <div class="chat-bubble
                                {{ eMinhaMensagem ? 'bubble-mine' : 'bubble-other' }}
                                {{ c.interno ? 'bubble-interno' : '' }}">
                                {{ c.mensagem|nl2br }}
                            </div>

                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>

    {# ── Formulário de nova mensagem ── #}
    <div class="card-footer">
        {% if not app.user %}
            <p class="text-muted small mb-0">
                <i class="bi bi-lock me-1"></i>
                <a href="{{ path('app_login') }}">Entre</a> para participar da conversa.
            </p>
        {% elseif not podeComentar %}
            {# Usuário logado mas sem permissão #}
            <div class="alert alert-warning py-2 px-3 mb-0 small">
                <i class="bi bi-shield-exclamation me-1"></i>
                Apenas o solicitante e os responsáveis pelo tipo
                <strong>{{ solicitacao.tipoLabel }}</strong>
                podem comentar nesta solicitação.
            </div>
        {% else %}
            <form method="post"
                  action="{{ path('solicitacao_comentario_add', {id: solicitacao.id}) }}"
                  novalidate>
                <input type="hidden" name="_token"
                       value="{{ csrf_token('comment_' ~ solicitacao.id) }}">

                <div class="mb-2">
                    <textarea name="mensagem"
                              class="form-control form-control-sm"
                              rows="2"
                              placeholder="Digite sua mensagem…"
                              maxlength="2000"
                              required></textarea>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-send me-1"></i>Enviar
                    </button>

                    {# Checkbox "interno" só para responsáveis/admins #}
                    {% if podeInterno %}
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox"
                               name="interno" id="chat-interno-{{ solicitacao.id }}"
                               value="1">
                        <label class="form-check-label small text-muted"
                               for="chat-interno-{{ solicitacao.id }}">
                            <i class="bi bi-lock me-1"></i>Mensagem interna
                        </label>
                    </div>
                    {% endif %}
                </div>
            </form>
        {% endif %}
    </div>{# /card-footer #}
</div>{# /card #}

{# CSS inline do chat (carregado uma vez pelo partial) #}
<style>
.chat-avatar {
    width: 2rem; height: 2rem;
    border-radius: 50%;
    background: var(--bs-primary, #0d6efd);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: .8rem; font-weight: 700;
    flex-shrink: 0; align-self: flex-start;
}
.chat-bubble {
    display: inline-block;
    padding: .45rem .7rem;
    border-radius: .75rem;
    font-size: .875rem;
    line-height: 1.5;
    word-break: break-word;
    text-align: left;
}
.bubble-other {
    background: #f1f3f5;
    border-bottom-left-radius: .2rem;
}
.bubble-mine {
    background: #0d6efd;
    color: #fff;
    border-bottom-right-radius: .2rem;
}
.bubble-interno {
    opacity: .85;
    outline: 2px dashed #ffc107;
    outline-offset: 2px;
}
</style>
