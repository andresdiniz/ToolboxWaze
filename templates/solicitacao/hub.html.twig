{% extends 'base.html.twig' %}
{% block title %}Solicitações{% endblock %}

{% block body %}
<div class="container py-4" style="max-width:900px">

  {# ══ Cabeçalho ══════════════════════════════════════════════════════ #}
  <div class="sol-hub-header">
    <h4><i class="bi bi-send"></i> Solicitações</h4>
    <p>Envie pedidos ao time Waze Brasil e acompanhe o andamento.</p>
  </div>

  {# ══ Tabs ════════════════════════════════════════════════════════════ #}
  <div class="hub-tabs" role="tablist">
    <a href="{{ path('solicitacao_hub', {aba: 'nova'}) }}"
       class="hub-tab{{ abaAtual == 'nova' ? ' active' : '' }}"
       role="tab" aria-selected="{{ abaAtual == 'nova' ? 'true' : 'false' }}">
      <i class="bi bi-plus-circle"></i> Nova solicitação
    </a>
    {% if app.user %}
    <a href="{{ path('solicitacao_hub', {aba: 'historico'}) }}"
       class="hub-tab{{ abaAtual == 'historico' ? ' active' : '' }}"
       role="tab" aria-selected="{{ abaAtual == 'historico' ? 'true' : 'false' }}">
      <i class="bi bi-clock-history"></i> Meu histórico
    </a>
    {% endif %}
    {% if isAdmin %}
    <a href="{{ path('solicitacao_hub', {aba: 'gestao'}) }}"
       class="hub-tab{{ abaAtual == 'gestao' ? ' active' : '' }}"
       role="tab" aria-selected="{{ abaAtual == 'gestao' ? 'true' : 'false' }}">
      <i class="bi bi-sliders"></i> Gestão
      {% if contadores.pendente is defined and contadores.pendente > 0 %}
        <span class="tab-badge">{{ contadores.pendente }}</span>
      {% endif %}
    </a>
    {% endif %}
  </div>

  {# ══ ABA: NOVA SOLICITAÇÃO ══════════════════════════════════════════ #}
  {% if abaAtual == 'nova' %}

  {{ form_start(form, {attr: {id: 'form-solicitacao', novalidate: 'novalidate', autocomplete: 'off'}}) }}
  {{ form_errors(form) }}

  <div class="sol-card">
    <div class="sol-card-header"><i class="bi bi-person"></i> Seus dados</div>
    <div class="sol-card-body">
      <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.solicitanteNome) }}</div>
        <div class="col-md-6">{{ form_row(form.solicitanteUsuario) }}</div>
        <div class="col-12">{{ form_row(form.solicitanteEmail) }}</div>
      </div>
    </div>
  </div>

  <div class="sol-card">
    <div class="sol-card-header"><i class="bi bi-list-check"></i> Tipo de solicitação</div>
    <div class="sol-card-body">
      {{ form_widget(form.tipo,   {attr: {class: 'd-none', 'aria-hidden': 'true', 'data-tipo-select': '1'}}) }}
      {{ form_widget(form.estado, {attr: {'data-estado-select': '1'}}) }}
      {{ form_errors(form.tipo) }}
      <div class="tipo-grid mt-3" id="tipo-pills">
        {% set iconMap = {
          'imagem_satelite':     {'icon': 'bi-globe',                'label': 'Imagem de Satélite'},
          'gerente_area':        {'icon': 'bi-map',                  'label': 'Gerente de Área'},
          'gerente_estado_pais': {'icon': 'bi-flag',                 'label': 'Gerente de Estado/País'},
          'nivel':               {'icon': 'bi-bar-chart',            'label': 'Nível (Upgrade/Downgrade)'},
          'oops':                {'icon': 'bi-exclamation-triangle', 'label': 'Oops de Editor'},
          'bandeira_posto':      {'icon': 'bi-fuel-pump',            'label': 'Bandeira de Posto de Gasolina'},
          'id_segmento':         {'icon': 'bi-signpost-2',           'label': 'Cadastro de ID de Segmento'}
        } %}
        {% for valor, info in iconMap %}
          <div class="tipo-pill{% if tipoAtual == valor %} active{% endif %}"
               data-value="{{ valor }}" tabindex="0" role="button"
               aria-pressed="{{ tipoAtual == valor ? 'true' : 'false' }}">
            <span class="tipo-icon"><i class="bi {{ info.icon }}"></i></span>
            <span class="tipo-label">{{ info.label }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div id="campos-spinner">
    <div class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></div>
    Carregando campos…
  </div>

  <div id="campos-dinamicos">
    {% for field in form %}
      {% if field.vars.name starts with 'dados_' %}
        <div class="sol-card campo-animado">
          <div class="sol-card-body">
            {% if field.vars.name == 'dados_permalink' %}
              <label class="form-label" for="{{ field.vars.id }}">{{ field.vars.label }}</label>
              <div class="permalink-wrapper">
                {{ form_widget(field, {attr: {'data-permalink': '1', 'autocomplete': 'off', 'spellcheck': 'false', 'placeholder': 'https://www.waze.com/editor/?zoom=15&lat=-23&lon=-46'}}) }}
                <button type="button" class="permalink-copy-btn" title="Copiar URL" aria-label="Copiar permalink">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
              {% if field.vars.help is defined and field.vars.help %}
                <div class="form-text">{{ field.vars.help }}</div>
              {% endif %}
              {{ form_errors(field) }}
            {% else %}
              {{ form_row(field) }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
    <div id="bloco-oops" class="sol-card campo-animado{{ tipoAtual == 'oops' ? '' : ' d-none' }}">
      <div class="sol-card-header"><i class="bi bi-images"></i> Provas (imagens)</div>
      <div class="sol-card-body">
        <label class="form-label">Compartilhe provas <span class="text-muted fw-normal">(até 5 imagens, 1 MB cada)</span></label>
        <input type="file" name="arquivos_oops[]" class="form-control" accept="image/*" multiple>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-2 mb-5">
    <button type="submit" class="btn-enviar" id="btn-enviar"{{ tipoAtual ? '' : ' disabled' }}>
      <i class="bi bi-send"></i> Enviar solicitação
    </button>
  </div>
  {{ form_end(form) }}

  {% endif %}

  {# ══ ABA: MEU HISTÓRICO ════════════════════════════════════════════ #}
  {% if abaAtual == 'historico' %}
    {% if not app.user %}
      <div class="sol-empty">
        <i class="bi bi-lock sol-empty-icon"></i>
        <p>Faça login para ver seu histórico de solicitações.</p>
        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm px-4">Entrar</a>
      </div>
    {% elseif historico is empty %}
      <div class="sol-empty">
        <i class="bi bi-inbox sol-empty-icon"></i>
        <p>Você ainda não enviou nenhuma solicitação.</p>
        <a href="{{ path('solicitacao_hub', {aba: 'nova'}) }}" class="btn btn-primary btn-sm px-4">
          <i class="bi bi-plus-circle me-1"></i> Criar primeira solicitação
        </a>
      </div>
    {% else %}
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted" style="font-size:.82rem">{{ historico|length }} solicitação(s)</span>
      </div>
      {% for s in historico %}
        <a href="{{ path('solicitacao_detalhe', {id: s.id}) }}" class="hist-row">
          <span class="hist-id">#{{ s.id }}</span>
          <span class="badge-status {{ s.status }}">{{ s.status|capitalize }}</span>
          <span class="hist-tipo">{{ s.tipoLabel }}</span>
          {% if s.estado %}<span class="hist-uf">{{ s.estado }}</span>{% endif %}
          <span class="hist-data">{{ s.criadaEm|date('d/m/Y H:i') }}</span>
          <i class="bi bi-chevron-right hist-arrow"></i>
        </a>
      {% endfor %}
    {% endif %}
  {% endif %}

  {# ══ ABA: GESTÃO (admin) ════════════════════════════════════════════ #}
  {% if abaAtual == 'gestao' and isAdmin %}

    <div class="gestao-counters">
      <a href="{{ path('solicitacao_hub', {aba: 'gestao'}) }}"
         class="gestao-counter gc-pendente{{ filtroStatus is null and filtroTipo is null ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.pendente ?? 0 }}</span>
        <span class="gc-lbl">Pendentes</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'resolvida'}) }}"
         class="gestao-counter gc-resolvida{{ filtroStatus == 'resolvida' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.resolvida ?? 0 }}</span>
        <span class="gc-lbl">Resolvidas</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'cancelada'}) }}"
         class="gestao-counter gc-cancelada{{ filtroStatus == 'cancelada' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.cancelada ?? 0 }}</span>
        <span class="gc-lbl">Canceladas</span>
      </a>
    </div>

    <div class="gestao-tipo-filters">
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: filtroStatus}) }}"
         class="btn btn-sm {{ filtroTipo is null ? 'btn-secondary' : 'btn-outline-secondary' }}">
        Todos
      </a>
      {% set tipoLabels = {
        'imagem_satelite':     'Satélite',
        'gerente_area':        'Ger. Área',
        'gerente_estado_pais': 'Ger. Estado',
        'nivel':               'Nível',
        'oops':                'Oops',
        'bandeira_posto':      'Bandeira',
        'id_segmento':         'ID Segmento'
      } %}
      {% for val, lbl in tipoLabels %}
        <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: filtroStatus, tipo: val}) }}"
           class="btn btn-sm {{ filtroTipo == val ? 'btn-primary' : 'btn-outline-primary' }}">
          {{ lbl }}
        </a>
      {% endfor %}
    </div>

    {% if gestaoLista is empty %}
      <div class="sol-empty">
        <i class="bi bi-check2-all sol-empty-icon"></i>
        <p>Nenhuma solicitação encontrada com esses filtros.</p>
      </div>
    {% else %}
      <div class="mb-2">
        <span class="text-muted" style="font-size:.82rem">{{ gestaoLista|length }} registro(s)</span>
      </div>
      {% for s in gestaoLista %}
        <div class="gestao-row">
          <span class="gr-id">#{{ s.id }}</span>
          <span class="badge-status {{ s.status }}">{{ s.status|capitalize }}</span>
          <span class="gr-tipo">{{ s.tipoLabel }}</span>
          <span class="gr-user">
            {{ s.solicitanteUsuario }}
            {% if s.estado %}
              <span class="badge-status" style="background:var(--tw-light);color:var(--tw-dark);margin-left:.35rem">{{ s.estado }}</span>
            {% endif %}
          </span>
          <span class="gr-data">{{ s.criadaEm|date('d/m/Y H:i') }}</span>
          <div class="gr-actions">
            <a href="{{ path('solicitacao_detalhe', {id: s.id}) }}"
               class="btn btn-sm btn-outline-secondary" title="Ver detalhes">
              <i class="bi bi-eye"></i>
            </a>
            {% if s.isPendente() %}
              <button type="button"
                      class="btn btn-sm btn-outline-success"
                      data-bs-toggle="modal"
                      data-bs-target="#modal-resolver"
                      data-id="{{ s.id }}"
                      data-label="{{ s.tipoLabel }} · {{ s.solicitanteUsuario }}"
                      data-token="{{ csrf_token('resolver_' ~ s.id) }}">
                <i class="bi bi-check-lg"></i> Resolver
              </button>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}

    {# Modal resolver #}
    <div class="modal fade" id="modal-resolver" tabindex="-1" aria-labelledby="modal-resolver-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:1.5px solid var(--sol-border)">
          <div class="modal-header" style="border-bottom:1.5px solid var(--sol-border)">
            <h5 class="modal-title fw-semibold" id="modal-resolver-label">Resolver solicitação</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <form id="form-resolver" method="post" action="">
            <input type="hidden" name="_token" id="resolver-token" value="">
            <div class="modal-body">
              <p class="text-muted" style="font-size:.85rem" id="resolver-label"></p>
              <label class="form-label fw-semibold">Nota de resolução <span class="text-muted fw-normal">(opcional)</span></label>
              <textarea name="nota" class="form-control" rows="3" placeholder="Descreva como foi tratado…" style="border-radius:8px"></textarea>
            </div>
            <div class="modal-footer" style="border-top:1.5px solid var(--sol-border)">
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-success btn-sm px-4">
                <i class="bi bi-check-lg me-1"></i>Confirmar
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

  {% elseif abaAtual == 'gestao' and not isAdmin %}
    <div class="sol-empty">
      <i class="bi bi-shield-lock sol-empty-icon"></i>
      <p>Acesso restrito a administradores.</p>
    </div>
  {% endif %}

</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
  /* ── Modal resolver ─────────────────────────────────────────── */
  const modalEl = document.getElementById('modal-resolver');
  if (modalEl) {
    modalEl.addEventListener('show.bs.modal', function (e) {
      const btn = e.relatedTarget;
      document.getElementById('resolver-label').textContent = btn.dataset.label;
      document.getElementById('resolver-token').value       = btn.dataset.token;
      document.getElementById('form-resolver').action       =
        '/solicitacoes/' + btn.dataset.id + '/resolver';
    });
  }

  /* ── Permalink copy btn ──────────────────────────────────────── */
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.permalink-copy-btn');
    if (!btn) return;
    const input = btn.closest('.permalink-wrapper')?.querySelector('input');
    if (!input || !input.value) return;
    navigator.clipboard.writeText(input.value).then(() => {
      const icon = btn.querySelector('i');
      icon.className = 'bi bi-clipboard-check';
      btn.style.color = 'var(--tw)';
      setTimeout(() => { icon.className = 'bi bi-clipboard'; btn.style.color = ''; }, 1800);
    });
  });

  /* ── Validação de permalink (zoom ≥15) ─────────────────────── */
  const WAZE_RE = /^https?:\/\/(?:www\.|beta\.)?waze\.com\/editor\//i;
  const ZOOM_RE = /[?&]zoom=(\d+)/i;

  function checkPermalink(val) {
    const v = val.trim();
    if (!v) return { ok: true };
    if (!WAZE_RE.test(v)) return { ok: false, msg: 'A URL deve ser do editor Waze (waze.com/editor).' };
    const m = ZOOM_RE.exec(v);
    if (!m)            return { ok: false, msg: 'URL sem parâmetro zoom. Copie a URL completa do editor.' };
    const z = parseInt(m[1], 10);
    if (z < 15)        return { ok: false, msg: `Zoom ${z} é insuficiente — mínimo exigido: 15.` };
    return { ok: true, zoom: z };
  }

  function applyPermalinkFeedback(input, result) {
    const wrap   = input.closest('.permalink-wrapper') ?? input.parentElement;
    const parent = wrap.parentElement;
    input.classList.toggle('is-invalid', !result.ok);
    input.classList.toggle('is-valid',    result.ok && input.value.trim().length > 0);

    /* Mensagem de erro */
    let fb = parent.querySelector('.permalink-feedback');
    if (!result.ok) {
      if (!fb) { fb = document.createElement('div'); fb.className = 'invalid-feedback permalink-feedback'; wrap.insertAdjacentElement('afterend', fb); }
      fb.textContent = result.msg;
    } else if (fb) { fb.remove(); }

    /* Zoom badge */
    let badge = parent.querySelector('.permalink-zoom-badge');
    if (result.ok && result.zoom) {
      if (!badge) { badge = document.createElement('span'); badge.className = 'permalink-zoom-badge zoom-ok'; wrap.insertAdjacentElement('afterend', badge); }
      badge.className = 'permalink-zoom-badge zoom-ok';
      badge.innerHTML = `<i class="bi bi-check-circle-fill"></i> Zoom ${result.zoom} — válido`;
    } else if (badge) { badge.remove(); }
  }

  function initPermalinks() {
    document.querySelectorAll('[data-permalink]').forEach(input => {
      if (input.dataset.plInit) return;
      input.dataset.plInit = '1';
      input.addEventListener('blur',  () => applyPermalinkFeedback(input, checkPermalink(input.value)));
      input.addEventListener('input', () => {
        if (input.classList.contains('is-invalid')) {
          const r = checkPermalink(input.value);
          if (r.ok) applyPermalinkFeedback(input, r);
        }
      });
    });
  }
  initPermalinks();

  /* ── Formulário nova solicitação ───────────────────────────────── */
  const tipoSelect = document.querySelector('[data-tipo-select]');
  if (!tipoSelect) return;

  const estadoSel = document.querySelector('[data-estado-select]');
  const pills     = document.querySelectorAll('.tipo-pill');
  const dinamicos = document.getElementById('campos-dinamicos');
  const spinner   = document.getElementById('campos-spinner');
  const btnEnviar = document.getElementById('btn-enviar');

  pills.forEach(pill => {
    pill.addEventListener('click',   () => chooseTipo(pill.dataset.value));
    pill.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); chooseTipo(pill.dataset.value); }
    });
  });

  function chooseTipo(valor) {
    if (tipoSelect.value === valor) return;
    tipoSelect.value = valor;
    activatePill(valor);
    fetchCampos(valor);
  }

  function activatePill(valor) {
    pills.forEach(p => {
      const on = p.dataset.value === valor;
      p.classList.toggle('active', on);
      p.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (btnEnviar) btnEnviar.disabled = !valor;
  }

  function fetchCampos(tipo) {
    spinner.classList.add('show');
    dinamicos.classList.add('loading');
    const url = new URL(window.location.href);
    url.searchParams.set('aba', 'nova');
    url.searchParams.set('_ajax_tipo', tipo);
    if (estadoSel) url.searchParams.set('_ajax_estado', estadoSel.value ?? '');
    fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(html => {
        const doc  = new DOMParser().parseFromString(html, 'text/html');
        const novo = doc.getElementById('campos-dinamicos');
        if (novo) {
          dinamicos.innerHTML = novo.innerHTML;
          dinamicos.querySelectorAll('.sol-card').forEach((el, i) => {
            el.style.animationDelay = (i * 0.055) + 's';
          });
          initPermalinks();
        }
      })
      .catch(err => console.error('ToolboxWaze fetchCampos erro:', err))
      .finally(() => {
        spinner.classList.remove('show');
        dinamicos.classList.remove('loading');
      });
  }

  /* Bloqueia submit se permalink inválido */
  document.getElementById('form-solicitacao')
    ?.addEventListener('submit', e => {
      let ok = true;
      e.target.querySelectorAll('[data-permalink]').forEach(input => {
        if (!input.value.trim()) return;
        const r = checkPermalink(input.value);
        applyPermalinkFeedback(input, r);
        if (!r.ok) { ok = false; if (ok === false) input.focus(); }
      });
      if (!ok) e.preventDefault();
    });
})();
</script>
{% endblock %}
