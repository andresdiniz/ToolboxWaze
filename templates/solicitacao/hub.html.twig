{% extends 'base.html.twig' %}
{% block title %}Solicitações{% endblock %}
{% form_theme form 'form/sol_theme.html.twig' %}

{# ══ Macro: badge de status com ícone ══════════════════════════════════ #}
{% macro status_badge(status, label) %}
  {% set iconeMap = {
    'pendente':          'bi-inbox-fill',
    'em_andamento':      'bi-arrow-repeat',
    'aguardando_retorno':'bi-hourglass-split',
    'em_analise':        'bi-search',
    'resolvida':         'bi-check-circle-fill',
    'negada':            'bi-x-circle-fill',
    'cancelada':         'bi-slash-circle-fill'
  } %}
  <span class="badge-status {{ status }}">
    <i class="bi {{ iconeMap[status] ?? 'bi-circle' }} me-1"></i>{{ label }}
  </span>
{% endmacro %}
{% import _self as m %}

{% block body %}
<div class="container py-4" style="max-width:900px">

  {# ══ Cabeçalho ══════════════════════════════════════════════════════ #}
  <div class="sol-hub-header">
    <h4><i class="bi bi-send-fill"></i> Solicitações</h4>
    <p>Envie pedidos ao time Waze Brasil e acompanhe o andamento.</p>
  </div>

  {# ══ Flash messages ══════════════════════════════════════════════════ #}
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'danger' ? 'danger' : 'warning') }} alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : (label == 'danger' ? 'exclamation-octagon-fill' : 'exclamation-triangle-fill') }} me-2"></i>
        {{ message }}
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}
  {% endfor %}

  {# ══ Tabs ════════════════════════════════════════════════════════════ #}
  <div class="hub-tabs" role="tablist">
    <a href="{{ path('solicitacao_hub', {aba: 'nova'}) }}"
       class="hub-tab{{ abaAtual == 'nova' ? ' active' : '' }}"
       role="tab" aria-selected="{{ abaAtual == 'nova' ? 'true' : 'false' }}">
      <i class="bi bi-plus-circle-fill"></i> Nova solicitação
    </a>
    {% if app.user %}
    <a href="{{ path('solicitacao_hub', {aba: 'historico'}) }}"
       class="hub-tab{{ abaAtual == 'historico' ? ' active' : '' }}"
       role="tab" aria-selected="{{ abaAtual == 'historico' ? 'true' : 'false' }}">
      <i class="bi bi-clock-history"></i> Meu histórico
    </a>
    {% endif %}
    {% if isAdmin %}
    <a href="{{ path('solicitacao_hub', {aba: 'gestao'}) }}"
       class="hub-tab{{ abaAtual == 'gestao' ? ' active' : '' }}"
       role="tab" aria-selected="{{ abaAtual == 'gestao' ? 'true' : 'false' }}">
      <i class="bi bi-sliders2"></i> Gestão
      {% set totalAberto = (contadores.pendente ?? 0) + (contadores.em_andamento ?? 0) %}
      {% if totalAberto > 0 %}
        <span class="tab-badge">{{ totalAberto }}</span>
      {% endif %}
    </a>
    {% endif %}
  </div>

  {# ══ ABA: NOVA SOLICITAÇÃO ══════════════════════════════════════════ #}
  {% if abaAtual == 'nova' %}

  {{ form_start(form, {attr: {id: 'form-solicitacao', novalidate: 'novalidate', autocomplete: 'off'}}) }}
  {{ form_errors(form) }}

  <div class="sol-card">
    <div class="sol-card-header"><i class="bi bi-person-fill"></i> Seus dados</div>
    <div class="sol-card-body">
      <div class="row g-3">
        <div class="col-md-6" id="wrap-solicitanteNome">{{ form_row(form.solicitanteNome) }}</div>
        <div class="col-md-6" id="wrap-solicitanteUsuario">{{ form_row(form.solicitanteUsuario) }}</div>
        <div class="col-12"   id="wrap-solicitanteEmail">{{ form_row(form.solicitanteEmail) }}</div>
      </div>
    </div>
  </div>

  <div class="sol-card">
    <div class="sol-card-header"><i class="bi bi-grid-1x2-fill"></i> Tipo de solicitação</div>
    <div class="sol-card-body">
      {{ form_widget(form.tipo,   {attr: {class: 'd-none', 'aria-hidden': 'true', 'data-tipo-select': '1'}}) }}
      {{ form_widget(form.estado, {attr: {class: 'd-none', 'aria-hidden': 'true', 'data-estado-select': '1'}}) }}
      {{ form_errors(form.tipo) }}
      <div class="tipo-grid mt-3" id="tipo-pills">
        {% set iconMap = {
          'imagem_satelite':     {'icon': 'bi-image-fill',            'label': 'Imagem de Satélite'},
          'gerente_area':        {'icon': 'bi-pin-map-fill',          'label': 'Gerente de Área'},
          'gerente_estado_pais': {'icon': 'bi-flag-fill',             'label': 'Gerente de Estado/País'},
          'nivel':               {'icon': 'bi-graph-up-arrow',        'label': 'Nível (Upgrade/Downgrade)'},
          'oops':                {'icon': 'bi-bug-fill',              'label': 'Oops de Editor'},
          'bandeira_posto':      {'icon': 'bi-fuel-pump-fill',        'label': 'Bandeira de Posto'},
          'id_segmento':         {'icon': 'bi-signpost-split-fill',   'label': 'ID de Segmento'}
        } %}
        {% for valor, info in iconMap %}
          <div class="tipo-pill{% if tipoAtual == valor %} active{% endif %}"
               data-value="{{ valor }}" tabindex="0" role="button"
               aria-pressed="{{ tipoAtual == valor ? 'true' : 'false' }}">
            <span class="tipo-icon"><i class="bi {{ info.icon }}"></i></span>
            <span class="tipo-label">{{ info.label }}</span>
          </div>
        {% endfor %}
      </div>
      <div id="tipo-error-msg" class="sol-error d-none mt-2">
        <i class="bi bi-exclamation-circle"></i> Selecione o tipo de solicitação antes de enviar.
      </div>
    </div>
  </div>

  <div id="campos-spinner">
    <div class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></div>
    Carregando campos…
  </div>

  <div id="campos-dinamicos">
    {% for field in form %}
      {% if field.vars.name starts with 'dados_' %}
        <div class="sol-card campo-animado">
          <div class="sol-card-body">
            {% if field.vars.name == 'dados_permalink' %}
              <label class="sol-label" for="{{ field.vars.id }}">{{ field.vars.label }}</label>
              <div class="permalink-wrapper">
                {{ form_widget(field, {attr: {'data-permalink': '1', 'autocomplete': 'off', 'spellcheck': 'false', 'placeholder': 'https://waze.com/pt-BR/editor?env=row&zoom=15&lat=-23&lon=-46'}}) }}
                <button type="button" class="permalink-copy-btn" title="Copiar URL" aria-label="Copiar permalink">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
              {% if field.vars.help is defined and field.vars.help %}
                <p class="sol-help">{{ field.vars.help }}</p>
              {% endif %}
              {{ form_errors(field) }}
            {% else %}
              {{ form_row(field) }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
    <div id="bloco-oops" class="sol-card campo-animado{{ tipoAtual == 'oops' ? '' : ' d-none' }}">
      <div class="sol-card-header"><i class="bi bi-images"></i> Provas (imagens)</div>
      <div class="sol-card-body">
        <label class="sol-label">Compartilhe provas <span class="text-muted fw-normal">(até 5 imagens, 1 MB cada)</span></label>
        <input type="file" name="arquivos_oops[]" id="input-oops-files" class="sol-input" accept="image/*" multiple>
        <div id="oops-file-preview" class="d-flex flex-wrap gap-2 mt-2"></div>
        <p id="oops-file-error" class="sol-error d-none mt-1"><i class="bi bi-exclamation-circle"></i> <span></span></p>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-2 mb-5">
    <button type="submit" class="btn-enviar" id="btn-enviar"{{ tipoAtual ? '' : ' disabled' }}>
      <span id="btn-enviar-text"><i class="bi bi-send-fill"></i> Enviar solicitação</span>
      <span id="btn-enviar-loading" class="d-none">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando…
      </span>
    </button>
  </div>
  {{ form_end(form) }}

  {% endif %}

  {# ══ ABA: MEU HISTÓRICO ════════════════════════════════════════════ #}
  {% if abaAtual == 'historico' %}
    {% if not app.user %}
      <div class="sol-empty">
        <i class="bi bi-lock-fill sol-empty-icon"></i>
        <p>Faça login para ver seu histórico de solicitações.</p>
        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm px-4">Entrar</a>
      </div>
    {% elseif historico is empty %}
      <div class="sol-empty">
        <i class="bi bi-inbox-fill sol-empty-icon"></i>
        <p>Você ainda não enviou nenhuma solicitação.</p>
        <a href="{{ path('solicitacao_hub', {aba: 'nova'}) }}" class="btn btn-primary btn-sm px-4">
          <i class="bi bi-plus-circle-fill me-1"></i> Criar primeira solicitação
        </a>
      </div>
    {% else %}
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted" style="font-size:.82rem"><i class="bi bi-list-ul me-1"></i>{{ historico|length }} solicitação(s)</span>
      </div>
      {% for s in historico %}
        <a href="{{ path('solicitacao_detalhe', {id: s.id}) }}" class="hist-row">
          <span class="hist-id">#{{ s.id }}</span>
          {{ m.status_badge(s.status, s.statusLabel) }}
          <span class="hist-tipo">{{ s.tipoLabel }}</span>
          {% if s.estado %}<span class="hist-uf">{{ s.estado }}</span>{% endif %}
          <span class="hist-data">{{ s.criadaEm|date('d/m/Y H:i') }}</span>
          <i class="bi bi-chevron-right hist-arrow"></i>
        </a>
      {% endfor %}
    {% endif %}
  {% endif %}

  {# ══ ABA: GESTÃO (admin) ════════════════════════════════════════════ #}
  {% if abaAtual == 'gestao' and isAdmin %}

    <div class="gestao-counters">
      <a href="{{ path('solicitacao_hub', {aba: 'gestao'}) }}"
         class="gestao-counter gc-pendente{{ filtroStatus is null and filtroTipo is null ? ' ativo' : '' }}">
        <span class="gc-num">{{ (contadores.pendente ?? 0) + (contadores.em_andamento ?? 0) }}</span>
        <span class="gc-lbl"><i class="bi bi-hourglass-split me-1"></i>Em aberto</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'pendente'}) }}"
         class="gestao-counter gc-pendente{{ filtroStatus == 'pendente' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.pendente ?? 0 }}</span>
        <span class="gc-lbl"><i class="bi bi-inbox me-1"></i>Pendentes</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'em_andamento'}) }}"
         class="gestao-counter gc-andamento{{ filtroStatus == 'em_andamento' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.em_andamento ?? 0 }}</span>
        <span class="gc-lbl"><i class="bi bi-arrow-repeat me-1"></i>Em andamento</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'resolvida'}) }}"
         class="gestao-counter gc-resolvida{{ filtroStatus == 'resolvida' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.resolvida ?? 0 }}</span>
        <span class="gc-lbl"><i class="bi bi-check2-circle me-1"></i>Resolvidas</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'negada'}) }}"
         class="gestao-counter gc-negada{{ filtroStatus == 'negada' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.negada ?? 0 }}</span>
        <span class="gc-lbl"><i class="bi bi-x-circle me-1"></i>Negadas</span>
      </a>
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: 'cancelada'}) }}"
         class="gestao-counter gc-cancelada{{ filtroStatus == 'cancelada' ? ' ativo' : '' }}">
        <span class="gc-num">{{ contadores.cancelada ?? 0 }}</span>
        <span class="gc-lbl"><i class="bi bi-slash-circle me-1"></i>Canceladas</span>
      </a>
    </div>

    <div class="gestao-tipo-filters">
      <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: filtroStatus}) }}"
         class="btn btn-sm {{ filtroTipo is null ? 'btn-secondary' : 'btn-outline-secondary' }}">
        <i class="bi bi-grid me-1"></i>Todos
      </a>
      {% set tipoIconFilters = {
        'imagem_satelite':     {'icon': 'bi-image',           'label': 'Satélite'},
        'gerente_area':        {'icon': 'bi-pin-map',         'label': 'Ger. Área'},
        'gerente_estado_pais': {'icon': 'bi-flag',            'label': 'Ger. Estado'},
        'nivel':               {'icon': 'bi-graph-up-arrow',  'label': 'Nível'},
        'oops':                {'icon': 'bi-bug',             'label': 'Oops'},
        'bandeira_posto':      {'icon': 'bi-fuel-pump',       'label': 'Bandeira'},
        'id_segmento':         {'icon': 'bi-signpost-split',  'label': 'ID Seg.'}
      } %}
      {% for val, info in tipoIconFilters %}
        <a href="{{ path('solicitacao_hub', {aba: 'gestao', status: filtroStatus, tipo: val}) }}"
           class="btn btn-sm {{ filtroTipo == val ? 'btn-primary' : 'btn-outline-primary' }}">
          <i class="bi {{ info.icon }} me-1"></i>{{ info.label }}
        </a>
      {% endfor %}
    </div>

    {% if gestaoLista is empty %}
      <div class="sol-empty">
        <i class="bi bi-funnel sol-empty-icon"></i>
        <p>Nenhuma solicitação encontrada com esses filtros.</p>
        <a href="{{ path('solicitacao_hub', {aba: 'gestao'}) }}" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-counterclockwise me-1"></i>Limpar filtros
        </a>
      </div>
    {% else %}
      <div class="mb-2 d-flex justify-content-between align-items-center">
        <span class="text-muted" style="font-size:.82rem">
          <i class="bi bi-list-ul me-1"></i>{{ gestaoLista|length }} registro(s)
          {% if filtroStatus %} · filtro: <strong>{{ filtroStatus|replace({'_': ' '})|capitalize }}</strong>{% endif %}
          {% if filtroTipo %} · tipo: <strong>{{ filtroTipo|replace({'_': ' '})|capitalize }}</strong>{% endif %}
        </span>
      </div>
      {% for s in gestaoLista %}
        <div class="gestao-row">
          <span class="gr-id">#{{ s.id }}</span>
          {{ m.status_badge(s.status, s.statusLabel) }}
          <span class="gr-tipo">{{ s.tipoLabel }}</span>
          <span class="gr-user">
            {{ s.solicitanteUsuario }}
            {% if s.estado %}
              <span class="badge-status" style="background:var(--tw-light);color:var(--tw-dark);margin-left:.35rem">{{ s.estado }}</span>
            {% endif %}
          </span>
          <span class="gr-data">{{ s.criadaEm|date('d/m/Y H:i') }}</span>
          <div class="gr-actions">
            <a href="{{ path('solicitacao_detalhe', {id: s.id}) }}"
               class="btn btn-sm btn-outline-secondary" title="Ver detalhes">
              <i class="bi bi-eye-fill"></i>
            </a>
            {% if s.isPendente() or s.status == 'em_andamento' %}
              <button type="button"
                      class="btn btn-sm btn-outline-success"
                      data-bs-toggle="modal"
                      data-bs-target="#modal-resolver"
                      data-id="{{ s.id }}"
                      data-label="{{ s.tipoLabel }} · {{ s.solicitanteUsuario }}"
                      data-token="{{ csrf_token('resolver_' ~ s.id) }}"
                      data-action="{{ path('solicitacao_resolver', {id: s.id}) }}"
                      title="Resolver solicitação">
                <i class="bi bi-check2-square"></i> Resolver
              </button>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}

    {# Modal resolver — com seleção de desfecho #}
    <div class="modal fade" id="modal-resolver" tabindex="-1" aria-labelledby="modal-resolver-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:1.5px solid var(--sol-border)">
          <div class="modal-header" style="border-bottom:1.5px solid var(--sol-border)">
            <h5 class="modal-title fw-semibold" id="modal-resolver-label">
              <i class="bi bi-check2-square me-2 text-success"></i>Resolver solicitação
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <form id="form-resolver" method="post" action="">
            <input type="hidden" name="_token" id="resolver-token" value="">
            <div class="modal-body">
              <p class="text-muted mb-3" style="font-size:.85rem" id="resolver-label"></p>

              <label class="sol-label fw-semibold mb-2">Desfecho</label>
              <div class="d-flex gap-3 mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="desfecho" id="modal-des-resolvida" value="resolvida" checked>
                  <label class="form-check-label text-success fw-semibold" for="modal-des-resolvida">
                    <i class="bi bi-check-circle-fill me-1"></i>Resolvida
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="desfecho" id="modal-des-negada" value="negada">
                  <label class="form-check-label text-danger fw-semibold" for="modal-des-negada">
                    <i class="bi bi-x-circle-fill me-1"></i>Negada
     