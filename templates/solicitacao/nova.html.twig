{% extends 'base.html.twig' %}
{% block title %}Nova Solicitação{% endblock %}

{% block stylesheets %}
<style>
.sol-card {
  background: #fff;
  border: 1px solid #e2e5ea;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
  margin-bottom: 1.25rem;
  overflow: hidden;
}
.sol-card-header {
  background: #f8f9fb;
  border-bottom: 1px solid #e2e5ea;
  padding: .7rem 1.1rem;
  font-weight: 600;
  font-size: .85rem;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: #5a6478;
  display: flex;
  align-items: center;
  gap: .45rem;
}
.sol-card-header i { color: #0077b5; font-size: 1rem; }
.sol-card-body { padding: 1.1rem 1.25rem; }
.tipo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: .65rem;
  margin-top: .35rem;
}
.tipo-pill {
  display: flex;
  align-items: center;
  gap: .6rem;
  padding: .65rem .85rem;
  border: 2px solid #dee2e8;
  border-radius: 8px;
  cursor: pointer;
  transition: border-color .18s, background .18s, box-shadow .18s;
  user-select: none;
  background: #fff;
}
.tipo-pill:hover { border-color: #0077b5; background: #f0f7ff; }
.tipo-pill.active {
  border-color: #0077b5;
  background: #e8f3fb;
  box-shadow: 0 0 0 3px rgba(0,119,181,.12);
}
.tipo-pill .tipo-icon {
  width: 32px; height: 32px;
  border-radius: 7px;
  background: #e8f3fb;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-size: .95rem;
  color: #0077b5;
  transition: background .18s;
}
.tipo-pill.active .tipo-icon { background: #0077b5; color: #fff; }
.tipo-pill .tipo-label { font-size: .82rem; font-weight: 500; color: #374151; line-height: 1.3; }
.tipo-pill.active .tipo-label { color: #0055a0; font-weight: 600; }
#campos-dinamicos { transition: opacity .22s ease; }
#campos-dinamicos.loading { opacity: .4; pointer-events: none; }
#campos-spinner {
  display: none;
  justify-content: center;
  align-items: center;
  padding: 1.5rem 0;
  gap: .6rem;
  color: #0077b5;
  font-size: .9rem;
}
#campos-spinner.show { display: flex; }
.sol-card-body .form-label { font-weight: 500; font-size: .875rem; margin-bottom: .3rem; }
.sol-card-body .form-control,
.sol-card-body .form-select {
  border-color: #d1d5db;
  border-radius: 7px;
  font-size: .875rem;
  transition: border-color .18s, box-shadow .18s;
}
.sol-card-body .form-control:focus,
.sol-card-body .form-select:focus {
  border-color: #0077b5;
  box-shadow: 0 0 0 3px rgba(0,119,181,.15);
}
.btn-enviar {
  background: #0077b5;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: .6rem 2rem;
  font-weight: 600;
  font-size: .9rem;
  transition: background .18s, box-shadow .18s;
}
.btn-enviar:hover { background: #005c8e; box-shadow: 0 3px 10px rgba(0,119,181,.25); }
.btn-enviar:disabled { background: #a0c4d8; cursor: not-allowed; }
@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.campo-animado { animation: fadeSlideIn .28s ease both; }
</style>
{% endblock %}

{% block body %}
<div class="container py-4" style="max-width:780px">
  <div class="mb-4">
    <h4 class="fw-bold mb-0">📋 Formulário de Solicitações</h4>
    <p class="text-muted small mt-1">Escolha o tipo, preencha os dados e envie. Responderemos por e-mail.</p>
  </div>

  {{ form_start(form, {attr: {id: 'form-solicitacao', novalidate: 'novalidate', autocomplete: 'off'}}) }}
  {{ form_errors(form) }}

  {# ── 1. Dados do solicitante ─────────────────────────────── #}
  <div class="sol-card">
    <div class="sol-card-header"><i class="bi bi-person"></i> Seus dados</div>
    <div class="sol-card-body">
      <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.solicitanteNome) }}</div>
        <div class="col-md-6">{{ form_row(form.solicitanteUsuario) }}</div>
        <div class="col-12">{{ form_row(form.solicitanteEmail) }}</div>
      </div>
    </div>
  </div>

  {# ── 2. Tipo (pills visuais) ───────────────────────────────── #}
  <div class="sol-card">
    <div class="sol-card-header"><i class="bi bi-list-check"></i> Tipo de solicitação</div>
    <div class="sol-card-body">
      {{ form_widget(form.tipo, {attr: {class: 'd-none', 'aria-hidden': 'true', 'data-tipo-select': '1'}}) }}
      {{ form_widget(form.estado, {attr: {'data-estado-select': '1'}}) }}
      {{ form_errors(form.tipo) }}

      <div class="tipo-grid mt-3" id="tipo-pills">
        {% set iconMap = {
          'imagem_satelite':     {'icon': 'bi-globe',                'label': 'Imagem de Satélite'},
          'gerente_area':        {'icon': 'bi-map',                  'label': 'Gerente de Área'},
          'gerente_estado_pais': {'icon': 'bi-flag',                 'label': 'Gerente de Estado/País'},
          'nivel':               {'icon': 'bi-bar-chart',            'label': 'Nível (Upgrade/Downgrade)'},
          'oops':                {'icon': 'bi-exclamation-triangle', 'label': 'Oops de Editor'},
          'bandeira_posto':      {'icon': 'bi-fuel-pump',            'label': 'Bandeira de Posto de Gasolina'},
          'id_segmento':         {'icon': 'bi-signpost-2',           'label': 'Cadastro de ID de Segmento'}
        } %}
        {% for valor, info in iconMap %}
          <div class="tipo-pill{% if tipoAtual == valor %} active{% endif %}"
               data-value="{{ valor }}" tabindex="0" role="button"
               aria-pressed="{{ tipoAtual == valor ? 'true' : 'false' }}">
            <span class="tipo-icon"><i class="bi {{ info.icon }}"></i></span>
            <span class="tipo-label">{{ info.label }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  {# ── 3. Campos dinâmicos (AJAX) ────────────────────────────── #}
  <div id="campos-spinner">
    <div class="spinner-border spinner-border-sm" role="status"></div> Carregando campos…
  </div>

  <div id="campos-dinamicos">
    {% for field in form %}
      {% if field.vars.name starts with 'dados_' %}
        <div class="sol-card campo-animado">
          <div class="sol-card-body">{{ form_row(field) }}</div>
        </div>
      {% endif %}
    {% endfor %}

    <div id="bloco-oops" class="sol-card campo-animado{{ tipoAtual == 'oops' ? '' : ' d-none' }}">
      <div class="sol-card-header"><i class="bi bi-images"></i> Provas (imagens)</div>
      <div class="sol-card-body">
        <label class="form-label">Compartilhe provas <span class="text-muted">(até 5 imagens, 1 MB cada)</span></label>
        <input type="file" name="arquivos_oops[]" class="form-control" accept="image/*" multiple>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-2 mb-4">
    <button type="submit" class="btn-enviar" id="btn-enviar"{{ tipoAtual ? '' : ' disabled' }}>
      <i class="bi bi-send me-1"></i> Enviar solicitação
    </button>
  </div>

  {{ form_end(form) }}
</div>

<script>
(function () {
  const tipoSelect = document.querySelector('[data-tipo-select]');
  const estadoSel  = document.querySelector('[data-estado-select]');
  const pills      = document.querySelectorAll('.tipo-pill');
  const dinamicos  = document.getElementById('campos-dinamicos');
  const spinner    = document.getElementById('campos-spinner');
  const btnEnviar  = document.getElementById('btn-enviar');

  if (!tipoSelect) { console.error('ToolboxWaze: campo tipo não encontrado no DOM'); return; }

  pills.forEach(pill => {
    pill.addEventListener('click', () => chooseTipo(pill.dataset.value));
    pill.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); chooseTipo(pill.dataset.value); }
    });
  });

  function chooseTipo(valor) {
    if (tipoSelect.value === valor) return;
    tipoSelect.value = valor;
    activatePill(valor);
    fetchCampos(valor);
  }

  function activatePill(valor) {
    pills.forEach(p => {
      const on = p.dataset.value === valor;
      p.classList.toggle('active', on);
      p.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    btnEnviar.disabled = !valor;
  }

  function fetchCampos(tipo) {
    spinner.classList.add('show');
    dinamicos.classList.add('loading');
    const url = new URL(window.location.href);
    url.searchParams.set('_ajax_tipo', tipo);
    if (estadoSel) url.searchParams.set('_ajax_estado', estadoSel.value ?? '');
    fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(html => {
        const doc  = new DOMParser().parseFromString(html, 'text/html');
        const novo = doc.getElementById('campos-dinamicos');
        if (novo) {
          dinamicos.innerHTML = novo.innerHTML;
          dinamicos.querySelectorAll('.sol-card').forEach((el, i) => {
            el.style.animationDelay = (i * 0.05) + 's';
            el.classList.add('campo-animado');
          });
        }
      })
      .catch(err => console.error('ToolboxWaze fetchCampos erro:', err))
      .finally(() => {
        spinner.classList.remove('show');
        dinamicos.classList.remove('loading');
      });
  }
})();
</script>
{% endblock %}
