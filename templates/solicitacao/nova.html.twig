{% extends 'base.html.twig' %}
{% block title %}Nova Solicitação{% endblock %}
{% form_theme form 'form/sol_theme.html.twig' %}

{% block body %}
<div class="container py-4" style="max-width:800px">

  <div class="sol-hub-header">
    <h4>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:-.2em;margin-right:.35em"><path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338L14.13 2.577z"/><path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-3.5-2a.5.5 0 0 0-.5.5v1h-1a.5.5 0 0 0 0 1h1v1a.5.5 0 0 0 1 0v-1h1a.5.5 0 0 0 0-1h-1v-1a.5.5 0 0 0-.5-.5"/></svg>
      Nova Solicitação
    </h4>
    <p>Escolha o tipo, preencha os dados e envie. Responderemos por e-mail.</p>
  </div>

  {{ form_start(form, {attr: {id: 'form-solicitacao', novalidate: 'novalidate', autocomplete: 'off'}}) }}
  {{ form_errors(form) }}

  {# ── 1. Dados do solicitante ─────────────────────────────────────────────── #}
  <div class="sol-card">
    <div class="sol-card-header">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.294 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
      Seus dados
    </div>
    <div class="sol-card-body">
      <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.solicitanteNome) }}</div>
        <div class="col-md-6">{{ form_row(form.solicitanteUsuario) }}</div>
        <div class="col-12">{{ form_row(form.solicitanteEmail) }}</div>
      </div>
    </div>
  </div>

  {# ── 2. Tipo (pills visuais) ─────────────────────────────────────────────── #}
  <div class="sol-card">
    <div class="sol-card-header">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3.854 2.146a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 3.293l1.146-1.147a.5.5 0 0 1 .708 0m0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708L2 7.293l1.146-1.147a.5.5 0 0 1 .708 0m0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0"/></svg>
      Tipo de solicitação
    </div>
    <div class="sol-card-body">
      {{ form_widget(form.tipo,   {attr: {class: 'd-none', 'aria-hidden': 'true', 'data-tipo-select': '1'}}) }}
      {{ form_widget(form.estado, {attr: {'data-estado-select': '1', class: 'd-none', 'aria-hidden': 'true'}}) }}
      {{ form_errors(form.tipo) }}

      <div class="tipo-grid" id="tipo-pills">
        {% set iconMap = {
          'imagem_satelite': {
            'label': 'Imagem de Satélite',
            'svg': '<path d="M9.732 1.001a.5.5 0 0 1 .5-.5h.001a.5.5 0 0 1 .5.5v1.618a5.5 5.5 0 0 1 4.249 4.249h1.618a.5.5 0 0 1 0 1H15a5.5 5.5 0 0 1-4.768 4.768v1.618a.5.5 0 0 1-1 0v-1.618A5.5 5.5 0 0 1 4.483 8.37H2.865a.5.5 0 0 1 0-1h1.618A5.5 5.5 0 0 1 9.232 2.62V1zm.5 1.638A4.5 4.5 0 1 0 10.867 12.5 4.5 4.5 0 0 0 10.232 2.64zm.5 3.86A1 1 0 1 1 8.5 7.5a1 1 0 0 1 2.232-1z"/>'
          },
          'gerente_area': {
            'label': 'Gerente de Área',
            'svg': '<path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/><path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>'
          },
          'gerente_estado_pais': {
            'label': 'Gerente de Estado/País',
            'svg': '<path d="M14.778.085A.5.5 0 0 1 15 .5V8a.5.5 0 0 1-.314.464L14.5 8l.186.464-.003.001-.006.003-.023.009a12 12 0 0 1-.397.15c-.264.095-.631.223-1.047.35-.816.252-1.879.523-2.71.523-.847 0-1.548-.28-2.158-.525l-.028-.01C7.68 8.71 7.14 8.5 6.5 8.5c-.7 0-1.638.23-2.437.477A20 20 0 0 0 3 9.342V15.5a.5.5 0 0 1-1 0V.5a.5.5 0 0 1 1 0v.282c.226-.079.496-.17.79-.26C4.606.272 5.67 0 6.5 0c.84 0 1.524.277 2.121.519l.043.018C9.286.788 9.828 1 10.5 1c.7 0 1.638-.23 2.437-.477a20 20 0 0 0 1.061-.34z"/>'
          },
          'nivel': {
            'label': 'Nível (Upgrade/Downgrade)',
            'svg': '<path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/>'
          },
          'oops': {
            'label': 'Oops de Editor',
            'svg': '<path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057m1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/><path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>'
          },
          'bandeira_posto': {
            'label': 'Bandeira de Posto de Gasolina',
            'svg': '<path d="M3 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-5a.5.5 0 0 1-.5-.5zm1 .5v4h4V3z"/><path d="M0 1.5A.5.5 0 0 1 .5 1H8a.5.5 0 0 1 .5.5V8H9a1.5 1.5 0 0 1 1.5 1.5V12a.5.5 0 0 0 1 0V8.354l-.853-.853a.5.5 0 1 1 .707-.707l1.5 1.5A.5.5 0 0 1 13 8.5V12a1.5 1.5 0 0 1-3 0V9.5A.5.5 0 0 0 9.5 9H9V15.5a.5.5 0 0 1-.5.5H.5a.5.5 0 0 1-.5-.5zm1 0v13h7v-13z"/>'
          },
          'id_segmento': {
            'label': 'Cadastro de ID de Segmento',
            'svg': '<path d="M7 7V1.414a1 1 0 0 1 2 0V7h5.586a1 1 0 0 1 0 2H9v5.586a1 1 0 0 1-2 0V9H1.414a1 1 0 0 1 0-2z"/><path fill-rule="evenodd" d=".5 1h15a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5H12a.5.5 0 0 1 0-1h3V2H1v2h3a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5v-3A.5.5 0 0 1 .5 1m0 9h3a.5.5 0 0 1 0 1H1v2h3a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5v-3a.5.5 0 0 1 .5-.5m11.5 0h3a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5H12a.5.5 0 0 1 0-1h3v-2h-3a.5.5 0 0 1 0-1"/>'
          }
        } %}

        {% for valor, info in iconMap %}
          <div class="tipo-pill{% if tipoAtual == valor %} active{% endif %}"
               data-value="{{ valor }}" tabindex="0" role="button"
               aria-pressed="{{ tipoAtual == valor ? 'true' : 'false' }}">
            <span class="tipo-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">{{ info.svg|raw }}</svg>
            </span>
            <span class="tipo-label">{{ info.label }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  {# ── 3. Área dinâmica — 100% gerenciada pelo JS via AJAX ─────────────────── #}
  <div id="campos-spinner" style="display:none;align-items:center;gap:.5rem;padding:.5rem 0;color:var(--bs-secondary-color,#6c757d)">
    <div class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></div>
    Carregando campos…
  </div>

  <div id="campos-sub"></div>

  <div class="d-flex justify-content-end mt-2 mb-5">
    <button type="submit" class="btn-enviar" id="btn-enviar" disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" style="margin-right:.3em"><path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338L14.13 2.577z"/></svg>
      Enviar solicitação
    </button>
  </div>

  {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
  /* ── Permalink copy ──────────────────────────────────────────────────────── */
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.permalink-copy-btn');
    if (!btn) return;
    const input = btn.closest('.permalink-wrapper')?.querySelector('input');
    if (!input || !input.value) return;
    navigator.clipboard.writeText(input.value).then(() => {
      btn.style.color = 'var(--tw)';
      setTimeout(() => { btn.style.color = ''; }, 1800);
    });
  });

  /* ── Permalink validation ────────────────────────────────────────────────── */
  const WAZE_RE = /^https?:\/\/(?:www\.|beta\.)?waze\.com(?:\/[a-z]{2}(?:-[A-Z]{2})?)?\/editor/i;
  const ZOOM_RE = /[?&]zoom(?:Level)?=(\d+)/i;
  function checkPermalink(val) {
    const v = val.trim();
    if (!v) return { ok: true };
    if (!WAZE_RE.test(v)) return { ok: false, msg: 'URL deve ser do editor Waze (waze.com/editor).' };
    const m = ZOOM_RE.exec(v);
    if (!m) return { ok: false, msg: 'URL sem parâmetro zoom. Copie a URL completa do editor.' };
    const z = parseInt(m[1], 10);
    if (z < 15) return { ok: false, msg: `Zoom ${z} insuficiente — mínimo: 15.` };
    return { ok: true, zoom: z };
  }
  function applyPermalinkFeedback(input, result) {
    const wrap   = input.closest('.permalink-wrapper') ?? input.parentElement;
    const parent = wrap.parentElement;
    input.classList.toggle('is-invalid', !result.ok);
    input.classList.toggle('is-valid', result.ok && !!input.value.trim());
    let fb = parent.querySelector('.permalink-feedback');
    if (!result.ok) {
      if (!fb) { fb = document.createElement('p'); fb.className = 'sol-error permalink-feedback'; wrap.insertAdjacentElement('afterend', fb); }
      fb.textContent = result.msg;
    } else if (fb) fb.remove();
  }
  function initPermalinks(root) {
    (root ?? document).querySelectorAll('[data-permalink]').forEach(input => {
      if (input.dataset.plInit) return;
      input.dataset.plInit = '1';
      input.addEventListener('blur',  () => applyPermalinkFeedback(input, checkPermalink(input.value)));
      input.addEventListener('input', () => { if (input.classList.contains('is-invalid')) applyPermalinkFeedback(input, checkPermalink(input.value)); });
    });
  }

  /* ── Estado ─────────────────────────────────────────────────────────────── */
  const tipoSelect = document.querySelector('[data-tipo-select]');
  if (!tipoSelect) return;

  const subArea   = document.getElementById('campos-sub');
  const spinner   = document.getElementById('campos-spinner');
  const btnEnviar = document.getElementById('btn-enviar');
  const pills     = document.querySelectorAll('.tipo-pill');

  let tipoAtual           = '';
  let tipoNivelAtual      = null;
  let acaoGerenteAtual    = null;
  let acaoGerenteEpAtual  = null;
  let cargoAtual          = null;
  let souChampAtual       = false;
  let fetchController     = null;

  /* ── Avalia se botão Enviar deve ficar habilitado ───────────────────────── */
  function atualizaBtnEnviar() {
    if (!btnEnviar) return;
    let podeEnviar = !!tipoAtual;
    if (tipoAtual === 'nivel')               podeEnviar = tipoNivelAtual !== null;
    if (tipoAtual === 'gerente_area')        podeEnviar = acaoGerenteAtual !== null;
    // FIX: exige também cargoAtual para não habilitar o botão antes de escolher cargo
    if (tipoAtual === 'gerente_estado_pais') podeEnviar = acaoGerenteEpAtual !== null && cargoAtual !== null;
    btnEnviar.disabled = !podeEnviar;
  }

  /* ── Pills ───────────────────────────────────────────────────────────────── */
  pills.forEach(pill => {
    pill.addEventListener('click',   () => chooseTipo(pill.dataset.value));
    pill.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); chooseTipo(pill.dataset.value); } });
  });

  function chooseTipo(valor) {
    if (tipoAtual === valor) return;
    tipoAtual          = valor;
    tipoNivelAtual     = null;
    acaoGerenteAtual   = null;
    acaoGerenteEpAtual = null;
    cargoAtual         = null;
    souChampAtual      = false;
    tipoSelect.value   = valor;
    activatePill(valor);
    atualizaBtnEnviar();
    fetchCampos();
  }

  function activatePill(valor) {
    pills.forEach(p => {
      const on = p.dataset.value === valor;
      p.classList.toggle('active', on);
      p.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  /* ── AJAX ───────────────────────────────────────────────────────────────── */
  function fetchCampos() {
    if (fetchController) fetchController.abort();
    fetchController = new AbortController();

    spinner.style.display = 'flex';
    subArea.style.opacity = '0.4';

    const url = new URL('/solicitacoes/campos', window.location.origin);
    url.searchParams.set('tipo', tipoAtual);
    if (tipoNivelAtual)     url.searchParams.set('tipoNivel', tipoNivelAtual);
    if (acaoGerenteAtual)   url.searchParams.set('acaoGerenteArea', acaoGerenteAtual);
    if (acaoGerenteEpAtual) url.searchParams.set('acaoGerenteEstadoPais', acaoGerenteEpAtual);
    if (cargoAtual)         url.searchParams.set('cargo', cargoAtual);
    if (souChampAtual)      url.searchParams.set('souChamp', '1');

    fetch(url.toString(), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      signal: fetchController.signal
    })
      .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(html => {
        subArea.innerHTML = html;
        subArea.style.opacity = '';
        subArea.querySelectorAll('.sol-card').forEach((el, i) => { el.style.animationDelay = (i * 0.055) + 's'; });
        initPermalinks(subArea);
        bindSubListeners();
        atualizaBtnEnviar();
      })
      .catch(err => { if (err.name !== 'AbortError') console.error('fetchCampos erro:', err); })
      .finally(() => { spinner.style.display = 'none'; subArea.style.opacity = ''; });
  }

  /* ── Listeners dentro de #campos-sub ────────────────────────────────────── */
  function bindSubListeners() {
    // Radio Upgrade/Downgrade (tipo=nivel)
    subArea.querySelectorAll('[data-tipo-nivel-ajax]').forEach(radio => {
      if (radio.dataset.nivelBound) return;
      radio.dataset.nivelBound = '1';
      radio.addEventListener('change', function () {
        if (!this.checked || this.value === tipoNivelAtual) return;
        tipoNivelAtual = this.value;
        souChampAtual  = false;
        atualizaBtnEnviar();
        fetchCampos();
      });
      if (radio.checked && !tipoNivelAtual) {
        tipoNivelAtual = radio.value;
        atualizaBtnEnviar();
      }
    });

    // Radio Incluir/Excluir (tipo=gerente_area)
    subArea.querySelectorAll('[data-acao-gerente-area-ajax]').forEach(radio => {
      if (radio.dataset.gerenteAreaBound) return;
      radio.dataset.gerenteAreaBound = '1';
      radio.addEventListener('change', function () {
        if (!this.checked || this.value === acaoGerenteAtual) return;
        acaoGerenteAtual = this.value;
        atualizaBtnEnviar();
        fetchCampos();
      });
      if (radio.checked && !acaoGerenteAtual) {
        acaoGerenteAtual = radio.value;
        atualizaBtnEnviar();
      }
    });

    // Radio Incluir/Excluir (tipo=gerente_estado_pais)
    subArea.querySelectorAll('[data-acao-gerente-ep-ajax]').forEach(radio => {
      if (radio.dataset.gerenteEpBound) return;
      radio.dataset.gerenteEpBound = '1';
      radio.addEventListener('change', function () {
        if (!this.checked || this.value === acaoGerenteEpAtual) return;
        acaoGerenteEpAtual = this.value;
        cargoAtual = null;  // reset cargo ao trocar de ação
        atualizaBtnEnviar();
        fetchCampos();
      });
      if (radio.checked && !acaoGerenteEpAtual) {
        acaoGerenteEpAtual = radio.value;
        atualizaBtnEnviar();
      }
    });

    // Radio Gerente de Estado / Gerente de País (tipo=gerente_estado_pais)
    // FIX: dispara fetchCampos ao detectar radio checked por padrão para
    // garantir que o campo UF condicional seja carregado corretamente
    subArea.querySelectorAll('[data-cargo-select] input[type="radio"]').forEach(radio => {
      if (radio.dataset.cargoBound) return;
      radio.dataset.cargoBound = '1';
      radio.addEventListener('change', function () {
        if (!this.checked || this.value === cargoAtual) return;
        cargoAtual = this.value;
        fetchCampos();
      });
      if (radio.checked && !cargoAtual) {
        cargoAtual = radio.value;
        fetchCampos(); // necessário: fetch anterior não tinha cargo, campos condicionais podem estar ausentes
      }
    });

    // Checkbox souChamp — só aparece para não-Champ no tipo nivel
    const chk = subArea.querySelector('[data-sou-champ]');
    if (chk && !chk.dataset.champBound) {
      chk.dataset.champBound = '1';
      chk.addEventListener('change', function () {
        souChampAtual = this.checked;
        fetchCampos();
      });
    }
  }

  /* ── Validação e bloqueio do submit ─────────────────────────────────────── */
  document.getElementById('form-solicitacao')
    ?.addEventListener('submit', e => {
      let ok = true;

      // FIX: valida campos obrigatórios do solicitante antes de enviar
      const camposObrigatorios = ['solicitanteNome', 'solicitanteUsuario', 'solicitanteEmail'];
      camposObrigatorios.forEach(nome => {
        const el = e.target.querySelector(`[name$="[${nome}]"]`);
        if (!el) return;
        const vazio = !el.value.trim();
        el.classList.toggle('is-invalid', vazio);
        if (vazio && ok) {
          ok = false;
          e.preventDefault();
          el.focus();
        }
      });

      // Valida permalinks
      e.target.querySelectorAll('[data-permalink]').forEach(input => {
        if (!input.value.trim()) return;
        const r = checkPermalink(input.value);
        applyPermalinkFeedback(input, r);
        if (!r.ok && ok) { ok = false; e.preventDefault(); input.focus(); }
      });
    });
})();
</script>
{% endblock %}
