{% extends 'base.html.twig' %}
{% block title %}Formulário encerrado{% endblock %}
{% block body %}
<div class="container py-5 text-center">
    <i class="fas fa-clock fa-3x text-muted mb-3"></i>
    <h2>Formulário encerrado</h2>
    <p class="text-muted">O prazo para envio de "{{ form.nome }}" foi encerrado.</p>
    <a href="{{ path('solicitar_index') }}" class="btn btn-outline-secondary mt-2">
        <i class="fas fa-arrow-left me-1"></i> Voltar
    </a>
</div>
{% endblock %}
