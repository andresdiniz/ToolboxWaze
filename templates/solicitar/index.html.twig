{% extends 'base.html.twig' %}
{% block title %}Minhas Solicitações{% endblock %}

{% block body %}
<div class="container py-4">

    <h1 class="h4 fw-bold mb-4">
        <i class="fas fa-inbox me-2 text-primary"></i>Solicitações
    </h1>

    {# ── Forms disponíveis ── #}
    {% if forms %}
    <h5 class="mb-3 text-muted">Abrir nova solicitação</h5>
    <div class="row g-3 mb-5">
        {% for f in forms %}
        <div class="col-12 col-sm-6 col-md-4">
            <a href="{{ path('solicitar_form', {slug: f.slug}) }}"
               class="card h-100 text-decoration-none shadow-sm border-0 hover-lift">
                <div class="card-body">
                    <div class="fw-semibold mb-1">{{ f.nome }}</div>
                    {% if f.descricao %}
                        <div class="text-muted small">{{ f.descricao }}</div>
                    {% endif %}
                </div>
                <div class="card-footer bg-transparent border-0 text-end">
                    <span class="btn btn-sm btn-primary">Abrir <i class="fas fa-arrow-right ms-1"></i></span>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# ── Minhas solicitações ── #}
    <h5 class="mb-3 text-muted">Minhas solicitações recentes</h5>
    {% if minhas is empty %}
        <div class="text-center text-muted py-5">
            <i class="fas fa-inbox fa-2x mb-3 d-block"></i>
            Você ainda não enviou nenhuma solicitação.
        </div>
    {% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Tipo</th>
                    <th>Status</th>
                    <th>Enviada em</th>
                </tr>
            </thead>
            <tbody>
                {% for s in minhas %}
                <tr>
                    <td class="text-muted">{{ s.id }}</td>
                    <td>{{ s.tipoLabel }}</td>
                    <td>
                        <span class="badge bg-{{ s.statusCor }}">{{ s.statusLabel }}</span>
                    </td>
                    <td>{{ s.criadaEm|date('d/m/Y H:i') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

</div>
{% endblock %}
