{% extends 'base.html.twig' %}
{% block title %}Limite atingido{% endblock %}
{% block body %}
<div class="container py-5 text-center">
    <i class="fas fa-ban fa-3x text-warning mb-3"></i>
    <h2>Limite de envios atingido</h2>
    <p class="text-muted">Você já atingiu o número máximo de envios para "{{ form.nome }}".</p>
    <a href="{{ path('solicitar_index') }}" class="btn btn-outline-secondary mt-2">
        <i class="fas fa-arrow-left me-1"></i> Voltar
    </a>
</div>
{% endblock %}
